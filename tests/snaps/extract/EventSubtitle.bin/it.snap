  "4.2.0" => "Mi chiedo dove sia adesso...
O dee, vi prego... proteggetela!",
  "4.3.0" => "Impa",
  "4.4.0" => "Impa",
  "5.0.0" => "Oh...",
  "5.1.0" => "Eroico Link, sei arrivato...",
  "5.2.0" => "Eh?",
