Map {
  "0.0.0" => "A2La foudreR frappe les temples! A0%1sF5R perd de l'énergie!",
  "0.1.0" => "A0%1sF4R amplifie ses pouvoirs dans A2la base ennemieR!",
  "0.2.0" => "A0%1sF4R a subi des dégâts à cause A2de la foudreR!",
  "0.3.0" => "Ne laissez pas A0%1sF0R s'enfuir!",
  "0.4.0" => "Prenez le contrôle A6des autres forts des sagesR!",
  "0.5.0" => "Ne laissez pas A1les forts des sagesR tomber aux mains de l'ennemi!",
  "0.6.0" => "Vous avez détruit A6les statuesR!",
  "0.7.0" => "A0%1sF4R se dirige vers A0%2sF0R!",
  "0.8.0" => "A6Les arbres ont pousséR et créé un chemin!",
  "0.9.0" => "A0%1sF4R va A0%2sF6R pour appeler des renforts!",
  "0.10.0" => "A0%1sF4R a atteint A0%2sF0R et appelle des renforts!",
  "0.11.0" => "A0%1sF4R a quitté le champ de bataille!",
  "0.12.0" => "A0%1sF4R n'a pas pu appeler des renforts!",
  "0.13.0" => "A0%1sF4R a quitté le champ de bataille!",
  "0.14.0" => "Vous avez empêché l'appel des renforts!",
  "0.15.0" => "A6Tous les forts des sagesR sont sous votre contrôle!",
  "0.16.0" => "A2La foudreR a cessé!",
  "0.17.0" => "Toutes les portes A6des forts des sagesR sont ouvertes!",
  "0.18.0" => "Rassemblez les guerriers près A0%1sF3R!",
  "0.19.0" => "A0%1sF4R renforce A2les monstres de la place centraleR!",
  "0.20.0" => "Les pouvoirs A2des monstres de la place centraleR se sont amplifiés!",
  "0.21.0" => "A0%1sF4R et A0%2sF0R ont rejoint le champ de bataille!",
  "0.22.0" => "A0%1sF4R et A0%2sF0R se dirigent vers A6un fort des sagesR!",
  "0.23.0" => "A2Les monstres de la place centraleR ont été renforcés par la magie!",
  "0.24.0" => "A2Les monstres de la place centraleR ont encore été renforcés par la magie!",
  "0.25.0" => "A2Les monstres de la place centraleR ont encore été renforcés par la magie!",
  "0.26.0" => "A2Les monstres de la place centraleR se dirigent vers A0%1sF0R!",
  "0.27.0" => "A2Les deux monstres géantsR ont été vaincus!",
  "0.28.0" => "A2Les monstres de la place centraleR ont été vaincus!",
  "0.29.0" => "A6La destruction des statuesR a reconnecté le chemin!",
  "0.30.0" => "A6La pousse des arbresR a reconnecté le chemin!",
  "0.31.0" => "A2Les monstres du temple de la terreR se dirigent vers C1%2sF0R et A0%3sF0R!",
  "0.32.0" => "A2Les monstres du temple du ventR se dirigent vers C1%2sF0R et A0%3sF0R!",
  "0.33.0" => "L'activation de tous les interrupteurs a relié les chemins!",
  "0.34.0" => "A2La foudreR a repris! A0%1sF5R subit des dégâts!",
  "0.35.0" => "Reprenez le contrôle A6des forts des sagesR!",
  "0.36.0" => "Reprenez le contrôle A6des forts des sagesR!",
  "0.37.0" => "La prise A6des forts des sagesR a fait cesser la foudre!",
  "0.38.0" => "A0%1sF4R se renforce grâce à la magie!",
  "0.39.0" => "A0%1sF4R se dirige vers A0%2sF0R!",
  "0.40.0" => "A0%1sF4R a récupéré de l'énergie grâce à la magie!",
  "0.41.0" => "Rassemblez les guerriers près A0%1sF3R!",
  "0.42.0" => "La récupération d'énergie A0%1sF3R a cessé!",
  "0.43.0" => "A0%2sF5R a provoqué la fuite A0%1sF3R!",
  "0.44.0" => "A0%1sF5R a perdu la bataille!",
  "0.45.0" => "A0%1sF4R a pris la fuite! La bataille est perdue!",
  "0.46.0" => "A0%2sF5R s'est emparée C1%1sF2R!",
  "0.47.0" => "A6Une skulltulaR est apparue sur le champ de bataille!",
  "0.48.0" => "Trouvez A6la skulltulaR!",
  "0.49.0" => "Vous avez trouvé A6la skulltulaR!",
  "0.50.0" => "A6La skulltulaR est sur le point de s'enfuir!",
  "0.51.0" => "A6La skulltulaR s'est enfuie!",
  "0.52.0" => "Vous avez vaincu A0%1sF0R!",
  "0.53.0" => "Les portes A0%1sF2R sont ouvertes!",
  "0.54.0" => "C2%1sF4R est sous votre contrôle!",
  "0.55.0" => "A0%2sF5R s'est emparée C1%1sF2R!",
  "0.56.0" => "A0%1sF4R a rejoint A0%2sF0R!",
  "0.57.0" => "Des attaques menacent A0%1sF0R!",
  "0.58.0" => "La chute A0%1sF2R est imminente!",
  "0.59.0" => "A0%1sF5R a cessé de perdre de l'énergie!",
  "0.60.0" => "A2De puissants monstresR s'approchent A0%1sF3R!",
  "0.61.0" => "A6Des portes de la grotte centraleR sont ouvertes!",
  "0.62.0" => "A6Des portes du couloir des templesR sont ouvertes!",
  "0.63.0" => "A0%1sF4R a récupéré toute son énergie vitale!",
  "0.64.0" => "A0%1sF5R se dirigent vers C1%2sF0R!",
  "0.65.0" => "A0%1sF5R se dirigent maintenant vers A0%3sF0R!",
