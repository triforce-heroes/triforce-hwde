  "0.40.0" => "A0%1sF4R s'est réfugié sous terre!",
  "0.41.0" => "A2DesR A0%1sF7R sont apparus un peu partout!",
  "0.42.0" => "Éliminez A0%1sF1R et faites sortir A0%2sF0R!",
