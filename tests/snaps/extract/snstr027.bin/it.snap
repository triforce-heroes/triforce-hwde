Map {
  "0.0.0" => "L'A0%1sF1R attacca l'A0%2sF7R!",
  "0.1.0" => "Sconfiggi l'A0%1sF3R!",
  "0.2.0" => "Conquista l'altro presidio dell'A0%1sF5R!",
  "0.3.0" => "Le porte della A6caverna di cristalloR si sono aperte!",
  "0.4.0" => "Hai ottenuto l'A6anello anticoR!",
  "0.5.0" => "Le condizioni di vittoria sono cambiate!",
  "0.6.0" => "Devi sconfiggere A0%1sF2R!",
  "0.7.0" => "Le condizioni di sconfitta sono cambiate!",
  "0.8.0" => "A0%1sF0R perde o l'area A0%2sF4R cade!",
  "0.9.0" => "Le porte verso ovest si sono aperte!",
  "0.10.0" => "Sconfiggi A0%1sF2R!",
  "0.11.0" => "Appaiono i rinforzi dell'A0%1sF5R!",
  "0.12.0" => "A0%1sF0R si ritira temporaneamente!",
  "0.13.0" => "Appaiono A0%1sF7R e A0%2sF7R!",
  "0.14.0" => "A0%1sF4R va verso l'area A0%2sF6R!",
  "0.15.0" => "Non far infiltrare A0%1sF2R nel presidio!",
  "0.16.0" => "A0%1sF0R è nell'area A0%2sF6R e sta per farsi esplodere!",
  "0.17.0" => "L'area C1%1sF0R è caduta per l'esplosione di A0%2sF6R!",
  "0.18.0" => "Il morale dell'A0%1sF1R e dell'A0%2sF1R è migliorato!",
  "0.19.0" => "L'area C1%2sF4R cade, demoralizzando l'A0%1sF1R!",
  "0.20.0" => "L'area C1%1sF0R è caduta per l'esplosione di A0%2sF6R!",
  "0.21.0" => "A0%1sF0R è esplosa!",
  "0.22.0" => "A0%1sF1R sono esplose!",
  "0.23.0" => "A0%1sF4R ancora più forte appare nell'area A0%2sF6R!",
  "0.24.0" => "Presto, conquista il presidio dell'A0%1sF1R!",
  "0.25.0" => "A0%1sF0R e A0%2sF2R cominciano a combattere!",
  "0.26.0" => "A0%1sF0R è in difficoltà! Vai in soccorso!",
  "0.27.0" => "A0%1sF0R è in grande difficoltà! Corri in soccorso!",
  "0.28.0" => "Hai sconfitto A0%1sF2R e A0%2sF2R!",
  "0.29.0" => "L'area A0%1sF0R è aperta!",
  "0.30.0" => "Sconfiggi A0%1sF2R!",
  "0.31.0" => "Appaiono 2 A0%1sF0R!",
  "0.32.0" => "Il A0%1sF0R a nord ovest va verso l'area A0%2sF6R!",
  "0.33.0" => "A0%1sF0R ha tradito! Va verso l'area A0%2sF6R!",
  "0.34.0" => "A0%1sF0R e A0%2sF2R perdono!",
  "0.35.0" => "A0%1sF0R entra nell'area A0%2sF6R!",
  "0.36.0" => "A0%1sF0R vuole attaccare l'A0%2sF7R!",
  "0.37.0" => "Hai sconfitto A0%1sF2R!",
  "0.38.0" => "Hai sconfitto A0%1sF2R e A0%2sF2R!",
  "0.39.0" => "A0%1sF0R inonda di magia oscura A0%2sF2R e A0%3sF2R.",
  "0.40.0" => "L'area C1%1sF0R è caduta!",
  "0.41.0" => "L'A0%1sF1R ha perso la battaglia!",
  "0.42.0" => "A0%1sF0R fugge!",
  "0.43.0" => "A0%1sF0R ha perso e l'armata si ritira!",
  "0.44.0" => "Appaiono i rinforzi dell'A0%1sF5R!",
  "0.45.0" => "La A6porta ovest del presidio centraleR è aperta!",
  "0.46.0" => "L'area A0%1sF6R non deve cadere!",
  "0.47.0" => "Il morale dell'A0%1sF1R è migliorato!",
  "0.48.0" => "A0%1sF0R e l'A0%2sF1R cominciano a combattere!",
  "0.49.0" => "Hai conquistato tutti i presidi dell'A0%1sF5R!",
  "0.50.0" => "L'area A0%1sF4R non deve cadere!",
  "0.51.0" => "Raggiungi la A6caverna di cristalloR e cerca l'A6anello anticoR!",
  "0.52.0" => "Conquista l'area A0%1sF2R per poter cercare l'A6anello anticoR!",
  "0.53.0" => "Hai sconfitto A0%1sF2R!",
  "0.54.0" => "È apparso un A5evocatoreR!",
  "0.55.0" => "Un'A6AracnulaR è stata avvistata sul campo di battaglia!",
  "0.56.0" => "Cerca l'A6AracnulaR!",
  "0.57.0" => "Hai ottenuto un'A6AracnulaR!",
  "0.58.0" => "L'A6AracnulaR si prepara alla fuga!",
  "0.59.0" => "L'A6AracnulaR è fuggita!",
  "0.60.0" => "A0%1sF0R appare e va verso l'area C2%2sF6R!",
  "0.61.0" => "Hai conquistato l'area C2%1sF4R!",
  "0.62.0" => "Raggiungi A0%1sF2R!",
  "0.63.0" => "L'A0%1sF0R lotta contro A0%2sF2R!",
  "0.64.0" => "A0%1sF0R appare e va verso l'area C2%2sF6R!",
  "0.65.0" => "Nell'area A0%1sF6R si nasconde un tesoro!",
  "0.66.0" => "Se A0%1sF2R esplode, il presidio cadrà!",
