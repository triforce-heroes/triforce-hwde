  "0.11.0" => "A0%1sF4R a atteint le A6point de destinationR !",
  "0.12.0" => "A1NarishaR rejoint le champ de bataille, attiré par l'odeur de la soupe !",
  "0.13.0" => "A1NarishaR a relié les deux chemins !",
  "0.14.0" => "C2%1sF4R et C2%2sF0R sont ouverts !",
  "0.15.0" => "A0%1sF4R avance vers la A1base alliéeR !",
