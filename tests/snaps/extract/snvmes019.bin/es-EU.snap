Map {
  "1.0.0.0" => "¡Eh, ayudadnos! ¡Juntos podremos
vencer a Volga!",
  "1.0.1.0" => "¿Necesitáis ayuda? ¡Yo me encargo!
¡Por algo soy la heroína legendaria!",
  "1.0.2.0" => "¡Con el martillo legendario no podemos
perder! ¡Dejadme a mí a ese tal Volga!",
  "1.0.3.0" => "¡Luchar solo es muy peligroso! ¡Salid del
templo y ayudad a Darunia!",
  "1.0.4.0" => "Vaya, un tonto solitario... ¡Enfréntate
a mí si quieres que llegue tu fin!",
  "1.0.5.0" => "Así que todos los monstruos están en el
mismo sitio... ¡Yo acabaré con ellos!",
  "1.0.6.0" => "Las cosas están poniéndose complicadas.
¡Hemos de ayudar a Darunia!",
  "1.0.7.0" => "Para reunirnos con Darunia tenemos que
abrir la entrada al templo.",
  "1.0.8.0" => "¡Nosotros nos encargaremos de franquear
la entrada al templo!",
  "1.0.9.0" => "Si seguimos así, no podremos llegar
a la puerta del templo...",
  "1.0.10.0" => "Son demasiado fuertes...",
  "1.0.11.0" => "La puerta está rota, y nosotros no
podemos arreglarla...",
  "1.0.12.0" => "¿Rota? Entonces reuníos con los otros
e intentaremos buscar una solución.",
  "1.0.14.0" => "Si trabajamos juntos, podremos arreglar
la puerta sin problemas.",
  "1.0.15.0" => "¡Sin los goron nunca podremos
abrir esa puerta!",
  "1.0.16.0" => "Sssi queréis abrir esssa puerta, nosotros
nos encargaremosss.",
  "1.0.17.0" => "¡La puerta está abierta y el enemigo
está entrando por ella!",
  "1.0.18.0" => "Darunia no sobrevivirá si no acudimos
pronto en su ayuda...",
  "1.0.19.0" => "¡Sí, debemos darnos prisa!",
  "1.0.20.0" => "¡Dessstrozad su bassse!",
  "1.0.21.0" => "¡El enemigo tiene nuestra base como
objetivo! ¡Debemos defenderla!",
  "1.0.22.0" => "¡No os preocupéis! ¡Yo defenderé
la base!",
  "1.0.23.0" => "¡La puerta se ha abierto y los monstruos
están entrando!",
  "1.0.24.0" => "Muchas gracias por vuestra ayuda.
¡Ahora ya podemos ir en busca de Volga!",
  "1.0.25.0" => "Has luchado solo durante un buen rato...
¿Seguro que estás bien?",
  "1.0.26.0" => "¡Darunia, no seas tan impetuoso!",
  "1.0.27.0" => "Al fin tenemos un poco de tranquilidad,
¡pero no debemos bajar la guardia!",
  "1.0.28.0" => "¡Debemosss tomar su bassse!",
  "1.0.29.0" => "El jefe de los goron es másss duro
de lo que pensábamos...",
  "1.0.30.0" => "¿Que la puerta essstá cerrada?
Pues tendremosss que abrirla...",
  "1.0.31.0" => "¡Ahora tomaremosss la base enemiga!",
  "1.0.32.0" => "¡No es posssible que me hayan vencido!",
  "1.0.33.0" => "¡No seremos nosotros los que caigamos
ante unos monstruos tan viles!",
  "1.0.34.0" => "¡Bien! Los monstruos se retiran
de nuestra base.",
  "1.0.35.0" => "Nos hemosss descuidado y por essso
nos han vencido...",
  "1.0.36.0" => "Vaya, qué bien que hayamos acabado con
esos escamosos...",
  "1.0.37.0" => "¡Bien! Sin esos reptiles rondando será
mucho más fácil defender la base.",
  "1.0.38.0" => "¡Nuestra base está a salvo de nuevo!",
  "1.0.39.0" => "Vaya, tener que vencerlos tantas veces
ha acabado con toda mi energía...",
  "1.0.40.0" => "¡¿Han acabado con mis aliados?!
Son más fuertes de lo que pensaba...",
  "1.0.41.0" => "¡Venceré a Volga con mis propias manos!",
  "1.0.42.0" => "No lo tendrás tan fácil, mentecato...",
  "1.0.43.0" => "¡Si continúan molestándome jamás podré
llegar adonde está Volga!",
  "1.0.44.0" => "¡Que alguien ayude a Darunia!",
  "1.0.45.0" => "¡Yo ayudaré!",
  "1.0.46.0" => "El bastión está cerrado.
¿Qué podemos hacer?",
  "1.0.47.0" => "Son duros de pelar... La batalla se está
poniendo muy peligrosa.",
  "1.0.48.0" => "Si alguien no me ayuda, ¡pronto estaré
más tieso que un bistec de roca!",
  "1.0.49.0" => "¡Eh, Volga! Si eres tan duro, ¿por qué
no te enfrentas a mí directamente?",
  "1.0.50.0" => "Bueno, ya que has llegado hasta aquí,
es posible que pueda divertirme contigo.",
  "1.0.51.0" => "¡Ayudad a Darunia! No se da cuenta de
que solo está perdido...",
  "1.0.52.0" => "¡Juntos seguro que venceremos!",
  "1.0.53.0" => "¡¿Nos están derrotando?! Parece que
los goron son bastante fuertes...",
  "1.0.54.0" => "¡Os aplastaré a todos!",
  "1.0.55.0" => "¡Marchando una ración de martillo!",
  "1.0.56.0" => "No puedo creer que tenga que retirarme.
¡Qué amargo sabor el de la derrota!",
  "1.0.57.0" => "¡Lo hemos conseguido! ¡Muchas gracias
por la ayuda!",
  "1.0.58.0" => "No hay de qué... ¡Un momento!
¡La brújula está brillando de nuevo!",
  "1.0.59.0" => "Lo siento, me han derrotado...",
  "1.0.60.0" => "¡Han tomado nuestra base!",
  "1.0.61.0" => "¡Fuera de mi camino! ¡Voy a acabar
con Volga yo solo!",
  "1.0.62.0" => "¡El enemigo va hacia los goron que se
ocupan de la puerta! ¡Hay que ayudarlos!",
  "1.0.63.0" => "¡Cuando se trata de ayudar, la heroína
de la leyenda es la mejor opción!",
  "1.0.64.0" => "¡Perfecto! ¡Hemos abierto la puerta!",
  "1.0.65.0" => "¡Bravo! ¿Darunia está bien?",
  "1.0.66.0" => "¡El templo se ha abierto desde dentro!
Pero ¿por qué?",
  "1.0.67.0" => "Pensaba que la puerta estaba rota...
¡Pero ahora hay que acabar con Volga!",
  "1.0.68.0" => "¡No voy a consentir que acaben conmigo
cuando he conseguido llegar tan lejos!",
  "1.0.69.0" => "¡Hay que parar a los monstruos! ¡No
debemos dejar que entren en la base!",
  "1.0.70.0" => "Todos luchan con valor... ¡No puedo
permitirme el lujo de perder!",
  "1.0.71.0" => "¡Darunia está en peligro!
¡Debemos ayudarlo enseguida!",
  "1.0.72.0" => "Yo me encargo de abrir el bastión.
¡Solo tengo que llegar hasta él!",
  "1.0.73.0" => "¡Aguanta, Darunia! ¡Ya vamos
en tu ayuda!",
  "1.0.74.0" => "¡Yo seré quien acabe con Volga!",
  "1.0.75.0" => "¡No debemos permitir que Darunia
sea derrotado!",
  "1.0.76.0" => "¡Si todos juntos protegemos la base,
el enemigo no podrá tomarla!",
  "1.0.77.0" => "Creo que he roto la puerta al cerrarla...
Bueno, así el enemigo no podrá entrar.",
  "1.0.78.0" => "Creo que es porque hemos vencido a los
monstruos. ¡Ahora, al Castillo de Hyrule!",
  "13.0.2.0" => "¡Se trataba de una impostora! Debemos
averiguar quién es en realidad.",
  "13.0.3.0" => "Yo rastrearé la zona este, vosotros
ocupaos del oeste.",
  "13.0.4.0" => "Sigue haciéndose llamar princesa...",
  "13.0.5.0" => "El enemigo viene hacia aquí...",
  "13.0.6.0" => "Buen trabajo. Entremos
en el Templo del Agua.",
  "13.0.7.0" => "¡Vamos!",
  "13.0.8.0" => "Nos atacan... ¡Tenemos que hacer algo!",
  "13.0.9.0" => "Estaré bien, lo importante ahora es
abrir todas las compuertas. ¡Rápido!",
  "13.0.10.0" => "Qué curioso; el agua se
ha retirado ligeramente.",
  "13.0.11.0" => "Ya podemos salvar a la princesa Ruto.",
  "13.0.12.0" => "Tenemos que interceptarlos
en este bastión.",
  "13.0.13.0" => "¡Despejado! Ahora solo queda lidiar con
la impostora.",
  "13.0.14.0" => "Lo siento...",
  "13.0.15.0" => "Sea como sea, el camino está despejado.",
  "13.0.16.0" => "Es demasiado fuerte...
¡Retirémonos al bastión!",
  "13.0.17.0" => "Si la impostora ha invocado a ese
monstruo, creo que ya sé quién es.",
  "13.0.18.0" => "No tiene sentido seguir
adelante sin Ruto...",
  "13.0.19.0" => "Acabemos con el enemigo de esta zona.
¡Atacad desde el acantilado norte!",
  "13.0.20.0" => "Gracias por la ayuda. Yo ya estoy bien,
¡así que ayuda a Ruto, por favor!",
  "13.0.21.0" => "Gracias por la ayuda.
¡Estoy perfectamente!",
  "13.0.22.0" => "Hemos conseguido pararlos...",
  "13.0.23.0" => "¡El enemigo nos supera!",
  "13.0.35.0" => "No tiene sentido seguir
adelante sin Ruto...",
  "13.0.36.0" => "Acabemos con el enemigo de esta zona.
¡Atacad desde el acantilado norte!",
  "13.0.37.0" => "Gracias por la ayuda. Yo ya estoy bien,
¡así que ayuda a Ruto, por favor!",
  "13.0.38.0" => "Gracias por la ayuda.
¡Estoy perfectamente!",
  "13.0.39.0" => "Hemos conseguido pararlos...",
  "13.0.40.0" => "¡El enemigo nos supera!",
  "13.0.52.0" => "No podemos seguir luchando sin la princesa Ruto.",
  "13.0.53.0" => "Acabemos con los enemigos de esta zona primero.
Luego rodearemos el acantilado norte.",
}