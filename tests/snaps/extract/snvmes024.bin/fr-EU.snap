Map {
  "1.0.0.0" => "Pourquoi y a-t-il autant de portes des âmes ?!
Fermons-les pour empêcher l'apparition des monstres !",
  "1.0.1.0" => "Attention ! Des monstres
inconnus protègent les portes !",
  "1.0.2.0" => "La magie des portes manipulerait-elle les
monstres ? Nous allons devoir les battre.",
  "1.0.3.0" => "Je te laisse les monstres au nord ! Nous, on
intercepte les ennemis qui arrivent du pont est !",
  "1.0.4.0" => "Les ennemis sont toujours plus nombreux !
On n'arrivera pas à les arrêter !",
  "1.0.5.0" => "La porte s'est fermée quand on a vaincu
ce monstre... Bien, continuons comme ça !",
  "1.0.6.0" => "Hé ! C'est quoi, ça ?! Un oiseau
gigantesque nous est tombé dessus !",
  "1.0.7.0" => "Il veut peut-être juste se reposer... ?
On ferait mieux de le laisser tranquille !",
  "1.0.8.0" => "Allez, profitons de son inattention
passagère pour... nous enfuir !",
  "1.0.9.0" => "Hé ! Mais qui es-tu ?!",
  "1.0.10.0" => "Moi ? Je m'appelle Tetra. J'ai été
enlevée par cet oiseau, le roi Cuirasse !",
  "1.0.11.0" => "Aïe, il m'a repérée, je crois. Tu veux
bien m'aider à m'en débarrasser ?",
  "1.0.12.0" => "Hein ? Euh... J'ai pas tout compris, mais
s'il suffit de chasser cet oiseau... ça me va !",
  "1.0.13.0" => "C'est terrible ! L'oiseau attaque Tetra !
Il faut aller lui porter secours !",
  "1.0.14.0" => "Link ? Link ! Aide-nous ! On essaye
de chasser cet oiseau, le roi Cuirasse !",
  "1.0.15.0" => "Pfiou... On a réussi à se
débarrasser de l'oiseau...",
  "1.0.16.0" => "(Y a des empêcheurs de tourner en rond.
Venez, on va leur mettre une raclée !)",
  "1.0.17.0" => "On s'est un peu trop fait remarquer...
Repoussons-les tous ensemble !",
  "1.0.18.0" => "On en a fini avec eux.",
  "1.0.19.0" => "Je dois fermer la porte des âmes... !",
  "1.0.20.0" => "(On va aller s'amuser dans leur base !)",
  "1.0.21.0" => "(Ils étaient plus forts...
que je le pensais...)",
  "1.0.22.0" => "Les monstres ne devraient
plus apparaître, maintenant.",
  "1.0.23.0" => "Il ne me reste plus
qu'à aider cette fille !",
  "1.0.24.0" => "(C'est quoi cet oiseau géant... ?
Il se bat contre les humains ?)",
  "1.0.25.0" => "(C'est notre chance. On va se débarrasser
de cette vermine d'humains !)",
  "1.0.26.0" => "Les monstres du désert
sont déchaînés !",
  "1.0.27.0" => "Ils profitent peut-être de la présence du roi
Cuirasse pour nous chasser du désert... ?",
  "1.0.28.0" => "Espèce d'oiseau déplumé... Tu vas payer
pour tout le mal que tu nous as fait !",
  "1.0.29.0" => "Cet imbécile d'oiseau a l'air
d'avoir repris des forces.",
  "1.0.30.0" => "Empêchons-le de s'enfuir en
prenant le fort qui lui sert de nid !",
  "1.0.31.0" => "Le tour est joué ! Il ne risque plus
de s'enfuir, maintenant !",
  "1.0.32.0" => "(Vous n'avez rien à faire ici, bande d'humains
répugnants ! Hors de notre désert !)",
  "1.0.33.0" => "Tiens... ? Il a l'air plus en forme qu'avant...
Peut-être parce qu'il s'est reposé ?",
  "1.0.34.0" => "Il est un peu trop sûr de lui !
Il faut vite lui prendre son nid !",
  "1.0.35.0" => "Cet oiseau est trop dangereux...
Il faut vite prendre son nid !",
  "1.0.36.0" => "On a eu raison de prendre son nid !
Il ne peut plus fuir, maintenant !",
  "1.0.37.0" => "Ça devrait nous
faciliter la tâche !",
  "1.0.38.0" => "Ne baissons pas notre garde pour autant.
Le monde est encore soumis à ces anomalies.",
  "1.0.39.0" => "Bon... Je n'ai pu trouver aucun indice sur
Cya... Mais je dois continuer à la chercher.",
  "1.0.40.0" => "Ils ont pris notre base... !
On a perdu...",
  "1.0.41.0" => "À cause du roi Cuirasse, les monstres du
désert voient rouge ! Occupons-nous-en !",
  "1.0.42.0" => "On n'a pas vraiment le
choix, de toute façon !",
  "1.0.43.0" => "On va lui faire payer,
à cet oiseau déplumé !",
  "1.0.44.0" => "Imbécile d'oiseau ! Me laisser tomber
dans ce désert... Sympa de sa part !",
  "1.0.45.0" => "Il ne reste plus que l'oiseau ! Sers-toi de
ta magie pour nous en débarrasser, Lana !",
  "1.0.46.0" => "Au fait, je crois que vous avez encore
quelque chose à faire, n'est-ce pas ?",
  "1.0.47.0" => "Il faut vite retourner à la base,
elle ne va pas tenir longtemps !",
}