  "0.17.0" => "Éliminez A0%1sF0R !",
  "0.18.0" => "Les conditions de défaite ont changé !",
  "0.19.0" => "Ne pas laisser A0%1sF0R fuir ni la A1base alliéeR tomber !",
  "0.21.0" => "A0%1sF4R ne doit pas s'enfuir !",
  "0.22.0" => "Éliminez immédiatement A0%1sF0R !",
  "0.23.0" => "Vous avez vaincu A0%1sF0R !",
  "0.27.0" => "Avancez sur la A2base ennemieR !",
  "0.28.0" => "A0%1sF5R avance sur la A1base alliéeR !",
  "0.30.0" => "A0%1sF4R avance !",
  "0.31.0" => "A0%1sF5R n'a plus assez d'énergie vitale et doit s'arrêter !",
  "0.32.0" => "A0%1sF5R reprend sa marche !",
