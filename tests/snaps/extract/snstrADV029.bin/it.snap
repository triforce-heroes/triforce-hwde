  "0.25.0" => "Hai impedito che A0%1sF2R invadesse l'area A0%2sF4R!",
  "0.26.0" => "A0%1sF0R entra nell'area A0%2sF6R!",
  "0.27.0" => "A0%2sF0R ha indebolito l'area C1%1sF4R!",
  "0.28.0" => "Il piano è stato portato a termine! A0%1sF1R si ritirano!",
  "0.29.0" => "A0%1sF0R ha perso! A0%2sF0R si indebolisce!",
