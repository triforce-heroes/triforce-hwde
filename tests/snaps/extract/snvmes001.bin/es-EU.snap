Map {
  "1.0.0.0" => "Estas cuevas están infestadas de monstruos, pero
debemos atravesarlas para llegar a la princesa.",
  "1.0.1.0" => "Eso de ahí parece una salida. Aunque tendremos
que dar un rodeo y acercarnos por el norte.",
  "1.0.2.0" => "Los soldados hylianos han avanzado hasta la
siguiente salida. Debemos ir con ellos, Link.",
  "1.0.3.0" => "Una gran roca bloquea el paso y los monstruos
nos rodean. ¡Debemos hacer algo!",
  "1.0.4.0" => "¿Cómo? Link y yo vamos de camino.
¡Aguantad hasta que lleguemos!",
  "1.0.5.0" => "¡Comandante Impa! ¡Nos habéis
salvado!",
  "1.0.6.0" => "Habéis hecho un buen trabajo. Link no
tardará mucho en llegar.",
  "1.0.7.0" => "¿Qué sucede aquí? Por muchos monstruos
que matemos, siempre aparecen más.",
  "1.0.8.0" => "Tiene que haber un bastión en alguna parte.
Link, ¿podrías localizarlo?",
  "1.0.9.0" => "¡Link! ¿Has localizado el bastión del
que proceden los monstruos?",
  "1.0.10.0" => "¡Bien hecho! Aunque parece que hay más
bastiones que siguen enviando monstruos.",
  "1.0.11.0" => "¡El número de monstruos se ha reducido!
Esto ya está mejor.",
  "1.0.12.0" => "¡El enemigo ataca sin piedad! No podemos
resistir por nuestra cuenta.",
  "1.0.13.0" => "Eso no es bueno... ¡Rápido, Link, ven aquí!",
  "1.0.14.0" => "¡Han llegado los refuerzos! ¡Menos mal!",
  "1.0.15.0" => "¡No nos queda más remedio que retirarnos!",
  "1.0.16.0" => "Hemos llegado tarde... Lo siento mucho.",
  "1.0.17.0" => "La roca nos impide avanzar.
¡Debemos destruirla!",
  "1.0.18.0" => "Seguro que hay alguna forma
de romperla...",
  "1.0.19.0" => "¡Os ayudaremos-goro! Esa roca
no es rival para un bombuchu-goro.",
  "1.0.21.0" => "¡Eso nos vendría de maravilla! ¡Daos prisa!",
  "1.0.22.0" => "Mi plan ha salido a pedir de boca. Ahora que
estáis en las cuevas, ya nunca podréis salir.",
  "1.0.23.0" => "¡Destruid a esos gusanos! ¡Haced que sufran!",
  "1.0.24.0" => "¡Van a por el bombuchu-goro!",
  "1.0.25.0" => "¡Link! ¡Protege el bombuchu!",
  "1.0.26.0" => "Aún quedan demasiados monstruos... Si no
hacemos algo, el bombuchu no podrá avanzar.",
  "1.0.27.0" => "Claro... Despejaré la zona que rodea a esta roca
para que el bombuchu pueda llegar hasta aquí.",
  "1.0.28.0" => "Cuántos monstruos... Quizás sería mejor
acabar con los bastiones primero.",
  "1.0.29.0" => "Si no abrimos la puerta norte del bastión,
el bombuchu no podrá avanzar-goro.",
  "1.0.30.0" => "Link, no puedo llegar al bastión.
¿Te encargas tú?",
  "1.0.31.0" => "¡Así se hace! Ahora el bombuchu podrá
llegar hasta la roca-goro.",
  "1.0.32.0" => "¡Bien hecho, Link! Ya podemos avanzar.",
  "1.0.33.0" => "¡Dirigíos a la salida!",
  "1.0.34.0" => "¡Rápido, Link, sigue avanzando!",
  "1.0.35.0" => "¡Han destruido el bombuchu!",
  "1.0.36.0" => "No pasa nada, tenemos más. ¡Sacaremos
otro-goro!",
  "1.0.37.0" => "Este es el último bombuchu del bastión.
¡Cuidadlo bien-goro!",
  "1.0.38.0" => "No hay salida sin un bombuchu... Si no
avanzamos, la oscuridad se extenderá.",
  "1.0.39.0" => "¡Avanzad! ¡Aplastad a esos gusanos!",
  "1.0.40.0" => "El enemigo ataca con fuerza, pero
debemos seguir avanzando.",
  "1.0.41.0" => "La puerta sur del bastión lleva a la salida.
¡Debemos hacernos con el control!",
  "1.0.42.0" => "¡Anda, ha aparecido un cofre! Debe de ser
la recompensa por tomar el bastión. ¡Ábrelo!",
  "1.0.43.0" => "¡Vaya! Seguro que ahí dentro
hay algo muy interesante...",
  "1.0.44.0" => "Hemos cantado victoria antes de tiempo.
La puerta sur no se abre...",
  "1.0.45.0" => "¡No tienen adónde ir! ¡Aplastadlos!",
  "1.0.46.0" => "Vienen enemigos de los túneles... Eso quiere
decir que el Señor de las Cavernas está ahí.",
  "1.0.47.0" => "Si lo derrotáis, puede que se abra la salida.
Buscadlo en los túneles más profundos.",
  "1.0.48.0" => "Me quedaré defendiendo la posición;
te encomiendo a ti la búsqueda.",
  "1.0.49.0" => "Yo defenderé la retaguardia. Intentaré resistir
cuanto pueda.",
  "1.0.50.0" => "¡Link! Ese monstruo debe de ser
el Señor de las Cavernas.",
  "1.0.51.0" => "¡Debemos acabar con él!
Es nuestra única esperanza.",
  "1.0.52.0" => "¡Link! Busca en los túneles más profundos.",
  "1.0.53.0" => "¡Bien hecho! Ya podemos salir de las cuevas.",
  "1.0.54.0" => "Lo siento, pero debo dejaros aquí. Espero que no
os pase nada en las cuevas.",
  "1.0.55.0" => "Él era quien frenaba a los monstruos que nos
seguían. Si no hacemos nada, nos rodearán.",
  "1.0.56.0" => "Las rocas todavía bloquean el paso...",
  "1.0.57.0" => "¡Nos encanta volar rocas-goro!",
  "1.0.58.0" => "Necesitamos vuestra ayuda una vez más.
Hay un bombuchu en ese bastión.",
  "1.0.59.0" => "Pero los enemigos impiden su avance.
¡Debéis recuperar el bastión!",
  "1.0.60.0" => "Dos rocas... Un bombuchu no será suficiente.",
  "1.0.61.0" => "Otro goron nos contó que había dejado un
bombuchu en estas cuevas. ¿Dónde estará?",
  "1.0.62.0" => "Yo defenderé a los goron; tú busca el bombuchu.",
  "1.0.63.0" => "¡Ahí está! ¡Lo has encontrado! Ya podemos
volar la roca-goro.",
  "1.0.64.0" => "¡Link! ¡Acaba con los enemigos del bastión!
Yo me encargaré de preparar el bombuchu.",
  "1.0.65.0" => "Creo que no está en ese bastión-goro.",
  "1.0.66.0" => "¡Bravo! Ya podemos soltar el bombuchu.",
  "1.0.67.0" => "¡Ya está todo listo! ¡Ponedlo en marcha!",
  "1.0.68.0" => "¡De acuerdo! Ahí van los dos bombuchus,
en línea recta hacia las rocas-goro.",
  "1.0.69.0" => "Siempre hay alguien que se cruza en mi camino...
¡Yo mismo aplastaré a esos gusanos!",
  "1.0.70.0" => "¡Hay que alejar a los monstruos
de los bombuchus!",
  "1.0.71.0" => "Estamos listos para irnos. Sheik,
o como te llames, ¡ven aquí!",
  "1.0.72.0" => "¡Voy!",
  "1.0.73.0" => "¡El primer ataque ha salido bien!",
  "1.0.74.0" => "Dentro de poco el camino estará abierto.
¡Defended al segundo bombuchu-goro!",
  "1.0.75.0" => "¡Genial! El camino a la salida está despejado.
¡Gracias a todos!",
  "1.0.76.0" => "¡Date prisa, Link! La salida está por aquí.",
  "1.0.77.0" => "Comandante Impa, ¿estáis bien?
¡Estamos esperando en la salida!",
  "1.0.78.0" => "¡Al bosque de Farone! He oído que hay una
chica que lidera la resistencia contra el mal.",
  "1.0.79.0" => "Espero que sea la princesa Zelda.",
  "1.0.80.0" => "¡Buen trabajo! Puede que ambos seáis capaces
de evitar el caos que se cierne sobre Hyrule.",
  "1.0.81.0" => "Qué vergüenza perder así...",
  "1.0.83.0" => "Ya no quedan bombuchus-goro...",
  "1.0.84.0" => "Si no rompemos esas rocas, no podremos salir.
Debemos volver a intentarlo...",
  "1.0.85.0" => "¡Ya no quedan más bombuchus! Si destruyen
esos dos, estamos perdidos-goro.",
  "1.0.86.0" => "Todavía quedan bastiones de los que salen
monstruos... Deberíamos haberlos destruido.",
  "1.0.87.0" => "¡Llegamos tarde, pero estamos aquí para luchar!",
  "1.0.88.0" => "Quizás deberíamos habernos ocupado
primero de los bastiones.",
  "1.0.89.0" => "¿Necesitáis nuestra ayuda-goro?",
  "1.0.90.0" => "Más adelante hay soldados de Hyrule, pero si no
abrimos las puertas, no podremos ir con ellos.",
  "1.0.91.0" => "Debemos hallar la forma de avanzar...",
  "1.0.92.0" => "Esta pared tiene una grieta... ¡A lo
mejor podemos echarla abajo!",
  "1.0.93.0" => "Si nos hacemos con el bastión, quizá
podamos parar las hordas de monstruos.",
  "1.0.94.0" => "¡Jia, jia, jia! Mientras contemos con
invocadores, no nos faltarán monstruos.",
  "1.0.95.0" => "¡Perseguidlos y rodeadlos
para acabar con ellos!",
  "1.0.96.0" => "Yo me encargo del enemigo del este. ¡No
dejéis que lleguen a la plaza del túnel!",
  "1.0.97.0" => "No puede ser... ¡El enemigo nos
ha seguido hasta aquí!",
  "1.0.98.0" => "¡No puedo defender los dos a la vez!
¡Ocúpate tú de uno, Link!",
  "1.0.99.0" => "Así que llegan más enemigos...
¡Yo me ocuparé de ellos!",
  "1.0.100.0" => "¿Por qué se dirigen a ese bastión?
¡Hay algo allí! ¡Debemos conquistarlo!",
  "13.0.0.0" => "Impa, ¡Link se esforzará cuanto pueda!
¡Pondremos a salvo a todo el mundo!",
  "13.0.1.0" => "La salida está por ahí, pero tenemos que dar
un rodeo por el norte para entrar.",
  "13.0.2.0" => "Los soldados hylianos se han adelantado.
¡Impa, tenemos que seguirlos!",
  "13.0.3.0" => "Los soldados de Hyrule están en apuros.
Impa, ¡debemos ayudarlos!",
  "13.0.4.0" => "¡Gracias por salvarnos!",
  "13.0.5.0" => "¡Ya estamos aquí! Impa está a punto
de llegar, así que todo irá bien.",
  "13.0.6.0" => "Tiene que haber un bastión del que salgan todos
estos monstruos. ¡Vayamos a por él!",
  "13.0.7.0" => "¡Impa, esa debe de ser la guarida
de los monstruos!",
  "13.0.8.0" => "¡Buen trabajo! Aunque siguen apareciendo
monstruos de algún otro bastión cercano.",
  "13.0.9.0" => "¡Rápido, Impa, tienes que ayudarnos!",
  "13.0.10.0" => "Lo siento mucho...",
  "13.0.11.0" => "¡Gracias! Y ahora dejemos que el bombuchu
haga su trabajo.",
  "13.0.12.0" => "¡Impa, tenemos que proteger el bombuchu!",
  "13.0.13.0" => "¡Link, ojo con el bombuchu! Acaba con
los enemigos que hay de camino a la roca.",
  "13.0.14.0" => "Link no consigue llegar al bastión...
¡Impa, debes encargarte tú!",
  "13.0.15.0" => "No hemos conseguido impedir que sigan
apareciendo enemigos...",
  "13.0.16.0" => "Tendríamos que habernos ocupado del
bastión para que no atacasen al bombuchu...",
  "13.0.17.0" => "¡Así se hace! Ahora el bombuchu podrá
llegar a la roca.",
  "13.0.18.0" => "¡Bien hecho, Impa! Ya podemos avanzar.",
  "13.0.19.0" => "¡Han acabado con el bombuchu! ¿Qué hacemos?",
  "13.0.20.0" => "Si perdemos el bombuchu, no podremos
llegar hasta la princesa Zelda.",
  "13.0.21.0" => "¡Impa, ven aquí cuanto antes!",
  "13.0.22.0" => "La puerta sur de este bastión lleva a la salida.
Puede que se abra si lo capturamos...",
  "13.0.23.0" => "Qué raro, la puerta sur no se ha abierto...
Al menos el bastión está en nuestras manos.",
  "13.0.24.0" => "¡Están saliendo enemigos de los túneles!
Quizás el Señor de las Cavernas esté por aquí.",
  "13.0.25.0" => "¡Impa, Link puede ocuparse del bastión!
Pase lo que pase, no se rendirá.",
  "13.0.26.0" => "Ese enemigo es muy sospechoso... ¡Impa, debe de
ser el Señor de las Cavernas!",
  "13.0.27.0" => "¡Sabía que podías hacerlo, Impa! Ahora ya
podemos salir.",
  "13.0.28.0" => "El chico que protegía la retaguardia ha caído.
¡Nos rodearán si no hacemos nada!",
  "13.0.29.0" => "Vuelve a haber rocas que
nos bloquean el paso.",
  "13.0.30.0" => "¡Perfecto! Un bombuchu es justo
lo que necesitamos.",
  "13.0.31.0" => "Si aún hay enemigos en el bastión, no podemos
sacar el bombuchu. ¡Debéis recuperarlo!",
  "13.0.32.0" => "Impa, debes buscar el bombuchu.
¡Link defenderá a los goron!",
  "13.0.33.0" => "Impa, acaba con los enemigos del bastión
para que podamos sacar al bombuchu.",
  "13.0.34.0" => "¿Estáis todos listos? ¡Vamos allá!",
  "13.0.35.0" => "¡Sheik, nos iremos enseguida! Ven con nosotros.",
  "13.0.36.0" => "¡Bravo, ahora solo
queda el otro!",
  "13.0.37.0" => "¡Ya podemos ir a la salida! ¡Gracias a todos!",
  "13.0.38.0" => "¡Vayamos al bosque de Farone! Tenemos que dar
con la chica de la que tanto hemos oído hablar.",
  "13.0.39.0" => "Ojalá sea la princesa Zelda.",
  "13.0.40.0" => "¡Tranquilo, Link! Si te perdemos,
todo habrá terminado...",
  "13.0.41.0" => "Con esa roca no podemos avanzar. Deberíamos
retirarnos y replantearnos la estrategia.",
  "13.0.42.0" => "Más adelante hay soldados de Hyrule, pero no
podemos llegar a ellos con las puertas cerradas...",
  "13.0.43.0" => "Impa, en lo más profundo de los
túneles hay algo sospechoso...",
  "13.0.44.0" => "¿No habrá nada que podamos
hacer para avanzar?",
  "13.0.45.0" => "En esa pared hay una grieta... Quizás
podamos usar algo para volarla.",
  "13.0.46.0" => "¡Rápido, Link! La salida está por aquí.",
  "13.0.47.0" => "¿Estás bien, Impa? Te esperaremos
en la salida.",
  "13.0.48.0" => "Quizás deberíamos habernos ocupado
primero de los bastiones de los monstruos.",
  "13.0.49.0" => "¡Seguro que es la guarida
de un monstruo!",
  "13.0.50.0" => "¡Vaya, hay enemigos por todas partes!",
}