  "0.39.0" => "Die A0%1sF1R wurden besiegt!",
  "0.40.0" => "A0%1sF0R ist geflohen!",
  "0.41.0" => "Die mittlere A6MagiekammerR wurde erobert!",
  "0.43.0" => "A1ZeldaR spürt eine gewaltige, böse Präsenz!",
  "0.44.0" => "Der Vormarsch A0%1sF2R hat das A6Nordtor des Ost-RosengartensR geöffnet!",
  "0.45.0" => "A0%1sF0R nähert sich A0%2sF4R!",
