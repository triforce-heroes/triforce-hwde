Map {
  "0.0.0" => "Rassemblez les guerriers près A0%1sF3R!",
  "0.1.0" => "A1DesR A0%1sF7R sont apparus et attaquent les monstres!",
  "0.2.0" => "A0%1sF4R s'est téléporté A0%2sF6R!",
  "0.3.0" => "A0%1sF4R est ouvert! A0%2sF5R se dirige vers A0%3sF0R!",
  "0.4.0" => "Les portes A0%1sF2R sont fermées!",
  "0.5.0" => "A0%1sF6R a rejoint le champ de bataille!",
  "0.6.0" => "Éliminez A0%1sF0R pour ouvrir les portes A0%2sF2R!",
  "0.7.0" => "Vous avez vaincu A0%1sF0R! A0%2sF4R est ouverte!",
  "0.8.0" => "Vous avez atteint A0%1sF0R!",
  "0.9.0" => "A0%1sF4R se prépare à invoquer A2des monstresR!",
  "0.10.0" => "Rendez-vous A0%1sF6R au plus vite!",
  "0.11.0" => "A0%1sF4R a invoqué A2des monstresR!",
  "0.12.0" => "A0%1sF5R se dirige vers A0%2sF0R!",
  "0.13.0" => "A0%1sF6R a rejoint le champ de bataille!",
  "0.14.0" => "A0%1sF4R avance à la recherche de nourriture!",
  "0.15.0" => "A2Une horde de monstresR est apparue autour A0%1sF3R!",
  "0.16.0" => "Secourez A0%1sF0R!",
  "0.17.0" => "A0%1sF4R est arrivé A6à l'aire de repasR!",
  "0.18.0" => "A0%1sF4R a mangé suffisament pour se transformer en A0%2sF2R!",
  "0.19.0" => "A0%1sF4R a pris la fuite!",
  "0.20.0" => "A0%1sF4R s'est téléporté à un autre endroit!",
  "0.21.0" => "Les portes des forts A0%1sF3R sont ouvertes!",
  "0.22.0" => "A0%1sF5R ont été vaincus!",
  "0.23.0" => "Retrouvez A0%1sF0R au plus vite!",
  "0.24.0" => "Vous avez pris A0%1sF0R! A0%2sF4R a rejoint le champ de bataille!",
  "0.25.0" => "Vous avez trouvé A0%1sF0R!",
  "0.26.0" => "A0%1sF4R est sous votre contrôle!",
  "0.27.0" => "Les portes A0%1sF2R sont ouvertes! A2De puissants monstresR avancent!",
  "0.28.0" => "A0%1sF5R avance!",
  "0.29.0" => "A0%1sF4R est ouvert! A0%2sF5R avance!",
  "0.30.0" => "A0%1sF5R avance!",
  "0.31.0" => "Éliminez A0%1sF0R au plus vite!",
  "0.32.0" => "A0%1sF4R est ébloui par la lumière A6de la boussoleR!",
  "0.33.0" => "A0%1sF4R a été vaincu!",
  "0.34.0" => "A0%1sF4R a récupéré A6la boussoleR des mains A0%2sF3R!",
  "0.35.0" => "Les attaques A0%2sF3R ont fait tomber A0%1sF0R!",
  "0.36.0" => "A0%1sF6R a rejoint le champ de bataille et se dirige vers C2%2sF0R!",
  "0.37.0" => "Un coffre se cache peut-être dans A0%1sF0R!",
  "0.38.0" => "A0%2sF5R a provoqué la fuite A0%1sF3R!",
  "0.39.0" => "A0%1sF5R est vaincue!",
  "0.40.0" => "A0%1sF4R est en difficulté!",
  "0.41.0" => "A0%1sF4R est en grand danger! Allez à son secours au plus vite!",
  "0.42.0" => "A0%1sF4R avance!",
  "0.43.0" => "Éliminez A0%1sF0R!",
