  "0.48.0" => "A6Les chambres ensorceléesR de l'est sont tombées!",
  "0.51.0" => "Ne laissez pas A0%1sF0R s'enfuir!",
  "0.52.0" => "A0%1sF5R change de direction pour secourir A0%2sF0R!",
  "0.53.0" => "A6Les chambres ensorceléesR de l'ouest ont été réactivées!",
  "0.54.0" => "A6Les chambres ensorceléesR de l'est ont été réactivées!",
  "0.55.0" => "A6Une skulltulaR est apparue sur le champ de bataille!",
