Map {
  "1.0.0.0" => "D'où peuvent bien venir tous ces monstres?",
  "1.0.1.0" => "Peuple d'Hyrule, tenez bon!
Nous devons protéger notre royaume!",
  "1.0.2.0" => "Hé, Link! Il faut qu'on protège la princesse!
Dépêche-toi!",
  "1.0.3.0" => "Combattez pour l'avenir d'Hyrule!
Protégez la princesse Zelda à tout prix!",
  "1.0.4.0" => "Ce lézard est trop puissant!
N'y a-t-il donc aucun moyen de le vaincre?",
  "1.0.5.0" => "Commençons par éliminer ce lézard!",
  "1.0.6.0" => "Approchez si vous l'osez!",
  "1.0.7.0" => "Ce jeune garçon, ce n'est vraiment
qu'une nouvelle recrue?",
  "1.0.8.0" => "Il est très doué...
Quel est son nom?",
  "1.0.9.0" => "Venez m'affronter! Je vous offrirai
l'honneur d'aller rejoindre vos ancêtres.",
  "1.0.10.0" => "Ne laissez pas passer le chevalier dragon!",
  "1.0.11.0" => "Aahh... J'ignore encore ton nom, petit,
mais nous nous retrouverons...",
  "1.0.12.0" => "Ces rochers nous bloquent la route.
Impossible d'aller aider la princesse Zelda!",
  "1.0.13.0" => "Je peux plus les retenir!
À l'aide!",
  "1.0.14.0" => "Oh non! Link, allons l'aider!",
  "1.0.15.0" => "Voilà! Cela devrait les arrêter pour un moment!",
  "1.0.16.0" => "Tu m'as enlevé un beau silex du pied! Pour te
remercier, je voudrais que tu prennes ce trésor!",
  "1.0.17.0" => "Notre trésor...
Je vais le laisser là...",
  "1.0.18.0" => "Ces bombes vont nous aider à briser les rochers
qui nous séparent de la princesse Zelda.",
  "1.0.19.0" => "À l'attaque! Rapportez-moi la tête de la
princesse d'Hyrule avant que je perde patience!",
  "1.0.20.0" => "Prenez le fort central et le fort est de la plaine,
et verrouillez les portes de chacun d'entre eux!",
  "1.0.21.0" => "Je vais préparer un plan d'attaque. Pendant ce
temps, dépêchez-vous de prendre le fort!",
  "1.0.22.0" => "Je n'ai pas de temps à perdre avec ces insectes.
Je dois m'occuper des préparatifs!",
  "1.0.23.0" => "Notre base est attaquée! Il faut la protéger!",
  "1.0.24.0" => "Bravo! À présent, prenez le fort est de la plaine!",
  "1.0.25.0" => "Reprenez le fort central!",
  "1.0.26.0" => "Bon travail! À présent,
prenez le fort central!",
  "1.0.27.0" => "Reprenez le fort est de la plaine!",
  "1.0.28.0" => "L'armée ennemie a pu être contenue au nord!
Allons demander son aide à la grande fée!",
  "1.0.29.0" => "Si nous avions des bombes, nous pourrions
briser le mur de la fontaine de la Déesse...",
  "1.0.30.0" => "Faites attention! L'ennemi nous
attaque depuis le nord!",
  "1.0.31.0" => "Vous avez enfin réussi à passer... Incapables!
Attaquez le château d'Hyrule au sud!",
  "1.0.32.0" => "Venez! Prions la grande fée tous ensemble!",
  "1.0.33.0" => "Nous avons réussi! Les troupes ennemies
ont été considérablement réduites!",
  "1.0.34.0" => "L'ennemi est en déroute!
C'est le moment ou jamais!",
  "1.0.35.0" => "Bien! Lançons la contre-attaque!",
  "1.0.36.0" => "Votre Altesse, je vous en prie, repliez-vous.
Nous nous occupons du reste.",
  "1.0.37.0" => "Très bien. Puissent les Déesses veiller sur vous.",
  "1.0.38.0" => "Comme c'est touchant. Tout cela est bien plus
amusant que ce que j'aurais cru...",
  "1.0.39.0" => "Hya ha ha! Mettons un peu de piment dans
cette bataille! Apparais, roi dodongo!",
  "1.0.40.0" => "Qu... Qu'est-ce que c'est que ce monstre?",
  "1.0.41.0" => "Nous... Nous... Nous allons essayer de l'arrêter!",
  "1.0.42.0" => "Nous... Nous ne pouvons pas nous
permettre de le laisser passer!",
  "1.0.43.0" => "P... Protégez cet endroit à tout prix! S'il tombe
aux mains de l'ennemi, c'est la fin!",
  "1.0.44.0" => "Utilisez ceci! Cela augmentera
la puissance des bombes!",
  "1.0.45.0" => "Félicitations à tous! Vous venez de prouver que
la détermination est la meilleure des armes!",
  "1.0.46.0" => "Commandant Impa, c'est terrible!
Le mage ennemi a pris le château!",
  "1.0.47.0" => "Quoi? Ce monstre n'était qu'une diversion?! Où
est la princesse Zelda? Est-elle saine et sauve?",
  "1.0.48.0" => "Que la lumière brille sur Hyrule...",
  "1.0.49.0" => "Nous avons perdu...",
  "1.0.52.0" => "Hya ha ha! Attaquez sans relâche!",
  "1.0.55.0" => "Bon à rien de Volga! On ne peut jamais compter
sur lui... Très bien! Envoyez la prochaine unité!",
  "1.0.57.0" => "Partons pour la fontaine au plus vite! Si ce plan
fonctionne, ils subiront de lourdes pertes!",
  "1.0.58.0" => "Vite, par ici! Aidez-moi à détruire ce mur!",
  "1.0.59.0" => "Bande de limaces, dépêchez-vous! Allez au sud!
Rendez-vous à la base de l'armée d'Hyrule!",
  "1.0.60.0" => "Ils ont traversé le fort central!",
  "1.0.61.0" => "Vous êtes enfin passés, bande d'incapables!
Prenez la base de l'armée d'Hyrule à présent!",
  "1.0.62.0" => "Comment? Ils ont réussi à prendre
le fort est de la plaine?",
  "1.0.63.0" => "Qu'avez-vous dit?",
  "1.0.65.0" => "Link, regarde! C'est la princesse!",
  "1.0.66.0" => "Oh, je te reconnais!
Tu étais au centre d'entraînement...",
  "1.0.67.0" => "Votre Altesse, êtes-vous blessée? La nouvelle
recrue a ouvert le passage avec des bombes.",
  "1.0.68.0" => "Oh, une nouvelle recrue? Ne dit-on pas qu'on
a souvent besoin d'un plus petit que soi...",
  "1.0.69.0" => "Un gros rocher bloque notre progression.
Pourrais-tu utiliser tes bombes pour le détruire?",
  "1.0.70.0" => "Eh... Elle... Elle est introuvable!",
  "1.0.71.0" => "Comment?!",
  "1.0.72.0" => "Nous nous occupons du fort de l'est!
Que quelqu'un se charge du fort central!",
  "1.0.73.0" => "Oh! Je me souviens de toi...
Tu étais au centre d'entraînement...",
  "1.0.74.0" => "Au secours! Aidez-moi!
Des monstres m'ont encerclée!",
  "1.0.75.0" => "Merci! Moi, c'est Proxi! Mais d'où sortent tous
ces monstres... Et au fait, c'est quoi ton nom?",
  "1.0.76.0" => "Link? Quel drôle de nom! Et tu es là pour
sauver Hyrule? Tu ne doutes de rien, toi!",
  "1.0.77.0" => "T'as pas l'air très loquace! Je vais rester avec
toi dans ce cas-là... Je parlerai pour deux! Hi hi!",
  "13.0.0.0" => "Super! On va pouvoir utiliser ça pour détruire
les rochers et rejoindre la princesse Zelda!",
  "13.0.1.0" => "Oh non! Il faut qu'on aille
défendre la base!",
  "13.0.2.0" => "Nous devons récupérer le fort central!",
  "13.0.3.0" => "Nous devons récupérer le fort est de la plaine!",
  "13.0.4.0" => "Écoutez-moi tous! L'ennemi nous attaque
depuis le nord!",
  "13.0.5.0" => "Ça va mal! L'ennemi traverse le fort central!",
  "13.0.6.0" => "Mais qu'est-ce qu'on va faire?!
L'ennemi traverse le fort est!",
  "13.0.7.0" => "Votre Altesse! Nous nous chargeons d'eux!",
  "13.0.8.0" => "C'est quoi, ce truc? Un fantôme?",
  "13.0.9.0" => "Attention! Il ne faut pas laisser ce chevalier
dragon aller plus loin!",
  "13.0.10.0" => "Votre Altesse! Veuillez me pardonner.
Je me suis jetée dans la gueule du loup...",
  "13.0.11.0" => "Nous devrions être en mesure de les repousser.
En avant! Il n'y a pas une minute à perdre!",
  "13.0.12.0" => "Madame Impa! Vous allez bien?",
  "13.0.13.0" => "Comment? Tu n'es qu'une nouvelle recrue?!",
  "13.0.14.0" => "Votre Altesse! Nous devons prendre le fort est et
le fort central et verrouiller leurs portes nord!",
  "13.0.15.0" => "Je vais préparer un plan d'attaque. Votre Altesse,
veuillez ordonner la prise des forts!",
  "13.0.16.0" => "L'armée ennemie a pu être contenue au nord!
Il faut obtenir l'aide de la grande fée à présent.",
  "13.0.17.0" => "Si notre plan fonctionne, nous leur infligerons
de lourdes pertes! Vite, à la fontaine!",
  "13.0.18.0" => "Si nous avions des bombes, nous pourrions
briser les portes de la fontaine de la Déesse...",
  "13.0.19.0" => "Par ici! Vite! Détruisons les portes et
entrons dans la fontaine!",
  "13.0.20.0" => "Soyez tous très prudents! L'ennemi
nous attaque depuis le nord!",
  "13.0.21.0" => "Comment? L'ennemi a pris le contrôle
du fort est de la plaine?",
  "13.0.22.0" => "Par ici! Prions la grande fée tous ensemble!",
  "13.0.23.0" => "Nous avons réussi, Votre Altesse! Les troupes
ennemies ont été considérablement réduites!",
  "13.0.24.0" => "Nous avons réussi, Votre Altesse! Les troupes
ennemies ont subi d'énormes pertes!",
  "13.0.25.0" => "Impa, laisse-moi me charger de cet endroit. Je
veux que tu commandes les troupes à l'arrière.",
  "13.0.26.0" => "Très bien. Soyez prudente, Votre Altesse!",
  "13.0.27.0" => "Nous avons survécu... Et c'est grâce à vous
tous. Cette victoire vous appartient!",
  "13.0.28.0" => "Votre Altesse! C'est terrible!
Le mage ennemi a pris le château!",
  "13.0.29.0" => "Il faut qu'on protège Hyrule!
En avant, Link! Dépêche-toi!",
  "13.0.30.0" => "Si nous utilisons ceci, nous pourrons détruire
les rochers et rejoindre Impa...",
  "13.0.31.0" => "Votre Altesse! Utilisez ceci! Cet objet devrait
augmenter la puissance des bombes!",
  "13.0.32.0" => "Votre Altesse... Pardonnez-moi...",
  "13.0.33.0" => "Des rochers nous bloquent la route! Comment
on va faire pour aller aider madame Impa?",
  "13.0.34.0" => "Link, regarde! C'est la princesse!",
}