  "5.5066.0" => "Erhöht Schaden gegen KHKKK0KQKRKMKN.",
  "5.5067.0" => "Erhöht Schaden gegen K1KWKXKOKPKUKV.",
  "5.5068.0" => "Erhöht Schaden gegen KYKZKSKTLDLE.",
  "5.5069.0" => "Erhöht Schaden gegen KGLRLZ.",
  "5.5070.0" => "Mehr Erfahrungspunkte für besiegte Gegner.",
  "5.5071.0" => "Besiegte Gegner hinterlassen mehr Rubine.",
  "5.5072.0" => "Erhöht die Beutequote für seltene Materialien.",
  "5.5073.0" => "Erhöht Beutequote für Waffen mit vielen Sockeln.",
  "5.5074.0" => "Erhöht Beutequote für Waffen mit vielen Sternen.",
  "5.5075.0" => "Es erscheinen mehr Herzen.",
  "5.5076.0" => "Besiege Gegner, um deine Lebensenergie aufzufüllen.",
  "5.5077.0" => "Besiege Gegner, um deine Spezialangriffleiste aufzufüllen.",
  "5.5078.0" => "Besiege Gegner, um deine Bomben zu stärken.",
  "5.5079.0" => "Besiege Gegner, um deinen Bogen zu stärken.",
  "5.5080.0" => "Besiege Gegner, um deinen Bumerang zu stärken.",
  "5.5081.0" => "Besiege Gegner, um deinen Fanghaken zu stärken.",
  "5.5082.0" => "Feinde werden gelegentlich mit einem Treffer besiegt.",
  "5.5083.0" => "Du nimmst mehr Schaden, wirst aber nicht zurückgeworfen.",
  "5.5084.0" => "Du nimmst mehr Schaden, heilst dich aber mit der Zeit.",
  "5.5085.0" => "Kein Blocken, dafür stärkerer Angriff.",
  "5.5086.0" => "Schwächere Heileffekte, dafür stärkerer Angriff.",
  "5.5087.0" => "Bei niedriger Lebensenergie steigt deine Angriffskraft.",
  "5.5088.0" => "Je mehr Festungen du hast, desto stärker ist dein Angriff.",
  "5.5089.0" => "Erhöht Waffenstärke um 200.",
  "5.5090.0" => "Erhöht Waffen-Grundstärke auf 560.",
  "5.5091.0" => "Erhöht den Schaden von Spezialangriffen.",
  "5.5092.0" => "Erhöht den Schaden von Schwachpunkt-Angriffen.",
  "5.5093.0" => "Erhöht den Schaden normaler Angriffe.",
  "5.5094.0" => "Erhöht Angriffsschaden bei voller Energie.",
  "5.5095.0" => "Erhöht Angriffsschaden beim Einsatz von Magie.",
  "5.5096.0" => "Schnellere normale und Komboangriffe.",
  "5.5097.0" => "Erhöht die Beutequote für Nahrung.",
  "5.5098.0" => "Besiege eine Anzahl Gegner, um deinen Hammer zu stärken.",
  "5.5099.0" => "Erhöht Schaden gegen L?L@LALVLWLX.",
  "5.5100.0" => "Erhöht Schaden gegen L1L2LC.",
  "5.5101.0" => "Erhöht Waffenstärke um 400.",
  "5.5102.0" => "Steigt die max. Anzahl der Herzen um 5, steigt die Angriffskraft.",
