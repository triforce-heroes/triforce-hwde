Map {
  "0.0.0" => "A0%1sF5R attaque A0%2sF1R!",
  "0.1.0" => "Éliminez A0%1sF1R!",
  "0.2.0" => "Prenez le contrôle de l'autre fort A0%1sF3R!",
  "0.3.0" => "Les portes d'accès à A6la caverne de cristalR sont ouvertes!",
  "0.4.0" => "Vous avez obtenu A6la bague ancienneR!",
  "0.5.0" => "Les conditions de victoire ont changé!",
  "0.6.0" => "Éliminez A0%1sF0R pour remporter la victoire!",
  "0.7.0" => "Les conditions de défaite ont changé!",
  "0.8.0" => "Ne laissez pas A0%1sF0R fuir ni A0%2sF0R tomber!",
  "0.9.0" => "Les portes menant au côté ouest de la grotte sont ouvertes!",
  "0.10.0" => "Éliminez A0%1sF0R!",
  "0.11.0" => "A0%1sF5R a reçu des renforts!",
  "0.12.0" => "A0%1sF4R quitte temporairement le champ de bataille!",
  "0.13.0" => "A2DesR A0%1sF7R et A2desR A0%2sF7R ont rejoint le champ de bataille!",
  "0.14.0" => "A0%1sF6R se dirige vers A0%2sF0R!",
  "0.15.0" => "Ne laissez pas A0%1sF0R s'introduire dans le fort!",
  "0.16.0" => "A0%1sF4R s'est introduit dans A0%2sF0R et se prépare à exploser!",
  "0.17.0" => "L'explosion A0%2sF3R provoque la chute C1%1sF2R!",
  "0.18.0" => "Le moral A0%1sF3R et A0%2sF3R est en hausse!",
  "0.19.0" => "La chute C1%2sF2R décourage A0%1sF1R!",
  "0.20.0" => "L'explosion A0%2sF3R provoque la chute C1%1sF2R!",
  "0.21.0" => "A0%1sF4R a explosé!",
  "0.22.0" => "Plusieurs A0%1sF7R ont explosé!",
  "0.23.0" => "A0%1sF6R renforcé a rejoint le champ de bataille depuis A0%2sF0R!",
  "0.24.0" => "Prenez le contrôle des forts A0%1sF3R au plus vite!",
  "0.25.0" => "A0%1sF4R affronte A0%2sF0R!",
  "0.26.0" => "A0%1sF4R est en difficulté! Allez l'aider!",
  "0.27.0" => "A0%1sF4R est en grand danger! Allez l'aider au plus vite!",
  "0.28.0" => "Vous avez vaincu A0%1sF0R et A0%2sF0R!",
  "0.29.0" => "Les portes A0%1sF2R sont ouvertes!",
  "0.30.0" => "Éliminez A0%1sF0R!",
  "0.31.0" => "Deux A0%1sF7R ont rejoint le champ de bataille!",
  "0.32.0" => "A0%1sF4R du nord-ouest se dirige vers A0%2sF0R!",
  "0.33.0" => "A0%1sF4R a trahi votre armée et se dirige à présent vers A0%2sF0R!",
  "0.34.0" => "Éliminez A0%1sF0R et A0%2sF0R pour remporter la victoire!",
  "0.35.0" => "A0%1sF4R a pénétré dans A0%2sF0R!",
  "0.36.0" => "A0%1sF4R lance une attaque contre A0%2sF1R!",
  "0.37.0" => "Vous avez vaincu A0%1sF0R!",
  "0.38.0" => "Vous avez vaincu A0%1sF0R et A0%2sF0R!",
  "0.39.0" => "A0%1sF4R renforce la puissance A0%2sF3R et A0%3sF3R grâce au pouvoir des ténèbres!",
  "0.40.0" => "Chute C1%1sF2R!",
  "0.41.0" => "A0%1sF5R a été vaincue!",
  "0.42.0" => "A0%1sF4R a pris la fuite!",
  "0.43.0" => "Vous avez vaincu A0%1sF0R! Ses troupes battent en retraite!",
  "0.44.0" => "A0%1sF5R a reçu des renforts!",
  "0.45.0" => "A6Les portes de la place centraleR sont ouvertes!",
  "0.46.0" => "Ne laissez pas A0%1sF0R tomber aux mains de l'ennemi!",
  "0.47.0" => "Le moral A0%1sF3R est en hausse!",
  "0.48.0" => "A0%1sF4R affronte A0%2sF1R!",
  "0.49.0" => "Vous avez pris le contrôle des forts A0%1sF3R!",
