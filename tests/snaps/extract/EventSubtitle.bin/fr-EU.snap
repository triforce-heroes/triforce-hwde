Map {
  "0.0.0" => "Gamin... Tu as réussi à me mettre en colère...",
  "0.1.0" => "Pfff... Je vais vous envoyer tous les deux en enfer !",
  "0.2.0" => "Oh non...",
  "0.3.0" => "Alors tu es bien...",
  "0.4.0" => "Volga",
  "0.5.0" => "Volga",
  "0.6.0" => "Impa",
  "0.7.0" => "Impa",
  "1.0.0" => "Son Altesse Zelda est introuvable...
Mais je pense qu'elle est saine et sauve...",
  "1.1.0" => "Nous devons la retrouver et pour cela, j'aurai besoin de toi.",
  "1.2.0" => "Link, tu dois devenir un héros digne de cette tenue.",
  "1.3.0" => "Impa",
  "1.4.0" => "Impa",
  "1.5.0" => "Impa",
  "2.1.0" => "La princesse n'est pas morte.",
  "2.2.0" => "Vous la retrouverez sûrement au cours du voyage du Héros...",
  "2.3.0" => "Je suis Sheik.",
  "2.4.0" => "Je suis un survivant d'un clan au service de la famille royale
d'Hyrule depuis les temps anciens, le clan sheikah.",
  "2.5.0" => "Le clan sheikah ?",
  "2.6.0" => "C'est impossible...",
  "2.7.0" => "Nous discuterons quand nous serons sortis de cette grotte.
Je vais combattre à vos côtés...",
  "2.8.0" => "???",
  "2.9.0" => "???",
  "2.10.0" => "Sheik",
  "2.11.0" => "Sheik",
  "2.12.0" => "Impa",
  "2.13.0" => "Impa",
  "2.14.0" => "Sheik",
  "3.1.0" => "Qui es-tu ?",
  "3.2.0" => "Es-tu à la tête de ce groupe ?",
  "3.3.0" => "En effet.",
  "3.4.0" => "Tu peux utiliser la magie, dirait-on.
Où l'as-tu apprise ?",
  "3.5.0" => "Comment ça, « où » ?
Je suis une sorcière, c'est tout.",
  "3.6.0" => "Je suis du même clan que Cya,
celle qui contrôle ces monstres.",
  "3.7.0" => "Dans ce cas, j'ai quelque chose à te demander...",
  "3.8.0" => "Quel est le but de cette sorcière, Cya ?",
  "3.9.0" => "Vous voulez savoir ?",
  "3.10.0" => "Hmm...",
  "3.11.0" => "Si vous nous prêtez main-forte...",
  "3.12.0" => "... je vous le dirai peut-être.",
  "3.13.0" => "Lana",
  "3.14.0" => "Impa",
  "3.15.0" => "Lana",
  "3.16.0" => "Impa",
  "3.17.0" => "Lana",
  "3.18.0" => "Lana",
  "3.19.0" => "Impa",
  "3.20.0" => "Impa",
  "3.21.0" => "Lana",
  "3.22.0" => "Lana",
  "3.23.0" => "Lana",
  "3.24.0" => "Lana",
  "4.1.0" => "Je pensais retrouver Son Altesse Zelda...
Nous avons fait fausse route.",
  "4.2.0" => "Où peut-elle bien être ?
J'espère qu'elle est saine et sauve...",
  "4.3.0" => "Impa",
  "4.4.0" => "Impa",
  "5.0.0" => "Tiens...",
  "5.1.0" => "Le Héros Link...
Je te félicite d'être arrivé jusqu'ici...",
  "5.2.0" => "Hmm... ?",
  "5.3.0" => "Link !",
  "5.4.0" => "Deux...",
  "5.5.0" => "Je vois...",
  "5.6.0" => "Laissez-moi donc vous accueillir comme il se doit...",
  "5.7.0" => "Viens, mon serviteur... !",
  "5.8.0" => "Cya",
  "5.9.0" => "Cya",
  "5.10.0" => "Cya",
  "5.11.0" => "Sheik",
  "5.12.0" => "Cya",
  "5.13.0" => "Cya",
  "5.14.0" => "Cya",
  "5.15.0" => "Cya",
  "6.0.0" => "Sheik, c'est... !",
  "6.1.0" => "Ah ha ha... Je n'aurais jamais cru que tu sois
en possession de la Triforce de la Sagesse.",
  "6.2.0" => "Grâce à toi, j'ai rassemblé toutes les parties de la Triforce...",
  "6.3.0" => "Voici... la véritable puissance de la Triforce... !",
  "6.4.0" => "Oh non... !
Link, fuis !",
  "6.5.0" => "Cya...",
  "6.6.0" => "L'heure est venue de rappeler les fragments de mon âme qui
ont été scellés aux confins du temps... !",
  "6.7.0" => "Oui... Les fragments d'âme...",
  "6.8.0" => "Oooooooooooh !",
  "6.9.0" => "Lana",
  "6.10.0" => "Cya",
  "6.11.0" => "Cya",
  "6.12.0" => "Cya",
  "6.13.0" => "Lana",
  "6.14.0" => "???",
  "6.15.0" => "???",
  "6.16.0" => "Cya",
  "6.17.0" => "Cya",
  "7.0.0" => "Tu aurais très bien pu suivre Link ou Lana,
alors pourquoi as-tu choisi de venir avec moi ?",
  "7.1.0" => "Je te trouve très suspect...
Tu dis être un survivant du clan sheikah ?",
  "7.2.0" => "Alors j'imagine que tu connais le nom du chef du clan.",
  "7.3.0" => "« Impa ». C'est bien ça... ?",
  "7.4.0" => "Tout à fait.
Et il n'y a personne du nom de Sheik dans mon clan.",
  "7.5.0" => "Qui es-tu ?
Qu'est-ce que tu manigances ?",
  "7.6.0" => "Je vous en prie !
Aidez la princesse Ruto !",
  "7.7.0" => "Ruto... C'est la princesse du domaine zora.",
  "7.8.0" => "La princesse Ruto a été enlevée par les Gorons !",
  "7.9.0" => "Darunia, le chef des Gorons était quelqu'un
de droit et jovial...",
  "7.10.0" => "Mais depuis qu'il a rencontré une certaine Zelda,
il est tout à coup devenu très agressif.",
  "7.11.0" => "Zelda... ?
Son Altesse Zelda est dans ce monde... ?!",
  "7.12.0" => "Quoi qu'il en soit, allons voir.",
  "7.13.0" => "Impa",
  "7.14.0" => "Impa",
  "7.15.0" => "Impa",
  "7.16.0" => "Sheik",
  "7.17.0" => "Impa",
  "7.18.0" => "Impa",
  "7.19.0" => "Fée",
  "7.20.0" => "Sheik",
  "7.21.0" => "Fée",
  "7.22.0" => "Fée",
  "7.23.0" => "Fée",
  "7.24.0" => "Impa",
  "7.25.0" => "Sheik",
  "8.0.0" => "C... Comment as-tu su qui j'étais vraiment ?",
  "8.1.0" => "Tu ne pouvais pas être Zelda.",
  "8.2.0" => "Parce que...",
  "8.3.0" => "... je suis Zelda !",
  "8.4.0" => "Votre Altesse Zelda !
Vous êtes saine et sauve !",
  "8.5.0" => "Impa, pardonne-moi de ne pas t'avoir révélé qui j'étais.",
  "8.6.0" => "Fermons la porte, Impa.",
  "8.7.0" => "Iscerro",
  "8.8.0" => "Sheik",
  "8.9.0" => "Sheik",
  "8.10.0" => "Zelda",
  "8.11.0" => "Impa",
  "8.12.0" => "Zelda",
  "8.13.0" => "Zelda",
  "9.0.0" => "N... N'approchez pas... !",
  "9.1.0" => "Hyaaa !",
  "9.2.0" => "Fiou...",
  "9.3.0" => "Tu vas bien ?",
  "9.4.0" => "Oui... ! Je m'appelle Machaon.
Euh... Et vous, qui êtes-vous ?",
  "9.5.0" => "Je m'appelle Lana.",
  "9.6.0" => "Je cherche la porte des âmes, mais je
n'ai aucune idée d'où elle se trouve...",
  "9.7.0" => "La porte des âmes ?
Cela ne me dit rien...",
  "9.8.0" => "Mais je peux vous conduire là
où vous désirez vous rendre.",
  "9.9.0" => "Euh... Comment ça ?",
  "9.10.0" => "C'est un papillon guide. Il vous guidera
à travers le monde du Crépuscule...",
  "9.11.0" => "Villageoise",
  "9.12.0" => "Villageoise",
  "9.13.0" => "Lana",
  "9.14.0" => "Lana",
  "9.15.0" => "Villageoise",
  "9.16.0" => "Lana",
  "9.17.0" => "Lana",
  "9.18.0" => "Machaon",
  "9.19.0" => "Machaon",
  "9.20.0" => "Lana",
  "9.21.0" => "Machaon",
  "10.0.0" => "Rends-nous ce papillon !
Il est très précieux !",
  "10.1.0" => "Ce papillon sécrète une poudre toxique, pas vrai ?",
  "10.2.0" => "Hein ?",
  "10.3.0" => "La poudre pâtissière de ce gentil papillon
n'est pas du tout empoisonnée.",
  "10.4.0" => "Pâ... Pâtissière... ?",
  "10.5.0" => "Ce joli papillon est un papillon guide.",
  "10.6.0" => "Si vous le lui demandez, il vous conduira n'importe où.",
  "10.7.0" => "N'importe où ?",
  "10.8.0" => "Hé, papillon ! Conduis-moi auprès de cette sorcière !",
  "10.9.0" => "Ah... Ah...
Que faire ?",
  "10.10.0" => "On n'a pas le choix. Il va falloir se battre.",
  "10.11.0" => "Lana",
  "10.12.0" => "Midona",
  "10.13.0" => "Lana",
  "10.14.0" => "Machaon",
  "10.15.0" => "Midona",
  "10.16.0" => "Machaon",
  "10.17.0" => "Machaon",
  "10.18.0" => "Midona",
  "10.19.0" => "Midona",
  "10.20.0" => "Machaon",
  "10.21.0" => "Lana",
  "11.0.0" => "Que fais-tu, Lana... ?",
  "11.1.0" => "Cya... !",
  "11.2.0" => "C'est elle... ! C'est à cause du sort qu'elle m'a jeté
que je me suis retrouvée dans cet état... !",
  "11.3.0" => "Ah ha ha... Je trouve que cette apparence te sied
parfaitement, Midona, princesse du Crépuscule.",
  "11.4.0" => "Toi... !",
  "11.5.0" => "Uuuh... !",
  "11.6.0" => "Misérables... !",
  "11.7.0" => "Lana, son visage... Vous vous ressemblez
comme deux gouttes d'eau !",
  "11.8.0" => "Je suis... l'autre moitié de Cya.
À l'origine, nous ne faisions qu'une.",
  "11.9.0" => "Hein... ?",
  "11.10.0" => "Cya",
  "11.11.0" => "Lana",
  "11.12.0" => "Midona",
  "11.13.0" => "Cya",
  "11.14.0" => "Midona",
  "11.15.0" => "Cya",
  "11.16.0" => "Cya",
  "11.17.0" => "Midona",
  "11.18.0" => "Lana",
  "11.19.0" => "Midona",
  "12.0.0" => "Je suis Fay...
Je vous attendais.",
  "12.1.0" => "Je vous reconnais comme étant un être
« différent mais identique » à mon maître.",
  "12.2.0" => "Ma mission est de vous venir en aide...",
  "12.3.0" => "Je vous conseille de faire équipe avec moi.",
  "12.4.0" => "Cela vous convient-il ?",
  "12.5.0" => "Fay",
  "12.6.0" => "Fay",
  "12.7.0" => "Fay",
  "12.8.0" => "Fay",
  "12.9.0" => "Fay",
  "13.0.0" => "Oh, l'ennemi a percé à jour mon plan.",
  "13.1.0" => "Comme c'est vexant.",
  "13.2.0" => "Cela me met dans une humeur exécrable.",
  "13.3.0" => "Je vais devoir châtier cette impertinence
en vous infligeant des souffrances infernales.",
  "13.4.0" => "Ghirahim",
  "13.5.0" => "Ghirahim",
  "13.6.0" => "Ghirahim",
  "13.7.0" => "Ghirahim",
  "14.0.0" => "Maître, brandissez votre épée vers le ciel
puis abaissez-la.",
  "14.1.0" => "Fay",
  "15.0.0" => "Vous avez récupéré vos parties de la Triforce !",
  "15.1.0" => "Oui... Elles sont en Link et en moi...",
  "15.2.0" => "Je ne sais pas ce qui s'est passé,
mais Cya doit être affaiblie.",
  "15.3.0" => "Si nous voulons contre-attaquer, c'est le moment ou jamais !",
  "15.4.0" => "Cya possède toujours la Triforce de la force.",
  "15.5.0" => "Ce ne sera pas si facile...",
  "15.6.0" => "Mais nous pouvons gagner, si nous avons l'épée de légende.",
  "15.7.0" => "Link a hérité du destin du Héros, il devrait pouvoir
retirer l'épée de légende de son socle.",
  "15.8.0" => "Mais... L'épée de légende est un talisman, elle
maintient la barrière qui scelle le mal...",
  "15.9.0" => "Si on la retire, l'âme maléfique qui a jadis
été scellée ne s'éveillera-t-elle pas ?",
  "15.10.0" => "La barrière dressée dans le temple de l'épée sacrée
a été créée à l'aide d'une magie spéciale.",
  "15.11.0" => "Même si l'on retire l'épée de légende,
elle ne se brisera pas si facilement.",
  "15.12.0" => "Mais... qui nous dit que Link aura la force
de retirer l'épée de légende ?",
  "15.13.0" => "J'ai foi en Link.",
  "15.14.0" => "Oui, moi aussi !",
  "15.15.0" => "C'est peut-être une bonne occasion de voir si
Link est un véritable Héros.",
  "15.16.0" => "Bien, en route pour le temple de l'épée sacrée.",
  "15.17.0" => "Lana",
  "15.18.0" => "Zelda",
  "15.19.0" => "Lana",
  "15.20.0" => "Lana",
  "15.21.0" => "Impa",
  "15.22.0" => "Impa",
  "15.23.0" => "Zelda",
  "15.24.0" => "Zelda",
  "15.25.0" => "Impa",
  "15.26.0" => "Impa",
  "15.27.0" => "Lana",
  "15.28.0" => "Lana",
  "15.29.0" => "Impa",
  "15.30.0" => "Zelda",
  "15.31.0" => "Lana",
  "15.32.0" => "Impa",
  "15.33.0" => "Zelda",
  "16.0.0" => "Te voilà... Sale morveux...",
  "16.1.0" => "Impossible... !",
  "16.2.0" => "Iscerro",
  "16.3.0" => "Iscerro",
  "17.0.0" => "Ta force vient de la puissance de ton épée, tu es bien sot
si tu ne t'en es pas rendu compte.",
  "17.1.0" => "La présomption, l'orgueil, l'arrogance...",
  "17.2.0" => "Ces noirs sentiments qui ont germé en toi...",
  "17.3.0" => "... ils vont te conduire à ta destruction.",
  "17.4.0" => "Cya",
  "17.5.0" => "Cya",
  "17.6.0" => "Cya",
  "17.7.0" => "Cya",
  "18.0.0" => "Reprends-toi ! Link !",
  "18.1.0" => "Un véritable Héros doit être conscient de ses propres faiblesses.",
  "18.2.0" => "Lana",
  "18.3.0" => "Impa",
  "19.1.0" => "Gh... !",
  "19.2.0" => "Très bien... Je vais vous donner une bonne leçon... !",
  "19.3.0" => "Hmmmm... !",
  "19.4.0" => "Cya ! Tu as finalement... Idiote...",
  "19.5.0" => "Cya",
  "19.6.0" => "Cya",
  "19.7.0" => "Cya",
  "19.8.0" => "Lana",
  "20.0.0" => "Vous allez m'aider à assouvir mon ambition.",
  "20.1.0" => "La Triforce sera mienne !",
  "20.2.0" => "Ganondorf",
  "20.3.0" => "Ganondorf",
  "21.0.0" => "Je les ai enfin rassemblées.",
  "21.1.0" => "Hu hu...",
  "21.2.0" => "Hu ha ha ha ha ha !",
  "21.3.0" => "Ganondorf",
  "21.4.0" => "Ganondorf",
  "21.5.0" => "Ganondorf",
  "22.0.0" => "Je vous en prie... !",
  "22.1.0" => "Aidez-moi... Mes amis !",
  "22.2.0" => "Lana",
  "22.3.0" => "Lana",
  "181.0.0" => "Ooooh ho ho ho ho ho !",
  "181.1.0" => "Je suis une grande fée au service de la Déesse.
Dis-moi quel est ton vœu.",
  "181.2.0" => "Grande fée",
  "181.3.0" => "Grande fée",
}