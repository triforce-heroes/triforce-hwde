Map {
  "0.0.0" => "¡Impide que A0%1sF2R huya!",
  "0.1.0" => "¡Salta por el A6precipicio norteR y ataca al enemigo por la retaguardia!",
  "0.2.0" => "¡El éxito del ataque sorpresa ha aumentado la moral de las A0%1sF1R!",
  "0.3.0" => "¡No has logrado sorprender a las A0%1sF1R!",
  "0.4.0" => "¡La moral de las A0%1sF1R ha disminuido al fracasar el ataque sorpresa!",
  "0.5.0" => "¡Las palabras A0%2sF6R han mermado la moral de las A0%1sF1R!",
  "0.6.0" => "¡La moral A0%1sF6R ha aumentado tras prestar ayuda!",
  "0.7.0" => "¡Conquista C2%1sF2R!",
  "0.8.0" => "¡C2%1sF0R y C2%2sF2R se han abierto!",
  "0.9.0" => "¡Las A0%1sF1R avanzan hacia las A0%2sF1R!",
  "0.11.0" => "¡A0%1sF0R avanza para ayudar A0%2sF4R!",
  "0.12.0" => "¡Has capturado C2%1sF2R!",
  "0.13.0" => "¡A0%1sF0R ha ido en busca del Espejo de la Verdad!",
  "0.14.0" => "¡A0%1sF0R se dirige hacia el A6Templo del AguaR!",
  "0.15.0" => "¡A0%1sF0R ha aparecido en C5%2sF2R!",
  "0.17.0" => "¡Las A0%1sF1R están buscando el Espejo de la Verdad!",
  "0.18.0" => "¡Las A0%1sF1R han encontrado el Espejo de la Verdad en C5%2sF2R!",
  "0.19.0" => "¡La estrategia A0%2sF6R ha hecho que C5%1sF2R se cierre!",
  "0.21.0" => "¡Toma la A6sala de controlR y abre todas las compuertas!",
  "0.22.0" => "¡A0%1sF0R avanza hacia el A6este del temploR!",
  "0.23.0" => "¡Ayuda A0%1sF4R!",
  "0.25.0" => "¡La compuerta C2%1sF6R se ha abierto!",
  "0.26.0" => "¡Activa el A6interruptorR que falta!",
  "0.28.0" => "¡Has abierto todas las compuertas!",
  "0.29.0" => "¡Derrota al A2guardaR y reúnete con A0%1sF2R!",
  "0.30.0" => "¡Has salvado A0%1sF4R y conseguiste el Espejo de la Verdad!",
  "0.31.0" => "¡Las condiciones para la victoria han cambiado!",
  "0.32.0" => "¡A0%1sF0R no puede huir!",
  "0.33.0" => "¡El poder del Espejo de la Verdad ha revelado un A6túnel secretoR!",
  "0.34.0" => "¡A0%1sF0R ha aparecido gracias a la estrategia A0%2sF6R!",
  "0.35.0" => "¡El enemigo ha hecho A0%1sF4R retirarse A0%2sF4R!",
  "0.37.0" => "¡Has derrotado A0%1sF4R!",
  "0.38.0" => "¡A0%1sF0R ha llegado A0%2sF4R!",
  "0.39.0" => "¡Las A0%1sF1R han ganado la batalla!",
  "0.40.0" => "¡A0%1sF0R ha huido!",
  "0.41.0" => "¡Las A0%1sF1R han sido derrotadas!",
  "0.42.0" => "¡A0%1sF0R está en peligro! ¡Necesita ayuda inmediata!",
  "0.43.0" => "¡A0%1sF0R está en grave peligro! ¡Necesita ayuda urgente!",
  "0.45.0" => "¡C5%1sF0R se ha abierto!",
  "0.46.0" => "¡Ha aparecido la A6entrada al Templo del AguaR!",
  "0.47.0" => "¡El éxito del ataque sorpresa ha aumentado la moral de las A0%1sF1R!",
