  "0.2.0" => "¡Has vencido A0%1sF4R!",
  "0.3.0" => "¡Al derrotar A0%1sF4R, el A6Portal de las AlmasR ha desaparecido!",
  "0.4.0" => "¡Has logrado vencer A0%1sF5R!",
  "0.5.0" => "¡Al derrotar A0%1sF5R, los A6portales de las almasR han desaparecido!",
  "0.6.0" => "¡A0%1sF0R ha aparecido!",
