  "0.8.0" => "¡A0%1sF0R se dirige al desierto del sur!",
  "0.9.0" => "¡A0%1sF0R ha alcanzado el desierto del sur!",
  "0.10.0" => "¡Al huir A0%2sF2R, A0%1sF2R está atacando en el desierto del sur!",
  "0.11.0" => "¡A0%1sF0R ha aparecido en el campo de batalla!",
  "0.12.0" => "¡A0%1sF0R se ha retirado temporalmente A0%2sF4R!",
  "0.13.0" => "¡Has alejado A0%1sF4R!",
  "0.14.0" => "¡A0%1sF0R, A0%2sF2R y A0%3sF2R se han abierto!",
  "0.15.0" => "¡Parte de las A0%1sF1R se dirige hacia A0%2sF2R!",
  "0.16.0" => "¡Has derrotado A0%1sF5R!",
  "0.17.0" => "¡Cierra inmediatamente todos los A6portales de las almasR!",
  "0.18.0" => "¡Parte de las A0%1sF1R se dirige hacia A0%2sF2R!",
  "0.19.0" => "¡Has derrotado A0%1sF5R!",
  "0.20.0" => "¡Has cerrado todos los A6portales de las almasR!",
  "0.21.0" => "¡Ataca y haz retroceder A0%1sF4R inmediatamente!",
  "0.22.0" => "¡Vence a los A2monstruosR y rescata A0%1sF4R inmediatamente!",
  "0.23.0" => "¡Se ha abierto una puerta en A6%1sF0R y en A6%2sF0R!",
  "0.24.0" => "¡Derrota A0%1sF5R!",
  "0.25.0" => "¡A0%1sF0R está atacando en el desierto del norte!",
  "0.26.0" => "¡Has tomado A0%1sF2R!",
  "0.27.0" => "¡Al perder el bastión, la moral A0%1sF6R ha disminuido!",
  "0.28.0" => "¡Al perder el bastión, A0%1sF2R se ha debilitado!",
  "0.29.0" => "¡Han aparecido refuerzos de las A0%1sF1R!",
  "0.30.0" => "¡A0%1sF0R se ha retirado temporalmente A0%2sF4R!",
