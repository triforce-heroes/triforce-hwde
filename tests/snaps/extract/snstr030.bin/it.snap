Map {
  "0.0.0" => "Sconfiggi A0%1sF2R!",
  "0.1.0" => "Conquista l'A2altopiano delle rovineR o le A2rovine sudR!",
  "0.2.0" => "Hai conquistato l'area C2%1sF4R!",
  "0.3.0" => "L'area A0%1sF0R è aperta!",
  "0.4.0" => "L'A0%1sF1R combatte insieme all'A0%2sF7R!",
  "0.5.0" => "Le condizioni di sconfitta sono cambiate!",
  "0.6.0" => "A0%1sF0R non deve fuggire!",
  "0.7.0" => "A0%1sF0R va verso l'area A0%2sF6R!",
  "0.8.0" => "Le aree C2%1sF0R e C2%2sF0R sono aperte!",
  "0.9.0" => "Attenzione, A0%2sF6R va verso l'area A0%1sF6R!",
  "0.10.0" => "L'area A0%1sF6R non deve cadere!",
  "0.11.0" => "Hai sconfitto A0%1sF2R!",
  "0.12.0" => "Sconfiggi A0%1sF2R!",
  "0.13.0" => "L'A0%1sF1R ha perso la battaglia!",
  "0.14.0" => "Hai sconfitto A0%1sF2R e A0%2sF2R!",
  "0.15.0" => "A0%1sF0R appare di nuovo!",
  "0.16.0" => "L'A0%1sF1R si unisce all'A0%2sF7R!",
  "0.17.0" => "L'A0%1sF1R combatte contro l'A0%2sF7R!",
  "0.18.0" => "A0%1sF0R perde o l'area A0%2sF6R cade!",
  "0.19.0" => "Sconfiggi A0%1sF2R!",
  "0.20.0" => "A0%1sF0R ora è più forte!",
  "0.21.0" => "I presidi dell'A5armata di OltrenuvolaR sono aperti!",
  "0.22.0" => "Appaiono i rinforzi dell'A5armata di OltrenuvolaR!",
  "0.23.0" => "Conquista i presidi dell'A0%1sF5R e ferma i rinforzi!",
  "0.24.0" => "I rinforzi dell'A0%1sF5R smettono di apparire!",
  "0.25.0" => "Il morale dell'A0%1sF1R è peggiorato!",
  "0.26.0" => "L'area C1%1sF0R è stata conquistata dall'A0%2sF7R!",
  "0.27.0" => "Le condizioni di vittoria sono cambiate!",
  "0.28.0" => "A0%1sF0R ora è più debole!",
  "0.29.0" => "Il morale dell'A0%1sF1R è migliorato!",
  "0.30.0" => "Hai conquistato il A5presidio della statuaR!",
  "0.31.0" => "Hai conquistato la A5fontana della deaR!",
  "0.32.0" => "Hai conquistato l'area C2%1sF0R!",
  "0.33.0" => "Not Used",
  "0.34.0" => "A0%1sF0R si ritira temporaneamente!",
  "0.35.0" => "A0%1sF0R appare di nuovo!",
  "0.36.0" => "Sul campo è apparsa un'A6AracnulaR!",
  "0.37.0" => "Cerca l'A6AracnulaR!",
  "0.38.0" => "Hai ottenuto un'A6AracnulaR!",
  "0.39.0" => "L'A6AracnulaR si prepara alla fuga!",
  "0.40.0" => "L'A6AracnulaR scappa!",
  "0.41.0" => "L'area A0%1sF0R è aperta!",
  "0.42.0" => "L'area A0%1sF0R è aperta!",
  "0.43.0" => "A0%1sF0R è in fuga!",
  "0.44.0" => "L'A0%1sF1R ha raggiunto l'A0%2sF7R!",
  "0.45.0" => "Conquista il A5presidio della statuaR!",
  "0.46.0" => "Conquista la A5fontana della deaR!",
  "0.47.0" => "A0%1sF0R si ritira verso l'area A0%2sF6R!",
  "0.48.0" => "L'A0%1sF1R si mette in marcia verso l'area A0%2sF6R!",
  "0.49.0" => "A0%1sF0R va verso A0%2sF2R!",
  "0.50.0" => "A0%1sF0R inizia a lottare contro A0%2sF2R!",
  "0.51.0" => "Presto, sconfiggi A0%1sF2R!",
  "0.52.0" => "L'A0%1sF1R si esalta e va verso l'area A0%2sF6R!",
  "0.53.0" => "A5Potenti nemiciR vanno verso l'area A0%1sF6R!",
  "0.54.0" => "A0%1sF1R appaiono!",
  "0.55.0" => "A0%1sF0R sta avanzando!",
  "0.56.0" => "Presto, conquista i presidi dell'A0%1sF1R!",
  "0.57.0" => "Hai sconfitto A0%1sF3R!",
  "0.58.0" => "A0%1sF0R appare e va verso l'area A0%2sF6R!",
  "0.59.0" => "Parte dell'A0%1sF1R va verso A0%2sF2R!",
  "0.60.0" => "Hai protetto A0%1sF2R!",
  "0.61.0" => "A0%1sF0R lascia una A6giara magicaR in campo e si ritira!",
  "0.62.0" => "L'A5armata di OltrenuvolaR ha fatto fuggire A0%1sF2R!",
  "0.63.0" => "Conquista i presidi rimanenti!",
  "0.64.0" => "Hai conquistato A63 presidiR!",
  "0.65.0" => "Hai conquistato l'area A0%1sF2R!",
  "0.66.0" => "Conquista l'area A0%1sF2R!",
  "0.67.0" => "L'A0%1sF1R ha cominciato la marcia!",
  "0.68.0" => "Hai conquistato l'area C4%1sF4R!",
  "0.69.0" => "Raggiungi A0%1sF2R!",
