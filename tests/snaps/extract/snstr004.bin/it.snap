  "0.47.0" => "Sconfiggi A0%2sF2R prima che lo faccia A0%1sF2R!",
  "0.48.0" => "A0%1sF1R hanno perso! A0%2sF0R ora è più debole!",
  "0.49.0" => "A0%1sF0R ha perso!",
