Map {
  "0.0.0" => "A0%1sF0R e A0%2sF2R vanno verso i A6santuariR!",
  "0.1.0" => "La trappola di A2LanaR ha chiuso la A6%1sF0R!",
  "0.2.0" => "L'area A0%1sF2R è aperta! A0%2sF0R avanza!",
  "0.3.0" => "La trappola di A2LanaR ha chiuso la A6%1sF0R!",
  "0.4.0" => "L'area A0%1sF0R è aperta, A0%2sF2R avanza!",
  "0.5.0" => "L'area C1%1sF2R è aperta!",
  "0.6.0" => "Adesso conquista l'area A0%1sF2R!",
  "0.7.0" => "L'area C1%1sF2R è aperta!",
  "0.8.0" => "Adesso conquista l'area A0%1sF2R!",
  "0.9.0" => "Hai conquistato il A6santuario della deaR!",
  "0.10.0" => "I A6santuariR sono caduti! Il morale dell'A0%1sF1R peggiora!",
  "0.11.0" => "A0%2sF0R fugge e l'A0%1sF1R si esalta!",
  "0.12.0" => "A0%2sF0R fugge e l'A0%1sF1R si esalta!",
  "0.13.0" => "A0%1sF5R appaiono in vari luoghi!",
  "0.14.0" => "A0%1sF1R si mettono in marcia!",
  "0.15.0" => "Sconfiggi A0%1sF3R!",
  "0.16.0" => "Appaiono A0%2sF6R e altre copie di A0%1sF2R!",
  "0.17.0" => "Sconfiggi A0%1sF3R nelle A6rovineR!",
  "0.18.0" => "A0%1sF0R cambia direzione per aiutare A0%2sF2R!",
  "0.19.0" => "Hai trovato la vera A0%1sF2R!",
  "0.20.0" => "Tutte le copie di A0%1sF2R diventano più forti!",
  "0.21.0" => "Tutte le copie di A0%1sF2R diventano più deboli!",
  "0.22.0" => "Hai sconfitto la vera A0%1sF2R!",
  "0.23.0" => "Tutte le copie di A0%1sF2R diventano più deboli!",
  "0.24.0" => "Hai sconfitto la vera A0%1sF2R!",
  "0.25.0" => "Le aree A0%1sF0R e A0%2sF0R sono aperte!",
  "0.26.0" => "A0%1sF1R si mettono in marcia!",
  "0.27.0" => "Sconfiggi A0%2sF2R nell'area A0%1sF6R!",
  "0.28.0" => "A0%1sF0R appare nell'area A0%2sF6R!",
  "0.29.0" => "L'area A0%1sF0R è aperta!",
  "0.30.0" => "A0%1sF0R è in fuga!",
  "0.31.0" => "A0%1sF0R si divide in 3 per magia!",
  "0.32.0" => "Nuove condizioni di sconfitta!",
  "0.33.0" => "Una A0%1sF2R raggiunge un A6punto di fugaR!",
  "0.34.0" => "A0%1sF0R va all'attacco di A0%2sF6R a ovest!",
  "0.35.0" => "A0%1sF0R va all'attacco di A0%2sF6R a est!",
  "0.36.0" => "Sconfiggi A0%1sF3R restanti!",
  "0.37.0" => "A0%1sF1R si avvicinano al A6punto di fugaR!",
  "0.38.0" => "A0%1sF0R a ovest si avvicina al A6punto di fugaR!",
  "0.39.0" => "A0%1sF0R a est si avvicina al A6punto di fugaR!",
  "0.40.0" => "A0%1sF0R ha perso!",
  "0.41.0" => "Hai sconfitto tutte A0%1sF3R!",
  "0.42.0" => "A0%1sF0R si ritira e non puoi più sconfiggerla!",
  "0.43.0" => "L'A0%1sF1R ha perso la battaglia!",
  "0.44.0" => "LA0%2sF7R ha conquistato l'area C1%1sF0R!",
  "0.45.0" => "L'A0%1sF1R ha perso la battaglia!",
  "0.46.0" => "L'area A0%1sF2R è aperta! A0%2sF0R avanza!",
  "0.47.0" => "Parte dell'A0%1sF1R si dirige verso A0%2sF6R!",
  "0.48.0" => "Parte dell'A0%1sF1R si dirige verso A0%2sF6R!",
  "0.49.0" => "Un A2evocatoreR è apparso!",
  "0.50.0" => "L'A0%1sF1R ha vinto la battaglia!",
  "0.51.0" => "Un'A6AracnulaR è stata avvistata sul campo di battaglia!",
  "0.52.0" => "Cerca l'A6AracnulaR!",
  "0.53.0" => "Hai ottenuto l'A6AracnulaR!",
  "0.54.0" => "L'A6AracnulaR sta per fuggire!",
  "0.55.0" => "L'A6AracnulaR è fuggita!",
  "0.56.0" => "Le A2copieR di A0%1sF6R sono sparite!",
  "0.57.0" => "Sconfiggi A0%1sF3R A6nelle rovineR!",
  "0.58.0" => "Salva A0%1sF2R e A0%2sF2R!",
  "0.59.0" => "Sono apparsi i rinforzi dell'A0%1sF1R!",
  "0.60.0" => "Hai sconfitto A0%1sF2R!",
  "0.61.0" => "I rinforzi di A0%1sF6R hanno cominciato un attacco generale!",
  "0.62.0" => "Le porte sono chiuse! Trova un'altra strada!",
  "0.63.0" => "A0%1sF0R ha perso!",
  "0.64.0" => "A0%1sF0R appare in varie aree!",
  "0.65.0" => "Il morale di A0%1sF6R è migliorato!",
  "0.66.0" => "Parte dell'A0%1sF1R va verso l'area C1%2sF0R!",
  "0.67.0" => "Hai difeso l'area C1%1sF0R!",
  "0.68.0" => "Sconfiggi A0%1sF2R perché si comporta in modo sospetto!",
  "0.69.0" => "A0%2sF1R migliorano il morale dell'A0%1sF1R!",
  "0.70.0" => "A0%1sF0R non ha portato a termine il suo piano!",
  "0.71.0" => "A0%1sF0R vuole chiamare altri rinforzi!",
  "0.72.0" => "A0%1sF0R è all'area A0%2sF6R e chiama i rinforzi!",
  "0.73.0" => "A0%1sF1R ora sono più forti e veloci!",
  "0.74.0" => "A0%1sF0R si esalta ed è più veloce!",
  "0.75.0" => "Sconfiggi l'ultima A0%1sF2R!",
  "0.76.0" => "A0%1sF0R a nord si avvicina al A6punto di fugaR!",
  "0.77.0" => "A0%1sF0R ha chiamato i rinforzi per l'A0%2sF5R!",
  "0.78.0" => "Ora puoi controllare A0%1sF2R!",
  "0.79.0" => "A0%1sF0R è in fuga!",
  "0.80.0" => "A0%1sF0R appare e va verso l'area C2%2sF6R!",
  "0.81.0" => "Hai conquistato l'area C2%1sF4R!",
  "0.82.0" => "Nell'area A0%1sF6R si nasconde un tesoro!",
  "0.83.0" => "A0%1sF0R si prepara a incoraggiare le truppe!",
  "0.84.0" => "Hai sconfitto A0%1sF2R!",
  "0.85.0" => "A0%1sF0R si prepara a incoraggiare le truppe!",
  "0.86.0" => "Presto, sconfiggi A0%1sF2R!",
  "0.87.0" => "A0%1sF0R arriva nell'area A0%2sF4R!",
  "0.88.0" => "A0%1sF0R abbandona il campo di battaglia!",
  "0.89.0" => "Presto, all'attacco!",
  "0.90.0" => "A0%1sF0R appare!",
