Map {
  "0.0.0" => "A0%1sF4R ne doit pas s'enfuir !",
  "0.1.0" => "Sautez de la A6falaise du nordR et attaquez l'ennemi depuis l'arrière !",
  "0.2.0" => "Le succès de l'attaque surprise galvanise A0%1sF1R !",
  "0.3.0" => "Vous avez rencontré A0%1sF1R de face ! L'attaque surprise a échoué !",
  "0.4.0" => "L'échec de l'attaque surprise décourage A0%1sF1R !",
  "0.5.0" => "Les paroles de A0%2sF0R découragent A0%1sF1R !",
  "0.6.0" => "Le soutien apporté à A0%1sF0R augmente son moral !",
  "0.7.0" => "Prenez le contrôle C2%1sF2R !",
  "0.8.0" => "Les portes C2%1sF2R et C2%2sF2R sont ouvertes !",
