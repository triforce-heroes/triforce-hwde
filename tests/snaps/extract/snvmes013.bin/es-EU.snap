Map {
  "1.0.0.0" => "Antes de nada debemos enseñarles nuestro
poder.",
  "1.0.1.0" => "De acuerdo. Enséñales una lección a
los monstruos de la aldea cercana.",
  "1.0.2.0" => "Yo me ocuparé del edificio del norte.
Me recuerda a un... patíbulo.",
  "1.0.3.0" => "¿Qué essstáis tramando?",
  "1.0.4.0" => "¡Coged a esssos idiotas!",
  "1.0.5.0" => "Si nos hacemos con los bastiones,
acabaremos con los enemigos de la aldea.",
  "1.0.6.0" => "Los bastiones no lograrán protegeros
de nuestro inmenso poder.",
  "1.0.7.0" => "Solo resta un bastión. ¡Debe ser nuestro
de inmediato!",
  "1.0.8.0" => "Si tanto te molesssta, recupéralo.",
  "1.0.9.0" => "¿Se puede saber qué ha passsado?",
  "1.0.10.0" => "¡No podemos dejar que tomen el bassstión!",
  "1.0.11.0" => "Antes de tomar la aldea debemos acabar
con ellos en ese bastión.",
  "1.0.12.0" => "¡No dejaré que traten asssí a misss
aliados! Osss superamosss en número.",
  "1.0.13.0" => "Aprovechemos que han salido para
conquistar los bastiones de la aldea.",
  "1.0.14.0" => "Queda uno más. ¡A por ellos!",
  "1.0.15.0" => "¡Haremos que nos devuelvan el bassstión!",
  "1.0.16.0" => "¡No nos provoquéisss!",
  "1.0.17.0" => "Menudos debiluchos...",
  "1.0.18.0" => "Las puertas siguen cerradas, aunque puede
que se abran si tomamos este bastión.",
  "1.0.19.0" => "Ni siquiera ahora que el bastión es nuestro se
abre la puerta... Tendré que investigar un poco.",
  "1.0.20.0" => "¿Qué es essse barullo que hay afuera?",
  "1.0.21.0" => "Las sombrasss se aproximan...",
  "1.0.22.0" => "¡Ocupaos de los intrusssos!",
  "1.0.23.0" => "Parece que los lagartitos han salido a jugar...",
  "1.0.24.0" => "Al parecer hay monstruos prisioneros; deberíamos
tratar de someterlos.",
  "1.0.25.0" => "Dejadme al rey dodongo a mí.",
  "1.0.26.0" => "Podemos ocuparnos del rey dodongo en otro
momento. Lo primero son estos de aquí.",
  "1.0.27.0" => "Tengo que estar a la altura
de las circunstancias.",
  "1.0.28.0" => "¡Qué espectáculo! Tal es la
fuerza del rey demonio.",
  "1.0.29.0" => "He fracasado... ¿Cómo ha podido ser?",
  "1.0.30.0" => "Justo ahora que iba a mostrar
mi verdadera fuerza...",
  "1.0.31.0" => "Tendría que haber bastado con eso...",
  "1.0.32.0" => "Han aparecido las bestias del desierto.
Si las derroto, sus secuaces me seguirán.",
  "1.0.33.0" => "Cada vez que se juntan, se ponen
de lo más agresivas.",
  "1.0.34.0" => "El enemigo del desierto no
es el objetivo principal.",
  "1.0.35.0" => "Al menos uno de los enemigos está fuera
de combate. ¡Vamos a por los demás!",
  "1.0.36.0" => "¡Je, je, je! ¡Nadie puede vencernos!",
  "1.0.37.0" => "Es un poder digno de un dios...",
  "1.0.38.0" => "Ganondorf no es solo el rey demonio,
¡es también el rey del mundo!",
  "1.0.39.0" => "La resistencia ha sido escasa, pero no todas
las batallas pueden ser épicas.",
  "1.0.40.0" => "¡Sacadme de aquí!",
  "1.0.41.0" => "Tu vida me pertenece...",
  "1.0.42.0" => "¿Qué mosca le habrá picado?",
  "1.0.43.0" => "Serás mi lacayo.",
  "1.0.44.0" => "¡Socorro!",
  "1.0.45.0" => "Me ayudarás a llevar a cabo mis planes.",
  "1.0.46.0" => "No pensé que un enemigo como este resultaría
un reto. ¡Ayúdame, rey demonio!",
  "1.0.47.0" => "Que el rey demonio tenga que lidiar con
estas naderías...",
  "1.0.48.0" => "Debo retirarme para recuperar fuerzas.",
  "1.0.49.0" => "No necesito la ayuda de nadie para controlar
esta zona. ¡Puedo hacerlo yo solo!",
  "1.0.50.0" => "¡Será sssoberbio! ¡A por él!",
  "1.0.51.0" => "Mi fuerza no es suficiente... ¡Ayudadme!",
  "1.0.52.0" => "Pensaba que eras el amo de las sombras,
¿cómo es que necesitas mi ayuda?",
  "1.0.53.0" => "Lo siento, pero debo retirarme.",
  "1.0.54.0" => "¡Eres un inútil! Apártate, yo me encargaré.",
  "1.0.55.0" => "¡Somos másss fuertes!",
  "1.0.56.0" => "¡Es muy poderossso!",
  "1.0.57.0" => "¡Qué fuerza más desssmesurada!",
  "1.0.58.0" => "¡Aniquiladlos!",
  "1.0.59.0" => "Truquitos a mí...",
  "1.0.60.0" => "¡Debemos capturar este lugar sin dilación!
Será un obsequio para mi amo y señor...",
  "1.0.61.0" => "¡Tenemosss que conseguir aliadosss!",
  "1.0.62.0" => "Parece que intentan fortalecerse...
¡Tomemos sus bastiones cuanto antes!",
  "1.0.63.0" => "¡Somosss poderosssos! ¡Adelante!",
  "1.0.64.0" => "¡Ningún bastión podrá resistirse
a nuestro poder!",
  "1.0.65.0" => "Algo sssucede en el sssur...
Iré a invessstigar.",
  "1.0.66.0" => "Los monstruos del norte han percibido
nuestra presencia. ¡Yo los detendré!",
  "1.0.67.0" => "No son más que viles gusanos.
Derrotarlos será tarea fácil.",
  "1.0.68.0" => "¡El bassstión está en peligro!
¡Debemosss protegerlo!",
  "1.0.69.0" => "¡Liberemosss a los monstruos!
¡Que luchen con nosotrosss!",
  "1.0.70.0" => "Quieren usar a sus prisioneros contra
nosotros... ¡Intentemos controlarlos!",
  "1.0.71.0" => "Interesante... Yo me ocuparé de los
prisioneros del norte.",
  "1.0.72.0" => "Entendido. Entonces yo me encargo
de los que están en el sur.",
  "1.0.73.0" => "¡Oídme, gusanos! ¡A partir de ahora
serviréis a nuestro señor Ganondorf!",
  "1.0.74.0" => "¡Prisssioneros! ¡Luchad contra losss
intrusssos si queréisss ser liberadosss!",
  "1.0.75.0" => "Entendido...",
  "1.0.76.0" => "Este desierto parece estar infestado
de bestias gigantes...",
  "1.0.77.0" => "No os preocupéis, mi señor; no son
rivales para nosotros.",
  "1.0.78.0" => "Vaya, cuántas bestias gigantes
hay en este desierto...",
  "1.0.79.0" => "Si acabamos con todas ellas,
el resto de gusanos se rendirán.",
  "1.0.80.0" => "¡Han vencido a nuestrosss aliadosss!
¡No ssse lo perdonaremosss!",
  "1.0.81.0" => "No nos eliminéis. Os serviremos.",
  "1.0.82.0" => "Mi señor, reunámonos cerca de la bestia.
¡Así sabrá lo poderosos que somos!",
}