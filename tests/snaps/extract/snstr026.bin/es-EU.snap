Map {
  "0.0.0" => "¡Están cayendo A2rayosR! ¡Las A0%1sF1R pierden energía vital!",
  "0.1.0" => "¡A0%1sF0R está aumentando su poder mágico en la A2base enemigaR!",
  "0.2.0" => "¡A0%1sF0R ha sufrido daño debido a los A2rayosR!",
  "0.3.0" => "¡Impide que A0%1sF2R huya!",
  "0.4.0" => "¡Conquista el resto de A6bastiones de los SabiosR!",
  "0.5.0" => "¡Impide que los A6bastiones de los SabiosR caigan!",
  "0.6.0" => "¡Has hecho desaparecer las A6estatuas de la TierraR!",
  "0.7.0" => "¡A0%1sF0R se dirige A0%2sF4R!",
  "0.8.0" => "¡Los A6árboles kolog han crecidoR y han conectado el camino!",
  "0.9.0" => "¡A0%1sF0R va A0%2sF4R para pedir refuerzos!",
  "0.10.0" => "¡A0%1sF0R ha pedido refuerzos en A0%2sF2R!",
  "0.11.0" => "¡A0%1sF0R ha abandonado el campo de batalla!",
  "0.12.0" => "¡A0%1sF0R no ha logrado solicitar refuerzos!",
  "0.13.0" => "¡A0%1sF0R ha abandonado el campo de batalla!",
  "0.14.0" => "¡Has evitado que se solicitasen refuerzos!",
  "0.15.0" => "¡Has conquistado los cuatro A6bastiones de los SabiosR!",
  "0.16.0" => "¡Han dejado de caer A2rayosR!",
  "0.17.0" => "¡Todos los A6bastiones de los SabiosR se han abierto!",
  "0.18.0" => "¡Reúnete con A0%1sF2R!",
  "0.19.0" => "¡A0%1sF0R ha fortalecido a los A2monstruos de la plaza centralR!",
  "0.20.0" => "¡El poder mágico de los A2monstruos de la plaza centralR está aumentando!",
  "0.21.0" => "¡A0%1sF0R y A0%2sF2R han aparecido!",
  "0.22.0" => "¡A0%1sF0R y A0%2sF2R se dirigen a los A6bastiones de los SabiosR!",
  "0.23.0" => "¡La magia ha fortalecido a los A2monstruos de la zona centralR!",
  "0.24.0" => "¡La magia ha fortalecido aún más a los A2monstruos de la zona centralR!",
  "0.25.0" => "¡La magia ha fortalecido más todavía a los A2monstruos de la zona centralR!",
  "0.26.0" => "¡Los A2monstruos de la zona centralR se dirigen A0%1sF4R!",
  "0.27.0" => "¡Has vencido a las dos A2bestias gigantesR!",
  "0.28.0" => "¡Has vencido a los A2monstruos de la zona centralR!",
  "0.29.0" => "¡Al desaparecer las A6estatuas de la TierraR, se ha conectado el camino!",
  "0.30.0" => "¡Los A6árboles kolog han crecidoR y han conectado el camino!",
  "0.31.0" => "¡Parte de los A2monstruos del Templo de la TierraR se dirigen C1%2sF4R y A0%3sF4R!",
  "0.32.0" => "¡Parte de los A2monstruos del Templo de la TierraR se dirigen C1%2sF4R y A0%3sF4R!",
  "0.33.0" => "¡Los dispositivos se han activado y han abierto el camino!",
  "0.34.0" => "¡Han caído más A2rayosR y han mermado la fuerza de las A0%1sF1R!",
  "0.35.0" => "¡Captura el A6bastión de los SabiosR inmediatamente!",
  "0.36.0" => "¡Recupera el control de todos los A6bastiones de los SabiosR!",
  "0.37.0" => "¡Al recuperar el control de los A6bastionesR, los rayos han cesado!",
  "0.38.0" => "¡A0%1sF0R ha usado el poder mágico para hacerse más fuerte!",
  "0.39.0" => "¡A0%1sF0R se dirige hacia A0%2sF2R!",
  "0.40.0" => "¡A0%1sF0R ha usado el poder mágico para recuperar su energía!",
  "0.41.0" => "¡Reúnete cuanto antes donde está A0%1sF2R!",
  "0.42.0" => "¡A0%1sF0R ha dejado de recuperar energía!",
  "0.43.0" => "¡Las A0%2sF1R han hecho huir A0%1sF4R!",
  "0.44.0" => "¡Las A0%1sF1R han sido derrotadas!",
  "0.45.0" => "¡A0%1sF0R ha huido! ¡Has perdido la batalla!",
  "0.46.0" => "¡Las A0%2sF1R han tomado C1%1sF2R!",
  "0.47.0" => "¡Ha aparecido una A6skulltulaR en el campo de batalla!",
  "0.48.0" => "¡Busca la A6skulltulaR!",
  "0.49.0" => "¡Has conseguido la A6skulltulaR!",
  "0.50.0" => "¡La A6skulltulaR está a punto de huir!",
  "0.51.0" => "¡La A6skulltulaR ha huido!",
  "0.52.0" => "¡Has derrotado A0%1sF4R!",
  "0.53.0" => "¡C2%1sF0R se ha abierto!",
  "0.54.0" => "¡Has conquistado C2%1sF2R!",
  "0.55.0" => "¡Las A0%2sF1R han tomado C1%1sF2R!",
  "0.56.0" => "¡A0%1sF0R se ha reunido con A0%2sF2R!",
  "0.57.0" => "¡A0%1sF0R está en peligro!",
  "0.58.0" => "¡A0%1sF0R está a punto de caer!",
  "0.59.0" => "¡Las A0%1sF1R han dejado de perder energía vital!",
  "0.60.0" => "¡Los A2monstruos poderososR se dirigen hacia A0%1sF2R!",
  "0.61.0" => "¡Se ha abierto una puerta en A6la cueva centralR!",
  "0.62.0" => "¡Se ha abierto una puerta en el A6corredor del temploR!",
  "0.63.0" => "¡A0%1sF0R ha recuperado toda su energía vital!",
  "0.64.0" => "¡A0%1sF3R se dirigen C1%2sF4R!",
  "0.65.0" => "¡A0%1sF3R se dirigen ahora A0%3sF4R!",
