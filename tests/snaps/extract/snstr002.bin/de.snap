  "0.30.0" => "Finde die A1Große FeeR!",
  "0.31.0" => "A0%1sF0R ist durch das A2FeuerR in Gefahr! Du musst helfen!",
  "0.32.0" => "A0%1sF0R muss verteidigt werden!",
  "0.33.0" => "A0%1sF0R muss unbedingt verteidigt werden!",
