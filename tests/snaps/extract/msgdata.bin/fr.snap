  "5.6171.0" => "Éclair de l'épée! Champ de bataille déchiré!",
  "5.6172.0" => "Soulagement! Bataillon de guérisseurs!",
  "5.6173.0" => "Chargez! Le choc des armées!",
  "5.6174.0" => "Prudence! Pluie de projectiles!",
  "5.6175.0" => "Raz-de-marée! Arrivée de renforts!",
  "5.6176.0" => "Grande mêlée! Des invités indésirables!",
  "5.6177.0" => "C'est dangereux d'y aller seul!",
  "5.6178.0" => "La cocotte! Un partenaire de confiance!",
  "5.6179.0" => "Frissons! Une croissance gigantesque!",
  "5.6180.0" => "Grand festival de la cocotte!",
  "5.6181.0" => "Vaillance! L'arrivée du héros!",
  "5.6182.0" => "Coup de chance! Des opportunités à saisir!",
  "5.6183.0" => "Tension! Des frissons sur le champ de bataille!",
  "5.6184.0" => "Abracadabra! Des magiciens au combat!",
  "5.6185.0" => "Capharnaüm! Allez vous battre ailleurs!",
  "5.6186.0" => "Au vol! Prenez garde aux chasseurs d'objets!",
