  "0.32.0" => "La fuite A0%2sF3R a remonté le moral A0%1sF3R!",
  "0.33.0" => "Rendez-vous C2%1sF6R!",
  "0.36.0" => "Franchissez A6les murs de tentaculesR et rendez-vous C2%1sF6R!",
  "0.37.0" => "A0%1sF4R a rejoint le champ de bataille!",
  "0.38.0" => "Les conditions de victoire ont changé!",
