  "0.18.0" => "Avanza e sconfiggi A2YugaR!",
  "0.19.0" => "Avanza e sconfiggi A2YugaR!",
  "0.20.0" => "A0%1sF0R ha un piano per individuare A0%2sF2R originale!",
