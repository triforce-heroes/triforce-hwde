Map {
  "1.0.0.0" => "Gegen diese Übermacht bleibt uns nur
die Flucht.",
  "1.0.1.0" => "Das erlaube ich nicht!
Das Triforce der Kraft gehört mir!",
  "1.0.2.0" => "In manchen Festungen verbirgt sich eine
heilige Kraft, die dem Feind Stärke verleiht...",
  "1.0.3.0" => "Sie versuchen verzweifelt, ihrer Zauberin die
Flucht zu ermöglichen. Wie langweilig...",
  "1.0.5.0" => "Lockt Ghirahim und Zanto in die Festungen!",
  "1.0.6.0" => "Hat dieses Kind etwa einen Plan?",
  "1.0.7.0" => "Geschafft! Ghirahim ist gefangen!",
  "1.0.8.0" => "Jetzt können wir sie zurückdrängen!",
  "1.0.9.0" => "Sehr gut! Zanto ist gefangen!",
  "1.0.10.0" => "Ob wir den Feind auf seiner Seite auch
zurückdrängen können?",
  "1.0.11.0" => "Die Verstärkung aus Hyrule wird bald hier sein!
Haltet nur noch ein kleines bisschen durch!",
  "1.0.12.0" => "Dieses Fiasko ist auf mich zurückzuführen.
Ich gelobe Besserung.",
  "1.0.13.0" => "Der Plan dieses Kindes ist ohne jede
Bedeutung.",
  "1.0.14.0" => "Vergebt mir...
Ich werde es wiedergutmachen...",
  "1.0.15.0" => "Der Plan dieses Kindes ist ohne jede
Bedeutung.",
  "1.0.16.0" => "Die heilige Macht ist erloschen...",
  "1.0.17.0" => "Du kannst nicht mehr fliehen.
Gib mir das Triforce der Kraft!",
  "1.0.18.0" => "Wir haben Zanto geschlagen!
Jetzt kennst du unsere Stärke!",
  "1.0.19.0" => "Wir haben Ghirahim besiegt!
Und wir haben noch Reserven!",
  "1.0.20.0" => "Alles in Ordnung, Lana?
Wir sind hier, um dir zu helfen!",
  "1.0.21.0" => "Impa! Danke für die Hilfe!",
  "1.0.22.0" => "Diese Monster werden am eigenen Leib
spüren, was mein Stamm mich gelehrt hat!",
  "1.0.23.0" => "Schade! Das war nur meine Doppelgängerin!",
  "1.0.24.0" => "Eine Doppelgängerin? Wie verschlagen...",
  "1.0.25.0" => "Besiegt die Echte, und ihre Doppelgängerinnen
werden verschwinden!",
  "1.0.26.0" => "Bedroht Ihr Lana unmittelbar, so wird Impa
die Fassung verlieren und sich zeigen.",
  "1.0.27.0" => "Das klingt annehmbar...",
  "1.0.28.0" => "So ein Pech aber auch!
Das ist ebenfalls nur eine Doppelgängerin!",
  "1.0.29.0" => "Wir sollten uns auf die Echte konzentrieren.
Säen wir etwas Chaos an Lanas Hauptquartier!",
  "1.0.30.0" => "Nein! Der Feind ist hier!",
  "1.0.31.0" => "Lana steckt in Schwierigkeiten!
Ich muss ihr helfen!",
  "1.0.32.0" => "Sieh an, da ist ja die Echte...",
  "1.0.33.0" => "Deine Tricks wirken nicht länger. Ich hoffe,
du bist auf das Unvermeidliche vorbereitet.",
  "1.0.34.0" => "Mein kleines Täuschungsmanöver war wohl
zu raffiniert für euch! Der Sieg ist unser!",
  "1.0.35.0" => "Mein Plan ist fehlgeschlagen...",
  "1.0.36.0" => "Elende Insekten...",
  "1.0.37.0" => "Wie konnten sie mich durchschauen? Meine
Doppelgängerinnen werden schwächer...",
  "1.0.38.0" => "Selbst wenn du mich besiegst, Lana wird
entkommen...",
  "1.0.39.0" => "Jetzt muss ich nur noch diese kleine
Zauberin einfangen.",
  "1.0.40.0" => "Selbst wenn du mich besiegst, Lana wird
entkommen...",
  "1.0.41.0" => "Wir werden Lana beschützen!",
  "1.0.42.0" => "Was glaubt ihr, damit zu erreichen?
Hinfort mit ihnen, jagt die Zauberin!",
  "1.0.43.0" => "Das Triforce der Kraft ist bald wieder bei
seinem rechtmäßigen Besitzer!",
  "1.0.44.0" => "Was? Wieder nur eine Doppelgängerin?
Denkt sie, sie kann mich zum Narren halten?",
  "1.0.45.0" => "Lana! Aktiviere den Magiekreis, um
zu fliehen!",
  "1.0.46.0" => "Oh nein, du wirst mir nicht entkommen!",
  "1.0.47.0" => "Du bist ganz allein...
Wir werden dich kriegen!",
  "1.0.48.0" => "Cia und ich waren einst eine Seele... Wenn ich
meine Seele erneut teile, entkomme ich ihm!",
  "1.0.49.0" => "Das sind nicht nur bloße Doppelgängerinnen...
Wir müssen alle drei gefangennehmen!",
  "1.0.50.0" => "Lasst die Mädchen nicht entkommen!",
  "1.0.51.0" => "Ich werde die Lana im Westen verfolgen.",
  "1.0.52.0" => "Ich verfolge die im Osten. Sie wird ihre
lachhaften Taschenspielertricks bereuen...",
  "1.0.53.0" => "Nicht nachlassen! Ich bin fast am Ziel...
Mit meiner Magie werden wir stärker...",
  "1.0.54.0" => "Sie vergeudet nur ihre Kraft.",
  "1.0.55.0" => "Beeil dich, Lana! Wenn du den Magiekreis
erreichst, bist du in Sicherheit!",
  "1.0.56.0" => "Hinterher! Lasst sie nicht entkommen!",
  "1.0.57.0" => "Sie wird noch entkommen!",
  "1.0.58.0" => "Warte gefälligst!",
  "1.0.59.0" => "Sie hat mir sehr viel Verdruss bereitet. Aber das
Triforce der Kraft ist endlich wieder mein!",
  "1.0.60.0" => "Schloss Hyrule wird bald folgen...
Und dann ist das Triforce in meinem Besitz!",
  "1.0.61.0" => "Das Triforce... In unerreichbarer Ferne...",
  "1.0.62.0" => "Hmpf... Deine kleinen Tricks haben besser
funktioniert, als ich gedacht hätte...",
  "1.0.63.0" => "Sehr gut! Wir haben Zanto isoliert!",
  "1.0.64.0" => "Jetzt können wir vielleicht den Feind
auf der anderen Seite zurückdrängen?",
  "1.0.65.0" => "Wenn wir ihr Hauptquartier einnehmen, haben
wir gewonnen! Kommt, alle zusammen!",
  "1.0.66.0" => "Jaaa! Wir schaffen das!",
  "1.0.67.0" => "Ich werde entkommen! Und wenn
es mich meine letzte Kraft kostet!",
  "1.0.68.0" => "Nur noch eine übrig...
Bringen wir es zu Ende!",
  "1.0.69.0" => "Du entkommst mir nicht, kleines Balg!",
}