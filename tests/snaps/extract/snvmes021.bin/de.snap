Map {
  "1.0.0.0" => "Die Prinzessin ist sicher zum Hauptquartier
gegangen. Schätze, ich sollte sie retten!",
  "1.0.1.0" => "Ich helfe dir! Aber... das Hauptquartier
schützt ein Torwächter.",
  "1.0.2.0" => "Tor und Wächter sind magisch gestärkt.
Wir müssen wohl erst Festungen erobern.",
  "1.0.3.0" => "Wir sollten uns aufteilen.
Ich übernehme den Osten!",
  "1.0.4.0" => "Die Monster strömen förmlich aus
dem Tempel!",
  "1.0.5.0" => "Egal, wie schwierig es wird... Ich werde
Licht in diese Dunkelheit bringen!",
  "1.0.6.0" => "Zelda hält die Schattenmagie zurück. Aber
allein wird sie nicht lange durchhalten!",
  "1.0.7.0" => "Sie versuchen, die Festungen zu stärken,
um die Schattenmagie aufrechtzuerhalten.",
  "1.0.8.0" => "Wenn wir die Schattenmagie nicht schwächen,
kommen wir nicht ins Hauptquartier!",
  "1.0.9.0" => "Der Thronwächter ist Zantos Schatten?
Wir müssen erst seine Magie schwächen!",
  "1.0.10.0" => "Wenn wir die Festungen erobern, können
wir seine Magie eindämmen? Dann los!",
  "1.0.11.0" => "Ihr Anführer wird frech, weil Zelda
geschwächt ist...",
  "1.0.12.0" => "Ein mächtiger Feind... Aber wenn wir seine
Festungen erobern, wird er schwächer.",
  "1.0.13.0" => "Wir müssen nicht alle Festungen
erobern. Drei sollten ausreichen!",
  "1.0.14.0" => "Sie haben es auf unser Hauptquartier
abgesehen. Wir müssen es beschützen!",
  "1.0.15.0" => "Ja, weiter so! Die übrigen Festungen
nehmen wir ihnen auch noch ab!",
  "1.0.16.0" => "Ein Feind weniger, der uns gefährlich
werden kann.",
  "1.0.17.0" => "Hmpf... Ich fürchte, wir haben sie
damit nur wütender gemacht...",
  "1.0.18.0" => "Puh! Jetzt nur noch ein paar Festungen
einnehmen...",
  "1.0.19.0" => "Die Festung wurde verstärkt! Jetzt wird
es schwieriger, die Prinzessin zu retten...",
  "1.0.20.0" => "Die Hälfte ist erledigt! Nehmen wir
ihnen schnell die übrigen Festungen ab!",
  "1.0.21.0" => "Die Festung wurde verstärkt?! Ich hoffe,
wir erreichen Zelda jetzt nicht zu spät...",
  "1.0.22.0" => "Zelda! Wisst Ihr, was Ihr tut? Wenn Ihr
Eure Kräfte erschöpft, ist das Euer Ende!",
  "1.0.23.0" => "Ich muss den Anführer aufhalten...
Schwächt Ihr solange den Feind!",
  "1.0.24.0" => "Ich muss die Schatten aufhalten...
Auch wenn es mich mein Leben kostet!",
  "1.0.25.0" => "Nein! Wenn Ihr das tut...
Das werde ich nicht zulassen!",
  "1.0.26.0" => "Weil wir eine Festung eingenommen haben,
sind die Feinde etwas schwächer geworden!",
  "1.0.27.0" => "Geschafft! Jetzt kommen keine neuen
Monster mehr heraus!",
  "1.0.28.0" => "Huch?! Was sind denn das jetzt für
Monster?",
  "1.0.29.0" => "Was haben sie denn jetzt herbeigerufen!?
Vorsicht! Das Ding ist gefährlich!",
  "1.0.30.0" => "Unsere Priorität sind noch immer die
Festungen, aus denen Schattenmagie strömt!",
  "1.0.31.0" => "Wir sind zu wenige!
Ich werde Verstärkung rufen!",
  "1.0.32.0" => "Wir kämpfen mit! Zusammen
werden wir sie aufhalten!",
  "1.0.33.0" => "Jetzt können wir uns ganz darauf
konzentrieren, Festungen einzunehmen!",
  "1.0.34.0" => "Danke für den Schutz! Unsere Mission
ist beendet. Wir ziehen uns zurück!",
  "1.0.35.0" => "Sie konnten keine Verstärkung rufen. Unser
Hauptquartier ist nicht gut geschützt...",
  "1.0.36.0" => "Ich sollte die Tore jetzt öffnen
können... Haltet durch, Zelda!",
  "1.0.37.0" => "Zelda! Kommen wir rechtzeitig?
Ich gebe Euch einen Teil meiner Magie!",
  "1.0.38.0" => "Ihr habt mich gerettet...",
  "1.0.39.0" => "Ihr werdet dafür büßen, was ihr Zelda
angetan habt!",
  "1.0.40.0" => "Ah... Mein Kompass leuchtet wieder!",
  "1.0.41.0" => "Denkst du etwa, dieses Schloss gehört dir?
Die Prinzessin der Schatten bin immer noch ich!",
  "1.0.42.0" => "Wir haben das stärkste dieser Monster
bezwungen!",
  "1.0.43.0" => "Danke für eure Hilfe! Aber die
Schattenmagie breitet sich weiter aus...",
  "1.0.44.0" => "Keine Angst. Als Prinzessin der Schatten
habe ich eine Idee...",
  "1.0.45.0" => "Unser Hauptquartier! Wie sollen
wir Zelda jetzt noch retten?!",
  "1.0.46.0" => "Verzeiht mir!
Meine Kraft... Ich...",
  "1.0.47.0" => "Hm... Das Hauptquartier ist immer noch
nicht offen!",
  "1.0.48.0" => "Ich werde deinem Treiben ein Ende setzen!",
  "1.0.49.0" => "Die Hälfte ist erledigt! Nehmen wir
ihnen schnell die übrigen Festungen ab!",
  "1.0.50.0" => "Wir müssen etwas unternehmen!",
  "1.0.51.0" => "Ich werde nicht zulassen, dass
Schattenmagie diese Welt verschlingt!",
  "1.0.52.0" => "Aus der Festung im Norden strömt besonders
viel Schattenmagie... Fangen wir dort an!",
  "1.0.53.0" => "War das ihr Anführer? Der Feind wird
frech, weil Zelda geschwächt ist...",
  "1.0.54.0" => "Sie scheinen irgendetwas vorzuhaben...",
  "1.0.55.0" => "Ihre Magie ist geschwächt!
Jetzt hält uns kein Torwächter mehr auf!",
  "1.0.56.0" => "Der Torwächter ist Geschichte! Wenn wir die
Festungen erobern, ist das Hauptquartier offen!",
  "1.0.57.0" => "Ich kämpfe an eurer Seite! Niemand wird
der Prinzessin ein Haar krümmen!",
  "1.0.58.0" => "Wenn wir so weitermachen, kommen wir bald an
Tor und Torwächter des Hauptquartiers vorbei!",
  "1.0.59.0" => "Midna... Ihr gabt mir Eure Kraft...
Und auch du hast sehr geholfen, Mädchen!",
  "1.0.60.0" => "Sieht aus, als hätten sie ihre ganze
Magie in diese Monstren gesteckt!",
  "1.0.61.0" => "Sie haben noch ein Monster gerufen?!
Das halten wir nicht mehr lange durch!",
  "1.0.62.0" => "Alles klar!
Ich nehme mir den Westen vor!",
  "1.0.63.0" => "Ja. Wenn Tor und Wächter nicht länger
gestärkt sind, kann ich das Tor öffnen!",
  "1.0.64.0" => "Midna! Was ist mit Euch passiert...?!
Und wer ist das Mädchen?",
  "1.0.65.0" => "Ich heiße Linkle! Ich bin mitgekommen,
um Euch zu retten, Prinzessin!",
  "1.0.66.0" => "Lasst uns den Rest besprechen,
wenn wir in Sicherheit sind!",
  "1.0.67.0" => "Als legendärer Held ist Prinzessinnen
retten meine Spezialität!",
  "1.0.68.0" => "Betrüger bleibt Betrüger. Gegen den
echten Herrscher kommt er nicht an.",
  "13.0.2.0" => "Zuerst sollten wir uns nach Osten bewegen
und die Vorposten dort einnehmen!",
  "13.0.3.0" => "Alles in Ordnung? Schnell, nimm die feindlichen
Festungen im Osten ein!",
  "13.0.4.0" => "Wir können nicht über die Brücke... Konzentrieren
wir uns erst einmal auf die Festung!",
  "13.0.5.0" => "Eine Schatztruhe? Die sollten wir uns nicht
entgehen lassen!",
  "13.0.6.0" => "Sie greifen uns aus der Luft an! Und wir
können kaum etwas dagegen tun...",
  "13.0.7.0" => "Um einen Drachen zu bezwingen, bedarf es
der Macht eines Magiekreises!",
  "13.0.8.0" => "Ich beschwöre einen Magiekreis in der Festung
unterhalb des Drachen! Ich brauche aber Hilfe!",
  "13.0.9.0" => "Diese Monster stehen mir im Weg!
Ich brauche Hilfe!",
  "13.0.10.0" => "Ist dort drüben alles in Ordnung? Ich bin hier
allein mittendrin im Getümmel...",
  "13.0.11.0" => "Wir dürfen keine Zeit verlieren... Der Magiekreis
muss so schnell wie möglich errichtet sein!",
  "13.0.12.0" => "Der Magiekreis ist errichtet! Damit können wir den
Drachen angreifen!",
  "13.0.13.0" => "Unser Hauptquartier wird fallen, wenn wir nichts
tun! Schnell! Greif mit dem Magiekreis an!",
  "13.0.14.0" => "Gut gemacht! Hoffentlich sind wir diesen Drachen
für immer los...",
  "13.0.15.0" => "Oh nein! Sie haben es auf Agnetha abgesehen!
Sie dürfen ihr nichts antun!",
  "13.0.16.0" => "Sie haben Agnetha gefangengenommen?! Das wird
sicher die Moral unserer Feinde im Osten stärken...",
  "13.0.17.0" => "Wir können den Drachen mit dem Magiekreis angreifen!
Erobere die Position unterhalb des Drachen!",
  "13.0.18.0" => "Machen wir es wieder wie beim letzten Mal?
Ich bin dabei!",
  "13.0.19.0" => "Er nimmt wieder Kurs auf die Festung...
Wir müssen ihn abwehren, so schnell es geht!",
  "13.0.20.0" => "Der Magiekreis ist errichtet! Diesmal solltest du
den Drachen erwischen!",
  "13.0.21.0" => "Es ist fast vorbei... Schnell! Verwende den
Magiekreis, um den Drachen zu besiegen!",
  "13.0.22.0" => "Da! Der magische Angriff hat gewirkt!
Der Drache fliegt jetzt deutlich niedriger!",
  "13.0.23.0" => "Schon drei Mal... Wie oft sollen wir das noch
wiederholen?",
  "13.0.24.0" => "Der Angriff mit meinem Magiekreis hat nichts
bewirkt... Was können wir nur tun?",
  "13.0.25.0" => "Folgen wir dem Schmetterling! Auf zum Gebäude im
Südosten... Uns bleibt keine andere Wahl!",
  "13.0.26.0" => "Der Magiekreis in der Quelle der Göttin ist vielleicht
genau das, was wir gegen den Drachen benötigen!",
  "13.0.27.0" => "Uns bleibt nur noch das Hauptquartier. Wir müssen
es mit unserem Leben schützen, sonst ist alles aus!",
  "13.0.28.0" => "Fantastisch! Wir haben es geschafft!",
  "13.0.29.0" => "Wenn wir den Drachen und diesen Zanto besiegen,
haben wir gewonnen... Nichts leichter als das!",
  "13.0.30.0" => "Ihr seid Opfer eurer Gier. Du... und Cia!",
  "13.0.31.0" => "Wir haben ihn... Endlich! Gute Arbeit!",
  "13.0.32.0" => "Wir haben die mächtigsten unserer Feinde besiegt!
Jetzt können wir das Seelenportal schließen!",
  "13.0.33.0" => "Das Hauptquartier hält dem Ansturm kaum noch
stand! Ich flehe euch an... Helft uns!",
  "13.0.34.0" => "Das Hauptquartier wird fallen!
Kommt zu Hilfe! Schnell!",
  "13.0.35.0" => "Nnnh... Sie haben mich erwischt...
Es... tut mir leid...",
  "13.0.36.0" => "Das Hauptquartier ist gefallen? Dann ist alles aus...",
  "13.0.37.0" => "Da! Der Magiekreis zeigt Wirkung!
Der Drache hat an Höhe verloren!",
}