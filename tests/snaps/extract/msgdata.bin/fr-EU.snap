  "5.342.0" => "Configurez le partage de données d'utilisation du logiciel.",
  "5.343.0" => "Paramétrez la mise en pause au lancement des missions.",
  "5.344.0" => "Accédez au tutoriel.",
  "5.345.0" => "Téléchargez du contenu.",
  "5.346.0" => "Choisissez de changer une partie des armes à deux éléments en armes rétro.",
  "5.347.0" => "Configurez la réception de notifications promotionnelles.",
  "5.348.0" => "Violon des Vagues : remplit la jauge de coup fatal.",
  "5.349.0" => "Conque de l'Écume : dégâts subis temporairement divisés par deux.",
  "5.350.0" => "Cloche des Algues : remplit la jauge de magie.",
  "5.351.0" => "Harpe du Reflux : les ennemis donnent plus de points d'expérience.",
  "5.352.0" => "Xylophone Marin : les ennemis donnent plus de rubis.",
  "5.353.0" => "Triangle de Corail : fait apparaître plus de nourriture.",
  "5.354.0" => "Orgue de l'Embellie : fait apparaître plus de matériaux.",
  "5.355.0" => "Tambour des Marées : fait apparaître plus d'armes.",
  "5.356.0" => "Pépé le Ramollo : appelez-le depuis une cabine téléphonique.",
  "5.357.0" => "Bracelet : pour soulever des rochers.",
  "5.358.0" => "Poudre magique : pour allumer les torches.",
  "5.359.0" => "Navire de Linebeck : facilite l'obtention de notes élevées pour les K.-O.",
  "5.360.0" => "Navire de fer : facilite l'obtention de notes élevées pour le temps.",
  "5.361.0" => "Navire d'or : facilite l'obtention de notes élevées pour les dégâts subis.",
  "5.362.0" => "Locomotive des dieux : permet d'avancer sur toutes les cartes avec le rang C.",
  "5.363.0" => "Locomotive d'acier : toutes les cartes ont deux éléments efficaces.",
  "5.364.0" => "Locomotive d'or : toutes les restrictions de personnage sont levées.",
  "5.365.0" => "Rail : pour relier les voies ferrées interrompues.",
  "5.366.0" => "Ardoise des tornades : l'utiliser sur les grenouilles dorées fait apparaître l'ennemi.",
  "5.367.0" => "Hélice des bourrasques : pour faire tourner un moulin à vent.",
  "5.368.0" => "Canon : pour tirer sur les rochers.",
  "5.369.0" => "Peinture murale : rend les ténèbres efficaces. Utilisez-la sur une faille pour changer de monde.",
  "5.370.0" => "Gant de puissance : rend la foudre efficace. Permet de soulever les rochers.",
  "5.371.0" => "Baguette de feu : rend le feu efficace. Fait fondre les statues de glace.",
  "5.372.0" => "Baguette des tornades : rend les ténèbres efficaces. Fait disparaître les dalles.",
  "5.373.0" => "Baguette des sables : rend le feu efficace. Soulève les dunes de sable.",
  "5.374.0" => "Baguette de glace : rend l'eau efficace. Fait tomber de la glace sur les statues de feu.",
  "5.375.0" => "Grappin : rend la lumière efficace. Permet d'atteindre des endroits éloignés.",
  "5.376.0" => "Boomerang : rend la foudre efficace. Active les interrupteurs de cristal.",
  "5.377.0" => "Arc : rend la lumière efficace. Tire une flèche dans une sentinelle.",
  "5.378.0" => "Bombes : augmentation des rubis gagnés. Permet de détruire les murs fissurés.",
  "5.379.0" => "Marteau : augmentation des dégâts infligés. Permet d'enfoncer les billots en bois.",
  "5.380.0" => "Ti'gorneau : rend l'eau efficace. Ramenez-le à Big'ornette et...",
  "5.381.0" => "Choisissez le personnage à qui vous souhaitez donner un ordre.",
