  "0.51.0" => "¡Han aparecido A2monstruosR en el A6Patíbulo del DesiertoR!",
  "0.52.0" => "¡A0%1sF0R ha presentido la batalla y ha empezado a A2atacarR!",
  "0.53.0" => "¡Impide que las A2bestias gigantesR se reúnan!",
  "0.54.0" => "¡A0%1sF0R se ha reunido con A0%2sF2R!",
  "0.55.0" => "¡A0%1sF0R y A0%2sF2R se han hecho más fuertes!",
  "0.56.0" => "¡A0%1sF0R ha invocado A2monstruosR en la A6aldeaR!",
  "0.57.0" => "¡Conquista los A6tres bastionesR cuanto antes!",
  "0.58.0" => "¡A0%1sF0R ha invocado más A2monstruosR!",
  "0.59.0" => "¡A0%1sF3R avanzan desde el A6desierto del norteR al A6del surR!",
  "0.60.0" => "¡Has impedido A0%1sF5R que llegaran al A6desierto del surR!",
  "0.61.0" => "¡A0%1sF3R han entrado en el A6desierto del surR!",
  "0.62.0" => "¡La moral de parte de las A0%1sF1R ha aumentado!",
  "0.63.0" => "¡Has conquistado los A6tres bastionesR!",
  "0.64.0" => "¡Han aparecido A0%1sF1R delante de las A6prisionesR!",
  "0.65.0" => "¡A0%1sF3R se disponen a abrir las A6prisionesR!",
  "0.66.0" => "¡Has derrotado A0%1sF5R!",
  "0.67.0" => "¡A0%1sF3R han abierto las A6puertas de las prisionesR!",
