Map {
  "0.0.0" => "¡Dirígete a la A6aldea de los monstruosR!",
  "0.1.0" => "¡Las puertas C2%1sF6R y C2%2sF6R se han abierto!",
  "0.2.0" => "¡Las A0%1sF1R se dirigen hacia las A0%2sF1R!",
  "0.3.0" => "¡Las A0%1sF1R han tomado C2%2sF2R!",
  "0.4.0" => "¡Toma C2%1sF2R, C2%2sF2R y C2%3sF2R!",
  "0.6.0" => "¡Recupera C2%2sF2R de manos de las A0%1sF1R!",
  "0.7.0" => "¡Se ha abierto una puerta en A6la entrada a la aldeaR!",
  "0.8.0" => "¡Toma C2%1sF2R y C2%2sF2R!",
  "0.9.0" => "¡Ahora toma C2%1sF2R!",
  "0.10.0" => "¡Has conquistado todos los bastiones de la A6aldeaR!",
  "0.11.0" => "¡A0%1sF0R ha alcanzado C2%2sF2R!",
  "0.12.0" => "¡La A6entrada al Patíbulo del DesiertoR se ha abierto!",
  "0.13.0" => "¡Dirígete al A6Patíbulo del DesiertoR!",
  "0.14.0" => "¡Has encontrado una A6prisiónR!",
  "0.15.0" => "¡Se ha abierto una puerta en A6%1sF0R!",
  "0.16.0" => "¡El A5ferrusR se ha unido a las A0%1sF1R!",
  "0.17.0" => "¡A0%1sF0R ha aparecido en el campo de batalla!",
  "0.18.0" => "¡A0%1sF0R se aproxima A0%2sF4R!",
  "0.19.0" => "¡Derrota A0%1sF5R cuanto antes!",
  "0.20.0" => "¡Los A0%3sF1R han caído y la moral A0%1sF6R y A0%2sF6R ha aumentado!",
  "0.21.0" => "¡Has derrotado A0%1sF5R!",
  "0.22.0" => "¡A0%1sF0R y A0%2sF2R han aparecido en el campo de batalla!",
  "0.23.0" => "¡Has capturado C2%1sF2R y sus puertas se han abierto!",
  "0.24.0" => "¡Las condiciones para la victoria han cambiado!",
  "0.25.0" => "¡Debes derrotar a todas las A2bestias gigantesR!",
  "0.26.0" => "¡La moral A0%1sF6R ha aumentado al encontrarse con A0%2sF2R!",
  "0.27.0" => "¡A0%1sF0R se ha hecho más fuerte al lado de A0%2sF2R!",
  "0.28.0" => "¡Has derrotado A0%1sF4R!",
  "0.29.0" => "¡Ahora derrota A0%1sF4R y A0%2sF4R!",
  "0.30.0" => "¡Has derrotado a todas las A2bestias gigantesR!",
  "0.31.0" => "¡A0%1sF0R está en peligro!",
  "0.32.0" => "¡A0%1sF0R ha huido!",
  "0.33.0" => "¡A0%2sF0R ha huido y la moral de las A0%1sF1R ha aumentado!",
  "0.34.0" => "¡A0%2sF0R ha huido y las A0%1sF1R se han fortalecido!",
  "0.35.0" => "¡Las A0%1sF1R han ganado la batalla!",
  "0.36.0" => "¡Las A0%1sF1R han sido derrotadas!",
  "0.37.0" => "¡Las A0%1sF1R han conquistado C1%2sF2R!",
  "0.38.0" => "¡Ahora derrota A0%1sF4R!",
  "0.39.0" => "¡Ahora ve por C2%1sF2R y C2%2sF2R!",
  "0.40.0" => "¡Ha aparecido una A6skulltulaR en el campo de batalla!",
  "0.41.0" => "¡Busca la A6skulltulaR!",
  "0.42.0" => "¡Has obtenido una A6skulltulaR!",
  "0.43.0" => "¡La A6skulltulaR está a punto de huir!",
  "0.44.0" => "¡La A6skulltulaR ha huido!",
  "0.45.0" => "¡A0%1sF0R ha presentido la batalla y se ha puesto en marcha!",
  "0.46.0" => "¡Derrota a todas las A2bestias gigantesR antes de que se junten!",
  "0.47.0" => "¡Las A6entradas a la aldeaR se han cerrado!",
  "0.48.0" => "¡Libera a los A5monstruosR de su A6prisiónR!",
  "0.49.0" => "¡Las A6puertas de entrada al Patíbulo del DesiertoR se han cerrado!",
