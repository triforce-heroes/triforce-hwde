Map {
  "0.0.0" => "A0%1sF0R hat C2%2sF6R erobert!",
  "0.1.0" => "A0%1sF0R ist offen!",
  "0.2.0" => "A0%1sF0R verbraucht ihre Magie, um A0%2sF6R in Schach zu halten!",
  "0.3.0" => "A0%1sF0R bereitet im A6OstpalastR eine Stärkung der Truppen vor!",
  "0.4.0" => "A0%1sF1R rücken Richtung A0%2sF4R und A0%3sF4R vor!",
  "0.5.0" => "A0%1sF0R hat C2%2sF3R A0%3sF6R beschworen!",
  "0.6.0" => "Ein Teil der A0%1sF1R rückt Richtung A0%2sF4R vor!",
  "0.7.0" => "A0%1sF0R darf nicht fallen!",
  "0.8.0" => "Die A6PalasteingängeR wurden erobert!",
  "0.9.0" => "A0%1sF0R muss schnell besiegt werden!",
  "0.10.0" => "A0%1sF0R wurde besiegt!",
  "0.11.0" => "A0%1sF0R hat die A0%2sF3R angespornt!",
  "0.12.0" => "A0%1sF1R wurden auf dem Schlachtfeld gesichtet!",
  "0.13.0" => "A0%1sF1R rücken gegen A0%2sF6R vor!",
  "0.14.0" => "A0%1sF0R wurde besiegt!",
  "0.15.0" => "A0%1sF0R beginnt, A0%2sF6R zu verstärken!",
  "0.16.0" => "A0%1sF0R ist dabei, A0%2sF6R zu verstärken!",
  "0.17.0" => "A0%1sF0R muss schnell besiegt werden!",
  "0.18.0" => "A0%1sF0R wurde durch A0%2sF6R gestärkt!",
  "0.19.0" => "A0%1sF1R haben das Kampfgeschehen verlassen!",
  "0.20.0" => "A0%1sF0R wurde besiegt!",
  "0.21.0" => "A0%1sF0R hat A0%2sF3R A0%3sF6R beschworen!",
  "0.22.0" => "A0%1sF0R will gegen A0%2sF6R vorrücken!",
  "0.23.0" => "Die Moral der A0%1sF1R steigt!",
  "0.24.0" => "Ein Teil der Festungen der A0%1sF5R wurde erobert!",
  "0.25.0" => "A0%1sF0R wurde geschwächt!",
  "0.26.0" => "Die Moral der A0%1sF1R sinkt!",
  "0.27.0" => "A0%1sF0R beschwört nicht mehr A0%2sF7R!",
  "0.28.0" => "A0%1sF0R hat in der Nähe C2%2sF2R A0%3sF6R beschworen!",
  "0.29.0" => "Die Magie A0%2sF2R hat A0%1sF6R stärker gemacht!",
  "0.30.0" => "A0%1sF0R rückt Richtung A0%2sF4R vor!",
  "0.31.0" => "A0%1sF1R wurden A0%2sF3R gesichtet!",
  "0.32.0" => "A0%1sF1R rücken Richtung A0%2sF4R und A0%3sF4R vor!",
  "0.33.0" => "A0%1sF0R ist am Ziel angekommen und ruft Verstärkung!",
  "0.34.0" => "Die A0%1sF5R haben Verstärkung erhalten!",
  "0.35.0" => "Die Verstärkung der A0%1sF1R rückt gegen den A2FeindR vor!",
  "0.36.0" => "A0%1sF1R haben nach Abschluss ihrer Mission das Schlachtfeld verlassen!",
  "0.37.0" => "Du konntest A0%1sF7R nicht beschützen!",
  "0.38.0" => "Die A2Festungen des SchattenpalastesR wurden erobert!",
  "0.39.0" => "A0%1sF0R verliert Magie und wird schwächer!",
  "0.40.0" => "A0%1sF0R muss A0%2sF6R erreichen!",
  "0.41.0" => "Die Magie A0%2sF2R hat A0%1sF6R geöffnet!",
  "0.42.0" => "A0%1sF0R hat A0%2sF4R Magie übertragen und sie damit gerettet!",
  "0.43.0" => "C1%1sF0R ist an die A0%2sF7R gefallen!",
  "0.44.0" => "Die A0%1sF1R wurden besiegt!",
  "0.45.0" => "A0%1sF0R wurde von den A0%2sF5R vertrieben!",
  "0.46.0" => "Die A0%1sF1R haben die Schlacht verloren!",
  "0.47.0" => "A0%1sF0R ist geflohen!",
  "0.48.0" => "Die A0%1sF1R wurden besiegt!",
  "0.49.0" => "A0%1sF0R bereitet eine Stärkung der Truppen vor!",
  "0.50.0" => "Besiege den anderen A0%1sF3R!",
  "0.51.0" => "Eine feindliche Magiefestung wurde erobert!",
  "0.52.0" => "A0%1sF0R hat in der Nähe A0%2sF2R A0%3sF6R beschworen!",
  "0.53.0" => "Durch den Sieg über A0%1sF6R wurde A0%2sF5R geöffnet!",
  "0.54.0" => "Erobere die übrigen A2MagiefestungenR!",
  "0.55.0" => "A0%1sF0R hat auf dem Zentralplatz A0%3sF6R beschworen!",
  "0.56.0" => "A0%1sF0R wird durch die Magie der Festungen gestärkt!",
  "0.57.0" => "A0%1sF0R rückt gegen A0%2sF6R vor!",
  "0.58.0" => "A0%1sF0R bereitet erneut eine Beschwörung vor!",
  "0.59.0" => "A0%1sF0R bereitet eine Beschwörung vor!",
  "0.60.0" => "Rette schnell A0%1sF6R!",
  "0.61.0" => "A0%1sF0R ist zurückgekehrt!",
  "0.62.0" => "A0%1sF0R bereitet einen Angriff auf C1%2sF6R vor!",
  "0.63.0" => "C1%1sF0R ist durch A0%2sF6R gefallen!",
  "0.65.0" => "A0%1sF1R rücken Richtung A0%2sF4R vor!",
  "0.66.0" => "A0%1sF0R ist offen!",
