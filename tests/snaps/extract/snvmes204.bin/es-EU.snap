Map {
  "1.0.0.0" => "Vuestra forma de luchar es digna
de admiración.",
  "1.0.1.0" => "¡He aquí por qué sois digno
de mi admiración!",
  "1.0.2.0" => "¿Por qué se estarán reuniendo
los enemigos a mi alrededor?",
  "1.0.3.0" => "¡Vaya, son muchos! Si no hacemos algo
rápido, tendremos problemas...",
  "1.0.4.0" => "Ilusos... Creen que pueden vencerme.
Aunque siendo tantos quizá tenga problemas...",
  "1.0.5.0" => "Es una pena no poder seguir admirando
este espectáculo, pero debo retirarme.",
  "1.0.6.0" => "¿Hasta cuándo tendré que aguantar
a este hatajo de impertinentes?",
  "1.0.7.0" => "¡Es todo un honor recibir
ayuda de alguien así!",
  "1.0.8.0" => "No hay palabras con las que pueda
expresar mi gratitud por vuestra ayuda.",
  "1.0.9.0" => "¡No tenéis rival, mi señor!",
  "1.0.10.0" => "¡Vuestro poder no conoce límites!",
  "1.0.11.0" => "Solo alguien tan poderoso es capaz de
barrer al enemigo con un simple gesto.",
  "1.0.12.0" => "¡Contemplad y temed un poder
que no tiene igual!",
  "1.0.13.0" => "¡No dejéis títere con cabeza!
¡Aplastadlos a todos!",
  "1.0.14.0" => "Me postro ante vos para juraros
lealtad hasta el fin, mi señor.",
  "1.0.15.0" => "No deberíais mediros con
semejante escoria.",
  "1.0.16.0" => "Me encanta el sabor de
la destrucción.",
  "1.0.17.0" => "¡Seguid así! ¡Quiero seguir admirando
vuestra grandeza!",
  "1.0.18.0" => "¡Nadie puede enfrentarse a vuestro
inconmensurable poder!",
  "1.0.19.0" => "¡«Imparable» es un término que se
queda muy corto para definiros!",
  "1.0.20.0" => "¡Vuestra fuerza no conoce límites!",
  "1.0.21.0" => "¡Ese cuco es enorme!
Y al parecer muy poderoso...",
  "1.0.22.0" => "¡Está acabando con todos! ¿Crees que
podríamos hacer que se aliase con nosotros?",
  "1.0.23.0" => "¡Qué impertinentes!
Estoy rodeada de enemigos...",
  "1.0.24.0" => "¡No podemos enfrentarnos a tantos!",
  "1.0.25.0" => "Estamos rodeados, Link...
¡Será mejor que hagamos algo pronto!",
  "1.0.26.0" => "Ya no podemos hacer nada más aquí...",
  "1.0.27.0" => "Nos han cercado, Link...
¡Debemos huir antes de que sea tarde!",
  "1.0.28.0" => "¡Gracias por la ayuda!",
  "1.0.29.0" => "¡Nos han ayudado, Link! Ahora
toca devolver el favor.",
  "1.0.30.0" => "¡Aún quedan muchos enemigos!
¡A por ellos, mis leales!",
  "1.0.31.0" => "¡Vaya, nunca pensé que serías capaz
de acabar con tantos enemigos!",
  "1.0.32.0" => "¿Acaso te crees más poderoso que mi cuco?",
  "1.0.33.0" => "¡Adelante, compañeros!",
  "1.0.34.0" => "¡No podemos perder un segundo!
¡Luchemos hasta el final!",
  "1.0.35.0" => "¡No bajéis la guardia!",
  "1.0.36.0" => "¡Muy bien, Link!",
  "1.0.37.0" => "No importa cuántos enemigos vengan.
¡Los venceremos a todos!",
  "1.0.38.0" => "¡No dejan de venir, Link!
¡Ánimo y a luchar hasta el final!",
  "1.0.39.0" => "Venga, vamos a otro sitio a
ocuparnos de más enemigos, Link.",
  "1.0.40.0" => "¡Vaya, Link!
¡Has derrotado a un montón!",
  "1.0.41.0" => "¡No bajéis la guardia hasta que
hayamos vencido!",
  "1.0.42.0" => "No ha sido tan difícil...
¡Menuda decepción!",
  "1.0.43.0" => "Hay que ser muy ignorante para
atreverse a desafiar a Ganon.",
  "1.0.44.0" => "Los enemigos huyen despavoridos
ante semejante fuerza.",
  "1.0.45.0" => "¡Acabar con esos gusanos
ha sido tarea fácil para vos!",
  "1.0.46.0" => "Vuestro inconmensurable poder
me deja sin palabras.",
  "1.0.47.0" => "¡Qué porte, qué forma de luchar!
Vuestro poder me subyuga...",
  "1.0.48.0" => "¡Lo hemos conseguido!
Ha sido pan comido...",
  "1.0.49.0" => "¡Nos enfrentábamos a un gran número,
pero hemos logrado vencer!",
  "1.0.50.0" => "¡Esta batalla me ha enseñado
muchas cosas!",
  "1.0.51.0" => "¡Vaya, Link! ¡Has derrotado a un montón!",
  "1.0.52.0" => "¡Eres increíble, Link!",
  "1.0.53.0" => "¡Has estado genial, Link!
Gracias a mi apoyo, claro...",
}