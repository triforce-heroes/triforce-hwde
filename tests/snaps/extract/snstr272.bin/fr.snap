  "0.24.0" => "A0%1sF4R se dirige vers A0%2sF0R!",
  "0.25.0" => "Les conditions de victoire ont changé!",
  "0.26.0" => "Éliminez A0%1sF0R et A0%2sF0R!",
  "0.27.0" => "Les portes C2%1sF2R et C2%2sF2R sont ouvertes!",
  "0.28.0" => "A0%1sF5R se dirige vers A0%2sF0R!",
  "0.29.0" => "A0%1sF4R attaque A6la place de MercantîleR depuis les airs!",
  "0.30.0" => "Éliminez A0%1sF0R au plus vite!",
  "0.31.0" => "A0%1sF4R a fui le champ de bataille!",
  "0.32.0" => "A0%1sF4R a fui le champ de bataille!",
  "0.33.0" => "A0%1sF4R encourage A0%2sF1R!",
  "0.34.0" => "Éliminez A0%1sF0R!",
  "0.35.0" => "Vous avez vaincu A0%1sF0R!",
