  "0.35.0" => "¡A0%1sF0R está atacando en el desierto del norte!",
  "0.36.0" => "¡Tras descansar, A0%1sF2R se ha fortalecido aún más!",
  "0.37.0" => "¡A0%1sF0R ha atacado en el desierto del sur!",
  "0.38.0" => "¡Has derrotado A0%1sF4R!",
