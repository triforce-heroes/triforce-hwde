  "0.13.0" => "Il A2presidio roccioso estR è stato conquistato e la A6%1sF0R è aperta!",
  "0.14.0" => "Hai conquistato le aree C5%1sF1R e C5%2sF1R!",
  "0.15.0" => "A0%1sF0R è ora in campo davanti all'area C2%2sF4R!",
  "0.16.0" => "Le condizioni di vittoria sono cambiate!",
  "0.17.0" => "Sconfiggi A0%1sF2R!",
  "0.18.0" => "A0%1sF1R si mettono in marcia!",
  "0.19.0" => "Attenzione, A0%1sF2R non deve avvicinarsi all'area C1%2sF4R!",
  "0.20.0" => "A0%1sF0R si ritira temporaneamente nell'area C2%2sF4R!",
  "0.21.0" => "A0%1sF0R riappare davanti all'area C2%2sF4R!",
  "0.22.0" => "A0%1sF0R va verso l'area A0%2sF4R!",
  "0.23.0" => "L'A0%1sF1R va verso l'area A0%2sF4R!",
  "0.24.0" => "Aiuta A0%1sF2R nel suo piano e conquista l'area C2%2sF2R!",
  "0.25.0" => "Conquista immediatamente l'area C2%1sF2R!",
  "0.26.0" => "Proteggi A0%1sF2R!",
  "0.27.0" => "A0%1sF0R incoraggia l'A0%2sF5R, migliorandone il morale!",
  "0.28.0" => "Sconfiggi A0%1sF2R!",
  "0.29.0" => "Sono apparsi i rinforzi dell'A0%1sF1R!",
  "0.30.0" => "L'A0%1sF1R si demoralizza perché l'area A0%2sF4R è aperta!",
  "0.31.0" => "Tutti i A2presidi GoronR sono aperti!",
  "0.32.0" => "Un A1attacco di rocceR è cominciato sull'area C2%1sF6R!",
  "0.33.0" => "L'A1attacco di rocceR ha distrutto la A6%1sF0R!",
  "0.34.0" => "Il piano di A0%1sF2R ha fatto aprire l'area C2%2sF4R!",
  "0.35.0" => "A0%1sF0R si ritira temporaneamente nell'area C2%2sF6R!",
  "0.36.0" => "Tutta l'A0%1sF1R va verso l'area A0%2sF6R!",
  "0.37.0" => "A0%1sF0R va verso l'area C1%2sF6R!",
  "0.38.0" => "Non far avvicinare A0%2sF6R all'area C1%1sF6R!",
  "0.39.0" => "A0%1sF0R si avvicina all'area A0%2sF6R!",
  "0.40.0" => "Non far avvicinare la A2radiominaR all'area A0%1sF6R!",
  "0.41.0" => "A0%1sF0R entra nell'area A0%2sF6R!",
