  "0.10.0" => "Alcuni presidi dell'A0%1sF1R sono aperti!",
  "0.11.0" => "A0%1sF0R ora è più forte!",
  "0.12.0" => "A0%1sF0R ha perso e A0%2sF2R si indebolisce!",
  "0.13.0" => "Ora sconfiggi A0%1sF2R!",
  "0.14.0" => "Se sconfiggi A0%1sF3R, A0%2sF2R si indebolirà!",
  "0.15.0" => "A0%1sF0R avanza verso A0%2sF2R!",
  "0.16.0" => "A0%1sF0R diventa più forte!",
  "0.17.0" => "A0%1sF1R appaiono!",
  "0.18.0" => "A0%1sF0R si indebolisce dopo l'evocazione!",
  "0.19.0" => "A0%1sF0R ha evocato A0%2sF2R!",
  "0.20.0" => "A0%2sF1R hanno potenziato A0%1sF2R!",
  "0.21.0" => "Sconfiggi A0%1sF2R!",
  "0.22.0" => "A0%1sF0R, A0%2sF2R e A0%3sF2R avanzano!",
