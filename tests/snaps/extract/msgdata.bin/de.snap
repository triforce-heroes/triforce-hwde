  "5.9351.0" => "SK: Viele Items aus item_card.mstxt übernommen.",
  "5.9401.0" => "Bomben",
  "5.9402.0" => "Bogen",
  "5.9403.0" => "Bumerang",
  "5.9404.0" => "Fanghaken",
  "5.9405.0" => "Waffentasche",
  "5.9406.0" => "Versiegelte Waffe",
  "5.9407.0" => "Rubine",
  "5.9408.0" => "Herzcontainer",
  "5.9409.0" => "Herzteil",
  "5.9410.0" => "Goldener Rubin",
  "5.9411.0" => "Großer Schlüssel",
  "5.9412.0" => "Standardmaterial",
  "5.9413.0" => "Seltenes Material",
  "5.9414.0" => "Edelmaterial",
  "5.9415.0" => "Herzteil",
  "5.9416.0" => "Kostüm",
  "5.9417.0" => "Hammer",
  "5.9418.0" => "Okarina",
  "5.9419.0" => "Nahrung",
  "5.9420.0" => "Köstliche Nahrung",
  "5.9421.0" => "Erlesene Nahrung",
  "5.9422.0" => "Feenkleidung",
  "5.9423.0" => "Du hast die Bomben erhalten!
Wirf sie auf Gegner oder sprenge
Felsen mit ihnen!",
  "5.9424.0" => "Du hast den Bogen erhalten! Mit ihm kannst
du auch weiter entfernte Gegner angreifen!
Kleinere Gegner werden durchschlagen!",
  "5.9425.0" => "Du hast den Bumerang erhalten! Mit ihm kannst
du Gegner betäuben, und nach dem Werfen
kommt er selbstverständlich wieder zurück!",
  "5.9426.0" => "Du hast den Fanghaken erhalten! Krall dich
an Gegnern oder Vorsprüngen fest. So hast
du mehr Möglichkeiten, dich fortzubewegen!",
  "5.9427.0" => "Du hast eine Waffentasche erhalten!
Du kannst dir später ansehen,
was genau du da erbeutet hast!",
  "5.9428.0" => "Du hast eine versiegelte Waffe erhalten!
Vielleicht eine ganz neue Waffe?
Das erfährst du nach der Schlacht!",
  "5.9429.0" => "Du hast Rubine erhalten!
Verarmen wirst du nicht...
",
  "5.9430.0" => "Du hast einen Herzcontainer erhalten!
Deine Energieleiste erweitert sich um
ein Herz!",
  "5.9431.0" => "Du hast ein Herzteil erhalten!
Sammle vier, um deine Energieleiste
um ein Herz zu erweitern!",
  "5.9432.0" => "Du hast einen goldenen Rubin erhalten!
Und deine Nase sieht auch schon golden aus...",
  "5.9433.0" => "Du hast den Großen Schlüssel erhalten!
Der letzte Kampf erwartet dich...
",
  "5.9434.0" => "Du hast ein Standardmaterial erhalten!
Damit könntest du eine praktische
neue Medaille erschaffen!",
  "5.9435.0" => "Du hast ein seltenes Material erhalten!
Damit könntest du eine ziemlich
nützliche Medaille erschaffen!",
  "5.9436.0" => "Du hast ein Edelmaterial erhalten!
Damit könntest du eine ganz
besondere Medaille erschaffen!",
  "5.9437.0" => "Du hast ein Herzteil erhalten!
Das ist das vierte Herzteil, somit wird
deine Energieleiste um ein Herz erweitert!",
  "5.9438.0" => "Du hast ein neues Kostüm erhalten!
Du kannst dir später ansehen,
was genau du da erbeutet hast!",
  "5.9439.0" => "Du hast den Hammer erhalten!
Getroffene Gegner werden umgeworfen,
und du kannst mit ihm Schalter betätigen!",
  "5.9440.0" => "Du hast die Okarina erhalten!
Mit ihr kannst du zu Eulenstatuen
fliegen!",
  "5.9441.0" => "Du hast Nahrung erhalten!
Gib sie deinen Feen-Gefährten!",
  "5.9442.0" => "Du hast köstliche Nahrung erhalten!
Da werden sich deine Feen-Gefährten
freuen!",
  "5.9443.0" => "Du hast erlesene Nahrung erhalten!
Deine Feen-Gefährten werden
durchdrehen vor Freude!",
  "5.9444.0" => "Du hast Feenkleidung erhalten!
Du kannst dir später ansehen,
was genau du da erbeutet hast!",
  "5.9445.0" => "Mehr Rubine!",
