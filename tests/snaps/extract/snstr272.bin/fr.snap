Map {
  "0.0.0" => "Trouvez un moyen de détruire A6le gros rocherR!",
  "0.1.0" => "A0%1sF5R affronte A5un oiseau géantR!",
  "0.2.0" => "C2%1sF4R est sous votre contrôle!",
  "0.3.0" => "Trouvez A6le coffreR sur le chemin!",
  "0.4.0" => "Vous avez vaincu A0%1sF1R qui avançaient!",
  "0.5.0" => "A6L'allée cachée de MercantîleR est fermée!",
  "0.6.0" => "A6L'allée cachée de MercantîleR est ouverte!",
  "0.7.0" => "Une partie A0%1sF3R se dirige vers A6MercantîleR!",
  "0.8.0" => "L'attaque A0%1sF3R a provoqué la fuite A5de l'oiseau géantR!",
  "0.9.0" => "A5L'oiseau géantR est réapparu A6à l'île étoiléeR!",
  "0.10.0" => "A0%1sF4R quitte temporairement le champ de bataille!",
  "0.11.0" => "A0%1sF4R est réapparu A6au pas de chatR!",
  "0.12.0" => "A0%1sF4R est réapparu A6à la caverne du dragonR!",
  "0.13.0" => "A0%1sF4R est réapparu A6à l'île des féesR!",
  "0.14.0" => "A0%1sF4R est réapparu A6à l'île étoiléeR!",
  "0.15.0" => "Vous avez détruit A6un gros rocherR!",
  "0.16.0" => "A6Un gros rocherR a été détruit! Une partie A0%1sF3R avance!",
  "0.17.0" => "Vous avez détruit A6les gros rochersR!",
  "0.18.0" => "Les portes C2%1sF2R sont ouvertes!",
  "0.19.0" => "L'arrivée de renforts depuis C2%1sF0R a été stoppée!",
  "0.20.0" => "Prenez le contrôle A2des forts aux entrées de la forteresseR!",
  "0.21.0" => "A2Tous les forts aux entrées de la forteresseR sont sous votre contrôle!",
  "0.22.0" => "Les renforts venant A2des forts aux entrées de la forteresseR ont été arrêtés!",
