Map {
  "0.0.0" => "Raggiungi il A6villaggio dei demoniR!",
  "0.1.0" => "Le aree C2%1sF0R e C2%2sF0R sono aperte!",
  "0.2.0" => "L'A0%1sF1R avanza verso l'A0%2sF3R!",
  "0.3.0" => "L'A0%1sF1R ha conquistato l'area C2%2sF2R!",
  "0.4.0" => "Conquista le aree C2%1sF2R, C2%2sF2R e C2%3sF2R!",
  "0.6.0" => "L'A0%1sF7R ha conquistato l'area C2%2sF2R! Riconquistala!",
  "0.7.0" => "L'A6entrata est del villaggioR si è aperta!",
  "0.8.0" => "Conquista le aree C2%1sF2R e C2%2sF2R!",
  "0.9.0" => "Adesso conquista l'area C2%1sF2R!",
  "0.10.0" => "Hai conquistato tutti i presidi del A6villaggioR!",
  "0.11.0" => "A0%1sF0R ha raggiunto l'area C2%2sF6R!",
  "0.12.0" => "L'A6entrata del patiboloR è aperta!",
  "0.13.0" => "Raggiungi il A6patiboloR!",
  "0.14.0" => "Una A6prigioneR è stata scoperta!",
  "0.15.0" => "La A6%1sF0R si è aperta!",
  "0.16.0" => "A5Il Titanus MagnusR si è unito all'A0%1sF1R!",
  "0.17.0" => "A0%1sF0R è in campo!",
  "0.18.0" => "A0%1sF0R si dirige verso A0%2sF2R!",
  "0.19.0" => "Presto, sconfiggi A0%1sF3R!",
  "0.20.0" => "La sconfitta A0%3sF7R fa esaltare A0%1sF6R e A0%2sF6R!",
  "0.21.0" => "Hai sconfitto A0%1sF2R!",
  "0.22.0" => "A0%1sF0R e A0%2sF2R scendono in campo!",
  "0.23.0" => "L'area C2%1sF2R è stata conquistata e si è aperta!",
  "0.24.0" => "Le condizioni di vittoria sono cambiate!",
  "0.25.0" => "Tutti i A2mostri gigantiR perdono!",
  "0.26.0" => "A0%1sF0R incontra A0%2sF2R e il suo morale è migliorato!",
  "0.27.0" => "A0%1sF0R incontra A0%2sF2R ed è più forte!",
  "0.28.0" => "A0%1sF0R ha perso!",
  "0.29.0" => "Adesso sconfiggi A0%1sF2R e A0%2sF2R!",
  "0.30.0" => "Tutti i A2mostri gigantiR sono stati sconfitti!",
  "0.31.0" => "A0%1sF0R è in pericolo!",
  "0.32.0" => "A0%1sF0R è in fuga!",
  "0.33.0" => "Il morale dell'A0%1sF1R migliora dopo la fuga di A0%2sF6R!",
  "0.34.0" => "L'A0%1sF1R è più forte dopo la fuga di A0%2sF2R!",
  "0.35.0" => "L'A0%1sF1R ha vinto la battaglia!",
  "0.36.0" => "L'A0%1sF1R ha perso la battaglia!",
  "0.37.0" => "L'A0%1sF1R ha conquistato l'area C1%2sF2R!",
  "0.38.0" => "Adesso sconfiggi A0%1sF2R!",
  "0.39.0" => "Adesso conquista le aree C2%1sF2R e C2%2sF2R!",
  "0.40.0" => "Un'A6AracnulaR è stata avvistata sul campo di battaglia!",
  "0.41.0" => "Cerca l'A6AracnulaR!",
  "0.42.0" => "Hai ottenuto l'A6AracnulaR!",
  "0.43.0" => "L'A6AracnulaR sta per fuggire!",
  "0.44.0" => "L'A6AracnulaR è fuggita!",
  "0.45.0" => "A0%1sF0R ha percepito una battaglia e si mette in marcia!",
  "0.46.0" => "Sconfiggi i A2mostri gigantiR prima che si riuniscano!",
  "0.47.0" => "Le A6entrate del villaggioR si sono chiuse!",
  "0.48.0" => "Libera i A5demoniR dalla A6prigioneR!",
  "0.49.0" => "L'A6entrata del patiboloR è chiusa!",
  "0.50.0" => "L'A6entrata del patiboloR è aperta!",
  "0.51.0" => "Sono apparsi dei A2demoniR che si nascondevano nel A6patiboloR!",
  "0.52.0" => "A0%1sF0R percepisce una battaglia e lancia un A2attacco di semiR!",
  "0.53.0" => "Attenzione, i A2mostri gigantiR non devono unirsi!",
  "0.54.0" => "A0%1sF0R ha raggiunto A0%2sF2R!",
  "0.55.0" => "A0%1sF0R e A0%2sF2R si proteggono a vicenda, potenziandosi!",
  "0.56.0" => "A0%1sF0R ha evocato A2demoniR nel A6villaggioR!",
  "0.57.0" => "Presto, conquista A63 presidiR!",
  "0.58.0" => "A0%1sF0R ha evocato altri A2demoniR!",
  "0.59.0" => "A0%1sF1R vanno dal A6deserto nordR a quello A6sudR!",
  "0.60.0" => "A0%1sF1R non hanno invaso il A6deserto sudR!",
  "0.61.0" => "A0%1sF1R hanno invaso il A6deserto sudR!",
  "0.62.0" => "L'A0%1sF5R raggiunge altre truppe e il morale è migliorato!",
  "0.63.0" => "Hai conquistato A63 presidiR!",
  "0.64.0" => "A0%1sF1R appaiono A6alle prigioniR!",
  "0.65.0" => "A0%1sF1R si preparano ad aprire le A6prigioniR!",
  "0.66.0" => "Hai sconfitto A0%1sF3R!",
  "0.67.0" => "A0%1sF1R hanno aperto le A6prigioniR!",
  "0.68.0" => "I demoni delle A6prigioniR si alleano con l'A0%1sF7R!",
  "0.69.0" => "Sconfiggi A0%1sF2R!",
  "0.70.0" => "A0%1sF0R percepisce la battaglia e avanza!",
  "0.71.0" => "L'A0%1sF5R si esalta e va verso l'A0%2sF7R!",
  "0.72.0" => "A0%1sF0R ha perso! La sua armata si ritira!",
  "0.73.0" => "Le aree C2%1sF0R, C2%2sF0R e C2%3sF0R sono aperte!",
  "0.74.0" => "Ora puoi controllare A0%1sF2R!",
  "0.75.0" => "L'A0%2sF5R ha fatto fuggire A0%1sF2R!",
  "0.76.0" => "A0%1sF0R appare e va verso l'area C2%2sF6R!",
  "0.77.0" => "Hai conquistato l'area C2%1sF4R!",
  "0.78.0" => "Nell'area A0%1sF6R si nasconde un tesoro!",
  "0.79.0" => "Raggiungi A0%1sF2R!",
  "0.80.0" => "Hai sconfitto A0%1sF2R!",
