Map {
  "0.0.0" => "Dirigez-vous vers A6le village des monstresR!",
  "0.1.0" => "Les portes C2%1sF2R et C2%2sF2R sont ouvertes!",
  "0.2.0" => "A0%1sF5R se dirige vers A0%2sF1R!",
  "0.3.0" => "A0%1sF5R a pris le contrôle C2%2sF2R!",
  "0.4.0" => "Prenez le contrôle C2%1sF2R, C2%2sF2R et C2%3sF2R!",
  "0.6.0" => "C2%2sF4R est sous le contrôle A0%1sF3R! Reprenez-le!",
  "0.7.0" => "A6Les portes est de l'entrée du villageR sont ouvertes!",
  "0.8.0" => "Prenez le contrôle C2%1sF2R et C2%2sF2R!",
  "0.9.0" => "Prenez le contrôle C2%1sF2R à présent!",
  "0.10.0" => "Vous avez pris le contrôle de tous les forts A6du villageR!",
  "0.11.0" => "A0%1sF4R a atteint C2%2sF0R!",
  "0.12.0" => "Les portes A6de l'entrée de la tour du JugementR sont ouvertes!",
  "0.13.0" => "Rendez-vous A6à la tour du JugementR!",
  "0.14.0" => "A6Une prisonR a été repérée!",
  "0.15.0" => "A6%1sF4R est ouverte!",
  "0.16.0" => "A5Un darknutR a rejoint A0%1sF1R!",
  "0.17.0" => "A0%1sF4R a rejoint le champ de bataille!",
  "0.18.0" => "A0%1sF4R se dirige vers A0%2sF0R!",
  "0.19.0" => "Éliminez A0%1sF1R au plus vite!",
  "0.20.0" => "La défaite A2desR A0%3sF7R remonte le moral A0%1sF3R et A0%2sF3R!",
  "0.21.0" => "Vous avez vaincu A0%1sF2R!",
  "0.22.0" => "A0%1sF4R et A0%2sF0R ont rejoint le champ de bataille!",
  "0.23.0" => "C2%1sF4R est sous votre contrôle! Ses portes sont ouvertes!",
  "0.24.0" => "Les conditions de victoire ont changé!",
  "0.25.0" => "Éliminez A2tous les monstres géantsR pour remporter la victoire!",
  "0.26.0" => "L'arrivée A0%2sF3R remonte le moral A0%1sF3R!",
  "0.27.0" => "L'arrivée A0%2sF3R rend A0%1sF0R plus puissant!",
  "0.28.0" => "Vous avez vaincu A0%1sF0R!",
  "0.29.0" => "Éliminez A0%1sF0R et A0%2sF0R à présent!",
  "0.30.0" => "A2Tous les monstres géantsR ont été vaincus!",
  "0.31.0" => "A0%1sF4R est en grand danger!",
  "0.32.0" => "A0%1sF4R a fui le champ de bataille!",
  "0.33.0" => "La fuite A0%2sF3R remonte le moral A0%1sF3R!",
  "0.34.0" => "La fuite A0%2sF3R rend A0%1sF1R plus puissante!",
  "0.35.0" => "A0%1sF5R a gagné la bataille!",
  "0.36.0" => "A0%1sF5R a été vaincue!",
  "0.37.0" => "A0%1sF5R a pris le contrôle C1%2sF2R!",
  "0.38.0" => "Éliminez A0%1sF0R à présent!",
  "0.39.0" => "Prenez le contrôle C2%1sF2R et C2%2sF2R à présent!",
  "0.40.0" => "A6Une skulltulaR est apparue sur le champ de bataille!",
  "0.41.0" => "Trouvez A6la skulltulaR!",
  "0.42.0" => "Vous avez obtenu A6une skulltulaR!",
  "0.43.0" => "A6La skulltulaR est sur le point de s'enfuir!",
  "0.44.0" => "A6La skulltulaR s'est enfuie!",
  "0.45.0" => "A0%1sF4R a senti un combat et avance!",
  "0.46.0" => "Éliminez A2tous les monstres géantsR avant qu'ils ne se rejoignent!",
  "0.47.0" => "A6Les portes de l'entrée du villageR sont fermées!",
  "0.48.0" => "Libérez A5les monstres emprisonnésR!",
  "0.49.0" => "Les portes A6de la tour du JugementR sont fermées!",
  "0.50.0" => "Les portes A6de la tour du JugementR sont ouvertes!",
  "0.51.0" => "A2Des monstresR cachés dans A6la tour du JugementR sont apparus!",
  "0.52.0" => "A0%1sF4R a senti un combat et lance A2un bombardement de grainesR!",
  "0.53.0" => "Essayez d'empêcher A2les monstres géantsR de se rejoindre!",
  "0.54.0" => "A0%1sF4R et A0%2sF0R se sont rejoints!",
  "0.55.0" => "A0%1sF4R et A0%2sF0R se protègent l'un l'autre et deviennent plus puissants!",
  "0.56.0" => "A0%1sF4R rassemble A2les monstresR A6dans le villageR!",
  "0.57.0" => "Prenez le contrôle A2des trois fortsR au plus vite!",
  "0.58.0" => "A0%1sF4R a rassemblé davantage A2de monstresR!",
  "0.59.0" => "A0%1sF5R du A6nord du désertR se dirigent vers A6le sud du désertR!",
  "0.60.0" => "Vous avez empêché A0%1sF0R d'atteindre A6le sud du désertR!",
  "0.61.0" => "A0%1sF5R ont pénétré A6le sud du désertR!",
  "0.62.0" => "La réunification des troupes remonte le moral d'une partie A0%1sF3R!",
  "0.63.0" => "A6Les trois fortsR sont sous votre contrôle!",
  "0.64.0" => "A0%1sF5R ont rejoint le champ de bataille A6devant les prisonsR!",
  "0.65.0" => "A0%1sF5R se préparent à ouvrir les portes A6des prisonsR!",
  "0.66.0" => "Vous avez vaincu la totalité A2desR A0%1sF7R!",
  "0.67.0" => "A0%1sF5R ont ouvert les portes A6des prisonsR!",
  "0.68.0" => "Les monstres A6des prisonsR se sont alliés à A0%1sF1R!",
  "0.69.0" => "Éliminez A0%1sF0R!",
  "0.70.0" => "A0%1sF4R a senti un combat et se met en marche!",
  "0.71.0" => "Le moral d'une partie A0%1sF3R remonte! Elle se dirige vers A0%2sF1R!",
  "0.72.0" => "La défaite A0%1sF3R a provoqué la retraite d'une partie des troupes!",
  "0.73.0" => "C2%1sF4R, C2%2sF0R et C2%3sF0R sont ouverts!",
  "0.74.0" => "Vous pouvez à présent jouer avec A0%1sF0R!",
  "0.75.0" => "A0%2sF5R a provoqué la fuite A0%1sF3R!",
  "0.76.0" => "A0%1sF6R a rejoint le champ de bataille et se dirige vers C2%2sF0R!",
  "0.77.0" => "C2%1sF4R est sous votre contrôle!",
  "0.78.0" => "Un coffre se cache peut-être dans A0%1sF0R!",
  "0.79.0" => "Rassemblez les guerriers près A0%1sF3R!",
  "0.80.0" => "Vous avez vaincu A0%1sF0R!",
