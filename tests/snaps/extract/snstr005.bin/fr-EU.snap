  "0.12.0" => "Vous avez pris le contrôle C2%1sF2R !",
  "0.13.0" => "A0%1sF4R quitte provisoirement le champ de bataille pour chercher le miroir de vérité !",
  "0.14.0" => "A0%1sF4R avance vers A6le temple de l'eauR !",
  "0.15.0" => "A0%1sF4R rejoint le champ de bataille depuis C5%2sF0R !",
  "0.17.0" => "A0%1sF5R commence à chercher le miroir de vérité !",
  "0.18.0" => "A0%1sF5R a trouvé le miroir de vérité dans C5%2sF0R !",
  "0.19.0" => "La ruse de A0%2sF0R a causé la fermeture des portes C5%1sF2R !",
  "0.21.0" => "Prenez la A6salle de contrôle des éclusesR et ouvrez toutes les écluses !",
  "0.22.0" => "A0%1sF4R avance vers l'A6est du templeR !",
  "0.23.0" => "Aidez A0%1sF0R !",
