  "0.17.0" => "A0%2sF0R ist geflohen! Ein Teil der A0%1sF1R ist stärker geworden!",
  "0.18.0" => "A0%1sF0R stärkt den Magiekreis A0%2sF2R!",
  "0.19.0" => "Besiege A0%1sF6R, bevor die Magie aufgeladen ist!",
  "0.20.0" => "A0%1sF0R muss schnell besiegt werden!",
  "0.21.0" => "Besiege schnellstmöglich A0%1sF6R!",
