Map {
  "0.0.0" => "L'A0%1sF1R ha perso la battaglia!",
  "0.1.0" => "La A1base alleataR si è arresa! Hai perso!",
  "0.2.0" => "I A2presidi nemiciR e i A5presidi esterniR sono indeboliti!",
  "0.3.0" => "A0%1sF1R vanno verso i A2presidiR dell'A0%2sF1R!",
  "0.4.0" => "L'A0%1sF1R va verso i A2presidiR dell'A0%2sF1R!",
  "0.5.0" => "Attenzione, A0%1sF3R stanno avanzando!",
  "0.6.0" => "A0%1sF0R ha perso! La sua armata si ritira!",
  "0.7.0" => "A0%1sF0R appare di nuovo!",
  "0.8.0" => "A0%1sF0R appare e si dirige verso un A6presidioR!",
  "0.9.0" => "Parte dell'A0%1sF1R avanza verso A0%2sF2R!",
  "0.10.0" => "Parte dell'A0%1sF1R va verso la A1base alleataR!",
  "0.11.0" => "Parte dell'A0%1sF1R avanza per riconquistare i A6presidiR!",
  "0.12.0" => "A0%1sF1R appaiono e avanzano per riconquistare i A6presidiR!",
  "0.13.0" => "A0%1sF0R appare sul campo di battaglia!",
  "0.14.0" => "A0%1sF0R si prepara a evocare A0%2sF6R!",
  "0.15.0" => "Presto, sconfiggi A0%1sF2R!",
  "0.16.0" => "A0%1sF0R ha evocato A0%2sF2R!",
  "0.17.0" => "A0%1sF0R si prepara a evocare ancora A0%2sF6R!",
  "0.18.0" => "A0%1sF0R ha evocato A0%2sF7R e si ritira!",
  "0.19.0" => "Hai sconfitto A0%1sF2R!",
  "0.20.0" => "Hai fermato l'incoraggiamento!",
  "0.21.0" => "A0%1sF1R abbandonano il fronte!",
  "0.22.0" => "A0%1sF0R abbandona il fronte!",
  "0.23.0" => "Hai messo al sicuro sei A6presidiR!",
  "0.24.0" => "All'A0%1sF1R manca un presidio per raggiungere l'obiettivo!",
  "0.25.0" => "All'A0%1sF1R manca un presidio per raggiungere l'obiettivo!",
  "0.26.0" => "Le condizioni di sconfitta sono cambiate!",
  "0.27.0" => "A0%1sF0R perde o l'area A0%2sF4R cade!",
  "0.28.0" => "A0%1sF1R e A0%2sF3R perdono e si demoralizzano!",
  "0.29.0" => "A0%1sF1R restanti si demoralizzano perché l'A0%2sF1R è in vantaggio!",
  "0.30.0" => "L'area A0%1sF0R si è aperta!",
  "0.31.0" => "A0%1sF0R si comporta in modo sospetto! Vai all'attacco!",
  "0.32.0" => "A0%2sF0R ha aiutato A0%1sF3R migliorandone il morale!",
  "0.33.0" => "A0%1sF0R ha finito di incoraggiare A0%2sF3R e se ne va!",
  "0.34.0" => "Rapporto intermedio sulla gara di conquista dei A6presidiR!",
  "0.35.0" => "L'A0%1sF1R è in vantaggio!",
  "0.36.0" => "L'A0%1sF1R è in svantaggio!",
  "0.37.0" => "L'A0%1sF5R e l'A0%2sF1R sono in parità!",
  "0.38.0" => "A0%1sF0R appare e va alla conquista di un A1presidio alleatoR!",
  "0.39.0" => "A0%1sF0R attacca un A1presidio alleatoR!",
  "0.40.0" => "Non far cadere i A1presidi alleatiR!",
  "0.41.0" => "Non hai conquistato sei A6presidiR!",
  "0.42.0" => "L'area A0%1sF0R è sotto attacco!",
