Map {
  "0.0.0" => "A0%1sF4R représente une menace ! Débarrassez-vous-en immédiatement !",
  "0.1.0" => "Vous avez approché A0%1sF0R !",
  "0.2.0" => "A0%1sF4R se A1joint à vousR !",
  "0.3.0" => "A0%1sF4R encourage l'A2armée ennemieR et la rend plus puissante !",
  "0.4.0" => "Vous n'avez pas choisi A0%1sF0R, qui se retourne contre vous !",
  "0.5.0" => "A0%1sF4R invoque A0%2sF3R !",
  "0.6.0" => "Les conditions de défaite ont changé !",
  "0.7.0" => "Ne pas laisser A0%1sF0R fuir !",
  "0.8.0" => "Vous avez vaincu la totalité A0%1sF3R !",
  "0.9.0" => "L'A2armée ennemieR quitte le champ de bataille !",
  "0.10.0" => "A0%1sF4R bat temporairement en retraite !",
  "0.11.0" => "A0%1sF4R quitte temporairement le champ de bataille !",
  "0.12.0" => "Vous avez fait échouer la stratégie de l'A2ennemiR !",
  "0.13.0" => "A0%1sF4R et A0%2sF0R rejoignent le champ de bataille !",
  "0.14.0" => "Les deux forces semblent s'affronter !",
  "0.15.0" => "Vous avez vaincu A0%1sF0R !",
  "0.16.0" => "Les forces obéissant à A0%1sF0R se A1joignent à vousR !",
  "0.17.0" => "A0%1sF4R et A0%2sF0R reviennent sur le champ de bataille !",
  "0.18.0" => "A0%1sF4R invoque un A2monstre géantR et de nombreuses A2troupes ennemiesR !",
  "0.19.0" => "A0%1sF4R invoque des A2monstres géantsR et de nombreuses A2troupes ennemiesR !",
  "0.20.0" => "Vous avez vaincu les deux A2chefsR !",
  "0.21.0" => "Vous avez vaincu tous les A2chefsR et le A2monstre géantR !",
  "0.22.0" => "Ne pas laisser A0%1sF0R ou A0%2sF0R fuir !",
  "0.23.0" => "A0%1sF4R reprend du poil de la bête pour A1vousR soutenir !",
  "0.24.0" => "La hausse de moral est terminée pour A0%1sF0R !",
  "0.25.0" => "A0%1sF4R place des A6bouteilles de magieR pour A1vousR soutenir !",
  "0.26.0" => "A0%1sF4R place des A6fragments de forceR pour A1vousR soutenir !",
  "0.27.0" => "Le temps est écoulé. Vous avez perdu !",
  "0.28.0" => "A0%1sF4R a fui. Vous avez perdu !",
  "0.29.0" => "A0%1sF4R est K.-O. !",
  "0.30.0" => "L'A5armée ennemieR quitte le champ de bataille !",
  "0.31.0" => "A0%1sF4R place d'autres A6bouteilles de magieR pour A1vousR soutenir !",
  "0.32.0" => "A0%1sF4R place d'autres A6fragments de forceR pour A1vousR soutenir !",
  "0.33.0" => "Votre alliance vous fait bénéficier de divers effets !",
  "0.34.0" => "A0%1sF4R se prépare pour son invocation ! Débarrassez-vous-en au plus vite !",
  "0.35.0" => "A0%1sF4R invoque des A2troupes ennemiesR !",
