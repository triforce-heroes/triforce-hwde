Map {
  "0.0.0" => "¡A0%1sF3R se disponen a invocar refuerzos!",
  "0.1.0" => "¡A0%1sF0R se dirige hacia A0%2sF2R!",
  "0.2.0" => "¡Rescata A0%1sF4R, que está en peligro!",
  "0.3.0" => "¡Rescata A0%1sF4R, que está en grave peligro!",
  "0.4.0" => "¡Has derrotado A0%1sF5R!",
  "0.5.0" => "¡Ya puedes jugar como A0%1sF2R!",
  "0.6.0" => "¡A0%1sF3R van hacia A0%2sF2R!",
  "0.7.0" => "¡A0%1sF0R está en peligro! ¡Necesita ayuda inmediata!",
  "0.8.0" => "¡A0%1sF0R está en grave peligro! ¡Necesita ayuda urgente!",
  "0.9.0" => "¡Has vencido A0%1sF4R!",
  "0.10.0" => "¡A0%1sF0R ha invocado aliados para ayudar A0%2sF4R!",
  "0.11.0" => "¡Ha aparecido una horda de A0%1sF1R!",
  "0.12.0" => "¡A0%1sF3R han invocado A0%2sF1R!",
  "0.13.0" => "¡A0%1sF3R se disponen a invocar!",
  "0.14.0" => "¡No pierdas de vista A0%1sF4R!",
  "0.15.0" => "¡A0%1sF3R no tienen magia y no han podido invocar!",
  "0.16.0" => "¡A0%2sF3R han abierto los bastiones de las A0%1sF1R!",
  "0.17.0" => "¡Han aparecido A0%1sF1R y están llamando A0%2sF5R!",
  "0.18.0" => "¡A0%1sF3R se dirigen A0%2sF5R!",
  "0.19.0" => "¡Vence A0%1sF5R cuanto antes!",
  "0.20.0" => "¡La moral A0%1sF6R y sus A2tropasR ha aumentado!",
  "0.21.0" => "¡A0%1sF0R y sus A2tropasR se dirigen A0%2sF4R!",
  "0.22.0" => "¡Impide que A0%1sF2R caiga!",
  "0.23.0" => "¡Han aparecido más A0%1sF1R, que solicitan refuerzos!",
  "0.24.0" => "¡A0%1sF3R se disponen a reunirse debajo A0%2sF6R!",
  "0.25.0" => "¡A0%1sF0R ha aparecido en el campo de batalla!",
  "0.26.0" => "¡A0%1sF0R avanza en busca de comida!",
  "0.27.0" => "¡Vence A0%1sF5R cuanto antes!",
  "0.28.0" => "¡Has vencido A0%1sF5R!",
  "0.29.0" => "¡A0%1sF0R y sus A2tropasR se dirigen A0%2sF4R!",
  "0.30.0" => "¡A0%2sF0R ha cerrado A0%1sF2R!",
  "0.31.0" => "¡Has vencido A0%1sF5R!",
  "0.32.0" => "¡Una horda de monstruos ha aparecido cerca A0%1sF6R!",
  "0.33.0" => "¡Rescata A0%1sF4R cuanto antes!",
  "0.34.0" => "¡Has escoltado A0%1sF4R!",
  "0.35.0" => "¡A0%1sF0R ha comido y se ha convertido en un cuco dorado!",
  "0.36.0" => "¡Las A6entradas del temploR se han abierto!",
  "0.37.0" => "¡A0%1sF0R se dirige hacia A0%2sF2R!",
  "0.38.0" => "¡A0%1sF0R está llamando A0%2sF4R!",
  "0.39.0" => "¡A0%1sF0R se ha reforzado absorbiendo poder mágico!",
  "0.40.0" => "¡A0%1sF0R se ha reforzado absorbiendo más poder mágico!",
  "0.41.0" => "¡A0%1sF0R ha perdido poder mágico y se ha debilitado!",
  "0.42.0" => "¡Has vencido A0%1sF4R!",
  "0.43.0" => "¡A0%1sF3R que quedaban han desaparecido!",
  "0.44.0" => "¡A0%1sF0R se ha retirado!",
  "0.45.0" => "¡Las A0%2sF1R han hecho huir A0%1sF4R!",
  "0.46.0" => "¡Las A0%1sF1R han sido derrotadas!",
  "0.47.0" => "¡Las A0%2sF1R han conquistado C1%1sF2R!",
  "0.48.0" => "¡A0%1sF0R se ha abierto!",
  "0.49.0" => "¡Has conquistado C2%1sF2R!",
  "0.50.0" => "¡A0%1sF0R ha huido!",
  "0.51.0" => "¡Ha aparecido una A6skulltulaR en el campo de batalla!",
  "0.52.0" => "¡La A6skulltulaR ha huido!",
  "0.53.0" => "¡A0%1sF0R está luchando contra A0%2sF2R!",
  "0.54.0" => "¡A0%1sF0R ha absorbido poder mágico A0%2sF7R!",
  "0.55.0" => "¡Has derrotado A0%1sF4R!",
  "0.56.0" => "¡A0%1sF0R y sus A2tropasR se dirigen hacia A0%2sF2R!",
  "0.57.0" => "¡A0%1sF0R se dirige hacia las A0%2sF1R!",
  "0.58.0" => "¡Vence A0%1sF5R y debilita A0%2sF4R!",
  "0.59.0" => "¡A0%2sF3R y A0%1sF2R se dirigen A0%3sF4R!",
