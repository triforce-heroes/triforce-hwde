Map {
  "1.0.0.0" => "Les monstres nous attaquent! À l'aide!",
  "1.0.1.0" => "Cya, laisse cette fée tranquille!
Elle n'a rien fait de mal!",
  "1.0.2.0" => "J'aurais dû me douter que tu serais là pour protéger
les fées, Lana. Mais tu n'y changeras rien, alors disparais.",
  "1.0.3.0" => "Nous ne sommes pas assez forts pour arrêter Cya.
Allons demander de l'aide au château d'Hyrule!",
  "1.0.4.0" => "Il est encore trop tôt pour affronter l'armée d'Hyrule...
Rattrapez-les avant qu'ils n'appellent du renfort!",
  "1.0.5.0" => "On s'en charge!
Comptez sur nous!",
  "1.0.6.0" => "Soldats! Prenez ces forts et
enfoncez leurs portes!",
  "1.0.7.0" => "Qu'est-ce qu'on va faire?!
Il y a des monstres partout!",
  "1.0.8.0" => "Va te cacher avec les autres fées!
Je vais m'occuper d'eux!",
  "1.0.9.0" => "Vous tous, au nord, c'est le moment, dépêchez-vous!",
  "1.0.10.0" => "Cya... Je t'arrêterai coûte que coûte!",
  "1.0.11.0" => "Ne les laissez surtout pas s'enfuir!",
  "1.0.12.0" => "Ils nous ont échappé... L'arrivée de l'armée
d'Hyrule n'est plus qu'une question de temps.",
  "1.0.13.0" => "Ha ha... Vous ne m'échapperez pas!",
  "1.0.14.0" => "Cela suffit. Vous avez fait du bon travail.",
  "1.0.15.0" => "Grrr... La majorité d'entre eux a réussi à s'enfuir...",
  "1.0.16.0" => "Comment? Vous n'avez pas réussi à éliminer une
seule fée? Vous n'êtes des monstres que de nom!",
  "1.0.17.0" => "Ils ont réussi! L'armée d'Hyrule va venir nous prêter
main forte! Il faut qu'on tienne encore un peu!",
  "1.0.18.0" => "Tsss. Fées... Humains... Quelle différence?
Je les exterminerai tous autant qu'ils sont!",
  "1.0.19.0" => "D'où viennent tous ces monstres? Et comment
ont-ils pu arriver aussi vite?",
  "1.0.20.0" => "Voilà la princesse! La chasse aux fées
est terminée! Éliminez-la!",
  "1.0.21.0" => "Soldats, en avant! Pour Hyrule!",
  "1.0.22.0" => "Comme c'est attendrissant! Les innocentes brebis
ont décidé de se rebeller contre les loups!",
  "1.0.23.0" => "Hum. Mes soldats ne pourront repousser une
telle armée seuls. J'y vais aussi!",
  "1.0.24.0" => "Tiens, voilà leur commandant qui arrive! Éliminons-la
pour faire sortir la princesse de sa cachette!",
  "1.0.25.0" => "Malédiction... Je n'ai pas été à la hauteur.
Votre Altesse! Je dois battre en retraite!",
  "1.0.26.0" => "Si même le commandant Impa a dû fuir, quelle
chance avons-nous de remporter la victoire?",
  "1.0.27.0" => "Les fées sont en sécurité à présent... Espérons que
l'armée d'Hyrule réussisse à repousser nos ennemis.",
  "1.0.28.0" => "Peuh! Ces soldats font beaucoup de bruit pour rien.
Je vous les laisse, amusez-vous bien... si c'est possible...",
  "1.0.29.0" => "J'y vais moi aussi! Je ne permettrai pas
que l'on menace la paix d'Hyrule!",
  "1.0.30.0" => "La princesse Zelda est sur le champ de bataille.
Nous devons la protéger à tout prix!",
  "1.0.31.0" => "...",
  "1.0.32.0" => "Qu'est-ce que tu fais là, jeune recrue?! C'est
trop dangereux, retourne au château... Hé!",
  "1.0.33.0" => "La princesse! Et on dirait qu'elle sait tenir sa lame.
Parfait, je vais mettre sa détermination à l'épreuve!",
  "1.0.34.0" => "Soldats d'Hyrule! Je cherche un vaillant adversaire!
Que ceux qui savent se battre viennent m'affronter!",
  "1.0.35.0" => "Ce chevalier est différent des autres...
Restez sur vos gardes!",
  "1.0.36.0" => "Halte-là! Persssonne ne passse!",
  "1.0.37.0" => "Ressstez sssur vos gardes! 
Elle est coriassse!",
  "1.0.38.0" => "Ce garçon est impressionnant! 
Serait-il...",
  "1.0.39.0" => "Nous ne devons pas baisser les bras!",
  "1.0.40.0" => "Princesse Zelda! C'est un honneur
de nous battre à vos côtés!",
  "1.0.41.0" => "Ensemble, nous préserverons la paix en Hyrule!",
  "1.0.42.0" => "Oui! Nous sommes les seuls à pouvoir protéger Hyrule!",
  "1.0.43.0" => "Continuons à nous battre! Nous ne pouvons
pas nous permettre de baisser les bras!",
  "1.0.44.0" => "Si la princesse Zelda se bat jusqu'au bout, 
nous nous battrons de toutes nos forces!",
  "1.0.45.0" => "...!",
  "1.0.46.0" => "Non! Il semble que nous devions battre en retraite...
Mais nous reviendrons!",
  "1.0.47.0" => "Ils se sont réfugiés dans le château sans nous y convier?
Allons punir cet affront comme il se doit! Gya ha ha!",
  "1.0.48.0" => "J'aurais dû les prendre plus au sérieux...
Je n'ai pas le choix, je me retire.",
  "1.0.49.0" => "Tsss... Il semble que je les aie sous-estimés...",
  "1.0.50.0" => "Ça ne peut pas finir comme ça...",
  "1.0.51.0" => "Ils nous ont échappé!",
  "1.0.52.0" => "Que faire?! Les monstres attaquent
sans relâche!",
  "1.0.53.0" => "Argh... Nous n'avons pas encore perdu.
Rassemblez les troupes et lancez une contre-attaque!",
  "1.0.54.0" => "Aux armes! Que tous ceux qui peuvent encore
combattre se rassemblent immédiatement!",
  "1.0.55.0" => "On a un problème! Dépêchez-vous!",
  "1.0.56.0" => "On dirait que notre plan a marché.
À mon tour maintenant.",
  "1.0.57.0" => "Nous sommes en route nous aussi!
Cette base ne fera pas long feu!",
  "1.0.58.0" => "Comment avons-nous pu nous laisser
vaincre par de si pitoyables adversaires?",
  "1.0.59.0" => "Notre plan n'a pas pas marché, mais
nous ne pouvons pas nous arrêter maintenant!",
  "1.0.60.0" => "Commandant Impa! Nooon!
Sans notre chef, nous sommes perdus!",
  "13.0.0.0" => "Hya ha ha! Prenez ces forts et
enfoncez leurs portes!",
  "13.0.1.0" => "Mais qu'est-ce que vous faites, sombres idiots?!
Ne les laissez pas s'enfuir!",
  "13.0.2.0" => "Ils vous ont échappé?! Imbéciles!
Vous n'êtes que des incapables!",
  "13.0.3.0" => "Vous venez au renfort de nos fuyards?
Votre bon cœur me dégoûte...",
  "13.0.4.0" => "Une princesse qui quitte son château pour se battre aux
côtés du bas peuple? Je vais lui faire regretter cette erreur!",
  "13.0.5.0" => "Je vais prendre le château... et la vie de la
princesse par la même occasion! Hya ha ha!",
  "13.0.6.0" => "Ce mage a l'air extrêmement dangereux!
Restez tous sur vos gardes!",
  "13.0.7.0" => "Comment? Notre base est tombée?
Bande de sales incapables... Battez en retraite!",
  "13.0.8.0" => "Hmpf, quand il s'agit de fuir, là, ils sont rapides.",
  "13.0.9.0" => "Attention! Il ne faut pas laisser ce chevalier
dragon aller plus loin!",
  "13.0.10.0" => "Votre Altesse! Veuillez me pardonner.
Je me suis jetée dans la gueule du loup...",
  "13.0.11.0" => "Nous devrions être en mesure de les repousser.
En avant! Il n'y a pas une minute à perdre!",
  "13.0.12.0" => "Madame Impa! Vous allez bien?",
  "13.0.13.0" => "Comment? Tu n'es qu'une nouvelle recrue?!",
  "13.0.14.0" => "Votre Altesse! Nous devons prendre le fort est et
le fort central et verrouiller leurs portes nord!",
  "13.0.15.0" => "Je vais préparer un plan d'attaque. Votre Altesse,
veuillez ordonner la prise des forts!",
  "13.0.16.0" => "L'armée ennemie a pu être contenue au nord!
Il faut obtenir l'aide de la grande fée à présent.",
  "13.0.17.0" => "Si notre plan fonctionne, nous leur infligerons
de lourdes pertes! Vite, à la fontaine!",
  "13.0.18.0" => "Si nous avions des bombes, nous pourrions
briser les portes de la fontaine de la Déesse...",
  "13.0.19.0" => "Par ici! Vite! Détruisons les portes et
entrons dans la fontaine!",
  "13.0.20.0" => "Soyez tous très prudents! L'ennemi
nous attaque depuis le nord!",
  "13.0.21.0" => "Comment? L'ennemi a pris le contrôle
du fort est de la plaine?",
  "13.0.22.0" => "Par ici! Prions la grande fée tous ensemble!",
  "13.0.23.0" => "Nous avons réussi, Votre Altesse! Les troupes
ennemies ont été considérablement réduites!",
  "13.0.24.0" => "Nous avons réussi, Votre Altesse! Les troupes
ennemies ont subi d'énormes pertes!",
  "13.0.25.0" => "Impa, laisse-moi me charger de cet endroit. Je
veux que tu commandes les troupes à l'arrière.",
  "13.0.26.0" => "Très bien. Soyez prudente, Votre Altesse!",
  "13.0.27.0" => "Nous avons survécu... Et c'est grâce à vous
tous. Cette victoire vous appartient!",
  "13.0.28.0" => "Votre Altesse! C'est terrible!
Le mage ennemi a pris le château!",
  "13.0.29.0" => "Il faut qu'on protège Hyrule!
En avant, Link! Dépêche-toi!",
  "13.0.30.0" => "Si nous utilisons ceci, nous pourrons détruire
les rochers et rejoindre Impa...",
  "13.0.31.0" => "Votre Altesse! Utilisez ceci! Cet objet devrait
augmenter la puissance des bombes!",
  "13.0.32.0" => "Votre Altesse... Pardonnez-moi...",
  "13.0.33.0" => "Des rochers nous bloquent la route! Comment
on va faire pour aller aider madame Impa?",
  "13.0.34.0" => "Link, regarde! C'est la princesse!",
}