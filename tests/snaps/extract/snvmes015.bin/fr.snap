Map {
  "1.0.0.0" => "Pensez-vous vraiment que vous serez en
sécurité derrière les portes de votre château?",
  "1.0.1.0" => "J'écraserai le Héros et la princesse ici même
et je récupérerai leurs fragments de la Triforce!",
  "1.0.2.0" => "Ce château est notre dernier rempart...
S'il tombe, ce sera la fin pour nous tous!",
  "1.0.3.0" => "Si nous voulons remporter la victoire, nous
devons prendre la base de Ganondorf!",
  "1.0.4.0" => "Je vais ouvrir ces portes pour permettre
l'avancée de nos troupes.",
  "1.0.5.0" => "Les portes sont attaquées! Soldats d'Hyrule,
concentrez vos efforts sur Xanto!",
  "1.0.6.0" => "À vos ordres, Votre Altesse!",
  "1.0.7.0" => "Elle a déjà tout compris... Nous ne devons pas
sous-estimer cette princesse.",
  "1.0.8.0" => "Ces humains ont l'air particulièrement
optimistes...",
  "1.0.9.0" => "Ha ha! Ça ne suffira pas à m'empêcher
de réaliser mes ambitions!",
  "1.0.10.0" => "Le Héros de la légende est de notre côté! Vous
n'avez aucune chance! Pas vrai, Link?",
  "1.0.11.0" => "Le Héros... Il est toujours là! Toujours
en travers de mon chemin!",
  "1.0.12.0" => "Link! Ne force pas trop! Bats en retraite
et économise tes forces si c'est nécessaire!",
  "1.0.13.0" => "Vous placez tous vos espoirs dans ce Héros,
mais vous avez peur qu'il se blesse. Pitoyable!",
  "1.0.14.0" => "Ne vous inquiétez pas! Link reviendra quand ses
blessures auront été soignées!",
  "1.0.15.0" => "Mission terminée... La voie est libre.",
  "1.0.16.0" => "On a vaincu un de leurs plus puissants guerriers!
Continuons sur notre lancée!",
  "1.0.17.0" => "Vous pensez que la défaite de Xanto va faire fléchir
ma détermination? Vous vous bercez d'illusions!",
  "1.0.18.0" => "Utilisons les pouvoirs de la grande fée à notre
avantage! La victoire est à portée de main.",
  "1.0.19.0" => "Empêchez-les d'aller à la fontaine! Si la grande
fée leur vient en aide, nous le regretterons.",
  "1.0.20.0" => "Seigneur, laissez-moi le plaisir de briser leurs
espoirs et leurs rêves de victoire!",
  "1.0.21.0" => "Nous n'arrivons à rien... Ignorons Ghirahim et
dirigeons-nous vers la fontaine!",
  "1.0.22.0" => "Nous avons réussi! Ghirahim a été vaincu!",
  "1.0.23.0" => "Humains... Ne vous réjouissez pas trop vite!
Je vous ferai regretter cette arrogance!",
  "1.0.24.0" => "Si nous accumulons de l'énergie magique, nous
pourrons détruire la base de Ganondorf!",
  "1.0.25.0" => "Nous avons encore besoin de temps!
Il nous faut davantage d'énergie magique...",
  "1.0.26.0" => "Nous y sommes presque!
Attendez encore un peu!",
  "1.0.27.0" => "C'est bon! C'est tout ce dont nous avons
besoin! Il est temps de dévoiler notre plan!",
  "1.0.28.0" => "Hé hé... Comme c'est dommage.",
  "1.0.29.0" => "Impa...! Non... C'est impossible...",
  "1.0.30.0" => "Allons-y, Link! On ne peut pas perdre
cette bataille!",
  "1.0.31.0" => "Link est de retour, c'est notre chance!
Que toutes les troupes passent à l'attaque!",
  "1.0.32.0" => "Link! Avançons, nous aussi!",
  "1.0.33.0" => "Comme c'est gentil... Le Héros ET la princesse!
Vous me rendez la vie bien plus facile!",
  "1.0.34.0" => "Empêchez-les d'avancer! Il faut protéger
la princesse Zelda à tout prix!",
  "1.0.35.0" => "Permettez-moi d'arrêter ce jeune insolent.",
  "1.0.36.0" => "Et laissez-moi m'occuper de la princesse.",
  "1.0.37.0" => "Non... Une défaite serait inacceptable...",
  "1.0.38.0" => "Anéantissez le Héros à présent!",
  "1.0.39.0" => "Li... Link!!! Réveille-toi, Link!!!",
  "1.0.40.0" => "C'est déjà fini? J'espérais vraiment que votre
Héros opposerait un peu plus de résistance.",
  "1.0.41.0" => "Maintenant, éliminez la princesse!",
  "1.0.42.0" => "Link se bat au péril de sa vie...
Je ne peux rester là à ne rien faire!",
  "1.0.43.0" => "La princesse se bat avec tellement d'ardeur...
Link! On devrait en faire autant!",
  "1.0.44.0" => "Vous ne savez vraiment pas quand abandonner.
Je vais m'occuper de vous moi-même.",
  "1.0.45.0" => "Non... Je vais en finir avec toi,
même si je dois le payer de ma vie!",
  "1.0.46.0" => "Ha ha ha! Je ne crois pas que tu puisses faire
quoi que ce soit dans cet état...",
  "1.0.47.0" => "Non, Link! Tu n'as pas le droit d'abandonner!",
  "1.0.48.0" => "Vous aurez beau essayer encore et encore,
jamais vous ne pourrez me vaincre.",
  "1.0.49.0" => "Je ne peux pas le laisser se sacrifier...
Link, j'arrive!",
  "1.0.50.0" => "Link, il faut y aller! Allons aider la princesse!",
  "1.0.51.0" => "J'utiliserai la Triforce de la sagesse pour
purifier tous les forts envahis par les ténèbres!",
  "1.0.52.0" => "Il n'y a pas un instant à perdre... Dirigeons-nous
vers la base de Ganondorf!",
  "1.0.53.0" => "Link, utilise la Triforce du courage pour chasser
le pouvoir des ténèbres qui enveloppe les forts!",
  "1.0.54.0" => "On perd notre temps, ici! Dirigeons-nous
au plus vite vers la base ennemie!",
  "1.0.55.0" => "Si nous réussissons à prendre la base
ennemie, nous pouvons remporter la victoire!",
  "1.0.56.0" => "J'utiliserai le pouvoir de la Triforce pour chasser
les âmes perverties de ce fort!",
  "1.0.57.0" => "Link, c'est la base ennemie! Si on en
prend le contrôle, la victoire est assurée!",
  "1.0.58.0" => "Fais disparaître le pouvoir des ténèbres
grâce à la Triforce, Link!",
  "1.0.59.0" => "Grrr... C'est donc ça, le pouvoir de la Triforce.
Il faut trouver un moyen de les arrêter.",
  "1.0.60.0" => "Le fort va tomber si nous ne faisons
rien. Soyez sans pitié! Tuez-les!",
  "1.0.61.0" => "Nous ne nous soumettrons jamais
à des monstres tels que vous!",
  "1.0.62.0" => "Nous donnerons notre vie pour protéger
notre belle terre d'Hyrule!",
  "1.0.63.0" => "Mais qu'est-ce que vous faites?!
Protégez notre base!",
  "1.0.64.0" => "Enfin... J'ai récupéré tous les fragments
de la Triforce!",
  "1.0.65.0" => "Toujours à se dresser en travers de mon chemin!
On dirait que mes ambitions devront attendre.",
  "1.0.66.0" => "Ça s'annonce très mal...
Je dois faire quelque chose!",
  "1.0.67.0" => "Je viens vous aider!
Soldats d'Hyrule, à l'attaque!",
  "1.0.68.0" => "Ne faiblissez pas! Nous devons
les repousser!",
  "1.0.69.0" => "Permettez-moi d'écraser
ces cloportes!",
  "1.0.70.0" => "Ah ah! Leurs troupes au nord
sont à présent séparées.",
  "1.0.71.0" => "L'ennemi recule! Profitons-en pour
lancer l'assaut sur la base ennemie!",
  "1.0.72.0" => "Où ont-ils trouvé une telle confiance?
Occupez-vous d'eux! Brisez leur moral!",
  "13.0.0.0" => "Pourquoi les humains sont-ils toujours
si pressés de mourir?",
  "13.0.1.0" => "Ce garçon... Si je parviens à l'éliminer,
le moral de l'ennemi sera réduit en miettes.",
  "13.0.2.0" => "Link reprendra le combat dès que
ses blessures seront soignées!",
  "13.0.3.0" => "Ils ne doivent pas continuer... Ne laissez
pas l'ennemi s'approcher de la fontaine!",
}