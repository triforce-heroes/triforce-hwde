Map {
  "0.0.0" => "A0%1sF0R è in difficoltà! Vai in soccorso!",
  "0.1.0" => "L'area C2%1sF2R è stata conquistata!",
  "0.2.0" => "A0%1sF0R comincia la ritirata!",
  "0.3.0" => "Hai sconfitto A0%1sF2R e A0%2sF2R!",
  "0.4.0" => "A0%1sF0R scende in campo!",
  "0.5.0" => "Le porte tra il A6desertoR e il A6patiboloR sono chiuse!",
  "0.6.0" => "Il morale di A0%1sF6R è peggiorato!",
  "0.7.0" => "A0%1sF0R va verso l'area A0%2sF6R!",
  "0.8.0" => "La A6%1sF0R si è chiusa per fermare l'avanzata di A2ZantR!",
  "0.9.0" => "L'A0%1sF1R ha sconfitto A0%2sF2R!",
  "0.10.0" => "La A6%1sF0R è aperta!",
  "0.11.0" => "Hai raggiunto A0%1sF2R!",
  "0.12.0" => "Appaiono A0%1sF6R, A0%2sF6R e A0%3sF6R!",
  "0.13.0" => "Il morale di A0%1sF6R è migliorato!",
  "0.14.0" => "Sono apparsi rinforzi per l'A0%1sF1R!",
  "0.15.0" => "L'A0%1sF1R si mette in marcia verso l'area A0%2sF6R!",
  "0.16.0" => "Le aree C5%1sF0R e C5%2sF0R sono aperte!",
  "0.17.0" => "Ferma l'attacco dell'A0%1sF5R!",
  "0.18.0" => "L'A0%1sF1R sferra un attacco generale!",
  "0.19.0" => "L'A0%1sF1R sferra un attacco generale sull'area A0%2sF6R!",
  "0.20.0" => "Hai trovato A0%1sF2R e A0%2sF2R!",
  "0.21.0" => "Hai sconfitto A0%1sF2R!",
  "0.22.0" => "L'area A0%1sF0R ha bisogno di rinforzi!",
  "0.23.0" => "L'area A0%1sF0R sta per cadere! Ha bisogno di rinforzi!",
  "0.24.0" => "A0%1sF0R è in difficoltà! Vai in soccorso!",
  "0.25.0" => "A0%1sF0R è in pericolo! Vai subito in soccorso!",
  "0.26.0" => "L'A0%1sF5R ha vinto la battaglia!",
  "0.27.0" => "L'A0%1sF5R ha messo in fuga A0%2sF2R!",
  "0.28.0" => "L'A0%1sF1R ha perso la battaglia!",
  "0.29.0" => "L'area C1%1sF0R è stata conquistata dall'A0%2sF5R!",
  "0.30.0" => "A2ZantR ha chiuso la A6%1sF0R!",
  "0.31.0" => "Attenzione, A0%1sF2R non deve ritirarsi!",
  "0.32.0" => "Sconfiggi A0%1sF2R!",
  "0.33.0" => "A0%1sF0R riappare grazie al teletrasporto!",
  "0.34.0" => "Presto, raggiungi A0%1sF2R!",
  "0.35.0" => "A0%1sF0R si teletrasporta per scappare dalla battaglia!",
  "0.36.0" => "Le porte tra il A6desertoR e il A6patiboloR sono aperte!",
  "0.37.0" => "La A6%1sF0R è aperta!",
  "0.38.0" => "Raggiungi i presidi e trova i veri A0%1sF2R e A0%2sF2R!",
  "0.39.0" => "Sconfiggi subito A0%1sF2R e A0%2sF2R!",
  "0.40.0" => "A0%1sF0R va verso l'area A0%2sF6R!",
  "0.41.0" => "La A6%1sF0R si è aperta!",
  "0.42.0" => "L'A2armata di GanondorfR ha aperto la A6%1sF0R!",
  "0.43.0" => "A2ZantR ha chiuso parte dell'area A0%1sF0R!",
  "0.44.0" => "A0%1sF0R si indebolisce per il A2caldo del desertoR!",
  "0.45.0" => "Attenzione, A0%1sF2R e A0%2sF2R non devono ritirarsi!",
  "0.46.0" => "Un'A6AracnulaR è stata avvistata sul campo di battaglia!",
  "0.47.0" => "Cerca l'A6AracnulaR!",
  "0.48.0" => "Hai ottenuto l'A6AracnulaR!",
  "0.49.0" => "L'A6SkulltulaR comincia a preparare la fuga!",
  "0.50.0" => "L'A6AracnulaR è fuggita!",
  "0.51.0" => "Presto, sconfiggi A0%1sF2R!",
  "0.52.0" => "Sconfiggi A0%1sF2R!",
  "0.53.0" => "Insegui A0%1sF2R!",
  "0.54.0" => "L'A0%1sF5R nel deserto sud ha smesso di perdere energia!",
  "0.55.0" => "L'A0%1sF5R nel deserto nord ha smesso di perdere energia!",
  "0.56.0" => "A0%1sF0R è di nuovo in fuga!",
  "0.57.0" => "A0%1sF0R va verso A0%2sF6R!",
  "0.58.0" => "L'area A0%1sF4R è parzialmente aperta!",
  "0.59.0" => "L'arsura del deserto sud riduce l'energia dei soldati!",
  "0.60.0" => "L'arsura del deserto nord riduce l'energia dei soldati!",
  "0.61.0" => "A0%1sF0R ha sconfitto A0%2sF2R!",
  "0.62.0" => "Cerca di raggiungere A0%1sF2R!",
  "0.63.0" => "Ora puoi controllare A0%1sF2R, A0%2sF2R e A0%3sF2R!",
  "0.64.0" => "A0%1sF1R appaiono nelle aree A0%2sF0R e A0%3sF0R!",
  "0.65.0" => "A0%1sF0R va verso le aree A0%2sF6R e A0%3sF6R!",
  "0.66.0" => "Hai sconfitto A0%1sF3R!",
  "0.67.0" => "A0%1sF0R e A0%2sF2R appaiono!",
  "0.68.0" => "A0%1sF0R si comporta in modo sospetto!",
  "0.69.0" => "Hai sconfitto A0%1sF2R e A0%2sF2R!",
  "0.70.0" => "Il morale dell'A0%1sF1R è migliorato!",
  "0.71.0" => "L'A0%1sF1R occupa le aree A0%2sF6R e A0%3sF6R!",
  "0.72.0" => "A0%1sF0R incoraggia l'A0%2sF5R, migliorandone il morale!",
  "0.73.0" => "A0%1sF0R ha evocato A0%2sF2R!",
  "0.74.0" => "A0%1sF0R va verso A0%2sF2R!",
  "0.75.0" => "L'A0%2sF5R ha messo in fuga A0%1sF2R!",
  "0.76.0" => "L'A0%1sF1R ha perso la battaglia!",
  "0.77.0" => "A0%1sF0R appare e va verso l'area C2%2sF6R!",
  "0.78.0" => "Hai conquistato l'area C2%1sF4R!",
  "0.79.0" => "Raggiungi A0%1sF2R!",
  "0.80.0" => "L'A0%1sF0R lotta contro A0%2sF2R!",
  "0.81.0" => "A0%1sF0R appare e va verso l'area C2%2sF6R!",
  "0.82.0" => "Nell'area A0%1sF6R si nasconde un tesoro!",
  "0.83.0" => "A0%1sF0R va verso i presidi dell'A0%2sF1R!",
  "0.84.0" => "Non far cadere i presidi dell'A0%1sF1R!",
  "0.85.0" => "A0%1sF0R ha invaso l'area A0%2sF6R!",
  "0.86.0" => "Presto, sconfiggi A0%1sF2R!",
  "0.87.0" => "L'A0%1sF1R ha occupato l'area A0%2sF2R!",
  "0.88.0" => "A0%1sF0R va verso A0%2sF2R!",
  "0.89.0" => "A0%1sF0R ha perso e le sue truppe si ritirano!",
