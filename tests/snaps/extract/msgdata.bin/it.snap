  "4.506.0" => "Non puoi aggiungere la stessa abilità due volte.",
  "4.507.0" => "Non puoi aggiungere altre abilità ATT.",
  "4.508.0" => "Non puoi aggiungere altre abilità ELE.",
  "4.509.0" => "Non puoi aggiungere altre abilità VS.",
  "4.510.0" => "Non puoi aggiungere altre abilità RAC.",
