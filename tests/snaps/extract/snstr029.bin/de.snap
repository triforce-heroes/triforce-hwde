Map {
  "0.0.0" => "Vorsicht! Die A0%2sF3R rücken Richtung A0%1sF4R vor!",
  "0.1.0" => "Die A0%1sF1R rücken Richtung A0%2sF4R vor!",
  "0.2.0" => "Die A0%1sF1R rücken Richtung A0%2sF4R vor!",
  "0.3.0" => "Die A0%1sF1R vorrückenden A0%2sF5R wurden besiegt!",
  "0.4.0" => "Besiege A0%1sF6R!",
  "0.5.0" => "A0%1sF0R und A0%2sF5R sind geschlossen!",
  "0.6.0" => "Die A0%2sF1R sind geschwächt! Die Moral der A0%1sF5R steigt!",
  "0.7.0" => "Greife die A0%1sF3R an!",
  "0.8.0" => "Der Rückzug A0%2sF2R stärkt die A0%1sF1R!",
  "0.9.0" => "A0%1sF0R wurde besiegt!",
  "0.10.0" => "A0%1sF0R hat sich vom Schlachtfeld zurückgezogen!",
  "0.11.0" => "Die A0%1sF1R greifen die A0%2sF7R an!",
  "0.12.0" => "A0%1sF0R ist zurückgekehrt!",
  "0.13.0" => "Die A0%1sF1R greifen die A0%2sF7R an!",
  "0.14.0" => "Die Siegbedingungen haben sich geändert!",
  "0.15.0" => "Besiege A0%1sF6R!",
  "0.16.0" => "A0%1sF0R flieht zum Magiekreis!",
  "0.17.0" => "Bedingungen für eine Niederlage wurden hinzugefügt!",
  "0.18.0" => "A0%1sF0R darf den A6FluchtpunktR nicht erreichen!",
  "0.19.0" => "A0%1sF0R wurde auf dem Schlachtfeld gesichtet!",
  "0.20.0" => "A0%1sF0R greift A0%2sF6R an!",
  "0.21.0" => "A0%1sF1R wurden auf dem Schlachtfeld gesichtet!",
  "0.22.0" => "Besiege A0%1sF6R oder A0%2sF6R!",
  "0.23.0" => "A0%1sF0R wurde besiegt!",
  "0.24.0" => "A0%1sF0R ist offen!",
  "0.25.0" => "Besiege A0%1sF6R und hol dir den Schlüssel!",
  "0.26.0" => "A0%1sF0R wurde besiegt! Ein A6Teil des PalastesR ist offen!",
  "0.27.0" => "A0%1sF0R ist zum Teil offen!",
  "0.28.0" => "Schnell, verfolge A0%1sF6R!",
  "0.29.0" => "A0%1sF0R muss schnell besiegt werden!",
  "0.30.0" => "Besiege schnellstmöglich A0%1sF6R!",
  "0.31.0" => "A0%1sF0R ist geflohen!",
  "0.32.0" => "Die A0%1sF1R wurden besiegt!",
  "0.33.0" => "C1%1sF0R ist an die A0%2sF7R gefallen!",
  "0.34.0" => "Die A0%1sF1R haben die Schlacht verloren!",
  "0.35.0" => "Die A0%1sF1R wurden besiegt!",
  "0.36.0" => "A0%1sF0R ist entkommen!",
  "0.37.0" => "Die A0%1sF1R wurden besiegt!",
  "0.38.0" => "A0%1sF0R rückt gegen A0%2sF6R vor!",
  "0.39.0" => "A0%1sF0R hat A0%2sF6R erreicht!",
  "0.40.0" => "A0%1sF0R redet mit A0%2sF4R!",
  "0.41.0" => "Die Moral der A0%1sF1R sinkt!",
  "0.42.0" => "Die A0%1sF1R rücken gegen A0%2sF6R vor!",
  "0.43.0" => "A0%1sF0R droht zu fallen! Deine Hilfe wird benötigt!",
  "0.44.0" => "A0%1sF0R steht kurz davor zu fallen! Deine Hilfe wird benötigt!",
  "0.45.0" => "Die A0%2sF1R haben den Vormarsch A0%1sF2R aufgehalten!",
  "0.46.0" => "A0%1sF0R rückt wieder vor!",
  "0.47.0" => "Erobere A0%1sF6R!",
  "0.48.0" => "A0%1sF0R rückt vor!",
  "0.49.0" => "A0%1sF0R hat Magie verbraucht und die A0%2sF1R beschworen!",
  "0.50.0" => "Die Abwehr A0%1sF2R wurde durch Erschöpfung halbiert!",
  "0.51.0" => "A0%1sF0R darf nicht fliehen!",
  "0.52.0" => "Ein Teil der A0%1sF1R rückt vor!",
  "0.53.0" => "Die im Palast versteckten A0%1sF1R wurden gesichtet!",
  "0.54.0" => "C4%1sF0R wurde erobert!",
  "0.55.0" => "A0%1sF0R darf nicht fallen!",
  "0.56.0" => "Die Moral der A0%1sF1R steigt!",
  "0.57.0" => "Dieser Zanto scheint voller Gier zu sein, das macht
ihn leicht zu kontrollieren. Versucht es mit ihm.",
  "0.58.0" => "A0%1sF0R wurde besiegt!",
  "0.59.0" => "Die A0%1sF1R rücken gegen die A0%2sF7R vor!",
  "0.60.0" => "A0%1sF0R ist in Bedrängnis und braucht Hilfe!",
  "0.61.0" => "A0%1sF0R ist in Gefahr und benötigt auf der Stelle Hilfe!",
  "0.62.0" => "Die Moral A0%1sF2R und A0%2sF2R ist gesunken!",
  "0.63.0" => "Behalte die A0%1sF1R im Auge!",
  "0.64.0" => "Der Rückzug A0%2sF2R stärkt A0%1sF6R!",
  "0.65.0" => "Die Niederlage A0%2sF2R schwächt A0%1sF6R!",
  "0.66.0" => "A0%1sF0R und A0%2sF5R sind offen!",
  "0.67.0" => "A0%1sF1R wurden besiegt!",
  "0.68.0" => "Die Moral A0%1sF2R steigt!",
  "0.69.0" => "A0%1sF0R hat A0%2sF6R erreicht!",
  "0.70.0" => "Du hast A0%1sF6R nicht besiegt!",
  "0.71.0" => "Eine A6SkulltulaR wurde auf dem Schlachtfeld gesichtet!",
  "0.72.0" => "Finde die A6SkulltulaR!",
  "0.73.0" => "Du hast die A6SkulltulaR erlegt!",
  "0.74.0" => "Die A6SkulltulaR wird bald fliehen!",
  "0.75.0" => "Die A6SkulltulaR ist geflohen!",
  "0.76.0" => "A0%1sF0R wurde gesichtet und rückt Richtung C2%2sF4R vor!",
  "0.77.0" => "C2%1sF0R wurde erobert!",
  "0.78.0" => "Versammele deine Mitstreiter bei A0%1sF4R!",
  "0.79.0" => "A0%2sF0R kämpft mit den A0%1sF0R!",
  "0.80.0" => "A0%1sF0R wurde gesichtet und rückt Richtung C2%2sF4R vor!",
  "0.81.0" => "A0%1sF0R scheint einen Schatz zu beherbergen!",
  "0.82.0" => "A0%2sF0R hat C1%1sF6R geschwächt!",
  "0.83.0" => "A0%1sF1R haben nach ihrer Mission das Schlachtfeld verlassen!",
  "0.84.0" => "Die A0%1sF0R haben C1%2sF6R fast erreicht!",
  "0.85.0" => "Die A0%1sF0R müssen schnell besiegt werden!",
  "0.86.0" => "A0%1sF0R und A0%2sF5R sind offen!",
