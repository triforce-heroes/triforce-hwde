Map {
  "0.0.0" => "Attention ! A0%1sF5R se dirige vers la A1base alliéeR !",
  "0.2.0" => "Le moral A0%1sF3R augmente !",
  "0.3.0" => "Dirigez-vous immédiatement vers le A6fort de la statueR !",
