Map {
  "0.0.0" => "Die A0%1sF1R wurden besiegt!",
  "0.1.0" => "A0%1sF0R wurde besiegt!",
  "0.2.0" => "A0%1sF0R hat ein A6HerzR abgelegt!",
  "0.3.0" => "A0%1sF0R hat einen A6Force-KristallR abgelegt!",
  "0.4.0" => "A0%1sF0R hat einen A6MagiekrugR abgelegt!",
  "0.5.0" => "A0%1sF0R ist geflohen!",
  "0.6.0" => "Die Moral A0%1sF2R steigt vorübergehend!",
  "0.7.0" => "A0%1sF0R rückt Richtung C1%2sF4R vor!",
  "0.8.0" => "A0%1sF0R rückt mit gestiegener Moral Richtung C1%2sF4R vor!",
  "0.9.0" => "A1Festungen der Truppen von HyruleR sind an die A2MonsterR gefallen!",
  "0.10.0" => "A2Alle FestungenR sind offen! Der A2FeindR rückt Richtung C1%2sF4R vor!",
  "0.11.0" => "Die A0%1sF1R kämpfen mit den A2Monstern im NordenR!",
  "0.12.0" => "Beschütze A0%1sF7R vor den A2MonsternR!",
  "0.13.0" => "Die A0%1sF1R haben in zwei Festungen Verstärkung erhalten!",
  "0.14.0" => "A0%1sF0R und A0%2sF5R sind offen! Der A2FeindR rückt vor!",
  "0.15.0" => "Die Richtung C1%1sF4R vorrückenden A2MonsterR wurden besiegt!",
  "0.16.0" => "Die A0%1sF1R haben weitere Verstärkung erhalten!",
  "0.17.0" => "C2%1sF0R und C2%2sF5R wurden erobert!",
  "0.18.0" => "Besiege die A2MonsterR, die C1%1sF1R vorrücken!",
  "0.19.0" => "Erobere A0%1sF6R und A0%2sF6R!",
  "0.20.0" => "A0%1sF0R wurde auf dem Schlachtfeld gesichtet!",
  "0.21.0" => "Die Siegbedingungen haben sich geändert!",
  "0.22.0" => "Besiege A0%1sF6R!",
  "0.23.0" => "A2Mächtige MonsterR rücken Richtung C1%1sF4R vor!",
  "0.24.0" => "Die A2mächtigen MonsterR wurden besiegt!",
  "0.25.0" => "Weitere A2mächtige MonsterR wurden gesichtet!",
  "0.26.0" => "A0%1sF1R sind zurückgekehrt!",
  "0.27.0" => "A0%1sF0R wurde durch das Licht des A6KompassR geschwächt!",
  "0.28.0" => "A0%1sF1R wurden auf dem Schlachtfeld gesichtet!",
  "0.29.0" => "Die A0%1sF1R rücken mit gestiegener Moral vor!",
  "0.30.0" => "Die A0%1sF1R rücken gegen die A2mächtigen MonsterR vor!",
  "0.31.0" => "A0%1sF0R muss schnell besiegt werden!",
  "0.32.0" => "A0%1sF0R hat C1%2sF6R fast erreicht!",
  "0.33.0" => "Die A2MonsterhordeR wurde besiegt!",
  "0.34.0" => "C1%1sF0R ist an die A0%2sF7R gefallen!",
  "0.35.0" => "A0%1sF0R ist geflohen!",
