Map {
  "0.0.0" => "Petit... Tu vas le regretter!",
  "0.1.0" => "Bien... Je vais tous les deux vous faire rejoindre vos ancêtres!",
  "0.2.0" => "Oh non...",
  "0.3.0" => "Se pourrait-il que tu sois...?",
  "0.4.0" => "Volga",
  "0.5.0" => "Volga",
  "0.6.0" => "Impa",
  "0.7.0" => "Impa",
  "1.0.0" => "La princesse Zelda est introuvable...
J'espère de tout cœur qu'elle est saine et sauve...",
  "1.1.0" => "Nous aurons besoin de ton aide pour la retrouver.",
  "1.2.0" => "Link, deviens le Héros que nous attendons
et porte cette tenue avec honneur.",
  "1.3.0" => "Impa",
  "1.4.0" => "Impa",
  "1.5.0" => "Impa",
  "2.1.0" => "La princesse n'est pas morte.",
  "2.2.0" => "Vous la retrouverez sûrement au cours de votre quête.",
  "2.3.0" => "Mon nom est... Sheik.",
  "2.4.0" => "Je fais partie du clan sheikah. Nous sommes
au service de la famille royale d'Hyrule
depuis des générations.",
  "2.5.0" => "Le clan sheikah?",
  "2.6.0" => "C'est impossible...",
  "2.7.0" => "Nous parlerons une fois sortis de ces grottes.
Pour l'instant, laissez-moi combattre à vos côtés.",
  "2.8.0" => "???",
  "2.9.0" => "???",
  "2.10.0" => "Sheik",
  "2.11.0" => "Sheik",
  "2.12.0" => "Impa",
  "2.13.0" => "Impa",
  "2.14.0" => "Sheik",
  "3.1.0" => "Qui es-tu?",
  "3.2.0" => "Es-tu à la tête de ce groupe?",
  "3.3.0" => "C'est bien moi.",
  "3.4.0" => "Tu peux utiliser la magie, dirait-on.
Où l'as-tu apprise?",
  "3.5.0" => "Comment ça, « où »?
Je suis une sorcière, c'est tout.",
  "3.6.0" => "Je fais partie du même clan que Cya. C'est elle
qui contrôle les monstres qui nous attaquent.",
  "3.7.0" => "Dans ce cas, j'ai quelque chose à te demander...",
  "3.8.0" => "Quel est le but de cette sorcière, Cya?",
  "3.9.0" => "Vous souhaitez réellement le savoir?",
  "3.10.0" => "Hmm...",
  "3.11.0" => "Aidez-nous.",
  "3.12.0" => "Aidez-nous et je vous le dirai.",
  "3.13.0" => "Lana",
  "3.14.0" => "Impa",
  "3.15.0" => "Lana",
  "3.16.0" => "Impa",
  "3.17.0" => "Lana",
  "3.18.0" => "Lana",
  "3.19.0" => "Impa",
  "3.20.0" => "Impa",
  "3.21.0" => "Lana",
  "3.22.0" => "Lana",
  "3.23.0" => "Lana",
  "3.24.0" => "Lana",
  "4.1.0" => "Je pensais retrouver la princesse Zelda...
Il semble que je me sois fait de faux espoirs.",
  "4.2.0" => "Où peut-elle bien être?
Puissent les Déesses veiller sur elle...",
  "4.3.0" => "Impa",
  "4.4.0" => "Impa",
  "5.0.0" => "Tiens...",
  "5.1.0" => "Link? C'est donc toi le Héros...
Je te félicite d'être arrivé jusqu'ici...",
  "5.2.0" => "Oh?",
  "5.3.0" => "Link!",
  "5.4.0" => "Deux...",
  "5.5.0" => "Je vois...",
  "5.6.0" => "Voilà une bonne nouvelle que je n'attendais pas...",
  "5.7.0" => "Viens, mon serviteur!",
  "5.8.0" => "Cya",
  "5.9.0" => "Cya",
  "5.10.0" => "Cya",
  "5.11.0" => "Sheik",
  "5.12.0" => "Cya",
  "5.13.0" => "Cya",
  "5.14.0" => "Cya",
  "5.15.0" => "Cya",
  "6.0.0" => "Sheik, c'est...",
  "6.1.0" => "Ha ha ha... Jamais je n'aurais pensé que tu viendrais
m'apporter toi-même la Triforce de la Sagesse.",
  "6.2.0" => "Grâce à toi, j'ai enfin rassemblé tous
les fragments de la Triforce!",
  "6.3.0" => "Contemplez... la puissance de la Triforce!",
  "6.4.0" => "Oh non!
Link, fuis!",
  "6.5.0" => "Cya...",
  "6.6.0" => "L'heure est venue de rappeler les fragments de mon
âme qui ont été scellés dans les replis du temps!",
  "6.7.0" => "Oui... Je sens qu'ils cherchent à revenir à moi...",
  "6.8.0" => "Graaaaah!",
  "6.9.0" => "Lana",
  "6.10.0" => "Cya",
  "6.11.0" => "Cya",
  "6.12.0" => "Cya",
  "6.13.0" => "Lana",
  "6.14.0" => "???",
  "6.15.0" => "???",
  "6.16.0" => "Cya",
  "6.17.0" => "Cya",
  "7.0.0" => "Tu aurais pu accompagner Link ou Lana.
Pourquoi avoir choisi de venir avec moi?",
  "7.1.0" => "Je n'arrive pas à te cerner...
Fais-tu réellement partie du clan sheikah?",
  "7.2.0" => "Si c'est le cas, dis-moi...
Quel est le nom du chef de ton clan?",
  "7.3.0" => "Impa. C'est-à-dire toi.",
  "7.4.0" => "En effet... Mais personne dans mon clan
ne porte le nom de Sheik.",
  "7.5.0" => "Qui es-tu donc alors?
Et quel est ton véritable objectif?",
  "7.6.0" => "Au secours! La princesse Ruto est en danger!",
  "7.7.0" => "Ruto, la princesse des Zoras?",
  "7.8.0" => "Elle a été enlevée par les Gorons!",
  "7.9.0" => "Darunia, leur chef, a pourtant toujours été
quelqu'un de droit.",
  "7.10.0" => "Mais il a rencontré une certaine Zelda
récemment... Et depuis, il n'est plus lui-même.",
  "7.11.0" => "Zelda?
La princesse Zelda se trouve ici?",
  "7.12.0" => "Nous devons y aller.
Je dois voir ça de mes propres yeux.",
  "7.13.0" => "Impa",
  "7.14.0" => "Impa",
  "7.15.0" => "Impa",
  "7.16.0" => "Sheik",
  "7.17.0" => "Impa",
  "7.18.0" => "Impa",
  "7.19.0" => "Fée",
  "7.20.0" => "Sheik",
  "7.21.0" => "Fée",
  "7.22.0" => "Fée",
  "7.23.0" => "Fée",
  "7.24.0" => "Impa",
  "7.25.0" => "Sheik",
  "8.0.0" => "Comment as-tu deviné qui j'étais vraiment?",
  "8.1.0" => "Tu ne pouvais pas être Zelda.",
  "8.2.0" => "Car...",
  "8.3.0" => "Je suis la princesse Zelda!",
  "8.4.0" => "Votre Altesse!
Vous êtes saine et sauve!",
  "8.5.0" => "Impa, pardonne-moi de ne pas
t'avoir révélé mon identité.",
  "8.6.0" => "Fermons la porte, Impa.",
  "8.7.0" => "Wizzro",
  "8.8.0" => "Sheik",
  "8.9.0" => "Sheik",
  "8.10.0" => "Zelda",
  "8.11.0" => "Impa",
  "8.12.0" => "Zelda",
  "8.13.0" => "Zelda",
  "9.0.0" => "N... N'approchez pas!",
  "9.1.0" => "Hyaaa!",
  "9.2.0" => "Pfiou...",
  "9.3.0" => "Tout va bien?",
  "9.4.0" => "Oui... mais... euh...
Qui êtes-vous?",
  "9.5.0" => "Mon nom est Lana.",
  "9.6.0" => "Je cherche la porte des âmes, mais
je ne sais pas par où commencer...",
  "9.7.0" => "Une porte des âmes?
Je n'en ai jamais vu...",
  "9.8.0" => "Mais je peux vous y conduire si c'est
vraiment ce que vous voulez.",
  "9.9.0" => "Euh... Comment ça?",
  "9.10.0" => "Grâce à lui! C'est un papillon de la Déesse.
Il nous guidera à travers le royaume du Crépuscule.",
  "9.11.0" => "Villageoise",
  "9.12.0" => "Villageoise",
  "9.13.0" => "Lana",
  "9.14.0" => "Lana",
  "9.15.0" => "Villageoise",
  "9.16.0" => "Lana",
  "9.17.0" => "Lana",
  "9.18.0" => "Machaon",
  "9.19.0" => "Machaon",
  "9.20.0" => "Lana",
  "9.21.0" => "Machaon",
  "10.0.0" => "Rends-le-nous!
Ce papillon est très précieux!",
  "10.1.0" => "Pourquoi? Pour qu'il répande sa
poudre toxique sur mes troupes?",
  "10.2.0" => "Hein?",
  "10.3.0" => "Non, non, ce lépidoptère ne fait pas partie
d'une espèce toxique! Je vous assure!",
  "10.4.0" => "Un lépido-quoi... ?",
  "10.5.0" => "Un papillon!
Celui-là est un papillon de la Déesse.",
  "10.6.0" => "Si vous lui demandez gentiment, il vous
conduira où vous le désirez.",
  "10.7.0" => "Où j'ai envie? Hum...",
  "10.8.0" => "Hé, papillon! Conduis-moi auprès
de cette sorcière de malheur!",
  "10.9.0" => "Oh non...
Qu'allons-nous faire?",
  "10.10.0" => "On n'a pas le choix. Il va falloir se battre.",
  "10.11.0" => "Lana",
  "10.12.0" => "Midona",
  "10.13.0" => "Lana",
  "10.14.0" => "Machaon",
  "10.15.0" => "Midona",
  "10.16.0" => "Machaon",
  "10.17.0" => "Machaon",
  "10.18.0" => "Midona",
  "10.19.0" => "Midona",
  "10.20.0" => "Machaon",
  "10.21.0" => "Lana",
  "11.0.0" => "Que fais-tu ici, Lana...?",
  "11.1.0" => "Cya!",
  "11.2.0" => "C'est elle! C'est à cause du sort qu'elle m'a jeté
que je suis dans cet état!",
  "11.3.0" => "Ha ha ha... Je trouve que cette apparence te sied
à merveille, Midona, princesse du Crépuscule.",
  "11.4.0" => "Oh, toi!",
  "11.5.0" => "Aaaaaaah!",
  "11.6.0" => "Misérables!",
  "11.7.0" => "Lana, son visage... Vous vous ressemblez
comme deux gouttes d'eau!",
  "11.8.0" => "Je suis... l'autre moitié de Cya.
À l'origine, nous ne faisions qu'une.",
  "11.9.0" => "Quoi?",
  "11.10.0" => "Cya",
  "11.11.0" => "Lana",
  "11.12.0" => "Midona",
  "11.13.0" => "Cya",
  "11.14.0" => "Midona",
  "11.15.0" => "Cya",
  "11.16.0" => "Cya",
  "11.17.0" => "Midona",
  "11.18.0" => "Lana",
  "11.19.0" => "Midona",
  "12.0.0" => "Mon nom est Fay.
Je vous attendais.",
  "12.1.0" => "Vous n'êtes pas mon maître, mais
je peux vous considérer comme tel.",
  "12.2.0" => "Ma mission est de vous venir en aide.",
  "12.3.0" => "Cette aide sera nécessaire si vous souhaitez réussir.",
  "12.4.0" => "Acceptez-vous que je me joigne à vous?",
  "12.5.0" => "Fay",
  "12.6.0" => "Fay",
  "12.7.0" => "Fay",
  "12.8.0" => "Fay",
  "12.9.0" => "Fay",
  "13.0.0" => "Oh, l'ennemi a percé mon plan à jour.",
  "13.1.0" => "Comme c'est vexant!",
  "13.2.0" => "Cela me met dans une humeur exécrable.",
  "13.3.0" => "S'ils ne sont pas capables d'exécuter mes ordres,
je n'ai plus qu'à me débarrasser d'eux!",
  "13.4.0" => "Ghirahim",
  "13.5.0" => "Ghirahim",
  "13.6.0" => "Ghirahim",
  "13.7.0" => "Ghirahim",
  "14.0.0" => "Maître, brandissez votre épée vers le ciel
puis abattez-la.",
  "14.1.0" => "Fay",
  "15.0.0" => "Vous avez récupéré vos parties
de la Triforce!",
  "15.1.0" => "Oui. Je les sens à nouveau en Link et en moi.",
  "15.2.0" => "Je ne pourrais pas vous expliquer pourquoi, mais
les pouvoirs de Cya doivent être grandement diminués.",
  "15.3.0" => "Si nous voulons contre-attaquer, c'est le moment ou jamais!",
  "15.4.0" => "Cya possède toujours la Triforce de la force.",
  "15.5.0" => "Ce ne sera pas si facile...",
  "15.6.0" => "En effet, mais nous pouvons gagner...
Si nous avons l'épée maîtresse.",
  "15.7.0" => "Je pense que Link possède l'âme et les qualités
nécessaires au Héros qui la maniera.",
  "15.8.0" => "Votre Altesse... L'épée maîtresse n'est pas une
simple arme, c'est avant tout une barrière.",
  "15.9.0" => "Elle retient à tout jamais l'âme maléfique qui y a été
scellée. Si on la retire, cette âme sera libérée.",
  "15.10.0" => "La barrière dressée dans le temple de l'épée sacrée
a été créée à l'aide d'un sort très spécial.",
  "15.11.0" => "Si l'on retire juste l'épée maîtresse, cela ne suffira pas
à la briser. En tout cas, pas entièrement...",
  "15.12.0" => "Comment pouvons-nous être sûrs que Link sera
à la hauteur de la tâche qui l'attend?",
  "15.13.0" => "Nous ne pouvons pas...
Mais j'ai foi en Link.",
  "15.14.0" => "Oui, moi aussi!",
  "15.15.0" => "Link, l'heure est venue pour toi de faire tes preuves.",
  "15.16.0" => "Bien, en route pour le temple de l'épée sacrée.",
  "15.17.0" => "Lana",
  "15.18.0" => "Zelda",
  "15.19.0" => "Lana",
  "15.20.0" => "Lana",
  "15.21.0" => "Impa",
  "15.22.0" => "Impa",
  "15.23.0" => "Zelda",
  "15.24.0" => "Zelda",
  "15.25.0" => "Impa",
  "15.26.0" => "Impa",
  "15.27.0" => "Lana",
  "15.28.0" => "Lana",
  "15.29.0" => "Impa",
  "15.30.0" => "Zelda",
  "15.31.0" => "Lana",
  "15.32.0" => "Impa",
  "15.33.0" => "Zelda",
  "16.0.0" => "Tu crois pouvoir m'échapper? Petit prétentieux...",
  "16.1.0" => "Pauvre fou!",
  "16.2.0" => "Wizzro",
  "16.3.0" => "Wizzro",
  "17.0.0" => "Une épée n'est qu'un jouet que les faibles aiment brandir.
Seuls les hommes et les fous osent leur confier leur destin.",
  "17.1.0" => "Arrogance... Orgueil... Suffisance...",
  "17.2.0" => "Ces noirs sentiments qui ont germé en toi...",
  "17.3.0" => "... ils te mèneront à ta fin.",
  "17.4.0" => "Cya",
  "17.5.0" => "Cya",
  "17.6.0" => "Cya",
  "17.7.0" => "Cya",
  "18.0.0" => "Tiens bon! Link!",
  "18.1.0" => "Ce n'est qu'en découvrant tes faiblesses que
tu pourras faire naître ta véritable force.",
  "18.2.0" => "Lana",
  "18.3.0" => "Impa",
  "19.1.0" => "Gah!",
  "19.2.0" => "Très bien... Je vais vous donner une bonne leçon!",
  "19.3.0" => "Hmmmm!",
  "19.4.0" => "Cya! Pourquoi as-tu... Quelle idiote...",
  "19.5.0" => "Cya",
  "19.6.0" => "Cya",
  "19.7.0" => "Cya",
  "19.8.0" => "Lana",
  "20.0.0" => "J'ai à présent tout ce dont j'ai besoin pour
assouvir mes ambitions.",
  "20.1.0" => "La Triforce sera mienne!",
  "20.2.0" => "Ganondorf",
  "20.3.0" => "Ganondorf",
  "21.0.0" => "Enfin! Les trois fragments sont réunis...",
  "21.1.0" => "Hé hé...",
  "21.2.0" => "Rah ha ha ha ha ha!",
  "21.3.0" => "Ganondorf",
  "21.4.0" => "Ganondorf",
  "21.5.0" => "Ganondorf",
  "22.0.0" => "Je vous en prie!",
  "22.1.0" => "Aidez-moi... Mes amis!",
  "22.2.0" => "Lana",
  "22.3.0" => "Lana",
  "181.0.0" => "Ha ha ha ha ha!",
  "181.1.0" => "Je suis une grande fée au service de la Déesse.
Dis-moi quel est ton souhait.",
  "181.2.0" => "Grande fée",
  "181.3.0" => "Grande fée",
}