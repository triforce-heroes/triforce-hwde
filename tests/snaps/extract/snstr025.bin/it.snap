Map {
  "0.0.0" => "A0%1sF0R va verso A0%2sF2R!",
  "0.1.0" => "Rinforzi dell'A0%1sF5R appaiono nei A2presidi nemiciR!",
  "0.2.0" => "Appaiono altri rinforzi dell'A0%1sF5R!",
  "0.3.0" => "A0%1sF1R vanno verso i A1presidiR dell'A0%2sF5R !",
  "0.4.0" => "Attenzione, A0%1sF2R non deve fuggire!",
  "0.5.0" => "A0%1sF0R è nei guai! Vai in soccorso!",
  "0.6.0" => "A0%1sF0R è in pericolo! Vai in soccorso!",
  "0.7.0" => "L'A0%2sF7R ha fatto fuggire A0%1sF2R!",
  "0.8.0" => "A0%1sF0R ha raggiunto l'area A0%2sF4R!",
  "0.9.0" => "A0%1sF0R ha raggiunto la destinazione!",
  "0.10.0" => "A0%1sF0R va verso l'area A0%2sF6R!",
  "0.11.0" => "A0%1sF0R ha raggiunto l'area A0%2sF4R!",
  "0.12.0" => "A0%1sF1R abbandonano il campo di battaglia!",
  "0.13.0" => "Appaiono i rinforzi dell'A0%1sF5R!",
  "0.14.0" => "A0%1sF0R è costretta a ritirarsi!",
  "0.15.0" => "A0%1sF0R deve andare alla A6sala della magaR!",
  "0.16.0" => "Hai conquistato l'area C2%1sF4R!",
  "0.17.0" => "Hai salvato A0%1sF2R dalle tenebre!",
  "0.18.0" => "I A2presidiR dell'A0%1sF5R sono parzialmente aperti!",
  "0.19.0" => "L'A0%1sF1R va verso A0%2sF2R!",
  "0.20.0" => "Ora puoi controllare A0%1sF2R!",
  "0.21.0" => "I rinforzi dell'A0%1sF5R appaiono in varie aree!",
  "0.22.0" => "Proteggi A0%1sF2R dai A2demoni indicatiR!",
  "0.23.0" => "L'A0%1sF1R inizia a lottare contro A0%2sF2R!",
  "0.24.0" => "Altri rinforzi dell'A0%1sF5R appaiono in varie aree!",
  "0.25.0" => "A0%1sF0R si prepara a eseguire un'evocazione!",
  "0.26.0" => "A0%1sF0R ha perso e l'armata si ritira!",
  "0.27.0" => "A0%1sF0R ha evocato A0%2sF2R!",
  "0.28.0" => "A0%1sF0R evoca ancora A0%2sF2R!",
  "0.29.0" => "A0%1sF0R va verso A0%2sF2R!",
  "0.30.0" => "Hai sconfitto A0%1sF2R!",
  "0.31.0" => "A0%1sF0R si prepara all'incoraggiamento!",
  "0.32.0" => "A0%1sF0R incoraggia parte dell'A0%2sF3R!",
  "0.33.0" => "Il morale di parte dell'A0%1sF1R è migliorato!",
  "0.34.0" => "Hai sconfitto tutti i A2demoni indicatiR!",
  "0.35.0" => "A0%1sF0R e A0%2sF3R appaiono!",
  "0.36.0" => "Hai sconfitto A0%1sF2R!",
  "0.37.0" => "Hai sconfitto A0%1sF3R!",
  "0.38.0" => "A0%1sF0R ha bisogno d'aiuto!",
  "0.39.0" => "Presto, A0%1sF2R ha bisogno d'aiuto!",
  "0.40.0" => "A0%1sF0R è in fuga!",
  "0.41.0" => "L'A0%1sF1R ha perso la battaglia!",
  "0.42.0" => "L'area A0%1sF0R rischia di cadere!",
  "0.43.0" => "L'area A0%1sF0R sta per cadere!",
  "0.44.0" => "L'area C1%1sF0R si è arresa all'A0%2sF7R!",
  "0.45.0" => "Hai sconfitto A0%1sF2R!",
  "0.46.0" => "Le condizioni di sconfitta sono cambiate!",
  "0.47.0" => "A0%1sF0R perde o l'area A0%2sF4R cade!",
  "0.48.0" => "L'area C2%1sF0R è caduta e non invia più rinforzi all'A0%2sF5R!",
  "0.49.0" => "L'area A0%1sF0R è aperta!",
  "0.50.0" => "Hai conquistato tutti i A2presidiR dell'A0%1sF5R!",
  "0.51.0" => "A0%1sF0R si prepara a evocare altri rinforzi!",
  "0.52.0" => "Un'A6AracnulaR è stata avvistata sul campo di battaglia!",
  "0.53.0" => "L'A6AracnulaR è fuggita!",
  "0.54.0" => "A0%1sF0R e A0%2sF2R avanzano verso A0%3sF2R!",
  "0.55.0" => "L'A0%2sF7R ha fatto fuggire A0%1sF3R!",
  "0.56.0" => "L'A0%1sF1R va verso A0%2sF2R!",
  "0.57.0" => "L'A0%1sF1R ha invaso l'area A0%2sF6R!",
  "0.58.0" => "A0%1sF0R a ovest va verso A0%2sF2R!",
  "0.59.0" => "A0%1sF0R a est va verso A0%2sF2R!",
  "0.60.0" => "Sconfiggi i A2demoni indicatiR e proteggi A0%1sF2R!",
  "0.61.0" => "Hai scortato A0%1sF2R!",
  "0.62.0" => "Attenzione, A0%1sF3R non devono scappare!",
  "0.63.0" => "A0%1sF1R vanno verso A0%2sF2R!",
  "0.64.0" => "A0%1sF0R va verso A0%2sF7R!",
  "0.65.0" => "A0%1sF1R vanno verso A0%2sF3R!",
