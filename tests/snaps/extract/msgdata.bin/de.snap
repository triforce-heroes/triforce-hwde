  "5.5053.0" => "Erhöht den Angriffschaden von PbPbPbPbPc.",
  "5.5054.0" => "Erhöht den Angriffschaden von PbPbPbPbPbPc.",
  "5.5055.0" => "Erhöht den Sprengradius explodierender Gegner.",
  "5.5056.0" => "Verlängert die Dauer von Schaden über Zeit.",
  "5.5057.0" => "Angriffe halten Gegner länger in der Luft.",
  "5.5058.0" => "Erhöhter Schaden dauert länger an.",
  "5.5059.0" => "Erhöhter Schaden wirkt auf mehrere Feinde.",
  "5.5060.0" => "Erhöht Schaden gegen K!K"K%L1L?LBLXLY.",
  "5.5061.0" => "Erhöht Schaden gegen K&K'K#.",
  "5.5062.0" => "Erhöht Schaden gegen K)K(K,K}.",
