  "0.26.0" => "Continuez et activez l'A6interrupteurR restant !",
  "0.28.0" => "Vous avez ouvert toutes les écluses !",
  "0.29.0" => "Éliminez le A2gardien de la porteR et rejoignez A0%1sF0R !",
  "0.30.0" => "Vous avez sauvé A0%1sF0R et obtenu le miroir de vérité !",
  "0.31.0" => "Les conditions de défaite ont changé !",
  "0.32.0" => "Ne pas laisser A0%1sF0R fuir !",
  "0.33.0" => "Le miroir de vérité a révélé un A6passage secretR !",
  "0.34.0" => "La ruse de A0%2sF0R a fait apparaître A0%1sF3R !",
  "0.35.0" => "A0%1sF4R est en mauvaise posture et se replie dans A0%2sF0R !",
  "0.37.0" => "Vous avez vaincu A0%1sF0R !",
  "0.38.0" => "A0%1sF4R a atteint A0%2sF0R !",
