Map {
  "1.0.0.0" => "Ehi Link, ascolta! Non ci posso credere!
Quest'isola fluttua nel cielo!",
  "1.0.1.0" => "Ah! Sottometterò tutti gli esseri di questa
terra, nessuno escluso!",
  "1.0.2.0" => "Volga è così borioso. Ha dimenticato
che sono io, Ghiraim, il capo dei demoni.",
  "1.0.3.0" => "Argh... Oltrenuvola non resisterà a lungo...!",
  "1.0.4.0" => "Chi guida l'armata dei demoni? A quanto
pare quel cavaliere drago... Prendiamolo!",
  "1.0.5.0" => "C'è già un mucchio di nemici vicino alla
nostra base! Dovete fare attenzione!",
  "1.0.7.0" => "Dei fulmini si stanno abbattendo vicino alla
base e i nemici non possono avvicinarsi!",
  "1.0.8.0" => "Devo proteggere la base degli umani da
quegli esseri malvagi...",
  "1.0.9.0" => "Quello è Narisha, il grande spirito dei cieli.
Ci darà un bel po' di filo da torcere.",
  "1.0.10.0" => "Qualcuno mi aiuti! Stanno rubando la
zuppa destinata a Narisha!",
  "1.0.11.0" => "Quella zuppa ci serve per chiedere
a Narisha di ricongiungere i percorsi...",
  "1.0.12.0" => "Recuperiamo quella zuppa! Andiamo alla
statua della dea a dare una mano!",
  "1.0.13.0" => "Oh! Sei qui per aiutarci! Questa zuppa è
davvero importante! Dobbiamo stare attenti!",
  "1.0.14.0" => "Ah... Non ce la faccio...
Qualcuno... prenda... la zuppa...!",
  "1.0.15.0" => "Accidenti! I nemici ci danno dentro!
Andiamo subito verso la statua della dea!",
  "1.0.16.0" => "Link... aspetto nel presidio della statua
della dea...",
  "1.0.17.0" => "Hai sentito quella voce? Qualcuno vuole
che andiamo sotto la statua della dea...",
  "1.0.18.0" => "Link... Finché non avrò portato a termine
questa missione, tu sarai il mio signore.",
  "1.0.19.0" => "Invocate Narisha con la zuppa!
I nostri uomini sono esausti!",
  "1.0.20.0" => "Zuppa di zucca... Ricevuto.
La porterò io.",
  "1.0.21.0" => "Puoi aiutare anche i nostri compagni?
Sono bloccati a nord dell'accademia.",
  "1.0.22.0" => "Non possiamo lasciare nessuno indietro!
Andiamo ad aiutarli!",
  "1.0.23.0" => "Oh... Ma come potete aiutarli se la strada
è bloccata?",
  "1.0.24.0" => "Gli abitanti dell'isola dicono che possiamo
chiedere a Narisha di sistemare la strada!",
  "1.0.25.0" => "Possibilità di avanzare usando la zuppa per
evocare Narisha: elevata. La porterò io.",
  "1.0.26.0" => "Trasporto della zuppa completato...",
  "1.0.27.0" => "Oh oh! Questa zuppa mi piace tantissimo!
È per me?",
  "1.0.28.0" => "Se conquistiamo la base, la vittoria sarà
comunque nostra.",
  "1.0.29.0" => "Faih presta aiuto agli alleati. Nel frattempo,
occuparsi del comandante nemico.",
  "1.0.30.0" => "Il comandante nemico... Oh, vorrà dire che
dobbiamo eliminare quell'essere spregevole?",
  "1.0.32.0" => "Grazie! Ma abbiamo un'altra richiesta...
Porta questa zuppa alla rupe a ovest.",
  "1.0.33.0" => "Ugh... Dobbiamo fermarci... Portate...
questa zuppa di zucca alla rupe a ovest...",
  "1.0.34.0" => "Confermato miglioramento del morale del
nemico. È necessaria molta prudenza.",
  "1.0.35.0" => "Trasporto della zuppa verso destinazione.",
  "1.0.36.0" => "Probabilità che la consegna determini
condizioni di battaglia favorevoli: 85%.",
  "1.0.37.0" => "È giunta l'ora di distruggere quegli
insetti nella loro base!",
  "1.0.38.0" => "Oh no! Si dirigono verso la nostra base!",
  "1.0.39.0" => "Grrr, che seccatura...
Volga, vedi di renderti utile!",
  "1.0.40.0" => "Faih a rapporto. Trasporto della seconda
zuppa effettuato.",
  "1.0.41.0" => "Oh oh oh... Mi avete chiamato?
Volete che ricolleghi la strada?",
  "1.0.42.0" => "Confermata riconnessione della strada.
Stabilito accesso alla base nemica.",
  "1.0.43.0" => "Ottimo! Ora possiamo sconfiggere il
loro capo!",
  "1.0.44.0" => "Armata nemica in marcia verso la base
alleata. Si consiglia di potenziare la difesa.",
  "1.0.45.0" => "Aaah, le cose si fanno interessanti.
Quando posso iniziare...?",
  "1.0.46.0" => "Finalmente sta uscendo!
Stavolta lo sconfiggeremo!",
  "1.0.47.0" => "Il mio sangue di drago ribolle nelle vene...
Forza, attaccatemi!",
  "1.0.48.0" => "Non è abbastanza!
Forza, ancora!",
  "1.0.49.0" => "Non farmi ridere!
Stai cercando di farmi il solletico?",
  "1.0.50.0" => "Che insolenza... Se fossi al pieno delle mie
forze, lo farei fuori in un batter d'occhio...",
  "1.0.51.0" => "Suggerimento: chiedere aiuto alla fata che
si trova qui per potenziare Narisha.",
  "1.0.52.0" => "La fata radiosa? Ma se non ci liberiamo
dei nemici non possiamo avvicinarci...",
  "1.0.53.0" => "Perfetto! Ora usa il cerchio magico e la
fata radiosa ti conferirà la sua forza!",
  "1.0.54.0" => "Suggerisco di usare il cerchio magico.",
  "1.0.55.0" => "Hai compreso la mia potenza ora? Ma
adesso basta, me ne vado a riposare...",
  "1.0.56.0" => "Uh... Tu...",
  "1.0.57.0" => "È debole. Ora è il momento giusto.
Distruggere Volga.",
  "1.0.58.0" => "Faih non ha forza a sufficienza per
fermare Volga.",
  "1.0.59.0" => "Faih è circondata!
Corriamo ad aiutarla!",
  "1.0.60.0" => "Se non vi foste intromessi, avrei
assaporato la vittoria...",
  "1.0.61.0" => "Abbiamo vinto! Ora possiamo tirare un
sospiro di sollievo!",
  "1.0.62.0" => "Ci avete fatto preoccupare...
Grazie davvero!",
  "1.0.63.0" => "Che risultato deludente... Devo eliminarli
e incrementare il potere dell'oscurità...",
  "1.0.64.0" => "Lasciamo che si godano il momento. La
prossima volta li distruggerò dall'interno!",
  "1.0.65.0" => "...",
  "1.0.66.0" => "La nostra base si è arresa!
Tutto è perduto...",
  "1.0.67.0" => "Impossibile continuare a combattere.
Sono spiacente.",
  "1.0.68.0" => "Qualcuno ci aiuti! Non possiamo
trasportare la zuppa in queste condizioni!",
  "1.0.69.0" => "Aiuto! Aiuto!
Questa preziosa zuppa è...",
  "1.0.70.0" => "Necessaria riconnessione delle strade
interrotte per combattere gli esseri malvagi.",
  "1.0.71.0" => "Capisco... Le strade sono interrotte,
giusto? Vedrò cosa posso fare...",
  "1.0.72.0" => "Mi spiace disturbarti... ma potresti portare
questa zuppa alla rupe a ovest?",
  "1.0.73.0" => "Aspetterò qui Narisha. Occupatevi voi del
comandante dei nemici.",
  "1.0.74.0" => "Io tratterrò Volga. Tu corri dalla fata
radiosa.",
  "1.0.75.0" => "Sembra che il lato sud sia sguarnito!
Attaccheremo da lì!",
  "1.0.76.0" => "Pensavi che non mi accorgessi di te?
Avrei altro da fare, ma dovrò eliminarti!",
  "1.0.77.0" => "Fermate quell'essere blu! Io intanto
distruggerò la base nemica!",
  "1.0.78.0" => "All'attacco! Prendete il loro presidio!",
  "1.0.79.0" => "Volga, non ti intromettere...
Le gesta eroiche sono affar mio...",
  "1.0.80.0" => "Minaccia al nostro presidio: eliminata.
Missione compiuta.",
  "1.0.81.0" => "Conquistiamo la loro base una volta
per tutte!",
  "1.0.82.0" => "È il mio momento di scendere in campo!",
  "1.0.83.0" => "Questo è un lavoro per me!",
  "1.0.84.0" => "Lizal: obiettivo inquadrato.
Affido obiettivo secondario: Dino.",
  "1.0.85.0" => "È troppo forte... per me...",
  "1.0.86.0" => "Nooo! Ho perso!!!",
  "1.0.87.0" => "Faih a rapporto: Lizal e Dino
in fuga. Missione compiuta.",
  "1.0.88.0" => "Faih a rapporto: nemici contro
base alleata annientati.",
  "1.0.89.0" => "Che state facendo?!
Tutte le truppe, all'attacco!!!",
  "13.0.0.0" => "Message",
  "13.0.1.0" => "Replacement message",
}