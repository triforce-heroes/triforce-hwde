  "0.42.0" => "A0%1sF0R si ritira dal fronte!",
  "0.43.0" => "L'area C1%1sF0R è stata conquistata dall'A0%2sF7R!",
  "0.44.0" => "A0%1sF0R fugge!",
  "0.45.0" => "L'A0%1sF1R ha perso la battaglia!",
  "0.46.0" => "Il morale di A0%1sF0R è migliorato!",
  "0.47.0" => "Presto, sconfiggi A0%1sF3R rimanenti!",
  "0.48.0" => "A0%1sF0R si prepara alla fuga!",
  "0.49.0" => "L'area A0%1sF0R si è aperta perché A0%2sF2R è in marcia!",
  "0.50.0" => "A0%2sF0R perde e parte dell'A0%1sF1R si ferma!",
  "0.51.0" => "L'A0%1sF1R si mette in marcia!",
  "0.52.0" => "Hai sconfitto 3 A0%1sF7R!",
