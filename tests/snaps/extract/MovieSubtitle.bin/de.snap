Map {
  "0.0.0" => "Das Triforce ist die Einheit von Kraft, Weisheit
und Mut.",
  "0.1.0" => "Seit jeher war es der Grund unzähliger Kämpfe
zwischen den Mächten des Lichts und der Finsternis.",
  "0.2.0" => "Wann immer das Triforce den Mächten des Bösen in
die Hände fiel, wurde Hyrule ins Unglück gestürzt.",
  "0.3.0" => "Doch immer erschien auch ein Held im grünen
Gewand, der dem Land den Frieden zurückbrachte.",
  "0.4.0" => "Es geschah in einem dieser dunklen Zeitalter, dass der
Held die Seele des Bösen in vier Fragmente teilte...",
  "0.5.0" => "...und sie versiegelte, um endlich den Kreislauf
der Zerstörung zu durchbrechen.",
  "0.6.0" => "Drei der Fragmente wurden über Raum und Zeit verstreut...",
  "0.7.0" => "Das letzte Fragment wurde in einem Tempel
auf geweihtem Grund mithilfe des legendären
Bannschwerts versiegelt.",
  "1.0.0" => "Seit Generationen erzählen sich die Hylianer die
Geschichte vom „Krieg jenseits der Zeiten“...",
  "1.1.0" => "Dies ist der Beginn dieser Legende...",
  "1.2.0" => "Tief in den Wäldern, den Blicken der Sterblichen
verborgen...",
  "1.3.0" => "...wachte eine mächtige Zauberin über
das Gleichgewicht des Triforce.",
  "1.4.0" => "Dank ihrer magischen Kräfte konnte sie die Zeiten
überblicken...",
  "1.5.0" => "...und das Schicksal jedes Lebewesens
erkennen, ohne jedoch jemals einzugreifen.",
  "1.6.0" => "Doch eines Tages erregte eine
besondere Seele ihre Aufmerksamkeit...",
  "1.7.0" => "Es war die Seele des legendären Helden,
der in Ewigkeit immer wiedergeboren wurde,
wenn Hyrule seiner Hilfe bedurfte...",
  "1.9.0" => "Ihre Magie hätte ihr zeigen müssen, dass die Seele
des Helden an eine andere Seele gebunden war.",
  "1.10.0" => "Aber sie erkannte nur, dass diese Seele
anders war als alle, die sie gekannt hatte.",
  "1.11.0" => "Dieser Moment der Ablenkung bot einem
Fragment der Finsternis die Gelegenheit,
sich aus seiner Gefangenschaft zu befreien.",
  "1.13.0" => "Die Finsternis schlich sich flüsternd in ihr Herz.",
  "1.14.0" => "Sie verdrängte das Licht und weckte in
ihr eine verzweifelte Begierde nach der
Seele des legendären Helden.",
  "1.16.0" => "Natürlich verfolgte das Böse damit ganz eigene Ziele...",
  "1.17.0" => "Es wollte die Macht des Triforce für seine
Auferstehung nutzen und Hyrule wieder
unter seine Herrschaft bringen.",
  "1.18.0" => "Nachdem das letzte Licht aus dem Herzen
der Zauberin verbannt war...",
  "1.19.0" => "...drängte die Finsternis sie, das Seelenportal
und damit den Weg durch die Zeiten zu öffnen.",
  "1.20.0" => "Ungeheuer aus allen Zeiten strömten aus den Portalen
und brachten einmal mehr Verderben über Hyrule.",
  "2.0.0" => "Impa...
Ich hatte schon wieder diese Vision...",
  "2.1.0" => "Vielleicht ist das ein Zeichen dunkler Zeiten für Hyrule...",
  "2.2.0" => "Dunkle Zeiten?",
  "2.3.0" => "Dann müssen wir ihn finden.",
  "2.4.0" => "Den Helden, der des legendären Gewandes würdig ist.",
  "2.5.0" => "Hier werden wir keine Helden finden...",
  "2.6.0" => "Es wäre klüger, sich anderweitig umzusehen.",
  "2.7.0" => "Euer Hoheit!",
  "2.8.0" => "Eine Armee von Ungeheuern nähert sich Hyrule!",
  "2.9.0" => "Macht euch kampfbereit!",
  "2.10.0" => "Sieh an! Ist das nicht die Prinzessin?",
  "2.11.0" => "Warum verschwendet sie ihre
Zeit damit, uns zuzusehen?",
  "2.12.0" => "Prinzessin Zelda scheint in Schwierigkeiten zu sein...",
  "2.13.0" => "Link!",
  "2.14.0" => "Was hast du vor?",
  "2.15.0" => "Zelda",
  "2.16.0" => "Impa",
  "2.17.0" => "Zelda",
  "2.18.0" => "Impa",
  "2.19.0" => "Impa",
  "2.20.0" => "Impa",
  "2.21.0" => "Impa",
  "2.22.0" => "Soldat",
  "2.23.0" => "Soldat",
  "2.24.0" => "Zelda",
  "2.25.0" => "Rekrut",
  "2.26.0" => "Rekrut",
  "2.27.0" => "Rekrut",
  "2.28.0" => "Rekrut",
  "2.29.0" => "Rekrut",
  "3.0.0" => "Sammelt euch um mich!",
  "3.1.0" => "Seelenportal... Höre meine Stimme... Öffne dich!",
  "3.2.0" => "Meine Seele wird frei sein!",
  "3.3.0" => "Ha!",
  "3.4.0" => "Gute Arbeit, mein Kind.",
  "3.5.0" => "Drei Fragmente meiner Seele sind wieder vereint...",
  "3.6.0" => "Es fehlt nur noch das letzte, das durch
das Master-Schwert festgehalten wird.",
  "3.7.0" => "Lana",
  "3.8.0" => "???",
  "3.9.0" => "???",
  "3.10.0" => "Cia",
  "3.11.0" => "???",
  "3.12.0" => "???",
  "3.13.0" => "???",
  "4.0.0" => "Vergebt mir, dass ich euch nichts gesagt hatte.",
  "4.1.0" => "Ich musste mich vor meinen Feinden verstecken.",
  "4.2.0" => "Link, dein Mut ist wahrlich außergewöhnlich.",
  "4.3.0" => "Schon bei unserer ersten Begegnung konnte
ich spüren, dass du jemand Besonderes bist.",
  "4.4.0" => "Wir haben die Seelenportale versiegelt und so
Raum und Zeit wieder ins Gleichgewicht gebracht.",
  "4.5.0" => "Als Nächstes...",
  "4.6.0" => "Moment mal! Schuldest du uns
nicht erst einmal eine Erklärung?",
  "4.7.0" => "Ja... stimmt.",
  "4.8.0" => "Ich hatte euch ja gesagt, dass Cia und ich vom
selben Clan stammen. Das ist nicht so ganz richtig...",
  "4.9.0" => "Cia und ich... Wir sind ein und dieselbe Person.",
  "4.10.0" => "Was!?",
  "4.11.0" => "Etwas hat von Cias Geist Besitz
ergriffen und das Licht aus ihr vertrieben.",
  "4.12.0" => "Dieses Licht bin ich. Ich bin jener Teil Cias,
der aus ihrem Geist vertrieben wurde.",
  "4.13.0" => "Und verantwortlich für diese Untat ist...",
  "4.14.0" => "Nutzlose Kreatur...",
  "4.15.0" => "Wer...?",
  "4.16.0" => "Ich besitze jetzt drei Fragmente meiner Seele.",
  "4.17.0" => "Meine Kraft mag noch nicht wiederhergestellt
sein, aber mein Körper ist es.",
  "4.18.0" => "Du!",
  "4.19.0" => "Cia, du warst mir meine bisher liebste Marionette.",
  "4.20.0" => "Was!? Ich bin kein Werkzeug, das
du nach Belieben benutzen kannst!",
  "4.21.0" => "Das ist alles nicht mehr von Belang...
Die letzte Barriere kann ich auch allein brechen.",
  "4.22.0" => "Andererseits hat dieser Körper
seine volle Stärke noch nicht erreicht...",
  "4.23.0" => "Doch die Allmacht der Göttinnen...",
  "4.24.0" => "Ihre Macht würde reichen, um mir zu alter
Stärke zu verhelfen und dieses Land unter
meine Herrschaft zu bringen.",
  "4.25.0" => "Das Triforce...",
  "4.26.0" => "...gehört mir!",
  "4.27.0" => "Was?!",
  "4.28.0" => "Törichtes Kind!",
  "4.29.0" => "Mut und Weisheit werden dir niemals gehören!",
  "4.30.0" => "Aargh!",
  "4.31.0" => "Das Triforce wird mein sein.
Es gehört mir, mir ganz allein!",
  "4.32.0" => "Genau wie der Held...",
  "4.33.0" => "Zelda",
  "4.34.0" => "Zelda",
  "4.35.0" => "Zelda",
  "4.36.0" => "Zelda",
  "4.37.0" => "Lana",
  "4.38.0" => "Lana",
  "4.39.0" => "Midna",
  "4.40.0" => "Lana",
  "4.41.0" => "Lana",
  "4.42.0" => "Lana",
  "4.43.0" => "Zelda",
  "4.44.0" => "Lana",
  "4.45.0" => "Lana",
  "4.46.0" => "Lana",
  "4.47.0" => "???",
  "4.48.0" => "Cia",
  "4.49.0" => "???",
  "4.50.0" => "???",
  "4.51.0" => "Cia",
  "4.52.0" => "Ganondorf",
  "4.53.0" => "Cia",
  "4.54.0" => "Ganondorf",
  "4.55.0" => "Ganondorf",
  "4.56.0" => "Ganondorf",
  "4.57.0" => "Ganondorf",
  "4.58.0" => "Cia",
  "4.59.0" => "Cia",
  "4.60.0" => "Ganondorf",
  "4.61.0" => "Ganondorf",
  "4.62.0" => "Cia",
  "4.63.0" => "Ganondorf",
  "4.64.0" => "Cia",
  "4.65.0" => "Cia",
  "5.0.0" => "Cia...",
  "5.1.0" => "Wir sind uns gleich... Wir beide sehnen uns nach
jemandem, mit dem wir nicht zusammen sein können.",
  "5.2.0" => "Kannst du deine Gefühle für immer
verschlossen halten?",
  "5.3.0" => "Ganz gleich in welcher Zeit, das Band
zwischen ihnen ist unvorstellbar stark.
Es zu brechen ist unmöglich.",
  "5.4.0" => "Haha... Du bist einfach zu brav.",
  "5.5.0" => "Der Rest liegt in euer aller Hände.",
  "5.6.0" => "Bringen wir das Licht zurück nach Hyrule.",
  "5.7.0" => "Damit sollten die Dinge wieder
so sein, wie sie einst waren.",
  "5.8.0" => "Und damit ist es für mich Zeit zu gehen...",
  "5.9.0" => "Lana...",
  "5.10.0" => "Werden wir uns wiedersehen?",
  "5.11.0" => "Lebt wohl...",
  "5.12.0" => "Lana",
  "5.13.0" => "Cia",
  "5.14.0" => "Cia",
  "5.15.0" => "Lana",
  "5.16.0" => "Cia",
  "5.17.0" => "Midna",
  "5.18.0" => "Zelda",
  "5.19.0" => "Lana",
  "5.20.0" => "Lana",
  "5.21.0" => "Zelda",
  "5.22.0" => "Zelda",
  "5.23.0" => "Lana",
  "6.0.0" => "Bleibt nur noch eines...",
  "6.1.0" => "Wir müssen das Master-Schwert
an seinen Platz zurückbringen.",
  "6.2.0" => "Aber das ist nicht meine Aufgabe.",
  "6.3.0" => "Ihr beide habt Hyrule einmal
mehr den Frieden gebracht.",
  "6.4.0" => "Lebewohl... Link...",
  "6.5.0" => "Link!",
  "6.6.0" => "Lana",
  "6.7.0" => "Lana",
  "6.8.0" => "Lana",
  "6.9.0" => "Lana",
  "6.10.0" => "Lana",
  "6.11.0" => "Zelda",
  "43.0.0" => "Hmm...",
  "43.1.0" => "Hey, Linkle!",
  "43.2.0" => "Hast du gehört?
Schloss Hyrule wird von Monstern angegriffen!",
  "43.3.0" => "Waaas? Im Ernst?!",
  "43.4.0" => "Selbst Prinzessin Zelda kann nicht viel gegen sie ausrichten.
Ich hoffe nur, die kommen nicht bis in unser Dorf...",
  "43.5.0" => "Was ist denn das für ein komisches Gewand?",
  "43.6.0" => "Ist doch klar! Ich werde diese Monster aufhalten!",
  "43.7.0" => "Meine Oma hat es immer gewusst...
Ich bin die Wiedergeburt des legendären Helden!",
  "43.8.0" => "So ein Zeug sagen doch alle Omas...",
  "43.9.0" => "Hier!",
  "43.10.0" => "Diesen Kompass habe ich von meiner Oma.
Das ist das Zeichen des Helden!",
  "43.11.0" => "Und jetzt lasst mich gehen. Hyrule braucht mich!",
  "43.12.0" => "Linkle",
  "43.13.0" => "Dorfbewohner",
  "43.14.0" => "Dorfbewohner",
  "43.15.0" => "Linkle",
  "43.16.0" => "Dorfbewohner",
  "43.17.0" => "Dorfbewohner",
  "43.18.0" => "Linkle",
  "43.19.0" => "Linkle",
  "43.20.0" => "Dorfbewohner",
  "43.21.0" => "Linkle",
  "43.22.0" => "Linkle",
  "43.23.0" => "Linkle",
  "44.4.0" => "Du hast gut gekämpft.",
  "44.5.0" => "Als legendärer Held habe ich nur meine Pflicht getan!",
  "44.6.0" => "Meine Oma wäre sicher stolz!",
  "44.7.0" => "Haha! Da bin ich mir sicher!",
  "44.12.0" => "Impa",
  "44.13.0" => "Linkle",
  "44.14.0" => "Linkle",
  "44.15.0" => "Impa",
  "45.0.0" => "Es hat sich ein weiteres Portal aufgetan.
Kannst du das überprüfen?",
  "45.1.0" => "Ich sollte mitgehen.",
  "45.2.0" => "Nein. Wir beide werden hier gebraucht.",
  "45.3.0" => "Link. Ich muss dich bitten, diese Aufgabe zu übernehmen.",
  "45.4.0" => "Was... Was ist gerade passiert?",
  "45.5.0" => "Impa",
  "45.6.0" => "Zelda",
  "45.7.0" => "Impa",
  "45.8.0" => "Impa",
  "45.9.0" => "Tetra",
  "46.0.0" => "Die Zukunft dieses Landes ist von Licht erfüllt.",
  "46.1.0" => "Auf Wiedersehen... irgendwann einmal!",
  "46.2.0" => "Gehen wir.
Lass uns die Welt wieder ins Lot bringen!",
  "46.3.0" => "König Daphnos",
  "46.4.0" => "Tetra",
  "46.5.0" => "Lana",
  "49.0.0" => "Linkle verließ ihr Dorf und schwor,
Hyrule den Frieden wiederzubringen.",
  "49.1.0" => "Sie marschierte los, den Kompass
ihrer Großmutter fest in der Hand.",
  "49.2.0" => "Doch sie kam nicht weit, bevor ein
schelmischer Kobold ihren Schatz stahl.",
  "49.3.0" => "Linkle jagte dem Kobold hinterher, um
ihren Kompass zurückzuerlangen.",
  "49.4.0" => "Dann geschah etwas Seltsames...",
  "49.5.0" => "Als ob er Linkle helfen wollte, begann der
Kompass, ein geheimnisvolles Licht auszustrahlen.",
  "49.6.0" => "Er schien auf sie zu reagieren! Linkle hängte
ihn sich wieder um und schwor sich, ihn
niemals wieder zu verlieren.",
  "49.7.0" => "Das Licht des Kompasses stellte
sie vor ein Rätsel.",
  "49.8.0" => "Was für eine Kraft wohnte ihm
wohl inne?",
  "49.9.0" => "Es musste ein Zeichen sein, dass sie
wirklich der legendäre Held war.",
  "49.10.0" => "Wenn sie diese Kraft nutzen könnte, würde
sich vielleicht ihr Schicksal erfüllen, und sie
könnte Hyrule retten.",
  "49.11.0" => "In ihrer Überzeugung gestärkt setzte
Linkle ihre Mission fort.",
  "50.0.0" => "Midna und Linkle eilten zum Schattenpalast, um
Zelda zu retten und die böse Magie aufzuhalten.",
  "50.1.0" => "Obwohl sie den Kampf gewonnen hatten, verschlang
die Schattenmagie weiterhin alles um sich herum.",
  "50.2.0" => "Midna fasste einen mutigen Entschluss.
Sie würde den Kristall zertrümmern, den
sie im Palast gefunden hatten.",
  "50.3.0" => "Sie glaubte, dass so vielleicht genug Energie
frei würde, um die Schatten einzudämmen.",
  "50.4.0" => "Dieser Plan würde jedoch auch zur Folge
haben, dass Midna wieder ihre verfluchte
Gestalt annähme.",
  "50.5.0" => "Doch Midna zahlte ohne Zögern diesen Preis, da
sie wusste, dass Zeldas Leben schwerer wog.",
  "50.6.0" => "Midnas Entschlossenheit beeindruckte Linkle tief.",
  "50.7.0" => "Mit einem neu entfachten Feuer in den
Augen eilte sie Richtung Schloss Hyrule.",
  "51.0.0" => "In der neuen Welt traf Link auf die
Piratenanführerin Tetra. Zusammen
kämpften sie tapfer gegen die Monster.",
  "51.1.0" => "Aber der Feind schien stärker, als sie gedacht hatten...",
  "51.2.0" => "Nach dem Sieg sah Link einen riesigen
Vogel davonfliegen.",
  "51.3.0" => "Bei genauerem Hinsehen erkannte er,
dass der Vogel etwas in den Krallen trug.",
  "51.4.0" => "Nicht etwas – jemanden!
Es war Tetra!",
  "51.5.0" => "Wenn Link nichts täte, wäre sie verloren!",
  "51.6.0" => "Ohne zu zögern, rannte er los, um sie zu retten.",
  "52.0.0" => "Lana und Link gelang es, Tetra zu retten
und alle Seelenportale zu schließen.",
  "52.1.0" => "Aber die Verwandlung, der Hyrule unterworfen
worden war, schien unumkehrbar.",
  "52.2.0" => "Lana, Link und Tetra hatten keine Ahnung, wie
sie alles wieder in Ordnung bringen sollten.",
  "52.3.0" => "In diesem Augenblick, in der Stunde der
größten Not, erschien eine Figur aus
den Legenden leibhaftig vor ihnen.",
  "52.4.0" => "Es war König Daphnos Nohansen von
Hyrule, der Rote Leuenkönig selbst!",
  "52.5.0" => "König Daphnos war in Tetras Welt der
Herrscher eines antiken Reiches gewesen,
das für immer versiegelt worden war.",
  "52.6.0" => "Auf göttliches Geheiß zeigte er sich in der
Hoffnung, das Unheil von der Welt
abwenden zu können.",
  "52.7.0" => "Er erklärte ihnen, dass die Ursache des
Unheils in Tetras Welt zu finden war.",
  "52.8.0" => "Jetzt sahen die Helden ihr Ziel klar vor Augen.",
  "52.9.0" => "In Erwartung eines harten Kampfes brachen
sie zu ihrer nächsten Reise auf.",
  "53.0.0" => "So kehrte in Hyrule wieder Frieden ein.",
  "53.1.0" => "Lana und Cia verabschiedeten sich von Link
und den anderen und kehrten als Hüterinnen
der Zeit ins Tal der Seher zurück.",
  "53.2.0" => "Kraft...
Weisheit...",
  "53.3.0" => "Mut.",
  "53.4.0" => "Gemeinsam würden sie das Gleichgewicht des
Triforce schützen – eines Willens und eines Sinnes.",
}