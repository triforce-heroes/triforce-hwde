Map {
  "0.0.0" => "A0%1sF1R si mettono in marcia!",
  "0.1.0" => "A0%1sF0R si mette in marcia verso l'area A0%2sF6R!",
  "0.2.0" => "L'area C1%1sF0R è stata conquistata dall'A0%2sF7R!",
  "0.3.0" => "Il morale dell'A0%1sF1R è peggiorato perché il presidio è caduto!",
  "0.4.0" => "L'A0%1sF7R ha conquistato l'area C2%2sF2R! Riprendila!",
  "0.5.0" => "Hai sconfitto un A0%1sF6R!",
  "0.6.0" => "Sconfiggi l'altro A0%1sF6R!",
  "0.7.0" => "A0%1sF0R ha evocato A0%2sF6R!",
  "0.8.0" => "A0%1sF0R scaglia un A2attacco di semiR sull'area A0%2sF6R!",
  "0.9.0" => "Sconfiggi A0%1sF2R per fermare l'A2attacco di semiR!",
  "0.10.0" => "A0%1sF0R va verso A0%2sF6R!",
  "0.11.0" => "Hai sconfitto A0%1sF6R!",
  "0.12.0" => "Hai sconfitto 2 A0%1sF0R!",
  "0.13.0" => "Riconquista l'area C2%1sF2R!",
  "0.14.0" => "Riconquista l'area C2%1sF2R!",
  "0.15.0" => "Riconquista le aree C2%1sF4R e C2%2sF2R!",
  "0.16.0" => "Hai difeso le aree C1%1sF4R e C1%2sF2R!",
  "0.17.0" => "A0%1sF0R e A0%2sF3R ti hanno tradito!",
  "0.18.0" => "A0%1sF0R è più forte grazie a una magia!",
  "0.19.0" => "Sconfiggi A0%2sF3R che si dirigono verso l'area A0%1sF6R!",
  "0.20.0" => "A0%1sF0R ha evocato A0%2sF3R!",
  "0.21.0" => "A0%1sF0R si ritira temporaneamente per attaccare A0%2sF2R!",
  "0.22.0" => "A0%1sF0R attacca A0%2sF2R!",
  "0.23.0" => "A0%1sF0R crea una A2barriera di tenebreR nell'area A0%2sF6R!",
  "0.24.0" => "A0%1sF0R si ritira temporaneamente!",
  "0.25.0" => "A0%1sF0R ha evocato A2potenti demoniR!",
  "0.26.0" => "A0%1sF0R si indebolisce per il consumo dei poteri magici!",
  "0.27.0" => "A0%1sF0R evoca altri A2potenti demoniR!",
  "0.28.0" => "Hai sconfitto A0%1sF2R!",
  "0.29.0" => "A0%1sF0R ha evocato dei A2demoniR!",
  "0.30.0" => "Dei presidi dell'A0%1sF5R si sono aperti!",
  "0.31.0" => "A0%1sF0R appare di nuovo!",
  "0.32.0" => "Parte dell'A0%1sF5R è in fuga!",
  "0.33.0" => "A0%1sF0R appare nell'area A0%2sF6R!",
  "0.34.0" => "Le condizioni di sconfitta sono cambiate!",
  "0.35.0" => "A0%1sF0R scappa o l'area A0%2sF4R cade!",
  "0.36.0" => "A0%1sF0R amplifica i poteri magici nella A2barriera di tenebreR!",
  "0.37.0" => "A0%1sF0R va verso l'area C2%2sF6R!",
  "0.38.0" => "Scorta A0%2sF2R fino all'area C2%1sF6R!",
  "0.39.0" => "La A2barriera di tenebreR ti fa perdere energia!",
  "0.40.0" => "A0%1sF0R ha raggiunto l'area C2%2sF6R!",
  "0.41.0" => "A0%1sF0R ha eliminato la A2barriera di tenebreR con la magia!",
  "0.42.0" => "Sconfiggi A0%1sF2R!",
  "0.43.0" => "A0%1sF0R ha amplificato i suoi poteri magici ed è più forte!",
  "0.44.0" => "Presto, sconfiggi A0%1sF2R!",
  "0.45.0" => "A0%1sF0R ha amplificato i suoi poteri magici ed è ancora più forte!",
  "0.46.0" => "Hai sconfitto A0%1sF4R!",
  "0.47.0" => "A0%1sF0R si ritira dal fronte!",
  "0.48.0" => "L'area C1%1sF0R è stata conquistata dall'A0%2sF7R!",
  "0.49.0" => "L'A0%1sF1R ha perso la battaglia!",
  "0.50.0" => "A0%1sF0R è in fuga!",
  "0.51.0" => "L'A0%1sF1R ha conquistato l'area C2%2sF0R!",
  "0.52.0" => "A0%1sF0R ha perso e l'A2attacco di semiR si è fermato!",
  "0.53.0" => "L'A0%1sF1R si mette in marcia!",
  "0.54.0" => "A0%1sF1R vanno verso A0%2sF2R!",
  "0.55.0" => "A0%1sF0R consuma i suoi poteri magici ed è ancora più debole!",
  "0.56.0" => "Adesso sconfiggi A0%1sF2R!",
  "0.57.0" => "L'area A0%1sF0R non deve cadere!",
  "0.58.0" => "Presto, sconfiggi A0%1sF2R!",
  "0.59.0" => "L'A0%1sF1R va verso A0%2sF2R!",
  "0.60.0" => "L'area C2%1sF0R è aperta!",
  "0.61.0" => "A0%1sF0R è più debole dopo la distruzione della A2barriera di tenebreR!",
  "0.62.0" => "Il morale dell'A0%1sF1R è migliorato!",
  "0.63.0" => "Presto, sconfiggi A0%1sF2R!",
  "0.64.0" => "A0%1sF0R si rimette in marcia!",
  "0.65.0" => "Hai sconfitto 3 A0%1sF7R!",
  "0.66.0" => "Sconfiggi subito A0%1sF2R!",
  "0.67.0" => "Parte dell'A0%1sF1R va verso l'area C2%2sF0R!",
  "0.68.0" => "A2Potenti demoniR vanno verso l'area A0%1sF0R!",
  "0.69.0" => "Sconfiggi i A2potenti demoniR che avanzano dalle A6rovineR!",
  "0.70.0" => "Hai sconfitto A0%1sF3R!",
  "0.71.0" => "L'area C2%1sF0R è aperta! A0%2sF1R avanzano!",
  "0.72.0" => "A0%1sF1R non hanno invaso l'area A0%2sF4R!",
  "0.73.0" => "A0%1sF0R ha invaso le A6rovineR!",
  "0.74.0" => "Il morale dell'A0%1sF7R peggiora dopo l'attacco dell'A0%2sF1R!",
  "0.75.0" => "A0%1sF1R e A0%2sF2R scendono in campo!",
  "0.76.0" => "A0%2sF0R ha potenziato A0%1sF3R!",
  "0.77.0" => "A0%1sF0R evoca A2demoniR vicino a A0%2sF6R!",
  "0.78.0" => "L'A0%2sF7R circonda e blocca A0%1sF2R!",
  "0.79.0" => "A0%1sF0R si rimette in marcia!",
  "0.80.0" => "A0%1sF0R ha raggiunto l'area C2%2sF6R! Hai aiutato Lana!",
  "0.81.0" => "Ora puoi controllare A0%1sF2R!",
  "0.82.0" => "A0%1sF0R ha perso e A0%2sF3R sono più deboli!",
  "0.83.0" => "L'A0%2sF5R ha messo in fuga A0%1sF2R!",
  "0.84.0" => "L'A0%1sF1R ha perso!",
  "0.85.0" => "Un'A6AracnulaR è stata avvistata sul campo di battaglia!",
