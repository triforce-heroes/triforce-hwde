Map {
  "0.0.0" => "Sconfiggi A0%1sF2R alla A6porta est del tempioR!",
  "0.1.0" => "Sconfiggi A0%1sF2R ed entra nel A6tempioR!",
  "0.2.0" => "Parte dell'A0%1sF5R ha tradito!",
  "0.3.0" => "Sconfiggi A0%1sF3R!",
  "0.4.0" => "Un'altra fazione dell'A0%1sF3R ha tradito!",
  "0.5.0" => "Parte dell'A0%1sF3R è fuggita!",
  "0.6.0" => "Sconfiggi A0%1sF2R che si trova da qualche parte nel A6presidioR!",
  "0.7.0" => "Raggiungi la A6destinazioneR dell'armata di Cia e sconfiggi A0%1sF2R!",
  "0.8.0" => "Raggiungi il A6presidio pacificoR e sconfiggi A0%1sF2R!",
  "0.9.0" => "Hai trovato A0%1sF2R!",
  "0.10.0" => "Il morale A0%1sF7R è migliorato!",
  "0.11.0" => "Tutta l'A0%1sF3R si dirige verso l'area C1%2sF0R!",
  "0.12.0" => "Sconfiggi A0%1sF2R!",
  "0.13.0" => "A0%1sF1R hanno perso!",
  "0.14.0" => "A0%1sF0R appare nell'area C1%2sF0R!",
  "0.15.0" => "A0%1sF0R ha perso!",
  "0.16.0" => "A0%1sF0R è in campo!",
  "0.17.0" => "Prima che raggiunga l'area C1%1sF6R sconfiggi A0%2sF2R!",
  "0.18.0" => "A0%1sF0R si mette in marcia verso l'A0%2sF3R!",
  "0.19.0" => "A0%1sF0R ha raggiunto l'area A0%2sF6R!",
  "0.20.0" => "Usa la A6badopultaR per attaccare A0%1sF2R!",
  "0.21.0" => "Sconfiggi A0%2sF2R prima che l'area C1%1sF4R ceda!",
  "0.22.0" => "Il morale di tutta l'A0%1sF5R è peggiorato!",
  "0.23.0" => "A0%1sF0R ha perso!",
  "0.24.0" => "Vai in fondo al A6tempio del sigilloR e sconfiggi A0%1sF2R!",
  "0.25.0" => "A0%1sF0R ha perso!",
  "0.26.0" => "L'area C1%1sF0R è stata conquistata dall'A0%2sF7R!",
  "0.27.0" => "L'A0%1sF1R ha perso la battaglia!",
  "0.28.0" => "A0%1sF0R è in fuga!",
  "0.29.0" => "L'A0%1sF1R ha vinto la battaglia!",
  "0.30.0" => "Sconfiggi A0%1sF2R e chiudi la A6porta delle animeR!",
  "0.31.0" => "Sembra che i soldati dell'A0%1sF1R si moltiplichino!",
  "0.33.0" => "Hai raggiunto la A6%1sF4R!",
  "0.34.0" => "A0%1sF0R ha analizzato l'area, restringendo il campo di ricerca!",
  "0.35.0" => "A0%1sF1R si dirigono verso l'area A0%2sF0R!",
  "0.36.0" => "L'analisi di A0%1sF6R ha ristretto ancora il campo di ricerca!",
  "0.37.0" => "Il A2capo dei traditoriR si nasconde in un A6presidioR vicino!",
  "0.38.0" => "Presto, trova e sconfiggi A0%1sF2R!",
  "0.39.0" => "A0%1sF4R appare nell'area C1%2sF0R!",
  "0.40.0" => "La A6%1sF0R è aperta!",
  "0.41.0" => "L'area C1%1sF4R non deve cadere!",
  "0.42.0" => "A0%1sF0R ha distrutto l'area A0%2sF2R!",
  "0.43.0" => "A0%1sF0R si dirige verso l'area A0%2sF2R!",
  "0.44.0" => "A0%1sF0R ha raggiunto la A6porta ovest del tempioR!",
  "0.45.0" => "A0%1sF0R ha raggiunto l'area A0%2sF2R!",
  "0.46.0" => "La A6%1sF4R si è aperta e il A2guardaportaR combatte!",
  "0.47.0" => "La A6%1sF0R si è aperta!",
  "0.48.0" => "Attacca A0%1sF2R alle A6dita dei piediR!",
  "0.49.0" => "Tutte le porte A6del tempioR sono aperte!",
  "0.50.0" => "L'A0%1sF1R ha cominciato un attacco generale!",
  "0.51.0" => "A0%1sF0R si mette in marcia verso A6ovest del tempioR!",
  "0.52.0" => "A0%1sF0R si mette in marcia verso A6est del tempioR!",
  "0.53.0" => "Attenzione, A0%1sF2R non deve ritirarsi!",
  "0.54.0" => "Comincia lo scontro con A0%1sF2R!",
  "0.55.0" => "A0%1sF0R ha raggiunto l'A6entrata ovest del tempioR!",
  "0.56.0" => "A0%1sF0R va verso l'A6entrata ovest del tempioR!",
  "0.57.0" => "A0%2sF0R è KO e il morale dell'A0%1sF1R è migliorato!",
  "0.58.0" => "A0%1sF1R hanno abbandonato il campo di battaglia!",
  "0.59.0" => "A0%1sF0R si mette in marcia verso l'area A0%2sF0R!",
  "0.60.0" => "Conquista l'area C2%1sF0R!",
  "0.61.0" => "Insegui A0%1sF2R!",
  "0.62.0" => "A0%1sF0R è caduto a terra!",
  "0.63.0" => "L'A0%1sF3R si mette in marcia verso l'area A0%2sF2R!",
  "0.64.0" => "Un'A6AracnulaR è stata avvistata sul campo di battaglia!",
  "0.65.0" => "Cerca l'A6AracnulaR!",
  "0.66.0" => "Hai ottenuto l'A6AracnulaR!",
  "0.67.0" => "L'A6AracnulaR sta per fuggire!",
  "0.68.0" => "L'A6AracnulaR è fuggita!",
  "0.69.0" => "L'A0%1sF1R ha conquistato l'area C2%2sF2R!",
  "0.70.0" => "A0%1sF0R ha distrutto l'area A0%2sF2R!",
  "0.71.0" => "A0%1sF1R si ritirano!",
  "0.72.0" => "A0%1sF0R si rimette in marcia verso l'area A0%2sF2R!",
  "0.73.0" => "Rinforzi dell'A0%1sF1R sono apparsi A6nel tempioR!",
  "0.74.0" => "Presto, sconfiggi A0%1sF2R prima che prepari l'attacco!",
  "0.75.0" => "Non ce l'hai fatta a sconfiggere A0%1sF2R!",
  "0.76.0" => "A0%1sF2R ha distrutto l'area C1%2sF2R!",
  "0.77.0" => "L'area A0%1sF0R è aperta!",
  "0.78.0" => "Conquista l'area C2%1sF0R!",
  "0.79.0" => "Attacca A0%1sF2R con la A6badopultaR!",
  "0.80.0" => "Secondo l'analisi di A1ProxiR, l'area di ricerca si è ristretta!",
  "0.81.0" => "Secondo l'analisi di A1ProxiR, l'area di ricerca si è ristretta ancora di più!",
  "0.82.0" => "Sconfiggi la guardia della A6%1sF4R!",
  "0.83.0" => "A0%1sF0R comincia a recuperare energia con la magia!",
  "0.84.0" => "A0%1sF0R recupera energia con la magia!",
  "0.85.0" => "Presto, usa la A6badopultaR!",
  "0.86.0" => "A0%1sF1R vanno verso l'area A0%2sF0R!",
  "0.87.0" => "A0%1sF0R evoca A0%2sF3R dalla A6porta delle animeR!",
  "0.88.0" => "A0%2sF0R avanza e il morale dell'A0%1sF1R migliora!",
  "0.89.0" => "Ora puoi controllare A0%1sF2R!",
  "0.90.0" => "L'attacco dell'A0%2sF5R ha messo in fuga A0%1sF2R!",
  "0.91.0" => "L'A0%1sF1R ha perso la battaglia!",
  "0.92.0" => "A0%1sF0R appare e va verso l'area C2%2sF6R!",
  "0.93.0" => "Hai conquistato l'area C2%1sF4R!",
  "0.94.0" => "Raggiungi A0%1sF2R!",
  "0.95.0" => "L'A0%1sF0R lotta contro A0%2sF2R!",
  "0.96.0" => "Il A6tempioR si è parzialmente aperto!",
  "0.97.0" => "A0%1sF0R ha invaso l'area A0%2sF6R!",
  "0.98.0" => "A0%2sF0R ha indebolito l'area C1%1sF0R!",
  "0.99.0" => "Il piano è terminato e A0%1sF3R si ritirano!",
  "0.100.0" => "A0%1sF0R appare e va verso l'area C2%2sF6R!",
  "0.101.0" => "Nell'area A0%1sF6R si nasconde un tesoro!",
  "0.102.0" => "A0%1sF0R ha perso e le sue truppe si ritirano!",
  "0.103.0" => "L'analisi di A1FaihR ha ristretto l'area di ricerca!",
  "0.104.0" => "L'analisi di A1FaihR ha ristretto ulteriormente l'area di ricerca!",
