Map {
  "0.0.0" => "Die A0%1sF1R haben die Schlacht gewonnen!",
  "0.1.0" => "Die A0%1sF1R wurden besiegt!",
  "0.2.0" => "Besiege A0%1sF6R und A0%2sF6R!",
  "0.3.0" => "Die A0%1sF1R wurden auf dem Schlachtfeld gesichtet!",
  "0.4.0" => "Die A0%1sF1R haben Verstärkung erhalten!",
  "0.5.0" => "Die A0%1sF1R haben sich zurückgezogen!",
  "0.6.0" => "A0%1sF1R rücken Richtung A1Deku-BaumR vor!",
  "0.7.0" => "A0%1sF0R und A0%2sF5R sind offen!",
  "0.8.0" => "A0%1sF0R und A0%2sF5R rücken Richtung A1Deku-BaumR vor!",
  "0.9.0" => "A0%1sF0R und A0%2sF5R sind stärker geworden!",
  "0.10.0" => "Einige A6FestungenR sind offen!",
  "0.11.0" => "Der A1Deku-BaumR ist gefallen! Die Schlacht ist verloren!",
  "0.12.0" => "Die A0%1sF1R haben A6NachschubkrügeR verteilt!",
  "0.13.0" => "Besiege die A2FeindeR und sammle A6MaterialienR!",
  "0.14.0" => "Nach deinem schnellen Erfolg wurden die A2feindlichen HauptleuteR gestärkt!",
  "0.15.0" => "Die A2feindlichen TruppenR haben den A1Deku-BaumR A2in BrandR gesetzt!",
  "0.16.0" => "Ein A2Magiekrug-TransportsoldatR wurde auf dem Schlachtfeld gesichtet!",
  "0.17.0" => "Ein A2Force-Kristall-TransportsoldatR wurde auf dem Schlachtfeld gesichtet!",
  "0.18.0" => "Ein A2Herz-TransportsoldatR wurde auf dem Schlachtfeld gesichtet!",
  "0.19.0" => "Besiege noch A2200 FeindeR mit Spezialangriffen!",
  "0.20.0" => "Besiege noch A2100 FeindeR mit Spezialangriffen!",
  "0.21.0" => "Besiege noch A250 FeindeR mit Spezialangriffen!",
  "0.22.0" => "Besiege noch A2200 FeindeR mit Magie!",
  "0.23.0" => "Besiege noch A2100 FeindeR mit Magie!",
  "0.24.0" => "Besiege noch A250 FeindeR mit Magie!",
  "0.25.0" => "Noch A2300 FeindeR!",
  "0.26.0" => "Noch A2200 FeindeR!",
  "0.27.0" => "Noch A2100 FeindeR!",
  "0.28.0" => "In manchen A6FestungenR sind A6Force-Kristall-KrügeR erschienen!",
  "0.29.0" => "In manchen A6FestungenR sind A6MagiekrügeR erschienen!",
  "0.30.0" => "A0%1sF0R und A0%2sF5R wurden durch das Besiegen der Hauptleute geschwächt!",
  "0.31.0" => "Besiege die A2HauptleuteR, um A0%1sF6R und A0%2sF6R zu schwächen!",
  "0.32.0" => "A0%1sF0R hat den A1Deku-BaumR erreicht!",
  "0.33.0" => "A0%1sF0R und A0%2sF4R wurden gesichtet und sind stärker geworden!",
  "0.34.0" => "Besiege die A2FeindeR um den A1Deku-BaumR!",
  "0.35.0" => "A0%1sF0R rückt gegen A0%2sF6R vor!",
  "0.36.0" => "Erste Prüfung!",
  "0.37.0" => "Spezialangriff-Prüfung!",
  "0.38.0" => "Magie-Prüfung!",
  "0.39.0" => "Letzte Prüfung!",
  "0.40.0" => "Durch dein Ergebnis wird die A6PrüfungR schwieriger!",
  "0.41.0" => "Die A2feindlichen HauptleuteR sind stärker geworden!",
  "0.42.0" => "Einige der A2feindlichen HauptleuteR sind stärker geworden!",
  "0.43.0" => "Die A0%1sF1R rücken Richtung A1Deku-BaumR vor!",
  "0.44.0" => "Der A2Magiekrug-TransportsoldatR hat sich zurückgezogen!",
  "0.45.0" => "Der A2Force-Kristall-TransportsoldatR hat sich zurückgezogen!",
  "0.46.0" => "Der A2Herz-TransportsoldatR hat sich zurückgezogen!",
  "0.47.0" => "A6Rang AR erreicht!",
  "0.48.0" => "A6Rang BR erreicht!",
  "0.49.0" => "A6Rang CR erreicht!",
  "0.50.0" => "Der A2Force-Kristall-TransportsoldatR wird sich in 2 Minuten zurückziehen!",
  "0.51.0" => "Der A2Magiekrug-TransportsoldatR wird sich in 1 Minute zurückziehen!",
  "0.52.0" => "Hoher Rang erreicht! A2BelohnungstruppenR wurden gesichtet!",
  "0.53.0" => "Hier ist das Ergebnis!",
  "0.54.0" => "A0%1sF0R und A0%2sF5R rücken gegen A0%3sF6R vor!",
  "0.55.0" => "A0%1sF0R und A0%2sF5R sind geschwächt! Besiege sie!",
  "0.56.0" => "Ein A2DekuranhaR wurde auf dem Schlachtfeld gesichtet!",
  "0.57.0" => "Vorsicht! Jede Minute wird ein A2DekuranhaR erscheinen!",
  "0.58.0" => "Besiege die A2FeindeR, um A6MaterialienR zu erhalten!",
