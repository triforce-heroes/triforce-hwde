Map {
  "0.0.0" => "A0%1sF1R bereiten eine Beschwörung vor!",
  "0.1.0" => "A0%1sF1R rücken gegen A0%2sF6R vor!",
  "0.2.0" => "A0%1sF0R ist in Bedrängnis und braucht Hilfe!",
  "0.3.0" => "A0%1sF0R ist in Gefahr und braucht sofort Hilfe!",
  "0.4.0" => "A0%1sF1R wurden besiegt!",
  "0.5.0" => "A0%1sF0R ist nun als spielbarer Kämpfer verfügbar!",
  "0.6.0" => "A0%1sF0R rückt gegen A0%2sF6R vor!",
  "0.7.0" => "A0%1sF0R ist in Bedrängnis und braucht Hilfe!",
  "0.8.0" => "A0%1sF0R ist in Gefahr und braucht sofort Hilfe!",
  "0.9.0" => "A0%1sF0R wurde besiegt!",
  "0.10.0" => "A0%1sF0R ruft Verstärkung, um A0%2sF6R zu beschützen!",
  "0.11.0" => "A0%1sF1R wurden gesichtet!",
  "0.12.0" => "A0%1sF1R haben A0%2sF7R beschworen!",
  "0.13.0" => "A0%1sF1R bereiten eine Beschwörung vor!",
  "0.14.0" => "Behalte A0%1sF6R im Auge!",
  "0.15.0" => "A0%1sF1R konnten wegen Magiemangel nicht beschwören!",
  "0.16.0" => "A0%2sF1R haben die Festungen der A0%1sF5R geöffnet!",
  "0.17.0" => "A0%1sF1R wurden gesichtet und wollen A0%2sF7R versammeln!",
  "0.18.0" => "A0%1sF1R sammeln sich um A0%2sF7R!",
  "0.19.0" => "A0%1sF1R müssen schnell besiegt werden!",
  "0.20.0" => "Die Moral A0%1sF2R und der A2versammelten TruppenR steigt!",
  "0.21.0" => "A0%1sF0R und die A2versammelten TruppenR rücken Richtung A0%2sF4R vor!",
  "0.22.0" => "A0%1sF0R darf nicht fallen!",
  "0.23.0" => "Weitere A0%1sF3R wurden gesichtet und wollen Verstärkung rufen!",
  "0.24.0" => "A0%1sF0R und A0%2sF5R sammeln sich unter A0%2sF4R!",
  "0.25.0" => "A0%1sF0R wurde auf dem Schlachtfeld gesichtet!",
  "0.26.0" => "A0%1sF0R rückt auf der Suche nach Futter vor!",
  "0.27.0" => "A0%1sF1R müssen schnell besiegt werden!",
  "0.28.0" => "A0%1sF1R wurden alle besiegt!",
  "0.29.0" => "A0%1sF0R und die A2Truppen in der UmgebungR rücken Richtung A0%2sF4R vor!",
  "0.30.0" => "A0%2sF0R hat A0%1sF6R geschlossen!",
  "0.31.0" => "A0%1sF1R wurden alle besiegt!",
  "0.32.0" => "A2MonstertruppenR sind um A0%1sF6R erschienen!",
  "0.33.0" => "Rette schnell A0%1sF6R!",
  "0.34.0" => "A0%1sF0R hat das Ziel erreicht!",
  "0.35.0" => "A0%1sF0R hat gefressen und sich in ein Goldhuhn verwandelt!",
  "0.36.0" => "Die A6TempeltoreR sind offen!",
  "0.37.0" => "A0%1sF0R rückt Richtung A0%2sF4R vor!",
  "0.38.0" => "A0%1sF0R will A0%2sF6R rufen!",
  "0.39.0" => "A0%1sF0R absorbiert Magie und wird stärker!",
  "0.40.0" => "A0%1sF0R absorbiert Magie und wird noch stärker!",
  "0.41.0" => "A0%1sF0R verliert Magie und wird schwächer!",
  "0.42.0" => "A0%1sF0R wurde besiegt!",
  "0.43.0" => "Alle A0%1sF3R sind verschwunden!",
  "0.44.0" => "A0%1sF0R hat sich zurückgezogen!",
  "0.45.0" => "A0%1sF0R ist nach dem Angriff der A0%2sF5R geflohen!",
  "0.46.0" => "Die A0%1sF1R wurden besiegt!",
  "0.47.0" => "C1%1sF0R ist an die A0%2sF7R gefallen!",
  "0.48.0" => "A0%1sF0R ist offen!",
  "0.49.0" => "C2%1sF0R wurde erobert!",
  "0.50.0" => "A0%1sF0R ist geflohen!",
  "0.51.0" => "Eine A6SkulltulaR wurde auf dem Schlachtfeld gesichtet!",
  "0.52.0" => "Die A6SkulltulaR ist geflohen!",
  "0.53.0" => "A0%1sF0R kämpft mit A0%2sF4R!",
  "0.54.0" => "A0%1sF0R absorbiert die Magie A0%2sF3R vollständig!",
  "0.55.0" => "A0%1sF0R wurde besiegt!",
  "0.56.0" => "A0%1sF0R und die A2versammelten TruppenR rücken gegen A0%2sF6R vor!",
  "0.57.0" => "A0%1sF0R rückt gegen A0%2sF7R vor!",
  "0.58.0" => "Besiege A0%1sF7R und schwäche so A0%2sF6R!",
  "0.59.0" => "A0%1sF0R und A0%2sF7R rücken Richtung A0%3sF4R vor!",
  "0.60.0" => "Die A0%1sF5R rücken gegen die A0%2sF7R vor!",
  "0.61.0" => "Die Moral der bei A0%1sF4R A2versammelten TruppenR sinkt!",
