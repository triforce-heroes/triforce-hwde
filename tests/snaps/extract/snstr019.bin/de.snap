Map {
  "0.0.0" => "Die A0%1sF7R greifen die A0%2sF7R an!",
  "0.1.0" => "A0%1sF0R hat das A6TempeltorR geschlossen!",
  "0.2.0" => "A0%1sF0R rückt gegen A0%2sF6R vor!",
  "0.3.0" => "A0%1sF0R rückt gegen A0%2sF6R vor!",
  "0.4.0" => "Die A0%2sF5R haben den Vormarsch A0%1sF2R aufgehalten!",
  "0.5.0" => "A0%1sF1R wurden auf dem Schlachtfeld gesichtet!",
  "0.6.0" => "A0%1sF1R rücken in Richtung A6TempeltorR vor!",
  "0.7.0" => "Die A0%1sF1R rücken gegen A0%2sF7R vor!",
  "0.8.0" => "A0%1sF0R ist in Bedrängnis und braucht Hilfe!",
  "0.9.0" => "A0%1sF0R ist in Gefahr und braucht sofort Hilfe!",
  "0.10.0" => "A0%1sF0R hat das Tempeltor erreicht!",
  "0.11.0" => "Eskortiere den Rest A0%1sF3R zum Ziel!",
  "0.12.0" => "Alle A0%1sF3R haben den A6Eingang des WassertempelsR erreicht!",
  "0.13.0" => "A0%1sF1R sind alle am Ziel!",
  "0.14.0" => "A0%1sF1R haben das A6TempeltorR geöffnet!",
  "0.15.0" => "A0%1sF0R ist geflohen!",
  "0.16.0" => "Die Moral eines Teils der A0%1sF1R steigt!",
  "0.17.0" => "Der Angriff der A0%1sF7R hat den A6TempeleingangR geöffnet!",
  "0.18.0" => "Ein Teil der A0%1sF1R rückt gegen die A0%2sF7R vor!",
  "0.19.0" => "Ein Teil der A0%1sF1R rückt Richtung A0%2sF4R vor!",
  "0.20.0" => "C1%1sF0R darf nicht fallen!",
  "0.21.0" => "Der Angriff der A0%1sF7R hat das A6Osttor des TempelsR geöffnet!",
  "0.22.0" => "A0%1sF0R wurde besiegt!",
  "0.23.0" => "A0%1sF0R ist offen!",
  "0.24.0" => "A0%1sF0R und A0%2sF5R rücken Richtung C1%3sF4R vor!",
  "0.25.0" => "Der Vormarsch A0%1sF2R wurde am A6Osttor des TempelsR aufgehalten!",
  "0.26.0" => "Der Angriff A0%1sF2R hat das A6Osttor des TempelsR geöffnet!",
  "0.27.0" => "A0%1sF0R rückt wieder Richtung C1%2sF4R vor!",
  "0.28.0" => "A0%1sF0R wurde besiegt!",
  "0.29.0" => "A0%1sF0R und A0%2sF5R wurden besiegt!",
  "0.30.0" => "A0%1sF0R rückt gegen A0%2sF6R vor!",
  "0.31.0" => "Die Festungen der A0%1sF1R sind offen!",
  "0.32.0" => "Ein Teil der A0%1sF1R rückt gegen A0%2sF6R vor!",
  "0.33.0" => "Die A0%2sF7R haben A0%1sF6R in die Zange genommen!",
  "0.34.0" => "Besiege die A0%2sF3R um A0%1sF6R!",
  "0.35.0" => "Unterstütze A0%1sF6R dabei, A0%2sF6R zu öffnen!",
  "0.36.0" => "A0%1sF0R hat A0%2sF6R erreicht!",
  "0.37.0" => "A0%1sF0R wurde unterstützt!",
  "0.38.0" => "Die A0%1sF1R haben sich zurückgezogen!",
  "0.39.0" => "Die A0%1sF1R haben gesiegt!",
  "0.40.0" => "A0%1sF0R ist nach dem Angriff der A0%2sF5R geflohen!",
  "0.41.0" => "Die A0%1sF1R haben die Schlacht verloren!",
  "0.42.0" => "A0%1sF0R ist an die A0%2sF7R gefallen!",
  "0.43.0" => "A0%1sF0R ist nun als spielbarer Kämpfer verfügbar!",
  "0.44.0" => "A0%1sF0R greift A0%2sF6R an!",
  "0.45.0" => "A0%1sF1R wurden besiegt!",
  "0.48.0" => "Begib dich zum A6WassertempelR!",
  "0.49.0" => "Besiege A0%1sF6R!",
  "0.50.0" => "Die A0%1sF5R erhalten Verstärkung C5%2sF3R!",
  "0.51.0" => "Öffne schnell die Schleusen und befreie A0%1sF6R!",
  "0.52.0" => "Die A0%1sF1R nähern sich A0%2sF4R!",
  "0.53.0" => "A0%1sF0R kämpft mit A0%2sF4R!",
  "0.54.0" => "A0%1sF0R wurde auf dem Schlachtfeld gesichtet!",
  "0.55.0" => "Öffne alle Schleusen!",
  "0.56.0" => "Du hast einen A6Schleusen-HebelR entdeckt!",
  "0.57.0" => "Eine A6SkulltulaR wurde auf dem Schlachtfeld gesichtet!",
  "0.58.0" => "Finde die A6SkulltulaR!",
  "0.59.0" => "Du hast die A6SkulltulaR erlegt!",
  "0.60.0" => "Die A6SkulltulaR wird bald fliehen!",
  "0.61.0" => "Die A6SkulltulaR ist geflohen!",
  "0.62.0" => "A0%1sF0R wurde gerettet!",
  "0.63.0" => "C2%1sF0R ist offen!",
  "0.64.0" => "A0%1sF0R rückt vor!",
  "0.65.0" => "A0%1sF0R hat das Kampfgeschehen verlassen!",
  "0.66.0" => "A0%1sF0R hat A0%1sF6R beschworen!",
  "0.67.0" => "In der Nähe C5%1sF2R wurden Monster gesichtet!",
  "0.68.0" => "A0%1sF0R ist zurückgekehrt, um A0%2sF6R zu unterstützen!",
  "0.69.0" => "A0%1sF0R hat sich vorerst zurückgezogen!",
  "0.70.0" => "Erobere C2%1sF6R!",
  "0.71.0" => "A0%1sF0R rückt vor, um den A6WassertempelR zu verteidigen!",
  "0.72.0" => "Der Angriff der A0%2sF5R senkt die Moral der A0%1sF1R!",
  "0.73.0" => "Eskortiere A0%1sF6R zum Ziel!",
  "0.74.0" => "A0%1sF0R hat A0%2sF6R erreicht!",
  "0.75.0" => "A0%1sF0R hat A0%2sF6R beschworen!",
  "0.76.0" => "Die Magie A0%2sF2R hat A0%1sF6R stärker gemacht!",
  "0.77.0" => "A0%1sF0R rückt Richtung A0%2sF4R vor!",
