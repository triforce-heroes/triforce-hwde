  "0.66.0" => "A0%1sF4R se précipite vers A0%2sF0R!",
  "0.67.0" => "Rendez-vous dans A0%1sF0R!",
  "0.68.0" => "A0%1sF4R est en difficulté! Allez l'aider!",
  "0.69.0" => "A0%1sF4R est en grand danger! Allez l'aider au plus vite!",
  "0.70.0" => "Le moral A2desR A0%1sF7R est en baisse!",
  "0.71.0" => "A0%1sF4R se dirige vers A0%2sF0R!",
