Map {
  "0.0.0" => "A0%1sF0R si dirige verso il A6checkpoint rocciosoR!",
  "0.1.0" => "Aiuta A0%1sF2R ad avanzare!",
  "0.2.0" => "A0%1sF1R vanno verso A0%2sF6R!",
  "0.3.0" => "A0%2sF0R ha perso! Il morale dell'A0%1sF1R è migliorato!",
  "0.4.0" => "A0%1sF0R non deve scappare!",
  "0.5.0" => "A0%2sF0R incoraggia l'A0%1sF1R, migliorandone il morale!",
  "0.6.0" => "Sconfiggi A0%1sF2R!",
