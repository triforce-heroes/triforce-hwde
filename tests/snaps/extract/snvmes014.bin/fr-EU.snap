Map {
  "1.0.0.0" => "Nous n'avons aucune chance de gagner...
Réfléchissons à un moyen de nous enfuir.",
  "1.0.1.0" => "Il n'en est pas question... La Triforce de la force
sera de nouveau mienne... !",
  "1.0.2.0" => "Je sens un pouvoir sacré émaner de quelques forts.
S'il venait à disparaître, l'ennemi perdrait espoir.",
  "1.0.3.0" => "Ils font tout ce qu'ils peuvent pour aider la sorcière
à fuir. J'espère qu'ils m'amuseront encore un peu.",
  "1.0.5.0" => "Écoutez-moi ! Nous devons attirer Ghirahim et
Xanto dans les forts !",
  "1.0.6.0" => "Cette petite gourde... Que cherche-t-elle à faire ?",
  "1.0.7.0" => "Oui ! On a réussi à isoler Ghirahim !",
  "1.0.8.0" => "C'est notre chance ! Unissons nos forces
et repoussons l'ennemi !",
  "1.0.9.0" => "Génial ! On a réussi à isoler Xanto !",
  "1.0.10.0" => "Je me demande si on pourrait pas repousser
l'ennemi de ce côté-ci aussi, maintenant...",
  "1.0.11.0" => "Courage, tout le monde ! Les renforts
ne devraient plus tarder !",
  "1.0.12.0" => "Tout ce qui est arrivé est ma faute...
Je vais me rattraper.",
  "1.0.13.0" => "Sa ruse ne change rien à mes plans.",
  "1.0.14.0" => "Je... Je vous en prie... Pardonnez-moi...
Je vais rattraper mon erreur.",
  "1.0.15.0" => "Sa ruse ne change rien à mes plans.",
  "1.0.16.0" => "Le pouvoir sacré a encore disparu...",
  "1.0.17.0" => "Tu ne peux pas me fuir... Donne-moi
la Triforce de la force !",
  "1.0.18.0" => "On a écrasé ce Xanto ! Vous voyez comme
on est forts ?!",
  "1.0.19.0" => "On a écrasé ce Ghirahim ! Et on s'est même pas
battus sérieusement !",
  "1.0.20.0" => "Lana, tu vas bien ? Je suis là, maintenant !",
  "1.0.21.0" => "Impa ! Merci !",
  "1.0.22.0" => "Je vais leur faire goûter à un arcane hérité
de mon clan !",
  "1.0.23.0" => "Dommage, il s'agissait de mon double !",
  "1.0.24.0" => "Un double... ? Comme c'est agaçant...",
  "1.0.25.0" => "Débarrassons-nous de la vraie et ses doubles
devraient disparaître... J'ai un plan.",
  "1.0.26.0" => "Si nous menaçons Lana, cela devrait forcer
la vraie Impa à se révéler...",
  "1.0.27.0" => "Hmm... Très bien...",
  "1.0.28.0" => "Vous vous fatiguez pour rien !
Il s'agissait aussi de mon double !",
  "1.0.29.0" => "J'avais raison. Il fallait forcer la vraie à sortir de son
trou. Détruisons les alentours de la base de Lana.",
  "1.0.30.0" => "Aaah ! Que fait l'ennemi ici... ?!",
  "1.0.31.0" => "Grr... Lana est en danger !
Attends, je viens te sauver !",
  "1.0.32.0" => "Hu hu hu... J'ai trouvé la vraie !",
  "1.0.33.0" => "Ton petit tour ne marchera plus...
Prépare-toi à mourir.",
  "1.0.34.0" => "Vous n'avez pas réussi à déjouer mon arcane !
La victoire sera nôtre !",
  "1.0.35.0" => "Argh... Mon plan n'a pas fonctionné comme je
l'avais prévu... Nous n'avons pas trouvé la vraie...",
  "1.0.36.0" => "Grrraaar... ! Bande de déchets inutiles !",
  "1.0.37.0" => "Argh... Comment ont-ils pu déjouer mon arcane... ?
Mes doubles vont être affaiblis...",
  "1.0.38.0" => "Les préparatifs sont déjà terminés... Lana va
pouvoir s'échapper, même si je ne m'en sors pas...",
  "1.0.39.0" => "Il ne nous reste plus qu'à attraper
la petite sorcière.",
  "1.0.40.0" => "Mais les préparatifs sont déjà terminés... Lana va
pouvoir s'échapper, même si je ne m'en sors pas...",
  "1.0.41.0" => "On protège Lana !",
  "1.0.42.0" => "Vous croyez pouvoir nous faire face ? Allez,
débarrassez-moi de ça et capturez la sorcière !",
  "1.0.43.0" => "Bientôt, la Triforce de la force sera
de nouveau entre mes mains... !",
  "1.0.44.0" => "Quoi... ?! C'était un double ?! Cette petite
gourde a osé me piéger !",
  "1.0.45.0" => "Lana ! J'ai fait installer des cercles magiques
de téléportation ! Utilise-les pour t'enfuir !",
  "1.0.46.0" => "Non... Je ne te laisserai pas t'enfuir !",
  "1.0.47.0" => "Elle est seule, elle ne peut rien faire...
Capturez-la immédiatement... !",
  "1.0.48.0" => "Cya et moi sommes nées d'une seule et même âme...
Si j'arrive à diviser mon âme comme cette fois-là...",
  "1.0.49.0" => "Ces doubles semblent différents des autres. Il nous
faut les attraper toutes les trois ou elle s'échappera.",
  "1.0.50.0" => "Suivez la fille ! Elle ne doit pas s'échapper !",
  "1.0.51.0" => "Je m'occupe de celle qui se dirige à l'ouest.",
  "1.0.52.0" => "Je me charge de celle qui va vers l'est. Elle va voir
ce qu'il en coûte de se moquer de nous... !",
  "1.0.53.0" => "Non ! Je ne peux pas abandonner maintenant !
Si j'utilise ma magie, je peux devenir plus forte... !",
  "1.0.54.0" => "Petite insolente... Elle se fatigue pour rien... !",
  "1.0.55.0" => "Lana, vite ! Il te suffit d'atteindre le cercle
magique et tu pourras leur échapper !",
  "1.0.56.0" => "Pourchassez-la ! Ne la laissez surtout pas s'enfuir !",
  "1.0.57.0" => "Elle va s'enfuir... !",
  "1.0.58.0" => "Toi ! Ne bouge plus !",
  "1.0.59.0" => "Elle nous a causé beaucoup de problèmes...
Mais j'ai enfin récupéré la Triforce de la force !",
  "1.0.60.0" => "Nous pouvons maintenant attaquer le château
d'Hyrule. Les fragments restants seront à moi... !",
  "1.0.61.0" => "Grr... La Triforce m'a échappé...",
  "1.0.62.0" => "Hmph... Petite maligne...",
  "1.0.63.0" => "Bien ! Nous avons isolé Xanto !",
  "1.0.64.0" => "Comme ça, on pourra peut-être repousser
les ennemis qui sont de l'autre côté.",
  "1.0.65.0" => "Si on arrive à faire tomber leur base,
on peut gagner ! Aidez-moi, mes amis !",
  "1.0.66.0" => "Ouais ! On est tous avec vous !",
  "1.0.67.0" => "J'arriverai à m'enfuir... Je dois puiser
dans mes dernières forces... !",
  "1.0.68.0" => "Hmpf... Il n'en reste plus qu'une...
La fin est proche.",
  "1.0.69.0" => "Sale gamine... !
Tu ne m'échapperas pas !",
}