Map {
  "1.0.0.0" => "Wir müssen die Magie wiedererlangen. Sonst
versinken ich und diese Welt in Dunkelheit!",
  "1.0.1.0" => "Aber Phantom-Ganon hat uns in alle Winde
verstreut!",
  "1.0.2.0" => "Wenn wir Phantom-Ganon nicht schwächen,
hören diese Blitzschläge nicht auf!",
  "1.0.3.0" => "Die Weisen in den Tempeln tragen
die Kraft des Lichts in sich.",
  "1.0.4.0" => "Dieses Spukgespenst sammelt immer
mehr Magie...",
  "1.0.5.0" => "Diese Macht...! Solange die Weisenfestungen
nicht uns gehören, treffen uns die Blitzschläge!",
  "1.0.6.0" => "Die Festung hat ein großes Emblem auf
dem Boden... Das Zeichen der Weisen!",
  "1.0.7.0" => "Die Festung ist eingenommen, aber die Tore
bleiben zu!? So erreichen wir Cia nicht!",
  "1.0.8.0" => "Hm... Es muss Phantom-Ganon sein, der sie
mit seiner Magie geschlossen hält.",
  "1.0.9.0" => "Sieht aus, als müssten wir alle der
Weisenfestungen erobern!",
  "1.0.10.0" => "Zwei der Festungen gehören uns...
Die Hälfte haben wir schon!",
  "1.0.11.0" => "Wir sollten aufpassen, dass der Feind sie
uns nicht wieder abnimmt!",
  "1.0.12.0" => "Was ist das...? Der Weg zu den 
Weisenfestungen ist blockiert!",
  "1.0.13.0" => "Oh, ein Schalter! Was wohl passiert,
wenn man ihn betätigt?",
  "1.0.14.0" => "Danke! So können wir vorrücken!",
  "1.0.15.0" => "Wir müssen die Weisenfestungen finden!
Bringt uns dieser Schalter nach oben?",
  "1.0.16.0" => "Erstaunlich, wie schnell diese Bäume
wachsen können!",
  "1.0.17.0" => "Wenn wir die Wege öffnen, kommen auch
Feinde durch. Wir müssen sie aufhalten!",
  "1.0.18.0" => "Wir konnten den Boten nicht aufhalten...
Jetzt sind mehr Feinde in den Festungen!",
  "1.0.19.0" => "Wir konnten wohl verhindern, dass sie
nach Verstärkung rufen.",
  "1.0.20.0" => "Die Weisenfestungen sind von Licht erfüllt...
Phantom-Ganons Magie wird schwächer!",
  "1.0.21.0" => "Halte durch, Cia! Wir kommen alle zu dir!",
  "1.0.22.0" => "Die Monster sind stärker geworden!
Cia ist in Gefahr!",
  "1.0.23.0" => "Aber Vorsicht! Über die neuen Wege kommen
Feinde zu Hauptquartier und Weisenfestungen!",
  "1.0.24.0" => "Und auch bei dieser Festung sind eine
Menge Monster!",
  "1.0.25.0" => "Über die geöffneten Wege kommen leider auch
Feinde zu Hauptquartier und Weisenfestungen...",
  "1.0.26.0" => "Auch diese Festung wird von einer großen
Zahl Monster bedroht.",
  "1.0.27.0" => "Zwei riesige Ungetüme...!",
  "1.0.28.0" => "Wir müssen die Weisenfestungen beschützen,
sonst gehen die Blitzschläge wieder los!",
  "1.0.29.0" => "Wenn die Weisenfestung fällt, werden die
Blitze uns wieder peinigen!",
  "1.0.30.0" => "Nein... Wir können die Weisenfestungen
nicht länger halten!",
  "1.0.31.0" => "Wenn eine der Weisenfestungen fällt,
kehren die Blitzschläge zurück...",
  "1.0.32.0" => "Wenn wir nichts unternehmen, verlieren wir
die Weisenfestungen!",
  "1.0.33.0" => "Wenn eine der Weisenfestungen fällt,
schlagen wieder Blitze ein...",
  "1.0.34.0" => "Oje... Die Weisenfestungen sind in Gefahr!",
  "1.0.35.0" => "Wenn eine der Weisenfestungen fällt, werden
wir wieder von Blitzen malträtiert!",
  "1.0.36.0" => "Was sollen wir nur tun?
Die Festung wird fallen!",
  "1.0.37.0" => "Wir müssen uns beeilen.
Allein kommt Cia nicht gegen sie an!",
  "1.0.38.0" => "Die Monster rücken vor! Wenn wir Cia
nicht bald erreichen, ist es zu spät!",
  "1.0.39.0" => "Wenn ich meine früheren Kräfte noch hätte...",
  "1.0.40.0" => "Danke, du hast mich gerettet...",
  "1.0.41.0" => "Endlich sind die Riesenviecher krepiert!",
  "1.0.42.0" => "So ein Schlamassel! Wir müssen Haupt-
quartier und Weisenfestungen schützen!",
  "1.0.43.0" => "Wir müssen gut zusammenarbeiten, um das
Hauptquartier und die Festungen zu schützen!",
  "1.0.44.0" => "Jetzt stehen uns alle Wege offen!
Schnell, zu Cia!",
  "1.0.45.0" => "Oh nein! Wir müssen die Weisenfestung
zurückerobern, damit die Blitze aufhören!",
  "1.0.46.0" => "Unsere Feinde sind dezimiert. Holen
wir uns die Weisenfestungen zurück!",
  "1.0.47.0" => "Er hat das alles angerichtet!
Woher nimmt er diese Kraft?",
  "1.0.48.0" => "Er nutzt die Magie, die er mir gestohlen hat.
Und jetzt wird er den Preis dafür bezahlen!",
  "1.0.49.0" => "Kommt! Wir müssen Cia helfen!",
  "1.0.50.0" => "Geht klar!",
  "1.0.51.0" => "Ich werde tun, was ich vermag.",
  "1.0.52.0" => "Zusammen sind wir stark!",
  "1.0.53.0" => "Ihn frontal anzugreifen wäre Selbstmord...
Aber alle zusammen können wir es schaffen!",
  "1.0.54.0" => "Wir sind alle da! Jetzt, Cia!",
  "1.0.55.0" => "Jetzt erhältst du deine gerechte Strafe!",
  "1.0.56.0" => "Ich hab mich vielleicht etwas übernommen...
Den Rest müsst ihr erledigen!",
  "1.0.57.0" => "Du kannst dich auf uns verlassen!",
  "1.0.58.0" => "Geben wir ihm die Abreibung,
die er verdient!",
  "1.0.59.0" => "Seine Kraft ist zwar erdrückend,
aber wir dürfen keine Angst haben!",
  "1.0.60.0" => "Auf geht's! Das Böse muss besiegt werden!",
  "1.0.61.0" => "Jetzt greift er anders an?!
Seid auf der Hut!",
  "1.0.62.0" => "Jeder Gegner besitzt irgendeine
Schwachstelle. Wir müssen sie nur finden!",
  "1.0.63.0" => "Mit vereinten Kräften können wir ihn besiegen!",
  "1.0.64.0" => "Es fehlt nicht mehr viel! Bald haben wir das
Triforce und Cias Magie zurück!",
  "1.0.65.0" => "Genau! Geben wir alles!",
  "1.0.66.0" => "Vergebt mir...
Ich konnte nichts ausrichten...",
  "1.0.67.0" => "Wenn wir die Festungen der Weisen erobern,
wird das Licht das Böse zurückdrängen!",
  "1.0.68.0" => "Ich schalte die Feinde oben aus.
Bitte öffnet danach den Weg!",
  "1.0.69.0" => "Ich übernehme die Feinde oben.
Öffnet danach den Weg!",
  "1.0.70.0" => "Lana! Bring alle zusammen!
Wir werden eine Menge Kraft brauchen.",
  "1.0.71.0" => "Aus dem Weg! Wir müssen zu Cia!",
  "1.0.72.0" => "Oh nein... Ich muss doch zu Cia!
Dann muss ich mich wohl durchkämpfen!",
  "1.0.73.0" => "Lasst mich durch!
Ich muss schnell zu dieser Cia!",
  "1.0.74.0" => "Wer wagt es, mir den Weg zu versperren?
Ich muss zu Cia eilen!",
  "1.0.75.0" => "In der Festung ist ein großes Emblem!
Ist das das Zeichen der Weisen?",
  "1.0.76.0" => "Was für ein seltsames Emblem...
Wahrscheinlich eine Weisenfestung?",
  "1.0.77.0" => "Dieses Emblem... Das ist das Zeichen der
Weisen.",
  "1.0.78.0" => "Um zu Cia zu gelangen, müssen wir den
Weg mittels des Schalters öffnen!",
  "1.0.79.0" => "Wir sollten den Schalter betätigen, um den
Weg zu öffnen. So kommen wir zu Cia!",
  "1.0.80.0" => "Nein! Das Hauptquartier!
Jetzt ist alles aus...",
  "1.0.81.0" => "Können wir nicht irgendwie alle
bei dem Monstrum zusammenkommen...?",
  "1.0.82.0" => "Wir müssen ohne Furcht zurückschlagen!
Nur so haben wir eine Siegeschance!",
  "1.0.83.0" => "Cia wird aufhören zu existieren!
Wir müssen sie beschützen!",
  "1.0.84.0" => "Nur noch eine Festung! Dann können
wir zu Cia ins Hauptquartier!",
  "1.0.85.0" => "Oh?! Als das Licht auf sie traf, sind die
Statuen einfach so verschwunden!",
  "1.0.86.0" => "Jetzt können wir mit dem Fanghaken
nach oben gelangen.",
  "1.0.87.0" => "Jetzt kommen wir mit dem
Fanghaken hoch!",
  "1.0.88.0" => "Hier ist ein Tor... Können wir das
nicht irgendwie aufbekommen?",
  "1.0.89.0" => "Können wir dieses Tor nicht
irgendwie öffnen?",
  "1.0.90.0" => "Wenn wir nur dieses Tor aufbekämen,
könnten wir unsere Kräfte vereinen...",
  "1.0.91.0" => "Wenn wir dieses Tor öffnen, könnten
wir uns leichter vereinigen...",
  "1.0.92.0" => "Jippie! Das Tor ist offen!",
  "1.0.93.0" => "Ja! Das Tor ist offen!",
  "1.0.94.0" => "Sehr gut! Das Tor ist offen!",
  "1.0.95.0" => "Das Tor hat sich geöffnet.
Wohlan!",
  "1.0.96.0" => "Nutzt Phantom-Ganon die Zeit etwa,
um Magie zu sammeln?",
  "1.0.97.0" => "Wenn wir die Monster besiegen und das Licht
stärken, muss er irgendwann herauskommen...",
  "1.0.98.0" => "Wir müssen Cia beschützen...
Los, besiegen wir die Monster!",
  "1.0.99.0" => "Nehmt euch in Acht!
Phantom-Ganon... Er greift an!",
  "13.0.0.0" => "Sieh mal, Link!
Ist das ein Schalter?",
  "13.0.1.0" => "Wir müssen schnell zur Weisenfestung!
Vielleicht öffnet der Schalter einen Weg?",
  "13.0.2.0" => "Wahnsinn! Die Bäume sind im
Handumdrehen groß geworden!",
  "13.0.3.0" => "Wenn wir die Wege öffnen, kommen auch
Feinde durch. Wir müssen sie aufhalten!",
  "13.0.4.0" => "Wir waren nicht schnell genug... Monster-
nachschub für die Weisenfestungen!",
  "13.0.5.0" => "Jetzt brauchen wir uns keine Sorgen
um feindliche Verstärkung zu machen!",
  "13.0.6.0" => "Er scheint die Monster zu stärken...
Cia ist in Gefahr!",
  "13.0.7.0" => "Aber wenn wir den Weg öffnen, könnten Feinde
Hauptquartier und Weisenfestungen angreifen.",
  "13.0.8.0" => "In dieser Festung sind auch massig Feinde!",
  "13.0.9.0" => "Aber wenn wir den Weg öffnen, könnten Feinde
Hauptquartier und Weisenfestungen angreifen.",
  "13.0.10.0" => "In dieser Festung sind auch massig Feinde!",
  "13.0.11.0" => "Da sind zwei riesige Monster erschienen!",
  "13.0.12.0" => "Wenn wir uns die Festungen abnehmen
lassen, kommen wieder die Blitzschläge!",
  "13.0.13.0" => "Oh nein! Die Festung wird gleich fallen!",
  "13.0.14.0" => "Wenn wir uns die Festungen abnehmen
lassen, gehen wieder die Blitzschläge los!",
  "13.0.15.0" => "Oh nein! Die Festung ist in Gefahr!",
  "13.0.16.0" => "Wenn wir uns die Festungen abnehmen
lassen, setzt es wieder Blitze!",
  "13.0.17.0" => "Oh nein! Wenn es so weitergeht,
verlieren wir die Festung!",
  "13.0.18.0" => "Wenn die Weisenfestung fällt, werden die
Blitze uns wieder peinigen!",
  "13.0.19.0" => "Es scheint, als könnten wir die
Weisenfestungen nicht beschützen...",
  "13.0.20.0" => "Wenn wir eine der Weisenfestungen verlieren,
gehen die Blitzschläge wieder los!",
  "13.0.21.0" => "Wir können die Weisenfestungen nicht halten!",
  "13.0.22.0" => "Wenn eine Weisenfestung eingenommen
wird, hagelt es wieder Blitze!",
  "13.0.23.0" => "Die Weisenfestung hält nicht mehr
lange durch!",
  "13.0.24.0" => "Wir müssen sie schnell besiegen!
Sonst ist Cia ganz auf sich allein gestellt!",
  "13.0.25.0" => "Die Monster sind in Bewegung!
Wir müssen schleunigst zu Cia!",
  "13.0.26.0" => "Jaaa! Wir haben die großen Brocken besiegt!",
  "13.0.27.0" => "Ein großes Emblem auf dem Boden...
Das muss eine Weisenfestung sein!",
  "13.0.28.0" => "Ein Emblem?
Vielleicht ist das eine Weisenfestung!",
  "13.0.29.0" => "Das Emblem zeigt, dass es sich hier wohl
um eine Weisenfestung handelt.",
  "13.0.30.0" => "Da ist ein großes Emblem auf dem Boden!
Ist das vielleicht eine der Weisenfestungen?",
  "13.0.31.0" => "Da ist ein großes Emblem auf dem Boden!
Ist das vielleicht eine der Weisenfestungen?",
  "13.0.32.0" => "Da ist ein großes Emblem auf dem Boden!
Ist das vielleicht eine der Weisenfestungen?",
  "13.0.33.0" => "Wir müssen den Schalter benutzen,
um zu Cia zu gelangen.",
  "13.0.34.0" => "Wir sollten wohl den Schalter benutzen,
wenn wir zu Cia wollen.",
  "13.0.35.0" => "Wir sollten uns alle bei dem Monstrum
versammeln, aber das ist jetzt wohl schwierig...",
  "13.0.36.0" => "Link wird erst die Feinde oben besiegen.
Danach kannst du den Weg öffnen, Tetra!",
  "13.0.37.0" => "Link wird erst die Feinde oben besiegen.
Danach kannst du den Weg öffnen!",
  "13.0.38.0" => "Nanu!? Das Licht hat die Statuen
verschwinden lassen!",
  "13.0.39.0" => "Greifen sie die Weisenfestungen an? Wenn
eine davon fällt, schlagen wieder Blitze ein!",
  "13.0.40.0" => "Jetzt kommen wir mit dem Fanghaken
nach oben!",
  "13.0.41.0" => "Die Monster wurden gestärkt!
Cia ist in Gefahr!",
  "13.0.42.0" => "Er stärkt die Monster?
Das bringt Cia in Gefahr!",
  "13.0.43.0" => "Wir müssen die Wege öffnen,
sonst kommen wir nicht zu Cia!",
  "13.0.44.0" => "Es ist wohl nötig, die Wege zu öffnen,
wenn wir Cia erreichen wollen.",
  "13.0.45.0" => "Aber wenn die Wege offen sind, kommen
auch die Monster zu unseren Festungen...",
  "13.0.46.0" => "Damit würden wir allerdings auch unsere
Festungen für die Monster öffnen...",
  "13.0.47.0" => "Die Monster rücken näher...
Wir müssen Cia schleunigst retten!",
  "13.0.48.0" => "Die Monster rücken vor... Wenn wir
Cia nicht bald erreichen, ist es zu spät!",
  "13.0.49.0" => "Dieses Tor... Können wir es
nicht irgendwie öffnen?",
  "13.0.50.0" => "Wenn wir nur dieses Tor aufbekämen,
könnten wir unsere Kräfte vereinen...",
  "13.0.51.0" => "Wenn wir dieses Tor öffnen, könnten
wir uns leichter vereinigen...",
  "13.0.52.0" => "Können wir dieses Tor nicht
irgendwie aufbekommen?",
  "13.0.53.0" => "Können wir dieses Tor nicht
irgendwie aufbekommen?",
  "13.0.54.0" => "Können wir dieses Tor nicht
irgendwie aufbekommen?",
  "13.0.55.0" => "Jaaa! Das Tor ist offen!",
  "13.0.56.0" => "Sehr gut! Das Tor ist offen!",
  "13.0.57.0" => "Das Tor hat sich geöffnet.
Wohlan!",
  "13.0.58.0" => "Jippie! Das Tor ist offen!",
  "13.0.59.0" => "Jippie! Das Tor ist offen!",
  "13.0.60.0" => "Jippie! Das Tor ist offen!",
  "13.0.61.0" => "Oh nein... Ich muss doch zu Cia!
Dann muss ich mich wohl durchkämpfen!",
  "13.0.62.0" => "Lasst mich durch!
Ich muss schnell zu dieser Cia!",
  "13.0.63.0" => "Wer wagt es, mir den Weg zu versperren?
Ich muss zu Cia eilen!",
  "13.0.64.0" => "Aus dem Weg! Wir müssen zu Cia!",
  "13.0.65.0" => "Aus dem Weg! Wir müssen zu Cia!",
  "13.0.66.0" => "Aus dem Weg! Wir müssen zu Cia!",
  "13.0.67.0" => "Mit dem Fanghaken kommen wir
jetzt nach oben!",
}