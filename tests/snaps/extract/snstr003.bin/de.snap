Map {
  "0.0.0" => "Erobere C2%1sF6R!",
  "0.1.0" => "A0%1sF0R hat einen anderen Weg eingeschlagen!",
  "0.3.0" => "A0%1sF0R kämpft mit A0%2sF4R!",
  "0.4.0" => "A0%1sF0R ist in Bedrängnis im Kampf gegen A0%2sF6R!",
  "0.5.0" => "Beschütze A0%1sF6R!",
  "0.6.0" => "A0%1sF0R hat sich vom Schlachtfeld zurückgezogen!",
  "0.7.0" => "Der Sieg über A0%2sF6R hebt die Moral A0%1sF2R!",
  "0.8.0" => "A0%1sF0R wurde gerettet!",
  "0.9.0" => "A0%1sF0R konnte nicht gerettet werden!",
  "0.10.0" => "Die A0%1sF1R haben C2%2sF6R erobert!",
  "0.12.0" => "Erobere C2%2sF6R von den A0%1sF7R zurück!",
  "0.13.0" => "Die A0%1sF1R haben C2%2sF6R zurückerobert!",
  "0.17.0" => "A6Beide FestungenR wurden erobert!",
  "0.18.0" => "Die A0%1sF1R rücken vor!",
  "0.19.0" => "Die A0%1sF1R haben A6vor der PyramideR einen Kampf begonnen!",
  "0.20.0" => "A0%1sF0R hat die A6OstbrückeR erreicht!",
  "0.21.0" => "A6%1sF0R ist offen!",
  "0.22.0" => "Die A0%1sF5R im Westen rücken in Richtung A1deines HauptquartiersR vor!",
  "0.23.0" => "A0%1sF0R rückt zum Gegenangriff auf die A0%2sF3R im Westen vor!",
  "0.24.0" => "Die A0%1sF5R rücken gegen A0%2sF6R vor!",
  "0.25.0" => "Der A1SpezialistR ist in Bedrängnis! Er benötigt Unterstützung!",
  "0.26.0" => "Der A1SpezialistR ist in Gefahr! Er benötigt sofort Unterstützung!",
  "0.27.0" => "A0%1sF0R ist am Ziel! Die A6OstbrückeR wurde gesenkt!",
  "0.28.0" => "Dringe über die A6OstbrückeR in die A6RuinenR vor!",
  "0.29.0" => "Du hast A0%1sF6R nicht beschützt!",
  "0.30.0" => "Der Plan ist fehlgeschlagen! Die Moral der A0%1sF5R sinkt!",
  "0.31.0" => "Die A0%1sF7R lassen die A6OstbrückeR herunter!",
  "0.32.0" => "Die Flucht A0%2sF2R hebt die Moral der A0%1sF5R!",
  "0.33.0" => "Begib dich Richtung C2%1sF4R!",
  "0.36.0" => "Durchbrich die A6TentakelwandR Richtung C2%1sF4R!",
  "0.37.0" => "A0%1sF0R wurde auf dem Schlachtfeld gesichtet!",
  "0.38.0" => "Die Siegbedingungen haben sich geändert!",
  "0.39.0" => "Besiege A0%1sF6R!",
  "0.40.0" => "A0%1sF0R hat sich zeitweilig unter die Erde zurückgezogen!",
  "0.41.0" => "A0%1sF1R wurden an verschiedenen Orten gesichtet!",
  "0.42.0" => "Besiege A0%1sF7R und finde A0%2sF6R selbst!",
  "0.43.0" => "Die A0%1sF1R rücken nach dem Sieg über A0%2sF6R vor!",
  "0.44.0" => "A0%1sF0R bombardiert das A1HauptquartierR!",
  "0.45.0" => "A0%1sF0R muss schnell besiegt werden!",
  "0.46.0" => "Besiege schnellstmöglich A0%1sF6R!",
  "0.47.0" => "A0%1sF0R wurde besiegt!",
  "0.48.0" => "Die Zerstörung A0%2sF2R hat A0%1sF6R hervorgelockt!",
  "0.49.0" => "A0%1sF0R wurde vollständig besiegt!",
  "0.50.0" => "Die A0%1sF1R haben die Schlacht gewonnen!",
  "0.51.0" => "A0%1sF0R ist geflohen!",
  "0.52.0" => "Die A0%1sF1R wurden besiegt!",
  "0.53.0" => "C1%1sF0R ist an die A0%2sF7R gefallen!",
  "0.54.0" => "Die A0%1sF1R rücken Richtung A0%2sF4R vor!",
  "0.55.0" => "A6%1sF0R ist offen!",
  "0.56.0" => "A0%1sF0R ist offen! A0%2sF0R rückt vor!",
  "0.57.0" => "C1%2sF0R wurde von den A0%1sF1R erobert!",
  "0.58.0" => "Das A1HauptquartierR darf nicht fallen!",
  "0.59.0" => "Die A0%1sF1R rücken gegen die A0%2sF7R vor!",
  "0.60.0" => "Erobere als Nächstes C2%1sF6R!",
  "0.61.0" => "A0%1sF0R hat sich zurückgezogen!",
  "0.62.0" => "Du hast C2%1sF6R erreicht!",
  "0.63.0" => "Eine A6SkulltulaR wurde auf dem Schlachtfeld gesichtet!",
  "0.64.0" => "Finde die A6SkulltulaR!",
  "0.65.0" => "Du hast die A6SkulltulaR erlegt!",
  "0.66.0" => "Die A6SkulltulaR wird bald fliehen!",
  "0.67.0" => "Die A6SkulltulaR ist geflohen!",
  "0.68.0" => "A0%1sF0R rückt zur A6OstbrückeR vor!",
  "0.69.0" => "Eine A6SchatztruheR wurde A0%1sF3R gesichtet!",
  "0.70.0" => "Die Moral A0%1sF2R steigt!",
  "0.71.0" => "A0%1sF0R wurde auf dem Schlachtfeld gesichtet!",
  "0.72.0" => "Die A0%1sF1R haben C2%2sF6R erobert!",
  "0.73.0" => "A0%1sF0R greift an!",
  "0.74.0" => "Die A0%1sF5R haben Verstärkung erhalten!",
  "0.75.0" => "A0%1sF0R wurde beim A1HauptquartierR gesichtet!",
  "0.76.0" => "A0%1sF0R ist geschlossen!",
  "0.77.0" => "A0%1sF0R ist offen!",
  "0.78.0" => "A0%1sF1R wurden auf dem Schlachtfeld gesichtet!",
  "0.79.0" => "A0%1sF0R will A2mächtige MonsterR beschwören!",
  "0.80.0" => "A0%1sF0R bereitet erneut eine Beschwörung vor!",
  "0.81.0" => "Besiege A0%1sF6R und verhindere die Beschwörung!",
  "0.82.0" => "A0%1sF0R und A0%2sF5R rücken gegen die A0%3sF7R vor!",
