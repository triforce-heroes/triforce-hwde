  "0.70.0" => "Die A0%1sF1R rücken gegen A0%2sF6R vor!",
  "0.71.0" => "A0%1sF0R erweckt die Statue und kann nur eingeschränkt kämpfen!",
  "0.72.0" => "Die A0%1sF1R rücken erneut gegen A0%2sF6R vor!",
