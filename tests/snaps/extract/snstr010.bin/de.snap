  "0.43.0" => "A0%1sF0R wurde besiegt! C2%2sF0R ist offen!",
  "0.44.0" => "A0%1sF0R wurde besiegt! C2%2sF0R ist offen!",
  "0.45.0" => "A0%1sF0R und A0%2sF5R sind offen!",
  "0.46.0" => "Unterstütze den Vormarsch A0%1sF2R!",
  "0.47.0" => "A0%1sF0R rückt gegen A0%2sF6R vor!",
  "0.48.0" => "A0%1sF0R, A0%2sF5R oder A0%3sF5R dürfen nicht fliehen!",
  "0.49.0" => "Die A0%1sF4R haben Verstärkung erhalten!",
  "0.50.0" => "A0%1sF0R hat sich vorerst zurückgezogen!",
  "0.51.0" => "Die A0%1sF1R haben den Weg zum A6Master-SchwertR freigegeben!",
  "0.52.0" => "A0%1sF0R hat das A6Master-SchwertR erhalten!",
  "0.53.0" => "Eine A6SiegelstatueR wurde A0%1sF3R entdeckt!",
  "0.54.0" => "A0%1sF0R rückt erneut Richtung A6SiegelstatueR vor!",
  "0.55.0" => "A0%1sF0R ist geflohen!",
  "0.56.0" => "A0%1sF0R rückt zum A6Sockel des heiligen SchwertesR vor!",
  "0.57.0" => "Der A6Tempel des heiligen SchwertesR ist nicht zugänglich!",
  "0.58.0" => "A0%1sF0R wurde gerettet!",
  "0.59.0" => "A0%1sF0R darf nicht fliehen!",
