Map {
  "0.0.0" => "A2FulminiR colpiscono i santuari! L'A0%1sF5R è più debole!",
  "0.1.0" => "A0%1sF0R potenzia la magia nella A2base nemicaR!",
  "0.2.0" => "A0%1sF0R ha subito danni dal A2fulmineR!",
  "0.3.0" => "Attenzione, A0%1sF2R non deve ritirarsi!",
  "0.4.0" => "Conquista i restanti A6presidi dei saggiR!",
  "0.5.0" => "Proteggi i A6presidi dei saggiR!",
  "0.6.0" => "Hai distrutto le A6statue della TerraR!",
  "0.7.0" => "A0%1sF0R va verso l'area A0%2sF6R!",
  "0.8.0" => "Gli A6alberi sono cresciutiR, aprendo la strada!",
  "0.9.0" => "A0%1sF0R va verso l'area A0%2sF6R per chiamare rinforzi!",
  "0.10.0" => "A0%1sF0R raggiunge l'area A0%2sF6R e chiama rinforzi!",
  "0.11.0" => "A0%1sF0R ha abbandonato il campo di battaglia!",
  "0.12.0" => "A0%1sF0R non ha potuto chiamare i rinforzi!",
  "0.13.0" => "A0%1sF0R si ritira dal campo di battaglia!",
  "0.14.0" => "Hai fermato la richiesta di rinforzi!",
  "0.15.0" => "Hai conquistato tutti e quattro i A6presidi dei saggiR!",
  "0.16.0" => "L'A2attacco di fulminiR si è interrotto!",
  "0.17.0" => "Tutti e quattro i A6presidi dei saggiR sono aperti!",
  "0.18.0" => "Raggiungi A0%1sF2R!",
  "0.19.0" => "A0%1sF0R ha potenziato i A2demoni nella piazza centraleR!",
  "0.20.0" => "I A2demoni nella piazza centraleR amplificano la magia!",
  "0.21.0" => "A0%1sF0R e A0%2sF2R scendono in campo!",
  "0.22.0" => "A0%1sF0R e A0%2sF2R vanno ai A6presidi dei saggiR!",
  "0.23.0" => "I A2demoni nella piazza centraleR si sono potenziati!",
  "0.24.0" => "I A2demoni nella piazza centraleR sono ancora più forti!",
  "0.25.0" => "I A2demoni nella piazza centraleR sono ancora più forti!",
  "0.26.0" => "I A2demoni nella piazza centraleR vanno all'area A0%1sF6R!",
  "0.27.0" => "Hai sconfitto due A2mostri gigantiR!",
  "0.28.0" => "Hai sconfitto i A2demoni nella piazza centraleR!",
  "0.29.0" => "Hai distrutto le A6statue della TerraR, collegando il passaggio!",
  "0.30.0" => "Gli A6alberi sono cresciutiR, aprendo la strada!",
  "0.31.0" => "I A2demoni del santuario della TerraR vanno verso le aree C1%2sF6R e A0%3sF6R!",
  "0.32.0" => "I A2demoni del santuario del VentoR vanno verso le aree C1%2sF6R e A0%3sF6R!",
  "0.33.0" => "Hai attivato tutti gli interruttori e la strada è aperta!",
  "0.34.0" => "I A2fulminiR ricominciano! L'A0%1sF5R è sotto attacco!",
  "0.35.0" => "Presto, conquista i A6presidi dei saggiR!",
  "0.36.0" => "Riconquista i A6presidi dei saggiR!",
  "0.37.0" => "La conquista dei A6presidi dei saggiR ha fermato i fulmini!",
  "0.38.0" => "A0%1sF0R è più forte grazie alla magia amplificata!",
  "0.39.0" => "A0%1sF0R si mette in marcia verso A0%2sF6R!",
  "0.40.0" => "A0%1sF0R riprende le forze con la magia!",
  "0.41.0" => "Raggiungi A0%1sF2R!",
  "0.42.0" => "A0%1sF0R ha smesso di recuperare le forze!",
  "0.43.0" => "L'A0%2sF7R ha messo in fuga A0%1sF2R!",
  "0.44.0" => "L'A0%1sF1R ha perso la battaglia!",
  "0.45.0" => "A0%1sF0R ha lasciato il campo di battaglia! Hai perso!",
  "0.46.0" => "L'area C1%1sF0R si è arresa all'A0%2sF7R!",
  "0.47.0" => "Un'A6AracnulaR è stata avvistata sul campo di battaglia!",
  "0.48.0" => "Cerca l'A6AracnulaR!",
  "0.49.0" => "Hai ottenuto un'A6AracnulaR!",
  "0.50.0" => "L'A6AracnulaR sta per fuggire!",
  "0.51.0" => "L'A6AracnulaR è fuggita!",
  "0.52.0" => "Hai sconfitto A0%1sF2R!",
  "0.53.0" => "L'area C2%1sF0R è aperta!",
  "0.54.0" => "Hai conquistato l'area C2%1sF4R!",
  "0.55.0" => "L'area C1%1sF0R si è arresa all'A0%2sF7R!",
  "0.56.0" => "A0%1sF0R ha raggiunto A0%2sF2R!",
  "0.57.0" => "L'area A0%1sF0R rischia di cadere!",
  "0.58.0" => "L'area A0%1sF0R sta per cadere!",
  "0.59.0" => "L'A0%1sF5R ha smesso di subire danni!",
  "0.60.0" => "A2Potenti mostriR vanno verso A0%1sF2R!",
  "0.61.0" => "La A6porta sud della caverna centraleR è aperta!",
  "0.62.0" => "La A6porta nord del passaggioR è aperta!",
  "0.63.0" => "A0%1sF0R ha recuperato interamente le forze!",
  "0.64.0" => "A0%1sF1R vanno verso l'area C1%2sF6R!",
  "0.65.0" => "A0%1sF1R ora vanno verso l'area A0%2sF6R!",
