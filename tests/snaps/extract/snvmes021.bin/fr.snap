Map {
  "1.0.0.0" => "La princesse a dû se rendre à la base ennemie.
Bon, j'imagine que je ferais mieux d'aller l'aider...",
  "1.0.1.0" => "Hé, je peux t'aider! Mais... on dirait qu'il y a un
gardien devant les portes de la base ennemie...",
  "1.0.2.0" => "La salle du trône et le gardien ont été
renforcés par un sortilège... Fantastique...",
  "1.0.3.0" => "On ferait mieux de se séparer.
Je vais à l'est. Toi, va à l'ouest!",
  "1.0.4.0" => "Wow! Ces ennemis ne plaisantent pas!
On dirait qu'ils viennent du palais...",
  "1.0.5.0" => "Je n'ai que faire de la force de nos
ennemis! Je mettrai fin à leur folie!",
  "1.0.6.0" => "Zelda empêche le Crépuscule de se propager,
mais elle ne tiendra pas longtemps!",
  "1.0.7.0" => "Rah... Ils essayent de renforcer leur fort
et de maintenir le pouvoir du Crépuscule.",
  "1.0.8.0" => "On arrivera pas à pénétrer dans la salle du
trône avec le Crépuscule... Il faut réagir!",
  "1.0.9.0" => "Ce gardien... C'est l'ombre de Xanto? Nous
pourrions le vaincre en affaiblissant sa magie...",
  "1.0.10.0" => "Si on prend des forts, la magie des ombres
sera affaiblie, c'est ça? Alors, c'est parti!",
  "1.0.11.0" => "Qui peut bien être derrière tout ça? Il doit
essayer de profiter de la faiblesse de Zelda!",
  "1.0.12.0" => "L'ennemi a l'air plutôt coriace, mais si on
prend leurs forts, on en fera qu'une bouchée!",
  "1.0.13.0" => "Avec ces monstres, pas besoin de prendre
tous les forts. Trois devraient suffire.",
  "1.0.14.0" => "Oh oh! On dirait que notre base est en
danger... Je ferais mieux d'aller la défendre!",
  "1.0.15.0" => "Continuez comme ça et prenez les
autres forts! Zelda nous attend!",
  "1.0.16.0" => "Bien, ça nous fait un
obstacle en moins!",
  "1.0.17.0" => "Oh non... Juste au moment où on
commençait à prendre confiance...",
  "1.0.18.0" => "Pfiou! Il ne nous reste qu'à prendre
la salle du trône! Enfin, je crois...",
  "1.0.19.0" => "Oh non! Ils l'ont encore renforcée! Comment
allons-nous rejoindre la princesse maintenant?",
  "1.0.20.0" => "Je me suis occupé de ma part des
ennemis. Allez! On va prendre le fort!",
  "1.0.21.0" => "Ils ont fortifié la salle du trône! Ça va nous
prendre une éternité pour rejoindre Zelda.",
  "1.0.22.0" => "Zelda! Tu vas bien? Conserve tes forces.
Si tu échoues, c'est la fin pour nous tous!",
  "1.0.23.0" => "Il faut que j'arrête leur commandant... Pendant
ce temps, affaiblis le reste de nos ennemis!",
  "1.0.24.0" => "Je mettrai fin à la tyrannie du Crépuscule
même si je dois le payer de ma vie!",
  "1.0.25.0" => "Non! ARRÊTEZ-LA! Tu crois
vraiment que je te laisserai faire?",
  "1.0.26.0" => "Parfait! On dirait que nous avons
affaibli l'ennemi en prenant ce fort!",
  "1.0.27.0" => "On a réussi! Les ennemis ont cessé
d'apparaître dans les forts!",
  "1.0.28.0" => "Quoi?! D'autres montres?!
C'est trop injuste!",
  "1.0.29.0" => "Fantastique! Regardez qui ils ont décidé
d'appeler... Ne le prenez pas à la légère!",
  "1.0.30.0" => "Évitez-le et concentrez vos efforts
sur les forts du Crépuscule!",
  "1.0.31.0" => "Nous avons besoin de plus de soldats.
Je vais appeler des renforts!",
  "1.0.32.0" => "Nous sommes arrivés! Combattons
cette créature ensemble!",
  "1.0.33.0" => "Parfait! On va pouvoir se concentrer
sur la capture des forts!",
  "1.0.34.0" => "Merci de nous avoir aidés! Notre mission
est accomplie! Allons-nous-en!",
  "1.0.35.0" => "Il n'a pas réussi à appeler les renforts... Ça veut
dire qu'on doit défendre la base nous-mêmes!",
  "1.0.36.0" => "J'ouvrirai ces portes de mes propres mains
si c'est nécessaire. Tiens bon, Zelda!",
  "1.0.37.0" => "Zelda! Tu es vivante! Quel soulagement!
Tiens, prends un peu de ma magie!",
  "1.0.38.0" => "Vous avez toute ma gratitude!",
  "1.0.39.0" => "Zelda!
Comment ont-ils pu oser?",
  "1.0.40.0" => "Hé, ma boussole brille à nouveau!",
  "1.0.41.0" => "Ne sois pas trop présomptueuse. Rappelle-toi
que tu parles à la princesse du Crépuscule!",
  "1.0.42.0" => "Hé! Mais c'est moi qui ai battu le
monstre le plus fort, je me trompe?",
  "1.0.43.0" => "Non en effet... Mais la magie des ombres
semble toujours faire effet... Que peut-on faire?",
  "1.0.44.0" => "Tout va bien se passer. En tant que princesse
du Crépuscule, c'est à moi de régler ça!",
  "1.0.45.0" => "Notre base! Comment peut-on sauver Zelda si
nous ne pouvons même pas la défendre?",
  "1.0.46.0" => "Pardonnez-moi... Je n'étais
pas... assez forte...",
  "1.0.47.0" => "Hé! Les portes de la base ennemie
ne se sont pas ouvertes!",
  "1.0.48.0" => "Vous ne vous en tirerez
à si bon compte!",
  "1.0.49.0" => "C'est réglé de ce côté-là!
Maintenant, allons prendre ce fort!",
  "1.0.50.0" => "Nous devons faire quelque chose!",
  "1.0.51.0" => "Je ne laisserai pas la magie du
Crépuscule dévorer ce monde!",
  "1.0.52.0" => "La magie du Crépuscule semble venir
de ce fort au nord! Allons voir!",
  "1.0.53.0" => "Pourquoi sont-ils si motivés? Ça ne va pas
nous arranger... pas avec Zelda aussi affaiblie.",
  "1.0.54.0" => "Hé, faites attention! On dirait que nos
ennemis préparent quelque chose!",
  "1.0.55.0" => "Parfait, le sortilège s'est affaibli!
Libérez-moi le chemin!",
  "1.0.56.0" => "Le gardien de la porte est tombé! Le fort et la
base ennemie doivent être ouverts à présent!",
  "1.0.57.0" => "Je m'occupe de protéger
la princesse!",
  "1.0.58.0" => "Prenons ce fort! Cela devrait affaiblir le sort
protégeant le gardien et la base ennemie!",
  "1.0.59.0" => "Midona... J'ai pris ce que tu m'as
donné... Merci... Merci à toi aussi...",
  "1.0.60.0" => "Les invocations ont cessé, mais ils concentrent
leur magie sur les monstres les plus puissants!",
  "1.0.61.0" => "Un nouveau monstre est apparu!
Nous devons faire quelque chose!",
  "1.0.62.0" => "Bien compris! Je me
charge du côté ouest!",
  "1.0.63.0" => "Si on affaiblit le gardien et les portes,
je devrais pouvoir ouvrir le passage!",
  "1.0.64.0" => "Midona! Tu es... si... différente...
Et qui est donc cette jeune fille?",
  "1.0.65.0" => "Je m'appelle Linkle! Et je suis venue
l'aider à vous sauver, princesse!",
  "1.0.66.0" => "Hé, on discutera plus tard! Pour le
moment, il faut sauver la princesse!",
  "1.0.67.0" => "Le rôle d'un Héros comme d'une Héroïne,
c'est de sauver les princesses!",
  "1.0.68.0" => "L'usurpateur a beau se grimer, il ne reste qu'un
imposteur! Il ne peut triompher de l'original!",
  "13.0.2.0" => "Marchons d'abord vers l'est et prenons le
poste ennemi! Vous êtes prêts? En avant!",
  "13.0.3.0" => "Allez, dépêchez-vous! Prenez les forts
de l'est! Ne vous laissez pas distraire!",
  "13.0.4.0" => "Le pont est détruit mais ne vous en faites pas!
Concentrez-vous sur les forts!",
  "13.0.5.0" => "Un coffre au trésor...
Je ne vais pas me priver.",
  "13.0.6.0" => "Ils nous attaquent depuis les airs...
Qu'est-ce qu'on peut faire...?",
  "13.0.7.0" => "Je sais! Pour toucher un dragon en plein vol,
la seule solution, c'est d'utiliser la magie!",
  "13.0.8.0" => "Je vais créer un cercle magique dans le fort sous
le dragon! Occupez-le pendant ce temps-là!",
  "13.0.9.0" => "Les monstres m'empêchent d'avancer! Est-ce
que quelqu'un pourrait venir m'en débarrasser?",
  "13.0.10.0" => "Hé, vous allez vous en sortir tout seuls?
Sans moi, qui va tenir la première ligne?",
  "13.0.11.0" => "Il profite de mon absence pour attaquer...
Je dois vite aller créer le cercle magique!",
  "13.0.12.0" => "Le cercle magique est prêt!
Utilisons-le pour attaquer le dragon!",
  "13.0.13.0" => "Notre base ne va plus tenir très longtemps!
Utilisez vite le cercle magique pour attaquer!",
  "13.0.14.0" => "Fantastique! J'espère que c'est la dernière
fois qu'on entend parler de ce dragon...",
  "13.0.15.0" => "Oh non! Ils essaient de capturer Machaon!
Ne laissez pas l'ennemi l'approcher!",
  "13.0.16.0" => "Machaon a été capturée! Cela va sûrement
provoquer l'arrivée de renforts ennemis à l'est.",
  "13.0.17.0" => "Il nous faut un cercle magique pour vaincre ce
dragon! Prenez la place qu'il survole!",
  "13.0.18.0" => "C'est le même plan que tout à l'heure!
Je m'en occupe!",
  "13.0.19.0" => "Il cherche à attaquer notre base...
Il faut vite le chasser!",
  "13.0.20.0" => "J'ai terminé le cercle magique!
Faites qu'il compte!",
  "13.0.21.0" => "On ne va plus tenir longtemps... Utilisez vite
le cercle magique pour vaincre le dragon!",
  "13.0.22.0" => "Regardez! L'attaque magique a marché!
Le dragon a perdu beaucoup d'altitude!",
  "13.0.23.0" => "C'est déjà la troisième fois...
Combien de temps ça va encore durer?",
  "13.0.24.0" => "Mon cercle magique n'a pas l'air de faire effet...
Comment est-ce qu'on pourrait faire?",
  "13.0.25.0" => "Suivons le papillon vers le bâtiment au sud-est!
Nous devons lui faire confiance!",
  "13.0.26.0" => "Le cercle magique de la fontaine de la Déesse
pourrait nous aider à vaincre Pyrodactilus!",
  "13.0.27.0" => "Il ne nous reste plus que notre base.
Il faut la protéger coûte que coûte...",
  "13.0.28.0" => "Tu as vu? Voilà de quoi nous sommes capables!",
  "13.0.29.0" => "Nous devons vaincre Xanto et Pyrodactilus...
Ça ne peut pas être si difficile, n'est-ce pas?",
  "13.0.30.0" => "C'est justement votre ambition qui a causé
votre perte... à Cya et à toi...",
  "13.0.31.0" => "On l'a enfin vaincu...
Merci à vous tous!",
  "13.0.32.0" => "Les ennemis les plus puissants ont été vaincus!
Allons fermer la porte des âmes à présent!",
  "13.0.33.0" => "Les ennemis attaquent notre base!
Protégez-la!",
  "13.0.34.0" => "Notre base est sur le point de tomber!
Il nous faut du renfort, vite!",
  "13.0.35.0" => "Je n'ai pas été à la hauteur...
Pardonnez-moi...",
  "13.0.36.0" => "Notre base est tombée...
La bataille est perdue...",
}