Map {
  "1.0.0.0" => "¿De dónde han salido todos estos monstruos?",
  "1.0.1.0" => "¡Debemos mantenernos firmes! Somos los únicos
que podemos proteger Hyrule.",
  "1.0.2.0" => "Debemos proteger a la princesa.
¡Date prisa, Link!",
  "1.0.3.0" => "¡Luchad por Hyrule! ¡Proteged a la princesa
Zelda a toda costa!",
  "1.0.4.0" => "Ese bicho es demasiado fuerte...
¿Cómo podemos acabar con él?",
  "1.0.5.0" => "¡Primero debemos acabar con el lagarto!",
  "1.0.6.0" => "¡Venid a por mí!",
  "1.0.7.0" => "¿De verdad no es más que
un simple soldado en prácticas?",
  "1.0.8.0" => "¡Qué fuerza! ¿Quién es ese soldado?",
  "1.0.9.0" => "¿Estás listo para reunirte con tus antepasados?
¡Yo te ayudaré!",
  "1.0.10.0" => "¡No dejéis avanzar al caballero dragón!",
  "1.0.11.0" => "No sé quién eres, pero algún día
volveremos a encontrarnos.",
  "1.0.12.0" => "Esas rocas nos impiden llegar hasta
la princesa Zelda.",
  "1.0.13.0" => "¡Ya no podemos contenerlos! ¡Ayuda!",
  "1.0.14.0" => "¡Nos necesitan, Link!",
  "1.0.15.0" => "Bien, ahora ya no podrán pasar.",
  "1.0.16.0" => "¡Gracias! Entra en la cueva y quédate el tesoro
que hay dentro como recompensa.",
  "1.0.17.0" => "Lo único que puedo hacer es
dejar aquí el tesoro.",
  "1.0.18.0" => "Usa las bombas para romper las rocas.
Así llegaremos hasta la princesa.",
  "1.0.19.0" => "¡Atacad! ¡Acabad con esa supuesta
princesa de Hyrule!",
  "1.0.20.0" => "¡Tomad el bastión central y el bastión este!
¡Luego cerrad las puertas norte!",
  "1.0.21.0" => "Voy a diseñar una estrategia para la batalla.
Mientras tanto tenéis que tomar ese bastión.",
  "1.0.22.0" => "No tengo tiempo para estas naderías. ¡Hay otros
asuntos que requieren mi atención!",
  "1.0.23.0" => "¡Están atacando la base aliada!",
  "1.0.24.0" => "¡Magnífico! Ahora, a por el bastión este.",
  "1.0.25.0" => "¡Recuperad el bastión central!",
  "1.0.26.0" => "¡Muy bien! Y ahora, a por el bastión central.",
  "1.0.27.0" => "¡Recuperad el bastión este!",
  "1.0.28.0" => "Hemos hecho que el enemigo se retire hacia
el norte. Ahora debemos dar con la Gran Hada.",
  "1.0.29.0" => "El muro de la fuente bloquea nuestro avance.
Si tuviésemos bombas...",
  "1.0.30.0" => "¡Atención! ¡El enemigo ataca por el norte!",
  "1.0.31.0" => "Veo que por fin habéis avanzado. ¡Ahora
id hacia el sur y tomad el Castillo de Hyrule!",
  "1.0.32.0" => "¡Por aquí! Debemos rezar todos juntos
a la Gran Hada.",
  "1.0.33.0" => "¡Bien! Las fuerzas enemigas se han visto
mermadas.",
  "1.0.34.0" => "Eso debe de haber reducido sus filas.",
  "1.0.35.0" => "¡Bien! ¡Ahora podemos contratacar!",
  "1.0.36.0" => "Princesa Zelda, os ruego que os retiréis.
Nosotros nos ocuparemos del resto.",
  "1.0.37.0" => "De acuerdo. ¡Que las diosas os protejan!",
  "1.0.38.0" => "Muy bien, seguid jugando a luchar... Mientras
tanto yo me divertiré.",
  "1.0.39.0" => "¡Ja, ja, ja! La batalla se ha puesto interesante.
¡Traed al rey dodongo!",
  "1.0.40.0" => "¿Qué clase de monstruo es ese?",
  "1.0.41.0" => "Debemos hacer cuanto podamos para detenerlo.",
  "1.0.42.0" => "¡Debemos detenerlo!",
  "1.0.43.0" => "Debemos defender este lugar a toda
costa. ¡Si cae, estaremos perdidos!",
  "1.0.44.0" => "¡Utiliza el cántaro! Aumentará la potencia
de tus bombas.",
  "1.0.45.0" => "¡Buen trabajo! ¡Habéis aguantado hasta el final!",
  "1.0.46.0" => "¡Comandante Impa, tenemos malas noticias!
El enemigo se ha apoderado del castillo.",
  "1.0.47.0" => "El monstruo no era más que un señuelo...
¿Dónde estará la princesa?",
  "1.0.48.0" => "La luz volverá a Hyrule.",
  "1.0.49.0" => "Nos han derrotado...",
  "1.0.52.0" => "¡Ja, ja! ¡Seguid atacando!",
  "1.0.55.0" => "Ya me imaginaba que no podía fiarme
de Volga. ¡Rápido, enviad más tropas!",
  "1.0.57.0" => "Si todo sale bien, acabaremos con ellos de un
solo golpe. ¡Rápido, a la fuente del hada!",
  "1.0.58.0" => "¡Venid, rápido! Ayudadme a derribar el muro.",
  "1.0.59.0" => "¡Daos prisa y avanzad hacia el sur!
Debemos cercar la base hyliana.",
  "1.0.60.0" => "¡Han invadido el bastión central!",
  "1.0.61.0" => "Vaya, así que habéis logrado entrar. ¡Bien!
¡Ahora id a por la base hyliana!",
  "1.0.62.0" => "¿Cómo? ¿Que han tomado el bastión este?",
  "1.0.63.0" => "¿Qué has dicho?",
  "1.0.65.0" => "¡Mira, Link! ¡Es la princesa!",
  "1.0.66.0" => "Tú eres el muchacho al que
vi entrenando...",
  "1.0.67.0" => "¡Princesa, estáis viva! Este soldado novato
ha utilizado bombas para abrirse paso.",
  "1.0.68.0" => "¿Un novato? Supongo que las apariencias
engañan.",
  "1.0.69.0" => "Una roca enorme nos bloquea el paso.
¿Podrías usar tus bombas?",
  "1.0.70.0" => "¡No conseguimos encontrarla!",
  "1.0.71.0" => "¿Cómo?",
  "1.0.72.0" => "Nosotros nos encargaremos del bastión
este. ¡Que alguien se ocupe del central!",
  "1.0.73.0" => "Te vi antes cuando estabas entrenando.",
  "1.0.74.0" => "¡Auxilio!
¡Me rodean los monstruos!",
  "1.0.75.0" => "¡Gracias! Me llamo Proxi y soy
un hada. ¿Tú quién eres?",
  "1.0.76.0" => "¿Link? Qué nombre más peculiar... Dime, ¿te
gustaría defender Hyrule de esos monstruos?",
  "1.0.77.0" => "¡Espléndido! Yo te ayudaré. ¡Seguro que
juntos nos hacemos famosos!",
  "1.0.79.0" => "¡Hagámonos con el bastión oeste!
Así podremos reunirnos con Impa.",
  "1.0.80.0" => "Hemos hecho retroceder al enemigo al
norte. Ahora necesitamos a la Gran Hada.",
  "1.0.81.0" => "Me encargaré de poner en marcha el plan.
¡Vamos, a la fuente del hada!",
  "1.0.82.0" => "¡Ataquemos el Castillo de Hyrule por el
norte, que es donde hay menos soldados!",
  "1.0.83.0" => "¡Sellemos la puerta del norte para
impedir la invasión enemiga!",
  "1.0.84.0" => "¡A sus órdenes, princesa!",
  "1.0.85.0" => "¡Hemos derrotado al enemigo! ¡Cerrad
el punto de control de la zona rocosa!",
  "1.0.86.0" => "¡Rápido, a la fuente del hada!",
  "1.0.87.0" => "¡Por aquí, princesa! ¡Pidamos ayuda
a la Gran Hada!",
  "1.0.88.0" => "¡Gran Hada, escucha nuestras súplicas!",
  "1.0.89.0" => "El plan ha sido todo un éxito gracias
a ti. Te ruego que aceptes esto.",
  "1.0.90.0" => "Es peligroso combatir en solitario.
¡Unamos nuestras fuerzas!",
  "1.0.91.0" => "Todo está preparado. ¡Daos prisa
y sellad la puerta del norte!",
  "1.0.92.0" => "¡Lo hemos conseguido! ¡Hemos diezmado
a los enemigos!",
  "1.0.93.0" => "¡Hemos diezmado un poco a los enemigos!",
  "1.0.94.0" => "¡Rápido, debemos impedir que el enemigo
refuerce el bastión! ¡Hay que tomarlo!",
  "1.0.95.0" => "¡Echadme una mano! Si atacamos juntos,
acabaremos con el monstruo.",
  "13.0.0.0" => "Si usamos esto para romper las rocas, podremos
llegar hasta la princesa Zelda.",
  "13.0.1.0" => "¡Tenemos que defender la base!",
  "13.0.2.0" => "¡Tenemos que recuperar el bastión central!",
  "13.0.3.0" => "¡Tenemos que recuperar el bastión este!",
  "13.0.4.0" => "¡Cuidado! El enemigo se acerca por el norte.",
  "13.0.5.0" => "¡El enemigo se aproxima al bastión central!",
  "13.0.6.0" => "¿Qué hacemos? El enemigo se aproxima por
el bastión este.",
  "13.0.7.0" => "¡Nosotros nos encargaremos, princesa!",
  "13.0.8.0" => "¿Eso es un fantasma?",
  "13.0.9.0" => "¡No dejéis que se adelante!",
  "13.0.10.0" => "Lo siento mucho, princesa. No sé cómo he podido
caer en su trampa.",
  "13.0.11.0" => "Desde aquí podemos hacer retroceder al enemigo.
¡Vamos allá!",
  "13.0.12.0" => "¿Estás bien, Impa?",
  "13.0.13.0" => "¿Eres uno de los soldados novatos?",
  "13.0.14.0" => "Debemos tomar el bastión central y el
del este, y luego cerrar sus puertas norte.",
  "13.0.15.0" => "Yo me dispondré a trazar el plan de batalla.
Princesa, encargaos de tomar los bastiones.",
  "13.0.16.0" => "El enemigo se ha abierto paso en el norte.
Necesitamos que la Gran Hada nos ayude.",
  "13.0.17.0" => "Si el plan tiene éxito, asestaremos un buen golpe
a todas las tropas. ¡A la fuente del hada!",
  "13.0.18.0" => "Si tuviésemos bombas, podríamos echar
abajo el muro de la fuente del hada.",
  "13.0.19.0" => "¡Rápido, por aquí! Echad abajo el muro
de la fuente del hada y entrad.",
  "13.0.20.0" => "Tened mucho cuidado; el enemigo está atacando
en el norte.",
  "13.0.21.0" => "¡Han tomado el bastión este!",
  "13.0.22.0" => "¡Por aquí! Debemos rezar todos juntos a
la Gran Hada.",
  "13.0.23.0" => "Princesa, el plan ha sido todo un éxito.
Hemos logrado mermar sus filas.",
  "13.0.24.0" => "Princesa, todo ha salido según lo planeado.
El enemigo ha sufrido muchas bajas.",
  "13.0.25.0" => "Yo me encargaré de esto, Impa. Tú tendrás
que dirigir a las tropas hylianas.",
  "13.0.26.0" => "De acuerdo. ¡Mucha suerte, princesa!",
  "13.0.27.0" => "¡Buen trabajo! Tanto esfuerzo al fin ha dado
sus frutos.",
  "13.0.28.0" => "¡Tenemos malas noticias, princesa!
¡El hechicero se ha apoderado del castillo!",
  "13.0.29.0" => "¡Link, tenemos que luchar por Hyrule!",
  "13.0.30.0" => "Con esto podremos volar esas rocas y llegar
hasta Impa.",
  "13.0.31.0" => "¡Tomad esto, princesa! Hará que las bombas
sean más potentes.",
  "13.0.32.0" => "Os he fallado, princesa...",
  "13.0.33.0" => "Las rocas nos impiden llegar hasta Impa...
¿No habrá nada que podamos hacer?",
  "13.0.34.0" => "¡Mira, Link! ¡Es la princesa!",
}