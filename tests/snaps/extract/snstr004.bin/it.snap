  "0.43.0" => "A0%1sF0R ha perso! Hai catturato A0%2sF2R!",
  "0.44.0" => "A0%1sF0R va verso l'area C2%2sF6R!",
  "0.45.0" => "A0%1sF0R ha raggiunto l'area C2%2sF6R!",
