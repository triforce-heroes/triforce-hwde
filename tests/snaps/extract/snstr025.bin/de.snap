Map {
  "0.0.0" => "A0%1sF0R rückt gegen A0%2sF6R vor!",
  "0.1.0" => "Der A2FeindR hat in mehreren A2FestungenR Verstärkung erhalten!",
  "0.2.0" => "Die A0%1sF5R haben weitere Verstärkung erhalten!",
  "0.3.0" => "A0%1sF1R rücken zu A1FestungenR der A0%2sF5R vor!",
  "0.4.0" => "A0%1sF0R darf nicht fliehen!",
  "0.5.0" => "A0%1sF0R ist in Bedrängnis und braucht Hilfe!",
  "0.6.0" => "A0%1sF0R ist in Gefahr und benötigt auf der Stelle Hilfe!",
  "0.7.0" => "A0%1sF0R wurde von den A0%2sF7R vertrieben!",
  "0.8.0" => "A0%1sF0R hat A0%2sF6R erreicht!",
  "0.9.0" => "A0%1sF0R hat das Ziel erreicht!",
  "0.10.0" => "A0%1sF0R rückt Richtung A0%2sF4R vor!",
  "0.11.0" => "A0%1sF0R hat A0%2sF6R erreicht!",
  "0.12.0" => "A0%1sF1R haben sich zurückgezogen!",
  "0.13.0" => "Die A0%1sF5R haben Verstärkung erhalten!",
  "0.14.0" => "A0%1sF0R wurde angegriffen und hat sich vorerst zurückgezogen!",
  "0.15.0" => "A0%1sF0R muss den A6Saal der ZauberinR erreichen!",
  "0.16.0" => "C2%1sF0R wurde erobert!",
  "0.17.0" => "A0%1sF0R wurde vor der Dunkelheit gerettet!",
  "0.18.0" => "Die A2FestungenR der A0%1sF5R sind teilweise offen!",
  "0.19.0" => "Die A0%1sF1R rücken gegen A0%2sF6R vor!",
  "0.20.0" => "A0%1sF0R ist nun als spielbarer Kämpfer verfügbar!",
  "0.21.0" => "Die A0%1sF5R haben vielerorts Verstärkung erhalten!",
  "0.22.0" => "Besiege alle A2Ziel-GegnerR und beschütze A0%1sF6R!",
  "0.23.0" => "A0%2sF0R kämpft mit A0%1sF1R!",
  "0.24.0" => "Die A0%1sF1R haben weitere Verstärkung erhalten!",
  "0.25.0" => "A0%1sF0R bereitet eine Beschwörung vor!",
  "0.26.0" => "Die Einheit A0%1sF2R wurde zerschlagen!",
  "0.27.0" => "A0%1sF0R hat A0%2sF6R beschworen!",
  "0.28.0" => "A0%1sF0R hat A0%2sF6R erneut beschworen!",
  "0.29.0" => "A0%1sF0R rückt gegen A0%2sF6R vor!",
  "0.30.0" => "A0%1sF0R wurde besiegt!",
  "0.31.0" => "A0%1sF0R bereitet eine Stärkung der Truppen vor!",
  "0.32.0" => "A0%1sF0R motiviert einen Teil der A0%2sF3R!",
  "0.33.0" => "Die Moral eines Teils der A0%1sF1R steigt!",
  "0.34.0" => "Alle A2Ziel-GegnerR wurden besiegt!",
  "0.35.0" => "A0%1sF0R und A0%2sF7R wurden gesichtet!",
  "0.36.0" => "A0%1sF0R wurde besiegt!",
  "0.37.0" => "Beide A0%1sF3R wurden besiegt!",
  "0.38.0" => "A0%1sF0R ist in Bedrängnis und braucht Hilfe!",
  "0.39.0" => "A0%1sF0R ist in Gefahr und benötigt auf der Stelle Hilfe!",
  "0.40.0" => "A0%1sF0R ist geflohen!",
  "0.41.0" => "Die A0%1sF1R wurden besiegt!",
  "0.42.0" => "A0%1sF0R droht zu fallen! Deine Hilfe wird benötigt!",
  "0.43.0" => "A0%1sF0R steht kurz davor zu fallen! Deine Hilfe wird benötigt!",
  "0.44.0" => "C1%1sF0R ist an die A0%2sF7R gefallen!",
  "0.45.0" => "1 A0%1sF3R wurde besiegt!",
  "0.46.0" => "Die Bedingungen für eine Niederlage haben sich geändert!",
  "0.47.0" => "A0%1sF0R darf nicht fliehen und A0%2sF5R darf nicht fallen!",
  "0.48.0" => "C2%1sF0R wurde erobert und liefert keine Verstärkung mehr!",
  "0.49.0" => "A0%1sF0R ist offen!",
  "0.50.0" => "Alle A2FestungenR der A0%1sF5R wurden erobert!",
  "0.51.0" => "A0%1sF0R bereitet erneut eine Beschwörung vor!",
  "0.52.0" => "Eine A6SkulltulaR wurde auf dem Schlachtfeld gesichtet!",
  "0.53.0" => "Die A6SkulltulaR ist geflohen!",
  "0.54.0" => "A0%1sF0R und A0%2sF5R rücken gegen A0%3sF6R vor!",
  "0.55.0" => "Beide A0%1sF3R sind geflohen!",
  "0.56.0" => "Die A0%1sF1R nähern sich A0%2sF4R!",
  "0.57.0" => "Die A0%1sF1R haben A0%2sF6R erreicht!",
  "0.58.0" => "A0%1sF0R im Westen rückt gegen A0%2sF6R vor!",
  "0.59.0" => "A0%1sF0R im Osten rückt gegen A0%2sF6R vor!",
