  "0.51.0" => "Ouverture A6%1sF2R !",
  "0.52.0" => "A0%1sF4R est plus puissant grâce à son sang de dragon !",
  "0.53.0" => "A0%1sF4R avance pour empêcher A0%2sF0R de progresser !",
  "0.54.0" => "La foudre de A1NarishaR affaiblit A0%1sF0R !",
  "0.55.0" => "Escortez A0%1sF0R !",
  "0.56.0" => "La A1base alliéeR ne doit pas tomber aux mains de l'ennemi !",
  "0.57.0" => "A0%1sF0R restaure son énergie vitale grâce à son sang de dragon !",
  "0.58.0" => "Une A6skulltulaR est apparue sur le champ de bataille !",
