Map {
  "0.0.0" => "A0%1sF5R appaiono nei A6presidi magiciR!",
  "0.1.0" => "Il morale A0%1sF7R è migliorato grazie ai A6presidi magiciR!",
  "0.2.0" => "Conquista i A6presidi magiciR est e ovest!",
  "0.3.0" => "Hai conquistato il A6presidio magicoR! Hai interrotto il flusso magico!",
  "0.4.0" => "Conquista i A6presidi magiciR e interrompi il flusso magico!",
  "0.5.0" => "Hai interrotto il flusso magico ovest!",
  "0.6.0" => "Interrompi il flusso magico est!",
  "0.7.0" => "Hai interrotto il flusso magico est!",
  "0.8.0" => "Interrompi il flusso magico ovest!",
  "0.9.0" => "L'area A0%1sF0R è aperta!",
  "0.10.0" => "A0%1sF0R va verso l'area A0%2sF6R!",
  "0.11.0" => "A0%1sF0R ha raggiunto l'area A0%2sF4R!",
  "0.12.0" => "A0%1sF0R si ritira temporaneamente!",
  "0.13.0" => "A0%1sF0R è in campo!",
  "0.14.0" => "Sconfiggi A0%1sF3R!",
  "0.15.0" => "A0%1sF0R ha perso!",
  "0.16.0" => "Appaiono ancora A0%1sF7R!",
  "0.17.0" => "L'A0%1sF1R è apparsa!",
  "0.18.0" => "L'A0%1sF1R sferra un attacco contro l'A0%2sF7R!",
  "0.19.0" => "A0%1sF0R si ritira verso il palazzo!",
  "0.20.0" => "L'A0%1sF1R si ritira verso l'area A0%2sF6R!",
  "0.21.0" => "A0%1sF0R va verso l'area A0%2sF6R!",
  "0.22.0" => "A0%1sF1R hanno perso!",
  "0.23.0" => "Il morale dell'A0%1sF1R è migliorato!",
  "0.24.0" => "A0%1sF0R ha evocato un'orda di demoni!",
  "0.25.0" => "A0%1sF0R ha abbandonato il campo di battaglia!",
  "0.26.0" => "Le condizioni di sconfitta sono cambiate!",
  "0.27.0" => "Tieni al sicuro A0%1sF6R e gli altri!",
  "0.28.0" => "Scorta l'A0%1sF5R!",
  "0.29.0" => "A0%1sF5R vanno verso A0%2sF2R!",
  "0.30.0" => "Le condizioni di vittoria sono cambiate!",
  "0.31.0" => "Devi sconfiggere A0%1sF2R!",
  "0.32.0" => "A0%1sF4R è in difficoltà! Vai in soccorso!",
  "0.33.0" => "A0%1sF4R è in grave pericolo! Corri subito in soccorso!",
  "0.34.0" => "A0%1sF0R ha raggiunto l'area A0%2sF6R con il teletrasporto!",
  "0.35.0" => "A0%1sF0R ha raggiunto l'area A0%2sF6R con il teletrasporto!",
  "0.36.0" => "A0%1sF0R ha abbandonato il campo di battaglia!",
  "0.37.0" => "L'A0%1sF1R ha sconfitto A0%2sF2R!",
  "0.38.0" => "L'A0%1sF1R ha vinto la battaglia!",
  "0.39.0" => "L'A0%1sF1R ha perso la battaglia!",
  "0.40.0" => "A0%1sF0R è in fuga!",
  "0.41.0" => "Il A6presidio magicoR centrale è stato conquistato!",
  "0.43.0" => "A1ZeldaR ha percepito una presenza maligna!",
  "0.44.0" => "A0%1sF0R si mette in marcia e la A6porta nord del roseto estR è aperta!",
  "0.45.0" => "A0%1sF4R si avvicina a A0%2sF6R!",
  "0.46.0" => "A0%1sF4R ha cominciato a combattere contro A0%2sF2R!",
  "0.47.0" => "I A6presidi magiciR ovest sono stati conquistati!",
  "0.48.0" => "I A6presidi magiciR est sono stati conquistati!",
  "0.51.0" => "Attenzione, A0%1sF2R non deve ritirarsi!",
  "0.52.0" => "L'A0%1sF1R cambia direzione per salvare A0%2sF2R!",
  "0.53.0" => "I A6presidi magiciR ovest sono stati riattivati!",
  "0.54.0" => "I A6presidi magiciR est sono stati riattivati!",
  "0.55.0" => "Un'A6AracnulaR è stata avvistata sul campo di battaglia!",
  "0.56.0" => "Cerca l'A6AracnulaR!",
  "0.57.0" => "Hai ottenuto l'A6AracnulaR!",
  "0.58.0" => "L'A6SkulltulaR comincia a preparare la fuga!",
  "0.59.0" => "L'A6AracnulaR è fuggita!",
  "0.60.0" => "Hai sconfitto il nemico!",
  "0.61.0" => "La trappola di A0%2sF6R ha chiuso l'area A0%1sF0R!",
  "0.62.0" => "Appare ancora A0%1sF6R!",
  "0.63.0" => "L'area A0%1sF0R si è aperta!",
  "0.64.0" => "Hai sconfitto 2 A0%1sF7R!",
  "0.65.0" => "A1SheikR ha percepito un immenso potere maligno!",
  "0.66.0" => "A0%1sF0R corre verso A0%2sF2R!",
  "0.67.0" => "Raggiungi l'area A0%1sF6R!",
  "0.68.0" => "A0%1sF0R è in pericolo! È richiesto aiuto immediato!",
  "0.69.0" => "A0%1sF0R è in grave pericolo! È richiesto aiuto immediato!",
  "0.70.0" => "Il morale A0%1sF7R è peggiorato!",
  "0.71.0" => "A0%1sF0R va verso A0%2sF2R!",
  "0.72.0" => "L'area C1%1sF0R si è arresa!",
  "0.73.0" => "Il flusso magico est è stato riattivato!",
  "0.74.0" => "Il flusso magico ovest è stato riattivato!",
  "0.75.0" => "Riconquista i A6presidi magiciR!",
  "0.76.0" => "L'area C2%1sF0R è aperta!",
  "0.77.0" => "A0%1sF0R deve andare verso l'area C2%2sF0R!",
  "0.78.0" => "Hai sconfitto A0%1sF2R!",
  "0.79.0" => "A0%2sF0R nell'area C4%1sF4R comincia a incoraggiare!",
  "0.80.0" => "A0%2sF4R fomenta parte dell'A0%1sF1R!",
  "0.81.0" => "A0%1sF0R non ha completato il piano!",
  "0.82.0" => "A0%1sF0R deve eliminare A0%3sF2R all'area C2%2sF0R!",
  "0.83.0" => "A0%1sF0R si prepara a evocare!",
  "0.84.0" => "L'area A0%1sF0R è aperta!",
  "0.85.0" => "A0%1sF0R va verso A0%2sF6R!",
  "0.86.0" => "A0%1sF0R deve raggiungere l'area A0%2sF0R!",
  "0.87.0" => "A0%1sF0R sta avanzando!",
  "0.88.0" => "A0%1sF0R ha evocato A5potenti demoniR!",
  "0.89.0" => "A0%1sF0R ha evocato altri A5potenti demoniR!",
  "0.90.0" => "A0%1sF0R si prepara di nuovo a evocare!",
  "0.91.0" => "A0%1sF0R ha perso e l'armata si ritira!",
  "0.92.0" => "A0%1sF0R appare e va verso l'area C4%2sF6R!",
  "0.93.0" => "Nell'area A0%1sF6R si nasconde un tesoro!",
  "0.94.0" => "Hai conquistato l'area C2%1sF4R!",
  "0.95.0" => "Hai conquistato l'area C4%1sF4R!",
