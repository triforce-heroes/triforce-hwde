Map {
  "0.0.0" => "Besiege die A2FeldmarschälleR der beiden feindlichen Truppenteile!",
  "0.1.0" => "Die A0%1sF1R wurden besiegt!",
  "0.2.0" => "Die A0%1sF1R haben die Schlacht gewonnen!",
  "0.3.0" => "A0%1sF0R ist geflohen! Du hast verloren!",
  "0.4.0" => "A1Dein HauptquartierR ist gefallen! Du hast verloren!",
  "0.5.0" => "Ein Teil der A0%1sF1R rückt in Richtung A1deines HauptquartiersR vor!",
  "0.8.0" => "Ein Teil der A0%1sF1R rückt vor!",
  "0.9.0" => "A0%1sF0R rückt Richtung A0%2sF4R vor!",
  "0.10.0" => "Ein Teil der A0%1sF1R rückt gegen A1deine TruppenR vor!",
  "0.11.0" => "Auch ein Teil der A0%1sF1R rückt gegen A1deine TruppenR vor!",
  "0.15.0" => "Du hast alle A2feindlichen HauptleuteR besiegt!",
  "0.16.0" => "A0%1sF0R rückt als Nächstes Richtung A0%2sF4R vor!",
  "0.17.0" => "A0%1sF0R ist offen!",
  "0.18.0" => "Besiege den anderen A2feindlichen FeldmarschallR!",
  "0.20.0" => "Die A0%1sF1R haben Verstärkung erhalten!",
  "0.21.0" => "Verstärkung für die A0%1sF1R eilt A0%2sF1R!",
  "0.22.0" => "Die A0%1sF1R haben erneut Verstärkung erhalten!",
  "0.24.0" => "Die Einheit A0%1sF2R wurde zerschlagen!",
  "0.25.0" => "Besiege A0%2sF6R zusammen mit A0%1sF4R!",
  "0.26.0" => "Verräter der A0%1sF5R bilden die A0%2sF1R!",
  "0.28.0" => "Der Feldmarschall der A0%1sF5R wurde gesichtet!",
  "0.29.0" => "A0%1sF0R wirbt Soldaten der A0%2sF3R ab!",
