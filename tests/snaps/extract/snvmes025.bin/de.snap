Map {
  "1.0.0.0" => "Ich kann Cias Anwesenheit spüren...
Aber das dort ist sie nicht!",
  "1.0.1.0" => "Das ist ein Nachbild der Schattenwelt. Wenn
wir es vertreiben, kann Cia gerettet werden.",
  "1.0.2.0" => "Trotz allem, was war... Wir müssen Cia
helfen, Link! Vertrauen wir Lana!",
  "1.0.3.0" => "Sie bekommen noch immer Verstärkung aus
dieser Festung. Das sollten wir unterbinden.",
  "1.0.4.0" => "Feiglinge! Sitzen in ihrer Festung und
rufen von dort Verstärkung!",
  "1.0.5.0" => "Beeilen wir uns und holen Cia da raus,
bevor noch mehr Feinde auftauchen!",
  "1.0.6.0" => "Sie rufen wieder Verstärkung?
Das nimmt kein gutes Ende...",
  "1.0.7.0" => "Retten wir Cia, bevor mehr Feinde
auftauchen! Dann ist es zu schaffen!",
  "1.0.8.0" => "Rufen wir zum Ausgleich eigene Verstärkung!",
  "1.0.9.0" => "Oh nein! Sie haben es auf unsere
Boten abgesehen!",
  "1.0.10.0" => "Vorsicht! Wir haben nur noch
einen einzigen Boten!",
  "1.0.11.0" => "Wir konnten sie nicht beschützen...",
  "1.0.12.0" => "Geschafft, zumindest einer ist
durchgekommen!",
  "1.0.13.0" => "Dann werde ich nun Verstärkung rufen!",
  "1.0.14.0" => "Die Gestalt in Schwarz ist abgehauen!",
  "1.0.15.0" => "Das muss warten... Zuerst müssen
wir diese Cia finden.",
  "1.0.18.0" => "Komm, Lana! Ohne dich können
wir Cia nicht retten!",
  "1.0.19.0" => "Lana, teile deine Magie mit Cia und hole
ihre Seele aus der Dunkelheit!",
  "1.0.20.0" => "Gut, ich versuche es! Cia, dieses Mal
werde ich dich retten!",
  "1.0.21.0" => "Wo bin ich? Lana? Du...
Du hast mich gerettet?",
  "1.0.22.0" => "Cia... Endlich sind wir wieder zusammen!
Helft mir! Sie braucht Ruhe!",
  "1.0.23.0" => "Dann schlagen wir hier für eine
Weile unser Hauptquartier auf.",
  "1.0.24.0" => "Die Monster rücken vor! Sie sind
bestimmt hinter eurer Cia her!",
  "1.0.25.0" => "Cia ist noch nicht transportfähig...
Ich muss sie beschützen!",
  "1.0.26.0" => "Dann werde ich sie ebenfalls beschützen.
Lana, gib du die Anweisungen!",
  "1.0.27.0" => "Diese Präsenz... Es ist die falsche Cia von
vorhin... Will sie Cias Magie stehlen?",
  "1.0.28.0" => "Wenn wir die Monster zurückschlagen, zeigt
sich die Doppelgängerin vielleicht wieder...",
  "1.0.29.0" => "Dann müssen wir Cia beschützen, bis ihr
dunkler Zwilling wieder auftaucht!",
  "1.0.30.0" => "Von diesen gefährlichen Monstern darf
keines übrig bleiben!",
  "1.0.31.0" => "Wir müssen wachsam sein...
Vielleicht planen sie etwas!",
  "1.0.32.0" => "Cia kann noch nicht weg...
Wir müssen sie beschützen!",
  "1.0.33.0" => "Cia... Weißt du etwas über diese
Doppelgängerin?",
  "1.0.34.0" => "Dunkel-Cia... Sie hat meine Magie gestohlen
und wollte meinen Platz einnehmen...",
  "1.0.35.0" => "Das werde ich nicht zulassen!",
  "1.0.36.0" => "Die Monster nähern sich Cia!
Bitte beschützt sie!",
  "1.0.37.0" => "Danke... Lana.",
  "1.0.38.0" => "Es werden immer mehr!
Wir müssen irgendwas tun!",
  "1.0.39.0" => "Irgendwann geht ihnen sicher die Verstärkung
aus... Erobert am besten ihre Festungen...",
  "1.0.40.0" => "Nach der Eroberung der Festung haben sich die
Tore geöffnet! Wir müssen mehr Tore öffnen!",
  "1.0.41.0" => "Das scheint die Verstärkung
unterbunden zu haben...",
  "1.0.42.0" => "Link...?! Du hilfst, mich
zu beschützen?",
  "1.0.43.0" => "Du bist nicht mehr unser Feind. Link
will dir helfen, wie die anderen hier.",
  "1.0.44.0" => "Ein wahrer Held eben...",
  "1.0.45.0" => "Schon wieder feindliche Verstärkung!",
  "1.0.46.0" => "Das war sicher nicht alles. Wahrscheinlich
kommt noch mehr Verstärkung...",
  "1.0.47.0" => "Sie rufen noch mehr Verstärkung?
Das ist ja wohl die Höhe!",
  "1.0.48.0" => "Wir müssen sie irgendwie aufhalten,
bevor noch mehr Feinde erscheinen!",
  "1.0.49.0" => "Jetzt sollte Schluss mit der
Verstärkung sein.",
  "1.0.50.0" => "Noch mehr?! Sie dürfen nicht
zu Cia vordringen!",
  "1.0.51.0" => "Sie hat genug Magie für all diese Monster
und ist trotzdem hinter Cia her...",
  "1.0.52.0" => "Wir müssen diesen Gegner aufhalten, sonst
werden die feindlichen Truppen gestärkt!",
  "1.0.53.0" => "Ich werde hier nicht untätig
rumsitzen!",
  "1.0.54.0" => "Lana... Wenn das so weitergeht,
werde ich... aufhören zu existieren...",
  "1.0.55.0" => "Was...!?
Sag mir, wie ich dir helfen kann!",
  "1.0.56.0" => "Besiegt die, die meine Magie gestohlen
hat. Bringt meine Magie zurück...",
  "1.0.57.0" => "Oh! Der Feind ist gerade stärker geworden!",
  "1.0.58.0" => "Vortrefflich! Der feindliche Plan ist
durchkreuzt!",
  "1.0.59.0" => "Schon wieder? Wir sind am
Rande der Erschöpfung!",
  "1.0.60.0" => "Ich kann die Präsenz von Dunkel-Cia schon
spüren. Bald wird sie sich zeigen!",
  "1.0.61.0" => "Bitte haltet nur noch ein klein
wenig länger durch!",
  "1.0.62.0" => "Sie versuchen wieder, Verstärkung zu
bekommen... Das werde ich verhindern!",
  "1.0.63.0" => "Wenn es noch mehr werden, sind wir in
Schwierigkeiten! Wir müssen uns beeilen!",
  "1.0.64.0" => "Geschafft! Sie rufen keine
Verstärkung mehr!",
  "1.0.65.0" => "Wir haben all ihre Lakaien besiegt.
Jetzt sollte Dunkel-Cia sich zeigen.",
  "1.0.66.0" => "Ich spüre, dass sie sich nähert!
Macht euch bereit!",
  "1.0.67.0" => "Dunkel-Links? Wo kommen die denn her!?",
  "1.0.68.0" => "Sie sind wieder hinter Cia her!",
  "1.0.69.0" => "Dunkel-Cia will Cia beseitigen und
ihren Platz einnehmen...",
  "1.0.70.0" => "Das lassen wir nicht zu... Halte durch, Cia...
Wir werden sie besiegen!",
  "1.0.71.0" => "Dunkel-Cia muss die Dunkel-Links
erschaffen haben...",
  "1.0.72.0" => "Um Cia zu beschützen, müssen wir
die Dunkel-Links aufhalten.",
  "1.0.73.0" => "Das wäre geschafft! Und jetzt
weiter zum nächsten...",
  "1.0.74.0" => "Dunkel-Cia... Sie ist hier.",
  "1.0.75.0" => "Es kommt alles in Ordnung, Cia!
Ich werde sie besiegen! Versprochen!",
  "1.0.76.0" => "Damit ist die Gefahr durch
die Dunkel-Links gebannt!",
  "1.0.77.0" => "Dunkel-Cia ist besiegt... Jetzt zu dem, der
meine Magie gestohlen hat... Phantom-Ganon!",
  "1.0.78.0" => "Phantom-Ganon... Er ist die Manifestation
des Bösen aus Tetras Welt?",
  "1.0.79.0" => "Er ist es, der dein Triforce geraubt hat,
Lana. Er hat dich durch mich aufgespürt.",
  "1.0.80.0" => "Er hat Cias Magie und das Triforce gestohlen
und so die Welt aus dem Gleichgewicht gebracht.",
  "1.0.81.0" => "Besiegen wir gemeinsam Phantom-Ganon
und bringen die Welt wieder ins Lot!",
  "1.0.82.0" => "Was für eine unglaubliche Macht!
Wir müssen vorsichtig sein!",
  "1.0.83.0" => "Wir werden noch verlieren...
Uns muss etwas einfallen!",
  "1.0.84.0" => "Es tut mir leid, Kinder... Ich konnte
euch keine bessere Zukunft schaffen...",
  "1.0.85.0" => "Wir können so nicht weiterkämpfen...
Wir können Cia nicht retten...",
  "1.0.86.0" => "Ich kann nicht mehr...
Es tut mir leid, Lana...",
  "1.0.87.0" => "Cia! Nein...",
  "1.0.88.0" => "Das Hauptquartier wird angegriffen!
Schlagt den Feind zurück!",
  "1.0.89.0" => "Schnell, verteidigt das Hauptquartier,
bevor wir es verlieren!",
  "1.0.90.0" => "Unser Hauptquartier wurde eingenommen...
Wir können nicht weiterkämpfen...",
  "1.0.91.0" => "Ich kann Cias Anwesenheit spüren.
Sie muss hier sein!",
  "1.0.92.0" => "Unüberlegt wie immer...
Aber ich ziehe das mit euch durch!",
  "13.0.2.0" => "Aus den Magiekammern, die mit einem Magiefluss
verbunden sind, kommen stärkere Feinde.",
  "13.0.3.0" => "Ha! Mit jeder eroberten Magiekammer
unterbrechen wir den Magiefluss.",
  "13.0.4.0" => "Den Westen haben wir erobert. Jetzt müssen wir
nur noch den Magiefluss im Osten unterbrechen!",
  "13.0.5.0" => "Den Osten haben wir erobert. Jetzt müssen wir
nur noch den Magiefluss im Westen unterbrechen!",
  "13.0.6.0" => "Wir haben zwei Verbindungen auf einmal gestört!
Es war gut, zuerst die Mitte zu erobern!",
  "13.0.7.0" => "Es sind weitere Dunkel-Links aufgetaucht!
Wir dürfen Link nicht alleine lassen!",
  "13.0.8.0" => "Das sieht nicht gut aus, sie haben uns in
die Ecke gedrängt... An alle! Rückzug!",
  "13.0.9.0" => "Die Dunkel-Links werden im Saal der Zauberin
wiedererweckt und hindern uns an der Flucht!",
  "13.0.10.0" => "Link! Werde ja nicht übermütig!",
  "13.0.11.0" => "Link kommt auch allein zurecht!
Rückzug! Sofort!",
  "13.0.12.0" => "Argh... Diese Kraft...
Wir können ihr nicht entfliehen...",
  "13.0.13.0" => "Ist... alles verloren?",
  "13.0.14.0" => "Ist... Ist es schon zu spät?",
  "13.0.15.0" => "Link! Bitte... Tu es für mich...",
  "13.0.16.0" => "Link! Wenn unser Held fällt, ist Cia nicht
mehr aufzuhalten!",
  "13.0.17.0" => "Diese Bürde... Sie ist zu groß für mich...",
  "13.0.18.0" => "Wenn auch nur einer unserer Freunde fallen sollte,
verlieren wir den Kampf, der uns noch erwartet...",
  "13.0.19.0" => "Meine Bürde... Sie ist zu groß...",
  "13.0.20.0" => "Meine Bürde... Sie ist zu groß...",
  "13.0.21.0" => "Meine Bürde... Sie ist zu groß...",
  "13.0.22.0" => "Meine Bürde... Sie ist zu groß...",
  "13.0.23.0" => "Zwei Dunkel-Links sind bezwungen!
Erledigen wir jetzt noch die beiden anderen!",
  "13.0.24.0" => "Wenn das so ist... wäre es am besten,
durch den Rosengarten im Westen zu fliehen!",
  "13.0.25.0" => "Es... tut mir leid...
Ich... kann nicht mehr...",
  "13.0.26.0" => "Link... Warte! Ich komme mit!",
}