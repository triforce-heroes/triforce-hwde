  "0.14.0" => "Une A6prisonR a été repérée !",
  "0.15.0" => "Ouverture A6%1sF2R !",
  "0.16.0" => "Le A5darknutR a rejoint A0%1sF1R !",
  "0.17.0" => "A0%1sF4R rejoint le champ de bataille !",
  "0.18.0" => "A0%1sF4R avance vers A0%2sF0R !",
  "0.19.0" => "Éliminez immédiatement A0%1sF1R !",
  "0.20.0" => "La défaite A0%3sF3R galvanise A0%1sF0R et A0%2sF0R !",
  "0.21.0" => "Vous avez vaincu A0%1sF2R !",
  "0.22.0" => "A0%1sF4R et A0%2sF0R rejoignent le champ de bataille !",
  "0.23.0" => "C2%1sF4R est sous votre contrôle ! Ses portes sont ouvertes !",
  "0.24.0" => "Les conditions de victoire ont changé !",
  "0.25.0" => "Vaincre tous les A2monstres géantsR !",
  "0.26.0" => "A0%2sF4R galvanise A0%1sF0R par sa présence !",
  "0.27.0" => "A0%2sF4R renforce A0%1sF0R par sa présence !",
  "0.28.0" => "Vous avez vaincu A0%1sF0R !",
  "0.29.0" => "Continuez et éliminez A0%1sF0R et A0%2sF0R !",
  "0.30.0" => "Vous avez vaincu tous les A2monstres géantsR !",
  "0.31.0" => "A0%1sF4R est en grand danger !",
  "0.32.0" => "A0%1sF4R fuit !",
  "0.33.0" => "La fuite de A0%2sF0R galvanise A0%1sF1R !",
  "0.34.0" => "La fuite de A0%2sF0R renforce A0%1sF1R !",
  "0.35.0" => "A0%1sF5R a vaincu !",
  "0.36.0" => "A0%1sF5R a été vaincue !",
  "0.37.0" => "A0%1sF5R a pris le contrôle C1%2sF2R !",
  "0.38.0" => "Continuez et éliminez A0%1sF0R !",
  "0.39.0" => "Continuez et prenez le contrôle C2%1sF2R et C2%2sF2R !",
  "0.40.0" => "Une A6skulltulaR est apparue sur le champ de bataille !",
  "0.41.0" => "Trouvez la A6skulltulaR !",
  "0.42.0" => "Vous avez obtenu une A6skulltulaR !",
  "0.43.0" => "La A6skulltulaR s'apprête à fuir !",
  "0.44.0" => "La A6skulltulaR s'est enfuie !",
  "0.45.0" => "A0%1sF4R a senti un combat et avance !",
  "0.46.0" => "Éliminez les A2monstres géantsR avant qu'ils ne se rejoignent !",
  "0.47.0" => "Fermeture des portes des A6entrées du hameauR !",
  "0.48.0" => "Libérez les A5monstresR de leurs A6prisonsR !",
  "0.49.0" => "Les portes de l'A6entrée de la tour du JugementR sont fermées !",
  "0.50.0" => "Les portes de l'A6entrée de la tour du JugementR sont ouvertes !",
  "0.51.0" => "Des A2monstresR cachés dans la A6tour du JugementR rejoignent le champ de bataille !",
  "0.52.0" => "A0%1sF4R a senti un combat et lance un A2bombardement de grainesR !",
  "0.53.0" => "Évitez de laisser A2les monstres géantsR se rejoindre !",
  "0.54.0" => "A0%1sF4R et A0%2sF0R se sont rejoints !",
  "0.55.0" => "A0%1sF4R et A0%2sF0R veillent l'un sur l'autre et sont plus puissants !",
  "0.56.0" => "A0%1sF4R invoque des A2monstresR depuis le A6hameauR !",
  "0.57.0" => "Prenez immédiatement le contrôle des A6trois fortsR !",
  "0.58.0" => "A0%1sF4R invoque d'autres A2monstresR !",
  "0.59.0" => "A0%1sF5R avancent sur la A6partie sud du désertR depuis le A6nordR !",
  "0.60.0" => "Vous avez empêché A0%1sF1R d'atteindre le A6sud du désertR !",
  "0.61.0" => "A0%1sF5R ont pénétré dans la A6partie sud du désertR !",
  "0.62.0" => "Le regroupement galvanise une partie A0%1sF3R !",
  "0.63.0" => "Vous avez pris le contrôle des A6trois fortsR !",
  "0.64.0" => "A0%1sF7R apparaissent devant les A6prisonsR !",
  "0.65.0" => "A0%1sF5R se préparent à ouvrir les A6prisonsR !",
  "0.66.0" => "Vous avez vaincu la totalité A0%1sF3R !",
  "0.67.0" => "A0%1sF5R ont ouvert les A6portes des prisonsR !",
  "0.68.0" => "Les monstres des A6prisonsR ont rejoint A0%1sF1R !",
  "0.69.0" => "Éliminez A0%1sF0R !",
  "0.70.0" => "A0%1sF4R a senti un combat et avance !",
  "0.71.0" => "Le moral d'une partie A0%1sF3R augmente ! Elle avance vers A0%2sF1R !",
  "0.72.0" => "A0%1sF4R est K.-O. ! Ses troupes battent en retraite !",
  "0.73.0" => "Les portes C2%1sF2R, C2%2sF2R et C2%3sF2R sont ouvertes !",
  "0.74.0" => "Vous pouvez contrôler A0%1sF0R !",
  "0.75.0" => "L'attaque A0%2sF3R a fait fuir A0%1sF0R !",
  "0.76.0" => "A0%1sF6R apparaît et avance sur C2%2sF0R !",
  "0.77.0" => "Vous avez pris le contrôle C2%1sF2R !",
  "0.78.0" => "Un trésor semble reposer dans A0%1sF0R !",
