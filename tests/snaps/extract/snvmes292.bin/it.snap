Map {
  "1.0.0.0" => "Da dove spuntano tutti questi demoni?!",
  "1.0.1.0" => "Tenete duro! Solo noi possiamo salvare Hyrule!",
  "1.0.2.0" => "Dobbiamo proteggere la principessa!
Presto, Link!",
  "1.0.3.0" => "Difenderemo Hyrule dal nemico!
Difenderemo la principessa Zelda a ogni costo!",
  "1.0.4.0" => "Maledetta lucertola! Come si affronta?!",
  "1.0.5.0" => "Prima di tutto occupiamoci della lucertola!",
  "1.0.6.0" => "Fatevi sotto!!!",
  "1.0.7.0" => "Sei sicuro che sia una recluta in allenamento?",
  "1.0.8.0" => "Niente male... ma chi è?!",
  "1.0.9.0" => "Se hai fiducia in te, fatti sotto!",
  "1.0.10.0" => "Non far allontanare il cavaliere drago!",
  "1.0.11.0" => "Ugh... non ti conosco, ma un giorno ci rivedremo...",
  "1.0.12.0" => "Non posso salvare la principesse Zelda con questa
roccia che blocca la strada!",
  "1.0.13.0" => "Non ce la facciamo più, arciroccia! Aiuto!!!",
  "1.0.14.0" => "Oh, no! Andiamo ad aiutarli, Link!",
  "1.0.15.0" => "Adesso non potranno entrare più, acciroccia!",
  "1.0.16.0" => "Ci hai salvati...! Prendi questo come ringraziamento.",
  "1.0.17.0" => "Il nostro... tesoro...
Non mi resta che lasciarlo qui...",
  "1.0.18.0" => "Con quella potremo distruggere la roccia
e raggiungere la principessa Zelda!",
  "1.0.19.0" => "All'attacco!
Annientate la principessa di Hyrule!",
  "1.0.20.0" => "Conquistate il presidio centrale e quello di campo
est! Chiudete le loro porte nord!",
  "1.0.21.0" => "Sto pensando a un piano, nel frattempo conquistate
il presidio!",
  "1.0.22.0" => "Non ho tempo da perdere con voi.
Ho ben altre cose a cui pensare.",
  "1.0.23.0" => "Vogliono attaccare la nostra base! Proteggiamola!",
  "1.0.24.0" => "Fantastico!
Adesso attacchiamo il presidio di campo est!",
  "1.0.25.0" => "Riconquistiamo il presidio centrale!",
  "1.0.26.0" => "Bene così!
Adesso conquistate il presidio centrale!",
  "1.0.27.0" => "Riconquistate il presidio di campo est!",
  "1.0.28.0" => "Abbiamo spinto il nemico a nord! Adesso ci serve
l'aiuto della fata radiosa!",
  "1.0.29.0" => "Se solo avessimo una bomba...
Potremmo distruggere la porta della fontana...",
  "1.0.30.0" => "Attenzione, il nemico attacca da nord!",
  "1.0.31.0" => "Finalmente abbiamo sfondato le difese nemiche!
Presto, verso sud alla base di Hyrule!!!",
  "1.0.32.0" => "Da questa parte! Preghiamo insieme la fata
radiosa!",
  "1.0.33.0" => "Ottimo lavoro!
Questo sarà un duro colpo per l'armata nemica!",
  "1.0.34.0" => "Questo sarà un duro colpo per l'armata nemica!",
  "1.0.35.0" => "Bene, adesso passiamo al contrattacco!",
  "1.0.36.0" => "Principessa Zelda, state indietro!
Adesso ci pensiamo noi!",
  "1.0.37.0" => "Capisco. Pregherò per te.",
  "1.0.38.0" => "Giocate pure quanto volete...
Io nel frattempo...",
  "1.0.39.0" => "Ah ah ah! Adesso comincia il divertimento!
Esci fuori, Mega Dodongo!",
  "1.0.40.0" => "C-Cos'è quel bestione?!",
  "1.0.41.0" => "Dobbiamo sconfiggerlo!!!",
  "1.0.42.0" => "Altolà!",
  "1.0.43.0" => "Dobbiamo fare tutto il possibile! Se perdiamo
è tutto finito!",
  "1.0.44.0" => "Usa questo! Aumenterà la potenza delle bombe!",
  "1.0.45.0" => "Tenete duro! Continuate così!",
  "1.0.46.0" => "Impa, una notizia terribile! Lo stregone nemico ha conquistato il nostro castello!",
  "1.0.47.0" => "Cosa?! Allora quel mostro era un'esca?!
Dov'è la principessa Zelda? Sta bene?!",
  "1.0.48.0" => "Che la luce risplenda su Hyrule...",
  "1.0.49.0" => "Abbiamo... perso...",
  "1.0.50.0" => "Oh, no... la principessa Zelda è scappata...
Allora è tutto finito...",
  "1.0.51.0" => "Link, falli fuori in un sol colpo
con la mossa speciale!",
  "1.0.52.0" => "Ah ah ah! Continuate ad attaccare!",
  "1.0.53.0" => "È la nostra occasione! All'attacco!",
  "1.0.54.0" => "Ora! In un colpo solo!",
  "1.0.55.0" => "Maledetto Volga! Fate uscire la prossima unità!",
  "1.0.56.0" => "Usa l'incantesimo e falli fuori in un colpo solo!",
  "1.0.57.0" => "Se il piano funziona, basterà un colpo solo!
Seguimi dalla fata radiosa alla fontana della dea!",
  "1.0.58.0" => "Presto, da questa parte!
Aiutami a sfondare la porta!",
  "1.0.59.0" => "Presto, verso sud!
Attacchiamo la base di Hyrule!",
  "1.0.60.0" => "Il presidio centrale è stato sfondato...!",
  "1.0.61.0" => "Finalmente abbiamo sfondato le difese nemiche!
Presto, alla base di Hyrule!",
  "1.0.62.0" => "Cosa?
Hanno conquistato il presidio di campo est?!",
  "1.0.63.0" => "Che cosa...?",
  "1.0.64.0" => "Cosa? La principessa Zelda non si trova?!",
  "1.0.65.0" => "Guarda, Link! La principessa!!!",
  "1.0.66.0" => "Tu sei la recluta che si stava allenando...",
  "1.0.67.0" => "Principessa Zelda... siete salva!
Una recluta ci ha aperto la strada con le bombe!",
  "1.0.68.0" => "Oh, una recluta...?
Qualunque contributo è importante...",
  "1.0.69.0" => "Pare che una grossa roccia blocchi il cammino.
Puoi distruggerla con delle bombe?",
  "1.0.70.0" => "N-Non... non sappiamo dove si trovi...",
  "1.0.71.0" => "Che cosa?!",
  "1.0.72.0" => "Ci pensiamo noi al presidio est!
Occupatevi del presidio centrale!",
  "1.0.73.0" => "Conquistate il presidio centrale!
Attaccate la base nemica!",
  "1.0.74.0" => "Impa è da sola in mezzo al nemico...
Andrò ad aiutarla!",
  "1.0.75.0" => "I Goron sono in pericolo... Arrivo!",
  "1.0.76.0" => "Non posso raggiungere Impa con questa roccia...
Devo distruggerla in qualche modo!",
  "1.0.77.0" => "Con questa potremo distruggere la roccia
e raggiungere Impa!",
  "1.0.78.0" => "Impa! Stai bene?!",
  "1.0.79.0" => "Principessa Zelda! Perdonatemi!
Sono caduta nella trappola del nemico!",
  "1.0.80.0" => "Dobbiamo respingere il nemico!
Forza, andiamo!",
  "1.0.81.0" => "Principessa Zelda! Usate questo!
Potenzierà le vostre bombe!",
  "1.0.82.0" => "Principessa Zelda... perdonatemi...",
  "1.0.83.0" => "Conquistiamo il presidio centrale!
Andiamo verso la base nemica!",
  "13.0.0.0" => "Possiamo usare quella roba per distruggere la roccia e raggiungere la principessa Zelda!",
  "13.0.1.0" => "Oh, no! Dobbiamo proteggere la base!",
  "13.0.2.0" => "Dobbiamo riconquistare il presidio centrale!",
  "13.0.3.0" => "Riconquista il presidio di campo est!",
  "13.0.4.0" => "Attenzione! Il nemico attacca da nord!",
  "13.0.5.0" => "Oh, no! Il nemico ha sfondato il presidio centrale!",
  "13.0.6.0" => "Che facciamo?! Il nemico ha sfondato il presidio est!",
  "13.0.7.0" => "Principessa Zelda, al resto ci pensiamo noi!",
  "13.0.8.0" => "Ma... cosa...? Un fantasma?!",
  "13.0.9.0" => "I Goron sono in pericolo! Arrivo!",
  "13.0.10.0" => "Questa roccia mi impedisce di raggiungere Impa. Devo trovare un modo per distruggerla...",
  "13.0.11.0" => "Con questa forse potrei distruggere la roccia
e raggiungere Impa!",
  "13.0.12.0" => "Principessa Zelda! Usate questo! Potenzierete la capacità delle bombe!",
  "13.0.13.0" => "Principessa Zelda... perdonatemi...",
  "13.0.14.0" => "Conquistate il presidio centrale!
Io attaccherò la base nemica!",
}