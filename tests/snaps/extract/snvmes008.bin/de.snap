Map {
  "1.0.0.0" => "Hey, Link! Ich kann es nicht glauben!
Eine Insel am Himmel!",
  "1.0.1.0" => "Ich werde jeden einzelnen Menschen
dieser Welt unterwerfen!",
  "1.0.2.0" => "Pah. Dieser Volga scheint zu vergessen,
dass ich, Ghirahim, die Dämonen führe.",
  "1.0.3.0" => "Argh... Wir können den Wolkenhort
nicht länger halten...",
  "1.0.4.0" => "Wer befehligt diese Ungeheuer? Sieht aus, als
wäre es wieder dieser Drachenritter... Auf ihn!",
  "1.0.5.0" => "Unser Hauptquartier ist von Feinden
umzingelt! Ihr müsst vorsichtig sein!",
  "1.0.7.0" => "Oh! Blitze halten den Feind davon ab, sich
unserem Hauptquartier zu nähern!",
  "1.0.8.0" => "Ich werde das Hauptquartier gegen die
Knechte des Bösen verteidigen...",
  "1.0.9.0" => "Das ist Narisha, der große Geist des Himmels...
Er wird uns noch äußerst lästig, das spüre ich.",
  "1.0.10.0" => "Zu Hilfe! Sie rauben die Suppe, die als
Opfergabe für Narisha gedacht war!",
  "1.0.11.0" => "Mit dieser Suppe könnten wir Narisha anrufen,
damit er uns den Weg öffnet...",
  "1.0.12.0" => "Dann sollten wir Narisha seine Suppe
besorgen. Auf zur Statue der Göttin!",
  "1.0.13.0" => "Ihr seid hier, um uns zu helfen? Die Suppe ist
wirklich wichtig, wir müssen sie bewachen!",
  "1.0.14.0" => "Argh... Ich gebe den Löffel ab...
Jemand... muss... die Suppe...",
  "1.0.15.0" => "Der Feind dringt weiter vor! Wir müssen
schnell zur Statue der Göttin!",
  "1.0.16.0" => "Link...
Ich erwarte dich unter der Statue der Göttin.",
  "1.0.17.0" => "Hast du diese Stimme gehört? Jemand möchte
uns unter der Statue der Göttin treffen...",
  "1.0.18.0" => "Link... bis ich meine Aufgabe erfüllt habe,
bist du mein Gebieter.",
  "1.0.19.0" => "Ruft Narisha mit dieser Suppe!
Uns fehlt die Kraft dazu...",
  "1.0.20.0" => "Kürbissuppe. Verstanden. Ich werde mich
um ihren Transport kümmern.",
  "1.0.21.0" => "Könntet Ihr vielleicht auch unseren Freunden
im Nordteil der Ritterschule helfen?",
  "1.0.22.0" => "Wir lassen niemanden zurück!
Wir müssen ihnen helfen!",
  "1.0.23.0" => "Der Weg nach Norden ist versperrt.
Eure Freunde sind auf sich gestellt...",
  "1.0.24.0" => "Narisha kann uns den Weg öffnen!
Das haben die Soldaten doch gesagt, oder?",
  "1.0.25.0" => "Ich vermute, dass uns Narisha als Dank
für diese Suppe hilft. Ich werde sie tragen.",
  "1.0.26.0" => "Transport der Suppe abgeschlossen.",
  "1.0.27.0" => "Oh, ich liebe diese Suppe! Ist die für mich?",
  "1.0.28.0" => "Wenn ich ihr Hauptquartier einnehme,
gehört der Sieg ohne Wenn und Aber mir.",
  "1.0.29.0" => "Ich werde unsere Truppen unterstützen.
Kümmere dich um den feindlichen Anführer!",
  "1.0.30.0" => "Der feindliche Anführer? Ah, wir sollen uns
wohl diese grimmige Gestalt vorknöpfen...",
  "1.0.32.0" => "Vielen Dank! Aber wir haben noch eine
Bitte... Tragt diese Suppe zur Westklippe!",
  "1.0.33.0" => "Ugh... Das war's wohl... Bringt...
diese Kürbissuppe... zur Westklippe...",
  "1.0.34.0" => "Die Truppenmoral des Gegners ist gestiegen.
Ich empfehle, Vorsicht walten zu lassen.",
  "1.0.35.0" => "Ich bringe die Suppe zum Ziel.",
  "1.0.36.0" => "Mit einer Wahrscheinlichkeit von 85 % wird
uns der Transport der Suppe von Nutzen sein.",
  "1.0.37.0" => "Jetzt werden wir die Menschlein mitsamt
ihrem Hauptquartier ausradieren!",
  "1.0.38.0" => "Oh nein! Sie greifen unser Hauptquartier an!",
  "1.0.39.0" => "Oh, diese lästigen Narren!
Volga, ich ziehe mich zurück!",
  "1.0.40.0" => "Ich bestätige den erfolgreich abgeschlossenen
Transport der zweiten Portion Suppe.",
  "1.0.41.0" => "Ho ho ho... Ihr habt mich gerufen?
Soll ich euch wieder eine Brücke bauen?",
  "1.0.42.0" => "Ich bestätige die Wiederherstellung des
Weges zum feindlichen Hauptquartier.",
  "1.0.43.0" => "Jetzt können wir uns den feindlichen General
vornehmen!",
  "1.0.44.0" => "Feindliche Truppen nehmen Kurs auf unser
Hauptquartier. Verteidigung erforderlich.",
  "1.0.45.0" => "Ah, langsam wird die Sache interessant.
Wenn ich bitten darf?",
  "1.0.46.0" => "Dieser wichtigtuerische Ritter hat sich endlich
hervorgewagt! Zahlen wir es ihm heim!",
  "1.0.47.0" => "Mein Drachenblut kocht bereits...
Stellt euch, ihr Narren!",
  "1.0.48.0" => "Soll das alles gewesen sein?
Versucht's noch mal!",
  "1.0.49.0" => "Wollt ihr mich zu Tode kitzeln?",
  "1.0.50.0" => "Dieser vorlaute Drachenwurm... Wäre ich nur
im Besitz all meiner Kräfte, ich würde ihn...",
  "1.0.51.0" => "Ich schlage vor, mithilfe der Großen Fee
Narishas Kraft zu verstärken.",
  "1.0.52.0" => "Die Große Fee... Sie ist dort drüben, oder? Aber
vorher müssten wir ein paar Feinde besiegen.",
  "1.0.53.0" => "Aktiviere den Magiekreis, damit die Große
Fee Narisha ihre Kraft verleiht.",
  "1.0.54.0" => "Du solltest den Magiekreis aktivieren!",
  "1.0.55.0" => "Siehst du, wie stark ich bin?
Aber jetzt bin ich müde... Ich brauche Ruhe...",
  "1.0.56.0" => "Ugh... Du...",
  "1.0.57.0" => "Er ist geschwächt.
Jetzt kannst du Volga besiegen!",
  "1.0.58.0" => "Ich bin nicht stark genug, um Volga zu
besiegen.",
  "1.0.59.0" => "Phai wurde umzingelt! Wir müssen ihr helfen!",
  "1.0.60.0" => "Ohne eure Einmischung hätte ich gesiegt...",
  "1.0.61.0" => "Wir haben gewonnen! Das sollte uns eine
kleine Verschnaufpause geben!",
  "1.0.62.0" => "Es sah eine Zeit lang nicht gut aus für uns.
Vielen Dank für die Rettung!",
  "1.0.63.0" => "Ich muss es zu Ende bringen. Die Macht der
Dunkelheit muss wachsen...",
  "1.0.64.0" => "Sollen sie ihren kleinen Triumph genießen.
Ich werde sie von innen heraus zerstören...",
  "1.0.65.0" => "... ... ...",
  "1.0.66.0" => "Unser Hauptquartier ist gefallen!
Alles ist verloren...",
  "1.0.67.0" => "Den Kampf fortzuführen ist nicht länger eine
Option.",
  "1.0.68.0" => "Hilfe! Zu Hilfe!
Wir können die Suppe so nicht transportieren.",
  "1.0.69.0" => "Hilfe! Die Suppe!",
  "1.0.70.0" => "Bitte ebne uns den Weg, damit wir das
Böse bekämpfen können.",
  "1.0.71.0" => "Ich verstehe...
Ich werde sehen, was ich tun kann.",
  "1.0.72.0" => "Könnt ihr diese Suppe zur Westklippe tragen?",
  "1.0.73.0" => "Ich warte hier auf Narisha. Ich schlage vor, dass
du dich dem feindlichen Hauptmann widmest!",
  "1.0.74.0" => "Ich werde Volga aufhalten.
Eile du zur Großen Fee.",
  "1.0.75.0" => "Im Süden ist ihre Verteidigung schwach...
Greift von dort aus ihr Hauptquartier an!",
  "1.0.76.0" => "Was schleicht ihr hier herum?
Ich muss euch wohl eine Lektion erteilen.",
  "1.0.77.0" => "Haltet das blaue Ding auf!
Ich inspiziere solange ihr Hauptquartier...",
  "1.0.78.0" => "Attacke! Wir nehmen ihre Festung ein!",
  "1.0.79.0" => "Dieser Volga muss sich wieder ins Rampenlicht
drängeln... Dabei gebührt der Ruhm mir allein!",
  "1.0.80.0" => "Die Bedrohung unserer Festungen wurde
beseitigt. Du hast gute Arbeit geleistet.",
  "1.0.81.0" => "Kommt, Brüder und Schwestern!
Wir überfallen ihr Hauptquartier!",
  "1.0.82.0" => "Einverssstanden!
Jetzt ist Echsssal an der Reihe!",
  "1.0.83.0" => "Verlassst euch auf Dinodo!",
  "1.0.84.0" => "Ich werde Echsal bekämpfen.
Du solltest Dinodo übernehmen.",
  "1.0.85.0" => "Ssso ssstark...",
  "1.0.86.0" => "Neeein! Ich habe versssagt...",
  "1.0.87.0" => "Ich bestätige die Eliminierung
von Echsal und Dinodo.",
  "1.0.88.0" => "Ich bestätige, dass unser Hauptquartier
nicht mehr bedroht wird.",
  "1.0.89.0" => "Was fällt euch ein?!
Alle, die noch kämpfen können, an die Front!",
  "13.0.0.0" => "Nachricht",
  "13.0.1.0" => "Ersatznachricht",
}