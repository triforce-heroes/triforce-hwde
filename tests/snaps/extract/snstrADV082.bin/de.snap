Map {
  "0.0.0" => "Besiege A0%1sF6R!",
  "0.1.0" => "A0%1sF0R wurde auf dem Schlachtfeld gesichtet!",
  "0.2.0" => "A0%1sF1R wurden auf dem Schlachtfeld gesichtet!",
  "0.3.0" => "A0%1sF0R und A0%2sF7R wurden gesichtet!",
  "0.4.0" => "Die Zeit ist um! Du hast verloren!",
  "0.5.0" => "Alle A2RiesenmonsterR wurden besiegt! Du hast gewonnen!",
  "0.6.0" => "A0%1sF1R rücken gegen A0%2sF7R vor!",
