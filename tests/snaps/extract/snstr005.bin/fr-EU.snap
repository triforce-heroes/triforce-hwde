  "0.43.0" => "A0%1sF4R est en grand danger ! Allez vite l'aider !",
  "0.45.0" => "Les portes C5%1sF2R sont ouvertes !",
  "0.46.0" => "A6L'entrée du temple de l'eauR est révélée !",
