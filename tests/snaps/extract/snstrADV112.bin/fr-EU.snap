  "0.37.0" => "A0%1sF4R invoque A0%2sF0R !",
  "0.38.0" => "A0%1sF4R se prépare à se renforcer !",
  "0.39.0" => "A0%1sF4R se prépare pour son invocation !",
  "0.40.0" => "A0%1sF4R se prépare à encourager son armée !",
  "0.41.0" => "A0%1sF4R gagne en puissance !",
  "0.42.0" => "A0%1sF4R encourage une partie de l'A2armée ennemieR et la rend plus puissante !",
