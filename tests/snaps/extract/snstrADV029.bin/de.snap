  "0.27.0" => "A0%2sF0R hat C1%1sF6R geschwächt!",
  "0.28.0" => "A0%1sF1R haben nach ihrer Mission das Schlachtfeld verlassen!",
  "0.29.0" => "Die Niederlage A0%1sF2R hat A0%2sF6R Energie gekostet!",
