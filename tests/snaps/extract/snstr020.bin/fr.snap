Map {
  "0.0.0" => "A0%1sF5R se préparent pour leurs invocations!",
  "0.1.0" => "A0%1sF5R se dirigent vers A0%2sF0R!",
  "0.2.0" => "A0%1sF4R est en difficulté!",
  "0.3.0" => "A0%1sF4R est en grand danger! Portez-lui secours au plus vite!",
  "0.4.0" => "Vous avez vaincu A0%1sF2R!",
  "0.5.0" => "Vous pouvez désormais jouer avec A0%1sF0R!",
  "0.6.0" => "A0%1sF5R se dirigent vers A0%2sF0R!",
  "0.7.0" => "A0%1sF4R est en difficulté!",
  "0.8.0" => "A0%1sF4R est en grand danger! Portez-lui secours au plus vite!",
  "0.9.0" => "Vous avez vaincu A0%1sF2R!",
  "0.10.0" => "A0%1sF4R a appelé des renforts pour protéger A0%2sF0R!",
  "0.11.0" => "A1DesR A0%1sF7R ont rejoint le champ de bataille!",
  "0.12.0" => "A0%1sF5R ont invoqué A2desR A0%2sF7R!",
  "0.13.0" => "A0%1sF5R se préparent pour de nouvelles invocations!",
  "0.14.0" => "Attention! Surveillez bien A0%1sF0R!",
  "0.15.0" => "A0%1sF5R, à court de pouvoirs magiques, ont raté leur invocation!",
  "0.16.0" => "Les portes des forts A0%1sF3R se sont ouvertes pour A0%2sF1R!",
  "0.17.0" => "A2DesR A0%1sF7R sont apparus et appellent A2desR A0%2sF7R!",
  "0.18.0" => "A0%1sF5R se rassemblent autour A2desR A0%2sF7R!",
  "0.19.0" => "Éliminez A0%1sF1R au plus vite!",
  "0.20.0" => "Le moral A2des troupes rassembléesR autour A0%1sF3R est en hausse!",
  "0.21.0" => "A2Les troupes rassembléesR autour A0%1sF3R se dirigent vers A0%2sF0R!",
  "0.22.0" => "Ne laissez pas A0%1sF0R tomber aux mains de l'ennemi!",
  "0.23.0" => "D'autres A0%1sF7R sont apparus! Le recrutement a commencé!",
  "0.24.0" => "A0%1sF5R ont commencé à se rassembler autour A0%2sF3R!",
  "0.25.0" => "A0%1sF6R a rejoint le champ de bataille!",
  "0.26.0" => "A0%1sF4R cherche de la nourriture!",
  "0.27.0" => "Éliminez A0%1sF1R au plus vite!",
  "0.28.0" => "Vous avez vaincu tous A2lesR A0%1sF7R!",
  "0.29.0" => "A0%1sF4R et A2ses troupesR se dirigent vers A0%2sF0R!",
  "0.30.0" => "A0%2sF4R a fermé les portes A0%1sF2R!",
  "0.31.0" => "Vous avez vaincu tous A2lesR A0%1sF7R!",
  "0.32.0" => "A2Une horde de monstresR est apparue autour A0%1sF3R!",
  "0.33.0" => "Secourez A0%1sF0R au plus vite!",
  "0.34.0" => "A0%1sF4R est en sécurité!",
  "0.35.0" => "A0%1sF4R se transforme en cocotte d'or après ce bon repas!",
  "0.36.0" => "A6Les portes des entrées du templeR sont ouvertes!",
  "0.37.0" => "A0%1sF4R se dirige vers A0%2sF0R!",
  "0.38.0" => "A0%1sF4R commence à appeler A0%2sF0R en renfort!",
  "0.39.0" => "A0%1sF4R absorbe de la magie et se renforce!",
  "0.40.0" => "A0%1sF4R absorbe de la magie et se renforce encore!",
  "0.41.0" => "A0%1sF4R a perdu ses pouvoirs magiques et s'affaiblit!",
  "0.42.0" => "Vous avez vaincu A0%1sF0R!",
  "0.43.0" => "Tous A0%1sF1R ont disparu!",
  "0.44.0" => "A0%1sF4R a battu en retraite!",
  "0.45.0" => "A0%2sF5R a provoqué la fuite A0%1sF3R!",
  "0.46.0" => "A0%1sF5R est vaincue!",
  "0.47.0" => "Les attaques A0%2sF3R ont fait tomber A0%1sF0R!",
  "0.48.0" => "Les portes A0%1sF2R sont ouvertes!",
  "0.49.0" => "C2%1sF4R est sous votre contrôle!",
  "0.50.0" => "A0%1sF4R a fui le champ de bataille!",
  "0.51.0" => "A6Une skulltulaR est apparue sur le champ de bataille!",
  "0.52.0" => "A6La skulltulaR s'est enfuie!",
  "0.53.0" => "A0%1sF4R affronte A0%2sF0R!",
  "0.54.0" => "A0%1sF4R a absorbé la magie A2desR A0%2sF7R sur le champ de bataille!",
  "0.55.0" => "Vous avez vaincu A0%1sF0R!",
  "0.56.0" => "A0%1sF4R et A2ses troupesR se dirigent vers A0%2sF0R!",
  "0.57.0" => "A0%1sF4R se dirige vers A0%2sF1R!",
  "0.58.0" => "Éliminez A0%1sF1R pour affaiblir A0%2sF0R!",
