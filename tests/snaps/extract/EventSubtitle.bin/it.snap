Map {
  "0.0.0" => "Moccioso, non farmi arrabbiare!",
  "0.1.0" => "Mpf... vi spedirò nella tomba tutti insieme!",
  "0.2.0" => "Accidenti...",
  "0.3.0" => "Ma allora, tu...",
  "0.4.0" => "Volga",
  "0.5.0" => "Volga",
  "0.6.0" => "Impa",
  "0.7.0" => "Impa",
  "1.0.0" => "Non riusciamo a individuare la posizione della
