Map {
  "0.0.0" => "A0%1sF7R rejoignent le champ de bataille depuis les A6portes des âmesR !",
  "0.1.0" => "Fermez immédiatement toutes les A6portes des âmesR !",
  "0.2.0" => "Vous avez vaincu A0%1sF2R !",
  "0.3.0" => "A0%1sF4R est K.-O. ! La A6porte des âmesR a disparu !",
  "0.4.0" => "Vous avez vaincu A0%1sF1R !",
  "0.5.0" => "A0%1sF5R sont K.-O. ! La A6porte des âmesR a disparu !",
  "0.6.0" => "A0%1sF4R rejoint le champ de bataille depuis les cieux !",
  "0.7.0" => "A0%1sF4R apparaît devant A0%2sF0R !",
  "0.8.0" => "A0%1sF4R avance sur la partie sud du désert !",
  "0.9.0" => "A0%1sF4R a atteint la partie sud du désert !",
  "0.10.0" => "A0%1sF4R a senti A0%2sF0R s'enfuir et lance une attaque sur le sud du désert !",
  "0.11.0" => "A0%1sF6R rejoint le champ de bataille !",
  "0.12.0" => "A0%1sF4R se réfugie provisoirement dans A0%2sF0R !",
  "0.13.0" => "Vous avez repoussé A0%1sF0R !",
  "0.14.0" => "Les portes A0%1sF2R, A0%2sF2R et A0%3sF2R sont ouvertes !",
  "0.15.0" => "Une partie A0%1sF3R avance vers A0%2sF0R !",
  "0.16.0" => "Vous avez vaincu A0%1sF1R !",
  "0.17.0" => "Fermez immédiatement toutes les A6portes des âmesR !",
  "0.18.0" => "Une partie A0%1sF3R avance sur A0%2sF0R !",
  "0.19.0" => "Vous avez vaincu A0%1sF1R qui avançaient !",
  "0.20.0" => "Vous avez fait disparaître toutes les A6portes des âmesR !",
  "0.21.0" => "Attaquez immédiatement A0%1sF0R pour le repousser !",
  "0.22.0" => "Éliminez immédiatement les A2monstresR et aidez A0%1sF0R !",
  "0.23.0" => "Ouverture A6%1sF2R et A6%2sF2R !",
  "0.24.0" => "Éliminez A0%1sF1R qui avancent !",
  "0.25.0" => "A0%1sF4R est passé à l'attaque en volant sur le nord du désert !",
  "0.26.0" => "Vous avez pris A0%1sF0R !",
  "0.27.0" => "La perte de son nid décourage A0%1sF0R !",
  "0.28.0" => "La perte de son nid affaiblit A0%1sF0R !",
  "0.29.0" => "A0%1sF5R a reçu des renforts !",
  "0.30.0" => "A0%1sF4R se réfugie provisoirement dans A0%2sF0R !",
  "0.31.0" => "A0%1sF4R se repose et récupère de l'énergie vitale !",
  "0.32.0" => "A0%1sF4R a fini de se reposer et reprend du poil de la bête !",
  "0.33.0" => "A0%1sF4R est passé à l'attaque en volant sur le sud du désert !",
  "0.34.0" => "A0%1sF4R a fini de se reposer et gagne en puissance !",
  "0.35.0" => "A0%1sF4R est passé à l'attaque en volant sur le nord du désert !",
  "0.36.0" => "A0%1sF4R a fini de se reposer et gagne encore en puissance !",
  "0.37.0" => "A0%1sF4R est passé à l'attaque en volant sur le sud du désert !",
  "0.38.0" => "Vous avez vaincu A0%1sF0R !",
  "0.39.0" => "A0%1sF5R a fait tomber la A1base alliéeR !",
  "0.40.0" => "A0%1sF5R a été vaincue !",
  "0.41.0" => "A0%2sF5R a fait fuir A0%1sF0R !",
  "0.42.0" => "Vous avez pris C2%1sF0R !",
  "0.43.0" => "Regroupez-vous vers A0%1sF0R !",
  "0.44.0" => "A0%1sF5R affronte A0%2sF0R !",
  "0.45.0" => "Vous pouvez contrôler A0%1sF0R !",
  "0.46.0" => "Prenez le contrôle A0%1sF2R !",
  "0.47.0" => "Une A6skulltulaR est apparue sur le champ de bataille !",
  "0.48.0" => "Vous avez obtenu une A6skulltulaR !",
  "0.49.0" => "La A6skulltulaR s'est enfuie !",
  "0.50.0" => "A0%1sF4R n'a pas réussi à battre en retraite !",
  "0.51.0" => "A0%1sF6R rejoint le champ de bataille !",
  "0.52.0" => "Des portes donnant accès à la A6tour du JugementR sont ouvertes !",
  "0.53.0" => "A0%1sF5R s'introduit dans C1%2sF0R !",
  "0.54.0" => "C1%1sF4R ne doit pas tomber aux mains de l'ennemi !",
  "0.55.0" => "Les conditions de victoire ont changé !",
  "0.56.0" => "Vaincre A0%1sF0R !",
  "0.57.0" => "A0%1sF5R de la A6tour du JugementR avancent sur C1%2sF0R !",
  "0.58.0" => "A0%1sF5R de la A6partie nord du désertR avancent sur C1%2sF0R !",
  "0.59.0" => "A0%1sF5R du A6sud du désertR avancent vers A0%2sF0R !",
  "0.60.0" => "Fermez toutes les A6portes des âmesR !",
  "0.61.0" => "Prenez A0%1sF0R et empêchez A0%2sF0R de se soigner !",
