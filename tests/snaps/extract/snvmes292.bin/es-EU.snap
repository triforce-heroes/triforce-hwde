Map {
  "1.0.0.0" => "¿De dónde han salido todos estos monstruos?",
  "1.0.1.0" => "¡Debemos mantenernos firmes! Somos los únicos
que podemos proteger Hyrule.",
  "1.0.2.0" => "Debemos proteger a la princesa. ¡Date prisa, Link!",
  "1.0.3.0" => "¡Luchad por Hyrule! ¡Proteged a la princesa
Zelda a toda costa!",
  "1.0.4.0" => "Ese bicho es demasiado fuerte...
¿Cómo podemos acabar con él?",
  "1.0.5.0" => "¡Primero debemos acaba con el lagarto!",
  "1.0.6.0" => "¡Venid a por mí!",
  "1.0.7.0" => "¿De verdad es un simple soldado en prácticas?",
  "1.0.8.0" => "¡Qué fuerza! ¿Quién es ese soldado?",
  "1.0.9.0" => "¿Estás listo para reunirte con tus antepasados?
¡Yo te ayudaré!",
  "1.0.10.0" => "¡No dejéis avanzar al caballero dragón!",
  "1.0.11.0" => "No sé quién eres... Pero algún día volveremos
a encontrarnos.",
  "1.0.12.0" => "Mientras esta roca esté aquí, no podremos
salvar a la princesa Zelda.",
  "1.0.13.0" => "¡Ya no podemos contenerlos! ¡Ayuda!",
  "1.0.14.0" => "¡No! Necesitan nuestra ayuda, Link.",
  "1.0.15.0" => "Bien, ahora ya no podrán pasar.",
  "1.0.16.0" => "¡Gracias! ¿Por qué no te quedas esto a cambio?",
  "1.0.17.0" => "Nuestro tesoro.... Lo dejaré aquí.",
  "1.0.18.0" => "Usa eso para romper las rocas que te encuentres
y así podremos llegar hasta la princesa Zelda.",
  "1.0.19.0" => "¡Atacad! ¡Acabad con esa tal princesa de Hyrule!",
  "1.0.20.0" => "¡Tomad el bastión central y el bastión este de
la llanura! ¡Luego cerrad las puertas norte!",
  "1.0.21.0" => "Voy a diseñar una estrategia para la batalla.
Mientras tanto, ¡tenéis que tomar ese bastión!",
  "1.0.22.0" => "No tengo tiempo para estas tonterías. ¡Hay otras
cosas que requieren mi atención!",
  "1.0.23.0" => "¡Están atacando la base aliada!",
  "1.0.24.0" => "¡Genial! Ahora, a por el bastión este de la llanura.",
  "1.0.25.0" => "¡Recuperad el bastión central!",
  "1.0.26.0" => "¡Muy bien! Y ahora, a por el bastión central.",
  "1.0.27.0" => "¡Recuperad el bastión este de la llanura!",
  "1.0.28.0" => "Hemos hecho que el enemigo se retire hacia
el norte. Ahora debemos dar con la Gran Hada.",
  "1.0.29.0" => "La puerta de la fuente bloquea nuestro avance.
Si tuviésemos bombas...",
  "1.0.30.0" => "¡Atención! ¡El enemigo ataca por el norte!",
  "1.0.31.0" => "Vaya, veo que esa chusma ha logrado avanzar.
¡Avanzad hacia el sur y tomad la base hyliana!",
  "1.0.32.0" => "¡Por aquí! Debemos rezar todos juntos
a la Gran Hada.",
  "1.0.33.0" => "¡Bien! Las fuerzas enemigas se han visto
mermadas.",
  "1.0.34.0" => "Eso debe de haber reducido sus filas.",
  "1.0.35.0" => "¡Bien! ¡Ahora podemos contratacar!",
  "1.0.36.0" => "Princesa Zelda, os ruego que os retiréis. Nosotros
nos encargaremos del resto.",
  "1.0.37.0" => "De acuerdo. ¡Que las Diosas os protejan!",
  "1.0.38.0" => "Eso, seguid jugando a luchar... Mientras
tanto yo me divertiré.",
  "1.0.39.0" => "¡Ja, ja, ja! La cosa se pone interesante.
¡Traed al rey dodongo!",
  "1.0.40.0" => "¿Qué es eso?",
  "1.0.41.0" => "Debemos hacer cuanto podamos para detenerlo.",
  "1.0.42.0" => "¡Debemos detenerlo!",
  "1.0.43.0" => "¡No podemos rendirnos! Si el bastión
cae, habremos perdido la batalla.",
  "1.0.44.0" => "¡Toma esto! Aumentará la potencia de las bombas.",
  "1.0.45.0" => "¡Buen trabajo! ¡Habéis aguantado hasta el final!",
  "1.0.46.0" => "¡Comandante Impa, tenemos malas noticias!
El enemigo se ha apoderado del castillo.",
  "1.0.47.0" => "¿Cómo? Entonces el monstruo no era más que
un señuelo... ¿Dónde está la princesa?",
  "1.0.48.0" => "La luz volverá a Hyrule...",
  "1.0.49.0" => "Nos han derrotado...",
  "1.0.50.0" => "La princesa Zelda ha huido... Ya no hay nada que
hacer.",
  "1.0.51.0" => "¡Usa tu ataque especial para acabar
con ellos de un plumazo!",
  "1.0.52.0" => "¡Ja, ja! ¡Seguid atacando!",
  "1.0.53.0" => "¡Es nuestra oportunidad! ¡Atacad ahora!",
  "1.0.54.0" => "¡No! ¡Debes hacerlo de un solo golpe!",
  "1.0.55.0" => "¿A qué se dedica Volga? En fin, ¡enviad
más tropas!",
  "1.0.56.0" => "¡Usa tu poder mágico para acabar con ellos
de un solo golpe!",
  "1.0.57.0" => "Si todo sale bien, acabaremos con ellos de un
solo golpe. ¡Rápido, a la fuente de la Diosa!",
  "1.0.58.0" => "¡Venid, rápido! Ayudadme a derribar la puerta.",
  "1.0.59.0" => "¡Daos prisa y avanzad hacia el sur!
Debemos cercar el bastión hyliano.",
  "1.0.60.0" => "¡Han invadido el bastión central!",
  "1.0.61.0" => "Vaya, así que habéis logrado entrar. ¡Bien!
¡Ahora id a por el bastión hyliano!",
  "1.0.62.0" => "¿Cómo? ¿Que han tomado el bastión este de la llanura?",
  "1.0.63.0" => "¿Qué has dicho?",
  "1.0.64.0" => "¿Cómo que no encontráis a la princesa Zelda?",
  "1.0.65.0" => "¡Mira, Link! ¡Es la princesa!",
  "1.0.66.0" => "¡Tú! Eres el que estaba entrenando...",
  "1.0.67.0" => "Princesa, ¡estáis viva! Este soldado novato usó
bombas para que pudiésemos abrirnos paso.",
  "1.0.68.0" => "¿Un novato? Supongo que las apariencias
engañan.",
  "1.0.69.0" => "Una roca enorme nos bloquea el paso.
¿Podrías usar tus bombas?",
  "1.0.70.0" => "¡No conseguimos encontrarla!",
  "1.0.71.0" => "¿Cómo?",
  "1.0.72.0" => "Nosotros nos ocuparemos del bastión del este.
¡Que alguien se ocupe del central!",
  "1.0.73.0" => "¡Haceos con el bastión central! Yo atacaré
la base enemiga mientras tanto.",
  "1.0.74.0" => "Debo rescata a Impa. No puedo dejarla
sola frente al enemigo.",
  "1.0.75.0" => "Los goron están en apuros. ¡Iré a ayudarles!",
  "1.0.76.0" => "Esa roca me impide llegar hasta Impa.
Ojalá hubiese un modo de romperla...",
  "1.0.77.0" => "Con esto podré romper la roca y llegar hasta Impa.",
  "1.0.78.0" => "¿Estás bien, Impa?",
  "1.0.79.0" => "¡Princesa! Lo siento; no tendría que haberme
dejado engañar por el enemigo.",
  "1.0.80.0" => "No te preocupes. Ahora debemos centrarnos en
hacer retroceder al enemigo.",
  "1.0.81.0" => "¡Tomad esto, princesa! Aumentará la potencia
de las bombas.",
  "1.0.82.0" => "Lo siento mucho, princesa.",
  "1.0.83.0" => "¡Capturad el bastión central! Yo atacaré
la base enemiga.",
  "13.0.0.0" => "Si usamos esto para romper las rocas,
lograremos llegar hasta la princesa Zelda.",
  "13.0.1.0" => "¡Debemos proteger la base!",
  "13.0.2.0" => "¡Tenemos que recuperar el bastión central!",
  "13.0.3.0" => "¡Recuperad el bastión este de la llanura!",
  "13.0.4.0" => "¡Tened cuidado! El enemigo se acerca por el norte.",
  "13.0.5.0" => "¡El enemigo se dirige al bastión central!",
  "13.0.6.0" => "¿Qué hacemos? El enemigo se aproxima
por el bastión este.",
  "13.0.7.0" => "¡Nosotros nos encargaremos del resto, princesa!",
  "13.0.8.0" => "¿Qué es eso? Parece un fantasma...",
  "13.0.9.0" => "¡Los goron están en un aprieto! ¡Voy para allá!",
  "13.0.10.0" => "Esta roca nos impide llegar hasta Impa. Ojalá
pudiésemos romperla...",
  "13.0.11.0" => "Usaré esto para destruir la roca y llegar hasta Impa.",
  "13.0.12.0" => "¡Tomad, princesa! Hará que las bombas
sean más potentes.",
  "13.0.13.0" => "Lo siento mucho, princesa...",
  "13.0.14.0" => "¡Capturad el bastión central! Yo me dirigiré
a la base enemiga.",
}