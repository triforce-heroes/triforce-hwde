Map {
  "0.0.0" => "¡Las A0%1sF1R han ganado la batalla!",
  "0.1.0" => "¡Las A0%1sF1R han perdido la batalla!",
  "0.2.0" => "¡Derrota A0%1sF4R y A0%2sF4R!",
  "0.3.0" => "¡Las A0%1sF1R han aparecido en el campo de batalla!",
  "0.4.0" => "¡Han aparecido refuerzos de las A0%1sF1R en el campo de batalla!",
  "0.5.0" => "¡Las A0%1sF1R se han retirado del campo de batalla!",
  "0.6.0" => "¡A0%1sF3R avanzan hacia el A1Gran Árbol DekuR!",
  "0.7.0" => "¡A0%1sF0R y A0%2sF2R se han abierto!",
  "0.8.0" => "¡A0%1sF0R y A0%2sF2R avanzan hacia el A1Gran Árbol DekuR!",
  "0.9.0" => "¡La fuerza A0%1sF6R y A0%2sF6R ha aumentado!",
  "0.10.0" => "¡Algunos de los A6bastionesR se han abierto!",
  "0.11.0" => "El A1Gran Árbol DekuR ha caído. ¡Has perdido la batalla!",
  "0.12.0" => "¡Las A0%1sF1R han traído A6cántaros de suministrosR!",
  "0.13.0" => "¡Vence a los A2enemigosR y recoge los A6materialesR!",
  "0.14.0" => "¡Al completar rápido la misión, los A2capitanes enemigosR se han fortalecido!",
  "0.15.0" => "¡Las A2tropas enemigasR han A2hecho arderR el A1Gran Árbol DekuR!",
  "0.16.0" => "¡Han aparecido A2tropas de transporte de frascos mágicosR!",
  "0.17.0" => "¡Han aparecido A2tropas de transporte de la fuerzaR!",
  "0.18.0" => "¡Han aparecido A2tropas de transporte de corazonesR!",
  "0.19.0" => "¡Derrota a A2200 enemigos másR con el ataque especial!",
  "0.20.0" => "¡Derrota a A2100 enemigos másR con el ataque especial!",
  "0.21.0" => "¡Derrota a A250 enemigos másR con el ataque especial!",
  "0.22.0" => "¡Derrota a A2200 enemigos másR con el poder mágico!",
  "0.23.0" => "¡Derrota a A2100 enemigos másR con el poder mágico!",
  "0.24.0" => "¡Derrota a A250 enemigos másR con el poder mágico!",
  "0.25.0" => "¡Quedan A2300 enemigosR!",
  "0.26.0" => "¡Quedan A2200 enemigosR!",
  "0.27.0" => "¡Quedan A2100 enemigosR!",
  "0.28.0" => "¡Han aparecido A6frascos de recuperación de ataque especialR en algunos A6bastionesR!",
  "0.29.0" => "¡Han aparecido A6frascos mágicosR en algunos A6bastionesR!",
  "0.30.0" => "¡A0%1sF0R y A0%2sF2R se han debilitado al perder a sus A2capitanesR!",
  "0.31.0" => "¡Vence a los A2capitanes enemigosR para debilitar A0%1sF4R y A0%2sF4R!",
  "0.32.0" => "¡A0%1sF0R ha llegado al A1Gran Árbol DekuR!",
  "0.33.0" => "¡A0%1sF0R y A0%2sF2R han aparecido y se han fortalecido!",
  "0.34.0" => "¡Derrota a los A2enemigosR alrededor del A1Gran Árbol DekuR!",
  "0.35.0" => "¡A0%1sF0R está atacando A0%2sF4R!",
  "0.36.0" => "¡Primera prueba!",
  "0.37.0" => "¡Prueba del ataque especial!",
  "0.38.0" => "¡Prueba del poder mágico!",
  "0.39.0" => "¡Prueba final!",
  "0.40.0" => "¡Al superar la prueba, el A6nivel del desafíoR ha aumentado!",
  "0.41.0" => "¡Los A2capitanes enemigosR se han fortalecido!",
  "0.42.0" => "¡Varios A2capitanes enemigosR se han fortalecido!",
