Map {
  "1.0.0.0" => "Argh... Il y a encore tellement...
de monstres...",
  "1.0.1.0" => "Nous sommes les seuls à pouvoir défendre le
château d'Hyrule ! Nous devons repousser l'ennemi !",
  "1.0.2.0" => "Je dois y aller... !
Je dois les aider !",
  "1.0.3.0" => "Qui es-tu... ? Tu es là pour nous aider ?",
  "1.0.4.0" => "Je m'appelle Linkle !
Je suis l'Héroïne venue sauver Hyrule !",
  "1.0.5.0" => "Une Héroïne... ? Alors, va aider mes alliés.
Moi, je m'occupe des ennemis au nord !",
  "1.0.6.0" => "Compte sur moi !",
  "1.0.7.0" => "Je dois me retirer... Mais je reviendrai
aussitôt que j'aurai repris des forces !",
  "1.0.8.0" => "Je vais battre temporairement en retraite !
Prenez ceci !",
  "1.0.9.0" => "Merci de votre aide ! Je dois me replier,
mais je reviendrai !",
  "1.0.10.0" => "Je bats en retraite pour le moment.
Je prie pour votre salut !",
  "1.0.11.0" => "Je vais me retirer pour le moment.
Tenez, c'est pour vous.",
  "1.0.12.0" => "Je vais m'assurer que nos arrières sont bien protégés.
Je vous laisse ceci. Puissiez-vous en faire bon usage !",
  "1.0.13.0" => "Je dois me retirer...
mais sachez que je reviendrai !",
  "1.0.14.0" => "Ils... Ils m'ont eu... Je vous laisse...
vous charger du reste !",
  "1.0.15.0" => "Courage ! Nous devons tenir bon ! Nous ne
pouvons laisser l'ennemi reprendre des forces !",
  "1.0.16.0" => "Je... Je n'en peux plus...",
  "1.0.17.0" => "Je n'aime pas ça... La situation empire
à chaque allié que nous perdons...",
  "1.0.18.0" => "Tenez bon ! Je vais faire de mon mieux
pour vous aider !",
  "1.0.19.0" => "Les monstres ne perdent pas de leur
vigueur... Ils arrivent depuis le nord !",
  "1.0.20.0" => "Je m'occupe des monstres au nord-ouest !",
  "1.0.21.0" => "Gardez courage ! Ne laissons pas l'ennemi
avancer plus loin !",
  "1.0.22.0" => "Je n'abandonnerai personne !
Je vous sauverai tous !",
  "1.0.23.0" => "Ces forts... Ce sont les nids des monstres !
Prenons-les vite, ou il en viendra encore d'autres !",
  "1.0.24.0" => "Mes soldats sont exténués, ils ne tiendront
plus longtemps. Restons vigilants !",
  "1.0.25.0" => "Parfait... Continuons comme ça et nous
arriverons à chasser les monstres !",
  "1.0.26.0" => "Compris ! Compte sur moi !",
  "1.0.27.0" => "Les monstres sont de plus en plus
nombreux... ! Je dois rester prudente.",
  "1.0.28.0" => "Il y en a encore plus qu'avant !
Mais ça ne va jamais s'arrêter ?!",
  "1.0.29.0" => "Encore ? Et en plus, les monstres foncent
sur nous ! Faites bien attention à vous !",
  "1.0.30.0" => "Et voilà !
L'ennemi ne viendra plus, maintenant !",
  "1.0.31.0" => "Super !
On a réussi à sauver tout le monde !",
  "1.0.32.0" => "Impressionnant, Linkle ! Tu as bien combattu !
Ton courage s'est transmis à tout le monde !",
  "1.0.33.0" => "À nous de jouer, maintenant !
Personne ne peut nous vaincre !",
  "1.0.34.0" => "Nous avons réussi à limiter les dégâts grâce à Linkle.
Soldats, écoutez-moi ! Lançons la contre-attaque !",
  "1.0.35.0" => "J'aurais voulu sauver tout le monde...",
  "1.0.36.0" => "Tu t'es bien débrouillée, Linkle. Ton courage
s'est sûrement transmis à tout le monde.",
  "1.0.37.0" => "L'ennemi semble aussi attaquer le château.
Nous devons le défendre !",
  "1.0.38.0" => "Il ne reste plus que les nids des monstres.
Je vais m'en occuper !",
  "1.0.39.0" => "Ouaaah ! Hé !
C'est quoi ce monstre super grand ?!",
  "1.0.40.0" => "Le roi dodongo est enragé... ?!
Nous devons l'arrêter !",
  "1.0.41.0" => "C'est sûrement le roi de ces monstres. Vu que
je suis l'Héroïne, c'est à moi de le vaincre !",
  "1.0.42.0" => "Encore d'autres monstres... !
Défendons le château !",
  "1.0.43.0" => "Bah, c'est bizarre... J'ai beau frapper ce
monstre, on dirait qu'il ne sent rien !",
  "1.0.44.0" => "Nos attaques semblent inefficaces... Tant pis,
concentrons-nous plutôt sur les autres monstres !",
  "1.0.45.0" => "Ça y est ! On a réussi !
On va pouvoir s'occuper du roi dodongo !",
  "1.0.46.0" => "C'est pas vrai ?!
Il y a encore des monstres en plus !",
  "1.0.47.0" => "Ils sont bien trop nombreux... Nous
n'allons pas pouvoir tenir longtemps !",
  "1.0.48.0" => "Nous voilà ! Pardonnez-nous d'avoir été si
longs ! Nous allons vous prêter main-forte !",
  "1.0.49.0" => "Vous êtes revenus !
C'est fantastique !",
  "1.0.50.0" => "Nous allons vous montrer la détermination
des soldats d'Hyrule !",
  "1.0.51.0" => "Ah ! Ma boussole... ?!",
  "1.0.52.0" => "Qu'est-ce que... ?! Cette boussole
a calmé la fureur du roi dodongo ?",
  "1.0.53.0" => "C'est extraordinaire ! Cette boussole est
bien la preuve que je suis une Héroïne !",
  "1.0.54.0" => "Le combat n'est pas encore terminé !",
  "1.0.55.0" => "Merci à tous !",
  "1.0.56.0" => "Repoussons les monstres jusqu'au dernier !",
  "1.0.57.0" => "Nous nous chargeons de la horde de monstres qui se
trouve du côté est ! Occupez-vous du roi dodongo !",
  "1.0.58.0" => "D'accord ! Je le vaincrai !
C'est mon rôle d'Héroïne, après tout !",
  "1.0.59.0" => "Nous allons arrêter les monstres à l'est !
Occupez-vous du roi dodongo !",
  "1.0.60.0" => "Nous allons faire tout notre possible pour arrêter
les monstres. Chargez-vous du roi dodongo !",
  "1.0.61.0" => "Le roi dodongo s'approche du château !
Qu'est-ce qu'il faut faire ?",
  "1.0.62.0" => "Si nous sommes pris en tenaille, nous perdrons nos chances
de victoire. Chargeons-nous d'abord des autres ennemis !",
  "1.0.63.0" => "On a réussi ! Il ne reste plus que le roi
des monstres, le roi dodongo...",
  "1.0.64.0" => "Co... Comment ?!
Le château d'Hyrule est tombé ?",
  "1.0.65.0" => "Je... Je n'ai pas pu remplir mon rôle
d'Héroïne... !",
  "1.0.66.0" => "Je dois me replier ! Je reviendrai quand
j'aurai repris des forces !",
  "1.0.67.0" => "Moi aussi, je m'en charge !
Unissons nos forces contre lui !",
  "1.0.68.0" => "Mais nous ne pouvons laisser l'ennemi prendre le
château. Éliminons les monstres à notre portée !",
  "1.0.69.0" => "Nous ne pouvons rien faire contre lui.
Occupons-nous des autres ennemis d'abord !",
  "1.0.70.0" => "Nous ne pourrons pas tenir longtemps...
Nous devons vaincre ce monstre !",
  "1.0.71.0" => "Nos troupes reviendront quand elles seront
prêtes. En attendant, il faut tenir bon.",
  "13.0.2.0" => "Nos alliés arrivent. Vous devez
tenir bon jusque-là !",
  "13.0.3.0" => "Je m'occupe du dragon au sud !",
  "13.0.4.0" => "Encore un peu de patience ! Nous arrivons vers
la place du nord avec les armes !",
  "13.0.5.0" => "Il y a un endroit peu solide sur la muraille.
Détruisons-le avec un missile teigneux pour entrer.",
  "13.0.6.0" => "Parfait ! Il ne reste plus que l'autre dragon !",
  "13.0.7.0" => "Nous avons éliminé les deux dragons ! Je nous
félicite ! Ça devrait aller mieux, maintenant !",
  "13.0.8.0" => "Ils ont réussi à se rejoindre... Éliminons-les avant
qu'ils ne fassent plus de blessés !",
  "13.0.9.0" => "Avancez, et protégez le missile teigneux !",
  "13.0.10.0" => "L'ennemi continue d'attaquer... Nous devons faire
quelque chose, sinon, c'en est fini de nous !",
  "13.0.11.0" => "Protégez le missile teigneux ! Si nous le perdons,
nous ne pourrons pas faire exploser la muraille !",
  "13.0.12.0" => "Très bien ! Entrons dans le château par la
brèche créée par l'explosion du missile teigneux !",
  "13.0.13.0" => "La stratégie est un échec... Que pouvons-nous
faire, maintenant... ?",
  "13.0.14.0" => "Ganondorf vient combattre en personne !
Restez sur vos gardes !",
  "13.0.15.0" => "La puissance des ténèbres grandit... Ne vous
approchez pas de Ganondorf !",
  "13.0.16.0" => "L'est du château est affaibli. Passez de ce côté
pour prendre le contrôle du château !",
  "13.0.17.0" => "Si nous prenons le château, nous
pourrons retourner la situation.",
  "13.0.18.0" => "C'est le combat final... Enfin... Allons-y ! Éliminons
Ganondorf !",
  "13.0.19.0" => "Nous n'avons peut-être pas encore récupéré le
château, mais nous avons vaincu Ganondorf !",
  "13.0.20.0" => "Nous avons vaincu Ganondorf ! Reprenons
le château, maintenant !",
  "13.0.21.0" => "Vous n'avez pas à craindre ce monstre ! Cette
bataille sera la dernière ! Gardez espoir !",
  "13.0.22.0" => "Tiens, prends ces flèches de lumière et inflige
le coup de grâce à Ganon !",
  "13.0.23.0" => "Les flèches contiennent suffisamment de puissance,
elles pourront venir à bout de Ganon !",
  "13.0.24.0" => "Je laisse toutes mes forces à ces flèches !",
  "13.0.25.0" => "Je donnerai toutes mes forces pour qu'elles
soient imprégnées dans ces flèches !",
  "13.0.26.0" => "Que ces flèches s'imprègnent de mes forces !",
  "13.0.27.0" => "Que mes forces soient utiles !",
  "13.0.28.0" => "Prends mon pouvoir aussi ! Nous devons mettre
un terme à cette guerre !",
  "13.0.29.0" => "Non... C'est la dernière bataille... Nous ne
pouvons pas abandonner maintenant...",
  "13.0.30.0" => "Nous avons perdu notre base... Nous ne pouvons
pas continuer le combat...",
  "13.0.31.0" => "Il me semble qu'il s'agit de l'endroit que le roi
dodongo avait détruit.",
  "13.0.32.0" => "Observe bien les mouvements de Ganon ! Nous
avons déjà affronté un ennemi similaire, non ?",
  "13.0.33.0" => "Il doit y avoir une arme parmi tes objets qui
pourrait te permettre de faire face à Ganon !",
  "13.0.34.0" => "Trop peu de nos alliés sont en bonne santé... Les
flèches de lumière ne sont pas assez puissantes...",
  "13.0.35.0" => "Les flèches de lumière seraient plus puissantes
si nous avions plus d'alliés en bonne santé... ",
  "13.0.36.0" => "Si nous éliminons Ganon, la foudre devrait s'arrêter !
Il faut le vaincre avant que le château ne soit détruit !",
  "13.0.37.0" => "Hm... La foudre a fait de gros dégâts.
Le château ne teindra plus longtemps !",
  "13.0.38.0" => "On ne plus faire marche arrière !
Il faut vite reprendre le château !",
  "13.0.39.0" => "Je vais attirer l'attention de Ganondorf !
Occupez-vous de prendre le château !",
  "13.0.40.0" => "Je vais attirer l'attention de Ganondorf !
Occupez-vous de prendre le château !",
  "13.0.41.0" => "Je vais attirer l'attention de Ganondorf !
Occupez-vous de prendre le château !",
  "13.0.42.0" => "Je vais attirer l'attention de Ganondorf !
Occupez-vous de prendre le château !",
  "13.0.43.0" => "Nous avons enfin repris le château d'Hyrule !
Ganondorf... Tu as perdu !",
  "13.0.44.0" => "Éliminons Ganondorf qui s'est installé dans le château d'Hyrule !
L'heure est venue de ramener la lumière dans ce monde !",
  "13.0.45.0" => "Nous avons vaincu Ganondorf et repris le château !
La victoire est à nous !",
  "13.0.46.0" => "Nous avons enfin repris le château d'Hyrule !
Ganondorf... Tu as perdu !",
}