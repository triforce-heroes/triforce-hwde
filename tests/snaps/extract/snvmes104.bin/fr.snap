Map {
  "1.0.0.0" => "La Triforce est à moi et je ne te laisserai
jamais t'en emparer!",
  "1.0.1.0" => "Folie! Ne vois-tu pas que son pouvoir est trop grand
pour toi? Gohma, allez prendre les forts de Cya!",
  "1.0.2.0" => "Il ne faut pas qu'ils prennent les forts devant les
ruines... Protégez-les au péril de votre vie, s'il le faut!",
  "1.0.3.0" => "Je vais retenir celle de l'est.
Occupez-vous de celle de l'ouest.",
  "1.0.4.0" => "Ils nous ont pris le fort?!
Récupérez-le à tout prix!",
  "1.0.5.0" => "Il est trop tôt pour vous réjouir... Voyons
comment vous vous débrouillerez contre celui-ci!",
  "1.0.6.0" => "Manhandla, maintenant...?
De mieux en mieux...",
  "1.0.7.0" => "Wizzro!
Retiens Manhandla!",
  "1.0.8.0" => "Moi... Mais... mes blessures de la dernière bataille
ne sont même pas encore guéries!",
  "1.0.9.0" => "Quelle puissance! Ganondorf contrôle
ces monstres avec une telle aisance...",
  "1.0.10.0" => "Il faut couper le mal à la racine... Wizzro!
Ouvre-moi la voie jusqu'à la base ennemie!",
  "1.0.11.0" => "Je me vois obligé de décliner ton offre, Cya. Ma fidélité
va toujours au plus fort... en l'occurence, Ganondorf.",
  "1.0.12.0" => "Tu trahirais tes alliés pour moi, insignifiant petit mage?
Ha! Alors, prouve-moi ta loyauté et finis-en avec eux.",
  "1.0.13.0" => "Gya ha ha! Vos désirs sont des ordres, mon
maître! Je ne vous décevrai pas!",
  "1.0.14.0" => "Wizzro, méprisable vermine!
Cette fois, je te réduirai à néant!",
  "1.0.15.0" => "La félonie de Wizzro devra attendre... Nous devons
éliminer les ennemis qui se dirigent vers notre base.",
  "1.0.16.0" => "Peu m'importe les trahisons, je sais que mon
Héros sera toujours là pour me protéger...",
  "1.0.17.0" => "Cya... C'est ce que je craignais... Le pouvoir
des ténèbres lui a fait perdre la raison.",
  "1.0.18.0" => "Je n'ai plus de raison de lui obéir. Mais,
je ne serai pas venu jusqu'ici pour rien!",
  "1.0.19.0" => "Ganondorf!
Affronte-moi!",
  "1.0.20.0" => "Ton offre est alléchante. Malheureusement, je
ne vois pas ce que j'ai à y gagner... Disparais!",
  "1.0.21.0" => "Argh! C'était un piège... Aaaaah!!!",
  "1.0.22.0" => "Gh... Je ne peux rien faire contre cette
barrière... Je dois battre en retraite...",
  "1.0.23.0" => "Hya ha ha... Nos effectifs diminuent?
Et alors? La bataille est loin d'être terminée!",
  "1.0.24.0" => "Et c'est ce que je sais faire de mieux!",
  "1.0.25.0" => "Hein... Mes pouvoirs auraient atteint leur limite?
Je vais avoir du mal à invoquer plus de monstres...",
  "1.0.26.0" => "Noooon! Pas ça! Pas dans la bague!",
  "1.0.27.0" => "Assez joué... Lancez une attaque
générale sur ces ruines!",
  "1.0.28.0" => "Ganondorf... Il est bien plus puissant que
je ne l'avais imaginé...",
  "1.0.29.0" => "Ils sssont trop nombreux,
on n'a aucune chanssse!",
  "1.0.30.0" => "Maître Volga, nous avons échoué!
Nous sssommes désolés...",
  "1.0.31.0" => "Je peux toujours compter sur mon Héros...
Je... Je peux toujours compter sur mon Héros...",
  "1.0.32.0" => "Cya, ressaisis-toi! Cesse d'utiliser tes pouvoirs,
ils te font perdre l'esprit!",
  "1.0.33.0" => "La... Lana...? Oh... Qu'est-ce qui m'est arrivé?
Je... Je dois vaincre Ganondorf...",
  "1.0.34.0" => "Je suis venue t'aider! Ensemble,
nous pouvons en finir avec lui!",
  "1.0.35.0" => "Le bien et le mal... Je ne pensais pas qu'elles pourraient
coopérer. Qu'importe... Je les éliminerai toutes les deux.",
  "1.0.36.0" => "Chaque minute qui passe, Ganondorf devient
plus puissant... Nous devons le vaincre au plus vite!",
  "1.0.37.0" => "Mais son repaire est à l'abri derrière une
barrière de ténèbres. Impossible de s'approcher.",
  "1.0.38.0" => "Je pense pouvoir disperser ces ténèbres, mais
je vais avoir besoin de toi. Je t'en prie, aide-moi!",
  "1.0.39.0" => "Il faut vite détruire la barrière!",
  "1.0.40.0" => "Que la lumière éradique les ténèbres!",
  "1.0.41.0" => "Alors vous avez détruit ma barrière? Étonnant...
Mais je vous écraserai, misérable insectes!",
  "1.0.42.0" => "Je sens le pouvoir des ténèbres affluer...
Mais ce n'est pas encore suffisant...",
  "1.0.43.0" => "Auriez-vous des doutes?
Ne deviez-vous pas me vaincre?",
  "1.0.44.0" => "Le pouvoir... Je le sens à présent...
Venez m'affronter et rencontrer votre fin!",
  "1.0.45.0" => "Vous n'êtes pas dignes de mon intérêt.
Je vous laisse patauger dans votre médiocrité.",
  "1.0.46.0" => "On a réussi! On l'a fait fuir!",
  "1.0.47.0" => "Dans ce cas, tu n'as plus rien à faire ici. Il est
temps pour toi de partir, on dirait.",
  "1.0.48.0" => "Cya... Arrêtons cette guerre, tu veux?
Si tu utilises encore tes pouvoirs, tu vas...",
  "1.0.49.0" => "Disparais! Personne ne m'empêchera
d'obtenir ce que je veux! Pas même toi!",
  "1.0.50.0" => "Si je perds maintenant, j'aurai fait
tout cela pour rien...",
  "1.0.51.0" => "J'aurais voulu pouvoir t'aider...
Cya, pardonne-moi...",
  "1.0.52.0" => "Folie! Occupez-vous donc de celui-là à présent!",
  "1.0.53.0" => "Hya ha ha! J'espère que ce n'est pas trop pour vous!
Tremblez devant mes pouvoirs, vous n'avez aucune chance!",
  "1.0.54.0" => "Volga! Retourne protéger notre base,
je te l'ordonne!",
  "1.0.55.0" => "Je n'ai plus de raisons de t'obéir.
Je suis seul maître de mon destin à présent.",
  "1.0.56.0" => "Notre base est en danger! Empêchez Manhandla
de la bombarder de graines!",
  "1.0.57.0" => "Si ça continue, notre base va tomber... Dépêchez-vous!
Mettez fin aux bombardements de graines de Manhandla!",
  "1.0.58.0" => "L'ennemi approche droit devant!
Préparez-vous à les recevoir!",
  "1.0.59.0" => "Ha ha ha! Voilà ce qui arrive
quand on ose me défier!",
  "1.0.60.0" => "Attaquez par l'est! Je mènerai l'assaut par
l'ouest et nous les écraserons entre nos griffes!",
  "1.0.61.0" => "Pensais-tu vraiment pouvoir
nous vaincre comme ça?",
  "1.0.62.0" => "Ah... Je n'ai pas réussi à les arrêter...",
  "1.0.63.0" => "Insupportables moucherons!
Je vais les disperser!",
  "1.0.64.0" => "Bah, pas de quoi s'inquiéter!",
  "1.0.65.0" => "Cette petite recherche quelque chose,
mais je ne la laisserai pas faire!",
  "1.0.66.0" => "Hors de mon chemin!",
  "1.0.67.0" => "Merci pour ton aide, Cya!",
  "1.0.68.0" => "Peu importe! Maitenant, dépêche-toi
et débarrasse-nous de cette barrière!",
  "1.0.69.0" => "Merci! Tu m'as sauvée la vie!",
  "1.0.70.0" => "Je ne l'ai fait que parce que c'était ma
mission. Maintenant, va accomplir ta tâche.",
  "13.0.0.0" => "Nous ne devons pas laisser l'ennemi prendre les forts
devant les ruines. Protégez-les coûte que coûte!",
  "13.0.1.0" => "Je me charge de sécuriser l'est de la région.
Occupez-vous de l'ouest.",
  "13.0.2.0" => "Comment?! Ils ont pris notre fort! Que faites-vous là?
Vous devriez être en train d'essayer de le récupérer!",
  "13.0.3.0" => "Parfait, nous sommes prêts à contre-attaquer!
Wizzro! Lance l'assaut!",
  "13.0.4.0" => "Mon Héros est là pour nous protéger...
Je peux m'occuper de Ganondorf...",
  "13.0.5.0" => "Ganondorf! Je vais en finir avec toi
ici et maintenant!",
  "13.0.6.0" => "C'était un piège!",
  "13.0.7.0" => "Se cacher derrière une barrière! Quelle lâcheté!
Je n'ai pas le choix, je dois battre en retraite...",
  "13.0.8.0" => "Je... J'ai sous-estimé les forces de Ganondorf...",
  "13.0.9.0" => "J'ai perdu la volonté de me battre...
Je me retire...",
  "13.0.10.0" => "Cya, vous devez battre en retraite. Vous ne
pouvez pas combattre dans cet état.",
  "13.0.11.0" => "Tais-toi! Je n'ai pas besoin de ta pitié.
Occupe-toi plutôt d'exterminer nos ennemis!",
  "13.0.12.0" => "Notre base! Si on ne met pas fin aux bombardements
de graines de Manhandla, elle tombera...",
  "13.0.13.0" => "Nous devons arrêter les bombardements de graines de
Manhandla, ou notre base sera réduite en tas de gravats!",
  "13.0.14.0" => "Les sortilèges de Wizzro ne sont pas un problème.
Éliminez plutôt les ennemis qui se dirigent vers notre base!",
  "13.0.15.0" => "Ils approchent du front! Nous
devons fortifier nos défenses!",
  "13.0.16.0" => "Hah! Ce n'est pas suffisant!",
  "13.0.17.0" => "On dirait que ce groupe pourrait bien
nous offri un combat digne de ce nom.",
  "13.0.18.0" => "C'était relativement distrayant...",
  "13.0.19.0" => "J'ai une idée. Attirons-les sur la place devant
les ruines et abaissons le pont sans être vus!",
  "13.0.20.0" => "De nouveaux ennemis sortent de ce fort
sans arrêt. On doit trouver une solution!",
  "13.0.21.0" => "L'ingénieur vient de quitter notre base!
Escortons-le jusqu'à la partie est des ruines!",
  "13.0.22.0" => "Link s'occupe des ennemis à l'ouest!
Il faut vite abaisser le pont!",
  "13.0.23.0" => "Link! Ce serait mieux si tu retenais l'ennemi
au centre, non?",
  "13.0.24.0" => "Attention! Les ennemis venant de l'ouest
se dirigent vers notre base!",
  "13.0.25.0" => "Bravo! Entrons dans les ruines par le pont!",
  "13.0.26.0" => "Oh non, l'ingénieur a été vaincu...",
  "13.0.27.0" => "Cya se trouve au sommet! Allons-y!",
  "13.0.28.0" => "Ce monstre est encore vivant!
Et il s'est réfugié sous terre!",
  "13.0.29.0" => "Pas de problème! On va s'en occuper!
Allez, Link! On y va!",
  "13.0.30.0" => "On s'en charge!
Allez, Link! Ne retiens pas tes coups!",
  "13.0.31.0" => "Notre base est attaquée!
Vite! Il faut le tuer!",
  "13.0.32.0" => "Non! Notre base est sur le point de tomber! Il
faut qu'on se débarrasse de lui immédiatement!",
  "13.0.33.0" => "Notre base ne va plus tenir
très longtemps! Vite, vite!",
  "13.0.34.0" => "Oh, non... On dirait que ce n'était
qu'une petite partie de ce monstre!",
  "13.0.35.0" => "On peut enfin attaquer Cya! C'est parti!
Direction l'autel au sommet des ruines!",
  "13.0.36.0" => "Oh non... Link! Ils t'ont eu?!",
  "13.0.37.0" => "Attention! Certains ennemis s'en prennent
à l'ingénieur!",
  "13.0.38.0" => "Les portes des ruines sont fermées...
On va devoir trouver un autre chemin...",
  "13.0.39.0" => "Link et moi attaquerons depuis l'est.
Occupez-vous de l'ouest.",
}