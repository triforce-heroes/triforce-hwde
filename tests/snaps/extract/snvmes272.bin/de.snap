Map {
  "1.0.0.0" => "Oh nein! Die Stadt wird angegriffen!
Wir müssen den Leuten helfen!",
  "1.0.1.0" => "Die Ungeheuer kommen aus der Verwunsche-
nen Bastion! Da ist bestimmt ihr Boss!",
  "1.0.2.0" => "Dieser komische Stein versperrt den
Weg. Wir müssen ihn zertrümmern!",
  "1.0.3.0" => "Eine der Festungen der Stadt wurde erobert!
Wir müssen sie uns sofort zurückholen!",
  "1.0.4.0" => "Wir kümmern uns um die Monster und
überlegen, was wir mit dem Felsen machen!",
  "1.0.5.0" => "Wenn wir diesen Vogel verjagen,
gehört die Festung uns!",
  "1.0.6.0" => "Wollen die ihr Territorium erweitern? An Port
Monee werden sie sich die Zähne ausbeißen!",
  "1.0.7.0" => "Sie kommen aus drei Richtungen! Wir
müssen uns aufteilen, um sie zu stoppen!",
  "1.0.8.0" => "Wir stellen uns denen im Osten,
übernehmt ihr die anderen!",
  "1.0.9.0" => "Schau mal! Ein Schiff!",
  "1.0.10.0" => "Nette Kanone... Damit lässt sich
doch bestimmt was anfangen!",
  "1.0.11.0" => "Hm, hier riecht es irgendwie
nach Schatz...",
  "1.0.12.0" => "Jetzt sollte die Stadt eine Weile
sicher sein. Weiter so!",
  "1.0.13.0" => "Mit diesem Hammer kann man
bestimmt Schalter betätigen!",
  "1.0.14.0" => "Die hecken doch irgendwas aus!
Los, geht nachsehen!",
  "1.0.15.0" => "Es kommen immer mehr Monster!
Diese Felsen müssen weg!",
  "1.0.16.0" => "Gut! Das Federvieh ist weg!",
  "1.0.17.0" => "Port Monee hat Ärger mit einem
Riesenvogel!",
  "1.0.18.0" => "Das ist der Maskenkönig! Wenn wir ihn
wüten lassen, wird die Festung fallen!",
  "1.0.19.0" => "Verfluchter Vogel!
Er ist zu schnell!",
  "1.0.20.0" => "Dann ist jetzt erst mal der
Anführer der Monster dran!",
  "1.0.21.0" => "Endlich können wir angreifen!",
  "1.0.22.0" => "Es gibt noch mehr von diesen Felsen!
Machen wir sie schnell kaputt, Link!",
  "1.0.23.0" => "Der Weg ist frei!",
  "1.0.24.0" => "Wenn wir die Eingänge der Bastion
einnehmen, kommt keine Verstärkung mehr!",
  "1.0.25.0" => "Da kommen noch Monster vom anderen
Eingang! Nehmen wir die Festung ein!",
  "1.0.26.0" => "Das sollte es mit der Verstärkung aus
der Bastion gewesen sein.",
  "1.0.27.0" => "Bleibt nur noch der Anführer!
Dem werden wir's zeigen!",
  "1.0.28.0" => "Wir wollen mehr Land!
Verjagt die Eindringlinge!",
  "1.0.29.0" => "Er will zur Stadt!",
  "1.0.30.0" => "Wir müssen die Stadt verteidigen!",
  "1.0.31.0" => "Fliegt der immer noch herum?
Langsam reicht's!",
  "1.0.32.0" => "Du willst abhauen?
Nicht mit mir!",
  "1.0.33.0" => "Wo ist Tetra? Wollte sie sich nicht
diesen Riesenvogel vornehmen?",
  "1.0.34.0" => "Was? Besiegt?
Kämpft gefälligst!",
  "1.0.35.0" => "Das sieht nicht gut aus...
Holen wir uns schnell den Boss!",
  "1.0.36.0" => "Wir können ihn nicht aufhalten! Wenn wir
nichts tun, ist die Stadt verloren!",
  "1.0.37.0" => "Der Boss ist Geschichte! Schnappen
wir uns noch die Kreatur!",
  "1.0.38.0" => "Die Monster ziehen sich zurück!
Wir haben gesiegt!",
  "1.0.39.0" => "Aber wo ist Tetra?",
  "1.0.40.0" => "Unser Hauptquartier...
Wie soll es jetzt weitergehen?",
  "1.0.41.0" => "Das ist also mein Ende...",
  "1.0.42.0" => "Es kommen immer mehr Monster aus
der Verwunschenen Bastion!",
  "1.0.43.0" => "Wir müssen verhindern, dass noch
mehr Verstärkung eintrifft!",
  "1.0.44.0" => "Oh nein! Wenn wir die Monster im Osten
nicht abwehren, wird die Stadt fallen!",
  "1.0.45.0" => "Port Monee ist sicher!",
  "1.0.46.0" => "Wo ist dieser Vogel hin?
Kann ja nicht weit weg sein...",
  "1.0.47.0" => "Schon wieder abgehauen! Na, egal...
Die Stadt ist wichtiger!",
  "1.0.48.0" => "Wenn du den Schalter an diesem Schiff mit dem
Hammer triffst, feuert bestimmt die Kanone!",
  "1.0.49.0" => "Lass die Kugel ordentlich durch die
Luft sausen!",
  "1.0.50.0" => "Wir müssen zusammenarbeiten!",
  "1.0.51.0" => "Monster von Osten!
Schnell, halten wir sie auf!",
  "1.0.52.0" => "Das war mal ein Piratenunterschlupf...
Jetzt ist es hier richtig gefährlich!",
  "1.0.53.0" => "Gegner sind in unser Hauptquartier einge-
drungen! Wir müssen sofort dahin zurück!",
  "1.0.54.0" => "Kommt! Greift mich an, wenn
ihr denkt, ihr seid stark genug!",
  "1.0.55.0" => "Ui, die sind nicht ohne! Wir dürfen nicht
zulassen, dass sie die Stadt erreichen!",
  "1.0.56.0" => "(Los! Greift an und zerstört die
Häuser dieser Menschen!)",
  "1.0.57.0" => "Jaaa! Wir haben gewonnen!",
}