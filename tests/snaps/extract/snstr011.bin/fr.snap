Map {
  "0.0.0" => "A2DesR A0%1sF7R sont apparus A6dans les chambres ensorceléesR!",
  "0.1.0" => "La puissance A6des chambres ensorceléesR remonte le moral A2desR A0%1sF7R!",
  "0.2.0" => "Prenez le contrôle A6des chambres ensorceléesR est et ouest!",
  "0.3.0" => "A6La chambre ensorceléeR est sous votre contrôle! Un flux magique a été interrompu!",
  "0.4.0" => "Prenez le contrôle A6des chambres ensorceléesR et interrompez les flux magiques!",
  "0.5.0" => "Les flux magiques entre A6les chambres ensorceléesR de l'ouest ont été interrompus!",
  "0.6.0" => "Interrompez les flux magiques à l'est!",
  "0.7.0" => "Les flux magiques entre A6les chambres ensorceléesR de l'est ont été interrompus!",
  "0.8.0" => "Interrompez les flux magiques à l'ouest!",
  "0.9.0" => "Les portes A0%1sF2R sont ouvertes!",
  "0.10.0" => "A0%1sF4R se dirige vers A0%2sF0R!",
  "0.11.0" => "A0%1sF4R a atteint A0%2sF0R!",
  "0.12.0" => "A0%1sF4R quitte temporairement le champ de bataille!",
  "0.13.0" => "A0%1sF6R est apparu sur le champ de bataille!",
  "0.14.0" => "Éliminez A0%1sF1R!",
  "0.15.0" => "Vous avez vaincu A0%1sF2R!",
  "0.16.0" => "D'autres A0%1sF7R sont apparus sur le champ de bataille!",
  "0.17.0" => "A0%1sF5R a rejoint le champ de bataille!",
  "0.18.0" => "A0%1sF5R attaque A0%2sF1R!",
  "0.19.0" => "A0%1sF4R se replie vers l'intérieur du palais!",
  "0.20.0" => "A0%1sF5R se réfugie dans A0%2sF0R!",
  "0.21.0" => "A0%1sF4R se dirige vers A0%2sF0R!",
  "0.22.0" => "Tous A0%1sF1R ont disparu!",
  "0.23.0" => "Le moral A0%1sF3R remonte!",
  "0.24.0" => "A0%1sF4R a invoqué des hordes de monstres!",
  "0.25.0" => "A0%1sF4R a fui le champ de bataille!",
  "0.26.0" => "Les conditions de défaite ont changé!",
  "0.27.0" => "Ne laissez pas un seul des membres du groupe A0%1sF3R s'enfuir!",
  "0.28.0" => "Aidez A0%1sF1R à battre en retraite!",
  "0.29.0" => "A0%1sF5R se dirigent vers A0%2sF0R!",
  "0.30.0" => "Les conditions de victoire ont changé!",
  "0.31.0" => "Éliminez A0%1sF0R pour remporter la victoire!",
  "0.32.0" => "A0%1sF4R est en difficulté!",
  "0.33.0" => "A0%1sF4R est en grand danger! Portez lui secours au plus vite!",
  "0.34.0" => "A0%1sF4R se téléporte A0%2sF6R!",
  "0.35.0" => "A0%1sF4R se téléporte A0%2sF6R!",
  "0.36.0" => "A0%1sF4R a fui le champ de bataille!",
  "0.37.0" => "A0%1sF5R a vaincu A0%2sF0R!",
  "0.38.0" => "A0%1sF5R a gagné la bataille!",
  "0.39.0" => "A0%1sF5R a été vaincue!",
  "0.40.0" => "A0%1sF4R a pris la fuite!",
  "0.41.0" => "A6La chambre ensorceléeR centrale est sous votre contrôle!",
  "0.43.0" => "A1ZeldaR a senti la présence d'une terrible force maléfique!",
  "0.44.0" => "A6Les portes de la roseraie estR sont ouvertes! A0%1sF4R avance!",
  "0.45.0" => "A0%1sF4R s'approche A0%2sF3R!",
  "0.46.0" => "A0%1sF4R affronte A0%2sF0R!",
