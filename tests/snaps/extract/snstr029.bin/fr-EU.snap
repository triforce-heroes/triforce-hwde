  "0.33.0" => "A0%2sF5R a fait tomber C1%1sF0R !",
  "0.34.0" => "A0%1sF5R a perdu !",
  "0.35.0" => "A0%1sF5R a été vaincue !",
  "0.36.0" => "A0%1sF4R a réussi à s'enfuir ! Vous n'avez pas réussi à l'éliminer !",
  "0.37.0" => "A0%1sF5R a été vaincue !",
