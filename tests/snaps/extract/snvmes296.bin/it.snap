Map {
  "1.0.0.0" => "Così tante porte delle anime?! Dobbiamo
chiuderle per fermare l'avanzata nemica!",
  "1.0.1.0" => "Attenzione! A guardia della porta c'è un
demone che non ho mai visto prima!",
  "1.0.2.0" => "Deve essere collegato alla porta in qualche modo.
Dobbiamo sconfiggerlo se vogliamo chiudere la porta!",
  "1.0.3.0" => "Occupati dei nemici a nord mentre noi
stiamo a guardia del ponte a est!",
  "1.0.4.0" => "I nemici continuano ad arrivare!
Non so come fermarli!",
  "1.0.5.0" => "La porta si è chiusa appena abbiamo sconfitto
il mostro! Continuiamo così!",
  "1.0.6.0" => "Ma che succede? Cos'è quell'enorme
uccello?!",
  "1.0.7.0" => "Magari sta solo riposando...
Sarà meglio non disturbarlo?",
  "1.0.8.0" => "Mettiamoci in salvo finché quell'uccellaccio
si riposa!",
  "1.0.9.0" => "E tu... chi sei?",
  "1.0.10.0" => "Sono Dazel e sono stata rapita da
quell'uccellaccio, Re Elmaroc.",
  "1.0.11.0" => "Ops... purtroppo ci ha visti...
Mi aiuti ad affrontarlo?!",
  "1.0.12.0" => "Non capisco bene cosa stia succedendo,
ma ti aiuterò a scacciare quell'uccello!",
  "1.0.13.0" => "Oh, no! Dazel è stata attaccata da quel rapace!
Dobbiamo salvarla!",
  "1.0.14.0" => "Link, dobbiamo scacciare quel rapace,
Re Elmaroc! Dammi una mano!",
  "1.0.15.0" => "Fiu... a quanto pare ce l'abbiamo fatta...",
  "1.0.16.0" => "(Liberiamoci di questi vermi...!)",
  "1.0.17.0" => "Purtroppo ci siamo fatti notare dai nemici...
Forza, ci sono altri guai in vista!",
  "1.0.18.0" => "A quanto pare abbiamo messo al sicuro
l'area!",
  "1.0.19.0" => "Devo chiudere la porta delle anime!",
  "1.0.20.0" => "(Distruggete la loro base!!!)",
  "1.0.21.0" => "(Sono... troppo forti per me...)",
  "1.0.22.0" => "Ora quei demoni non dovrebbero più
assalirci...",
  "1.0.23.0" => "Pensiamo a salvare la ragazza!",
  "1.0.24.0" => "(Cos'è quell'enorme uccello che combatte
con gli umani?!)",
  "1.0.25.0" => "(Sfruttiamo l'occasione per eliminarli come
si deve!)",
  "1.0.26.0" => "I demoni nel deserto sono irrequieti!",
  "1.0.27.0" => "Proprio ora che siamo occupati con Re Elmaroc...
Avranno pensato di cogliere l'occasione!",
  "1.0.28.0" => "Quel maledetto uccellaccio mi ripagherà
per tutto il fastidio che mi ha dato!",
  "1.0.29.0" => "Quel maledetto rapace è tornato in forma!",
  "1.0.30.0" => "Dobbiamo conquistare il presidio in cui ha
fatto il nido!",
  "1.0.31.0" => "Adesso non potrà più scapparci!",
  "1.0.32.0" => "(Andatevene da qui!!!)",
  "1.0.33.0" => "Uhm... sembra più in forma di prima...
Forse il riposino gli ha fatto bene?",
  "1.0.34.0" => "Quell'uccellaccio è fin troppo in forma!
Andiamo a prendergli il nido!",
  "1.0.35.0" => "Quel rapace inquietante è davvero pericoloso...
Dobbiamo distruggere il suo nido!",
  "1.0.36.0" => "Senza il suo nido non può più scappare!",
  "1.0.37.0" => "Finalmente un po' di pace!",
  "1.0.38.0" => "Altro che pace! Non dimenticare quelle
piccolissime anomalie in giro per il mondo...",
  "1.0.39.0" => "Dobbiamo ancora scovare Cia!
Non abbiamo trovato alcun indizio!",
  "1.0.40.0" => "Nooo! Hanno conquistato la nostra base!
Abbiamo perso...",
  "1.0.41.0" => "Grazie a Re Elmaroc, i demoni del deserto hanno
pensato bene di farsi sotto! Dobbiamo fermarli!",
  "1.0.42.0" => "Coraggio!",
  "1.0.43.0" => "Adesso facciamo i conti!",
  "1.0.44.0" => "Quell'uccellaccio ha avuto un bel coraggio
a portarmi nel deserto!",
  "1.0.45.0" => "Ci resta solo quell'uccellaccio!
Sconfiggiamolo con la magia di Lana!",
  "1.0.46.0" => "Non avevate anche qualcos'altro da fare?",
  "1.0.47.0" => "Dobbiamo tornare subito alla nostra
base per difenderla!",
}