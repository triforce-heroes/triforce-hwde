Map {
  "0.0.0" => "A0%1sF1R sind aus den A6MagiekammernR gekommen!",
  "0.1.0" => "Die Macht der A6MagiekammernR hebt die Moral A0%1sF3R!",
  "0.2.0" => "Erobere die A6MagiekammernR im Westen und Osten!",
  "0.3.0" => "Du hast eine A6MagiekammerR erobert! Der Magiefluss wurde unterbrochen!",
  "0.4.0" => "Erobere die A6MagiekammernR und unterbrich den Magiefluss!",
  "0.5.0" => "Der Magiefluss im Westen wurde unterbrochen!",
  "0.6.0" => "Unterbrich den Magiefluss im Osten!",
  "0.7.0" => "Der Magiefluss im Osten wurde unterbrochen!",
  "0.8.0" => "Unterbrich den Magiefluss im Westen!",
  "0.9.0" => "A0%1sF0R ist offen!",
  "0.10.0" => "A0%1sF0R rückt Richtung A0%2sF4R vor!",
  "0.11.0" => "A0%1sF0R hat A0%2sF6R erreicht!",
  "0.12.0" => "A0%1sF0R hat sich vorerst zurückgezogen!",
  "0.13.0" => "A0%1sF0R wurde auf dem Schlachtfeld gesichtet!",
  "0.14.0" => "Besiege jeden einzelnen A0%1sF3R!",
  "0.15.0" => "A0%1sF0R wurde besiegt!",
  "0.16.0" => "Weitere A0%1sF3R wurden gesichtet!",
  "0.17.0" => "Die A0%1sF1R wurden auf dem Schlachtfeld gesichtet!",
  "0.18.0" => "Die A0%1sF1R greifen die A0%2sF7R an!",
  "0.19.0" => "A0%1sF0R zieht sich Richtung Palast zurück!",
  "0.20.0" => "Die A0%1sF1R ziehen sich A0%2sF1R zurück!",
  "0.21.0" => "A0%1sF0R rückt Richtung A0%2sF4R vor!",
  "0.22.0" => "A0%1sF1R sind alle verschwunden!",
  "0.23.0" => "Die Moral der A0%1sF1R steigt!",
  "0.24.0" => "A0%1sF0R hat eine große Anzahl Monster beschworen!",
  "0.25.0" => "A0%1sF0R hat sich zurückgezogen!",
  "0.26.0" => "Die Bedingungen für eine Niederlage haben sich geändert!",
  "0.27.0" => "Beschütze A0%1sF6R und die anderen!",
  "0.28.0" => "Decke den Rückzug der A0%1sF5R!",
  "0.29.0" => "A0%1sF1R rücken gegen A0%2sF6R vor!",
  "0.30.0" => "Die Siegbedingungen haben sich geändert!",
  "0.31.0" => "Besiege A0%1sF6R!",
  "0.32.0" => "A0%1sF4R steckt in Schwierigkeiten!",
  "0.33.0" => "A0%1sF4R ist in Gefahr und benötigt sofort Hilfe!",
  "0.34.0" => "A0%1sF0R hat sich A0%2sF1R teleportiert!",
