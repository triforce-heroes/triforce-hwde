Map {
  "0.0.0" => "Geh mir aus dem Weg, du Wicht!",
  "0.1.0" => "Gut... Dann sterbt gemeinsam!",
  "0.2.0" => "Oh nein...",
  "0.3.0" => "Bist du etwa...",
  "0.4.0" => "Volga",
  "0.5.0" => "Volga",
  "0.6.0" => "Impa",
  "0.7.0" => "Impa",
  "1.0.0" => "Wir können Prinzessin Zelda nicht finden.
Hoffentlich ist sie wohlauf...",
  "1.1.0" => "Wir brauchen deine Hilfe, um sie zu finden.",
  "1.2.0" => "Erweise dich als Held, der dieses
Gewandes würdig ist, Link.",
  "1.3.0" => "Impa",
  "1.4.0" => "Impa",
  "1.5.0" => "Impa",
  "2.1.0" => "Die Prinzessin ist nicht tot.",
  "2.2.0" => "Ihr werdet ihr früher oder später sicher begegnen.",
  "2.3.0" => "Mein Name ist... Shiek.",
  "2.4.0" => "Ich bin ein Nachfahre des Stammes der Shiekah...
Wir waren einst Diener der Königsfamilie von Hyrule.",
  "2.5.0" => "Der Stamm der Shiekah?",
  "2.6.0" => "Unmöglich...",
  "2.7.0" => "Unterhalten wir uns darüber, wenn wir aus dieser Höhle
entkommen sind. Erlaubt mir, euch zu begleiten!",
  "2.8.0" => "???",
  "2.9.0" => "???",
  "2.10.0" => "Shiek",
  "2.11.0" => "Shiek",
  "2.12.0" => "Impa",
  "2.13.0" => "Impa",
  "2.14.0" => "Shiek",
  "3.1.0" => "Du...",
  "3.2.0" => "Führst du diese Soldaten an?",
  "3.3.0" => "Ja.",
  "3.4.0" => "Du verwendest Magie.
Wo hast du das gelernt?",
  "3.5.0" => "Nun ja...
Ich bin eine Zauberin.",
  "3.6.0" => "Ich gehöre demselben Clan an wie jene,
die all diese Ungeheuer befehligt... Cia.",
  "3.7.0" => "Dann sag mir...",
  "3.8.0" => "Was will diese Cia in Hyrule?",
  "3.9.0" => "Hmm...",
  "3.10.0" => "Mal sehen...",
  "3.11.0" => "Helft uns!",
  "3.12.0" => "...Dann verrate ich es euch.",
  "3.13.0" => "Lana",
  "3.14.0" => "Impa",
  "3.15.0" => "Lana",
  "3.16.0" => "Impa",
  "3.17.0" => "Lana",
  "3.18.0" => "Lana",
  "3.19.0" => "Impa",
  "3.20.0" => "Impa",
  "3.21.0" => "Lana",
  "3.22.0" => "Lana",
  "3.23.0" => "Lana",
  "3.24.0" => "Lana",
  "4.1.0" => "Ich hatte gehofft, Prinzessin Zelda hier
zu finden. Aber diese Hoffnung war vergebens.",
  "4.2.0" => "Wo ist sie nur?
Mögen die Göttinnen sie beschützen...",
  "4.3.0" => "Impa",
  "4.4.0" => "Impa",
  "5.0.0" => "Sieh an...",
  "5.1.0" => "Link, der Held...
Lass dich anschauen...",
  "5.2.0" => "Was?",
  "5.3.0" => "Link!",
  "5.4.0" => "Zwei...",
  "5.5.0" => "Ah, ich verstehe...",
  "5.6.0" => "Umso besser...",
  "5.7.0" => "Komm heraus, meine Kreatur!",
  "5.8.0" => "Cia",
  "5.9.0" => "Cia",
  "5.10.0" => "Cia",
  "5.11.0" => "Shiek",
  "5.12.0" => "Cia",
  "5.13.0" => "Cia",
  "5.14.0" => "Cia",
  "5.15.0" => "Cia",
  "6.0.0" => "Shiek! Das ist...",
  "6.1.0" => "Wie zuvorkommend von euch, auch noch
das Triforce der Weisheit mitzubringen!",
  "6.2.0" => "Damit habe ich jetzt alle drei Teile...",
  "6.3.0" => "Seht das Triforce in all seiner Pracht!",
  "6.4.0" => "Oh nein...
Link, weg hier!",
  "6.5.0" => "Cia...",
  "6.6.0" => "Es ist an der Zeit, die Fragmente
meiner Seele zu mir zu rufen...",
  "6.7.0" => "Ja... Ich spüre, wie sie sich nähern...",
  "6.8.0" => "AAAAAH!",
  "6.9.0" => "Lana",
  "6.10.0" => "Cia",
  "6.11.0" => "Cia",
  "6.12.0" => "Cia",
  "6.13.0" => "Lana",
  "6.14.0" => "???",
  "6.15.0" => "???",
  "6.16.0" => "Cia",
  "6.17.0" => "Cia",
  "7.0.0" => "Du hättest Link oder Lana begleiten können.
Warum bist du stattdessen mir gefolgt?",
  "7.1.0" => "Du bist mir ein Rätsel...
Wie viel weißt du wirklich über den Stamm der Shiekah?",
  "7.2.0" => "Sag, wer ist der Anführer deines Stammes?",
  "7.3.0" => "Das bist du... Impa.",
  "7.4.0" => "Richtig. Und in meinem Stamm
gibt es niemanden namens Shiek.",
  "7.5.0" => "Wer bist du also wirklich?
Was willst du?",
  "7.6.0" => "Hilfe! Prinzessin Ruto ist in Gefahr!",
  "7.7.0" => "Ruto, die Prinzessin der Zoras...",
  "7.8.0" => "...Sie wurde von den Goronen entführt!",
  "7.9.0" => "Dabei ist ihr Häuptling Darunia
doch eigentlich so ein netter Kerl!",
  "7.10.0" => "Jemand namens Zelda ist hier aufgetaucht...
Seitdem ist er nicht mehr derselbe!",
  "7.11.0" => "Zelda?
Prinzessin Zelda ist hier?",
  "7.12.0" => "Das sollten wir uns mit eigenen Augen ansehen.",
  "7.13.0" => "Impa",
  "7.14.0" => "Impa",
  "7.15.0" => "Impa",
  "7.16.0" => "Shiek",
  "7.17.0" => "Impa",
  "7.18.0" => "Impa",
  "7.19.0" => "Fee",
  "7.20.0" => "Shiek",
  "7.21.0" => "Fee",
  "7.22.0" => "Fee",
  "7.23.0" => "Fee",
  "7.24.0" => "Impa",
  "7.25.0" => "Shiek",
  "8.0.0" => "Wie habt ihr meine Illusion durchschaut?",
  "8.1.0" => "Du kannst unmöglich Zelda sein.",
  "8.2.0" => "Denn...",
  "8.3.0" => "Ich bin Zelda!",
  "8.4.0" => "Prinzessin! Ihr lebt!",
  "8.5.0" => "Impa, bitte vergib mir, dass ich
dich nicht eingeweiht habe.",
  "8.6.0" => "Lass uns dieses Portal gemeinsam versiegeln.",
  "8.7.0" => "Pyroma",
  "8.8.0" => "Shiek",
  "8.9.0" => "Shiek",
  "8.10.0" => "Zelda",
  "8.11.0" => "Impa",
  "8.12.0" => "Zelda",
  "8.13.0" => "Zelda",
  "9.0.0" => "K-k-kommt nicht näher!",
  "9.1.0" => "Waaah!",
  "9.2.0" => "Das war knapp...",
  "9.3.0" => "Alles in Ordnung?",
  "9.4.0" => "Ja! Mein Name ist Agnetha.
Und wer bist du?",
  "9.5.0" => "Ich bin Lana.",
  "9.6.0" => "Ich bin auf der Suche nach dem Seelenportal.
Aber ich weiß nicht so recht, wo ich suchen soll...",
  "9.7.0" => "Seelenportal?
Das sagt mir nichts...",
  "9.8.0" => "Aber ich kann dich überall
hinbringen... ganz gleich, an welchen Ort!",
  "9.9.0" => "Und... wie würdest du das anstellen?",
  "9.10.0" => "Mit dem Schmetterling der Göttin!
Er wird uns durch das Schattenreich führen!",
  "9.11.0" => "Dorfbewohnerin",
  "9.12.0" => "Dorfbewohnerin",
  "9.13.0" => "Lana",
  "9.14.0" => "Lana",
  "9.15.0" => "Dorfbewohnerin",
  "9.16.0" => "Lana",
  "9.17.0" => "Lana",
  "9.18.0" => "Agnetha",
  "9.19.0" => "Agnetha",
  "9.20.0" => "Lana",
  "9.21.0" => "Agnetha",
  "10.0.0" => "Lass ihn frei!
Wir brauchen ihn!",
  "10.1.0" => "Wozu? Damit er herumfliegen
und meine Truppen vergiften kann?",
  "10.2.0" => "Was?",
  "10.3.0" => "Ich kann dir versichern, dass er nicht zu den
toxischen Lepidoptera gehört.",
  "10.4.0" => "Lepi... Was?",
  "10.5.0" => "Es ist ein Schmetterling der Göttin.",
  "10.6.0" => "Wenn du ihn behutsam bittest, wird er dich überall
hinführen. Er ist ein Schmetterling voller Geheimnisse!",
  "10.7.0" => "Ganz gleich, wohin ich will, ja?",
  "10.8.0" => "Hey, Schmetterling!
Bring mich zu diesem Hexenscheusal!",
  "10.9.0" => "Du liebe Güte... Und was machen wir jetzt?",
  "10.10.0" => "Wir werden wohl kämpfen müssen.",
  "10.11.0" => "Lana",
  "10.12.0" => "Midna",
  "10.13.0" => "Lana",
  "10.14.0" => "Agnetha",
  "10.15.0" => "Midna",
  "10.16.0" => "Agnetha",
  "10.17.0" => "Agnetha",
  "10.18.0" => "Midna",
  "10.19.0" => "Midna",
  "10.20.0" => "Agnetha",
  "10.21.0" => "Lana",
  "11.0.0" => "Lana, was tust du hier?",
  "11.1.0" => "Cia!",
  "11.2.0" => "Das ist sie! Sie hat mich verflucht!
Wegen ihr sehe ich so aus!",
  "11.3.0" => "Nun, ich finde, das steht dir ganz gut so.
Passt gut zu einer Prinzessin der Schatten...",
  "11.4.0" => "Du kleine...",
  "11.5.0" => "Aaaargghh!",
  "11.6.0" => "Hnnng...",
  "11.7.0" => "Lana, ihr Gesicht... Sie sieht aus wie du...",
  "11.8.0" => "Ich... ich bin Cias andere Hälfte.
Wir waren früher ein einziges Wesen...",
  "11.9.0" => "Waaaaaaaas?",
  "11.10.0" => "Cia",
  "11.11.0" => "Lana",
  "11.12.0" => "Midna",
  "11.13.0" => "Cia",
  "11.14.0" => "Midna",
  "11.15.0" => "Cia",
  "11.16.0" => "Cia",
  "11.17.0" => "Midna",
  "11.18.0" => "Lana",
  "11.19.0" => "Midna",
  "12.0.0" => "Ich bin Phai. Ich habe dich erwartet.",
  "12.1.0" => "Du bist nicht mein Gebieter, aber ich
kann dich als solchen akzeptieren.",
  "12.2.0" => "Es ist meine Aufgabe, dir zu dienen.",
  "12.3.0" => "Meine Hilfe ist von elementarer Bedeutung
für den erfolgreichen Abschluss deiner Mission.",
  "12.4.0" => "Soll ich dich begleiten?",
  "12.5.0" => "Phai",
  "12.6.0" => "Phai",
  "12.7.0" => "Phai",
  "12.8.0" => "Phai",
  "12.9.0" => "Phai",
  "13.0.0" => "Oh, hat der Feind meine Pläne durchschaut?",
  "13.1.0" => "Wie unerfreulich!",
  "13.2.0" => "Das stört mich nun aber wirklich.",
  "13.3.0" => "Ich sollte diesen Lästlingen
eine kleine Lektion erteilen!",
  "13.4.0" => "Ghirahim",
  "13.5.0" => "Ghirahim",
  "13.6.0" => "Ghirahim",
  "13.7.0" => "Ghirahim",
  "14.0.0" => "Hebe dein Schwert zum Himmel
und schwinge es dann nach unten.",
  "14.1.0" => "Phai",
  "15.0.0" => "Du hast dein Triforce wieder?",
  "15.1.0" => "Ja, und Link auch...",
  "15.2.0" => "Ich weiß nicht, was geschehen ist, aber
Cia sollte jetzt erheblich geschwächt sein.",
  "15.3.0" => "Wenn wir einen Gegenangriff starten wollen,
dann wäre jetzt der richtige Zeitpunkt!",
  "15.4.0" => "Cia besitzt noch immer das Triforce der Kraft.",
  "15.5.0" => "Es wird nicht einfach sein...",
  "15.6.0" => "Nein. Wir können siegen.
Solange wir das Master-Schwert haben...",
  "15.7.0" => "Ich glaube, dass Link den nötigen
Charakter besitzt, um es führen zu können.",
  "15.8.0" => "Aber Prinzessin... Das Master-Schwert ist
nicht nur eine Waffe. Es ist eine Barriere.",
  "15.9.0" => "Es hält ein Fragment des Bösen gefangen. Wird es
aus seinem Sockel gezogen, wird das Böse befreit...",
  "15.10.0" => "Die Barrieren um den Tempel des heiligen
Schwertes sind eine besondere Art der Magie.",
  "15.11.0" => "Wenn wir das Master-Schwert entfernen, wird diese
Barriere davon nicht aufgehoben. Zumindest nicht ganz...",
  "15.12.0" => "Wie können wir sicher sein, dass
Link dieser Aufgabe gewachsen ist?",
  "15.13.0" => "Ich glaube an ihn.",
  "15.14.0" => "Ich auch!",
  "15.15.0" => "Nun, Link... Wenn du nach einer Gelegenheit
gesucht hast, dich zu beweisen... Hier ist sie.",
  "15.16.0" => "Begeben wir uns zum Tempel des heiligen Schwertes!",
  "15.17.0" => "Lana",
  "15.18.0" => "Zelda",
  "15.19.0" => "Lana",
  "15.20.0" => "Lana",
  "15.21.0" => "Impa",
  "15.22.0" => "Impa",
  "15.23.0" => "Zelda",
  "15.24.0" => "Zelda",
  "15.25.0" => "Impa",
  "15.26.0" => "Impa",
  "15.27.0" => "Lana",
  "15.28.0" => "Lana",
  "15.29.0" => "Impa",
  "15.30.0" => "Zelda",
  "15.31.0" => "Lana",
  "15.32.0" => "Impa",
  "15.33.0" => "Zelda",
  "16.0.0" => "Hab ich dich, du elender Bengel...",
  "16.1.0" => "Unmöglich!",
  "16.2.0" => "Pyroma",
  "16.3.0" => "Pyroma",
  "17.0.0" => "Ein Schwert ist nur ein Werkzeug für die Schwachen.
Nur Narren verlassen sich auf seine vermeintliche Stärke.",
  "17.1.0" => "Arroganz... Hochmut... Stolz...",
  "17.2.0" => "Davon hat die Dunkelheit in dir gezehrt...",
  "17.3.0" => "Und jetzt wird sie dein Untergang!",
  "17.4.0" => "Cia",
  "17.5.0" => "Cia",
  "17.6.0" => "Cia",
  "17.7.0" => "Cia",
  "18.0.0" => "Halte durch, Link!",
  "18.1.0" => "Wahre Stärke erlangt man nur,
wenn man seine Schwächen kennt!",
  "18.2.0" => "Lana",
  "18.3.0" => "Impa",
  "19.1.0" => "Uaaahhh!",
  "19.2.0" => "Erlaube mir, dir eine Lektion zu erteilen!",
  "19.3.0" => "Hnnnnn...!",
  "19.4.0" => "Cia! Das ist Wahnsinn!",
  "19.5.0" => "Cia",
  "19.6.0" => "Cia",
  "19.7.0" => "Cia",
  "19.8.0" => "Lana",
  "20.0.0" => "Es gibt da etwas, das ich will. Und ich habe alles,
was ich brauche, um es zu erlangen.",
  "20.1.0" => "Das Triforce wird mir gehören!",
  "20.2.0" => "Ganondorf",
  "20.3.0" => "Ganondorf",
  "21.0.0" => "Endlich... Alle drei Teile...",
  "21.1.0" => "Hehehe...",
  "21.2.0" => "HA HA HA HA!",
  "21.3.0" => "Ganondorf",
  "21.4.0" => "Ganondorf",
  "21.5.0" => "Ganondorf",
  "22.0.0" => "Erfülle meinen Wunsch!",
  "22.1.0" => "Hilfe!",
  "22.2.0" => "Lana",
  "22.3.0" => "Lana",
  "181.0.0" => "O-ho ho ho ho ho!",
  "181.1.0" => "Ich bin eine Große Fee, Dienerin der Göttin.
Und dein Wunsch sei dir erfüllt.",
  "181.2.0" => "Große Fee",
  "181.3.0" => "Große Fee",
}