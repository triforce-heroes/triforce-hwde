Map {
  "0.0.0" => "Conquista l'area C2%1sF2R!",
  "0.1.0" => "A0%1sF0R ha cambiato percorso!",
  "0.3.0" => "A0%1sF0R ha cominciato a combattere contro A0%2sF2R!",
  "0.4.0" => "A0%1sF0R è in difficoltà contro A0%2sF2R!",
  "0.5.0" => "Proteggi A0%1sF2R!",
  "0.6.0" => "A0%1sF0R ha abbandonato la battaglia!",
  "0.7.0" => "A0%2sF0R ha perso e il morale di A0%1sF6R è migliorato!",
  "0.8.0" => "Hai salvato A0%1sF2R!",
  "0.9.0" => "Non hai salvato A0%1sF2R!",
  "0.10.0" => "L'A0%1sF1R ha conquistato l'area C2%2sF2R!",
  "0.12.0" => "L'A0%1sF7R ha conquistato l'area C2%2sF2R! Riconquistala!",
  "0.13.0" => "L'A0%1sF1R ha riconquistato l'area C2%2sF2R!",
  "0.17.0" => "A6Due presidiR sono stati conquistati!",
  "0.18.0" => "L'A0%1sF1R si mette in marcia!",
  "0.19.0" => "L'A0%1sF1R comincia a combattere A6davanti alle rovineR!",
  "0.20.0" => "A0%1sF0R si dirige verso il A6ponte estR!",
  "0.21.0" => "La A6%1sF0R è aperta!",
  "0.22.0" => "L'A0%1sF5R a ovest si dirige verso la A1base alleataR!",
  "0.23.0" => "A0%1sF0R va verso l'A0%2sF3R a ovest per il contrattacco!",
  "0.24.0" => "L'A0%1sF5R sta andando verso A0%2sF2R!",
  "0.25.0" => "L'A1ingegnereR è in difficoltà! Vai ad aiutarlo!",
  "0.26.0" => "L'A1ingegnereR è in pericolo! Vai subito ad aiutarlo!",
  "0.27.0" => "Hai difeso A0%1sF2R! Il A6ponte estR si è abbassato!",
  "0.28.0" => "Attraversa il A6ponte estR ed entra nelle A6rovineR!",
  "0.29.0" => "Non hai difeso A0%1sF2R!",
  "0.30.0" => "L'A0%1sF5R ha fallito il piano e il suo morale è peggiorato!",
  "0.31.0" => "Il A6ponte estR è stato abbassato dall'A0%1sF7R!",
  "0.32.0" => "Il morale dell'A0%1sF5R migliora dopo che A0%2sF2R si ritira!",
  "0.33.0" => "Vai verso l'area C2%1sF6R!",
  "0.36.0" => "Sfonda il A6muro di tentacoliR e vai verso l'area C2%1sF6R!",
  "0.37.0" => "A0%1sF0R appare!",
  "0.38.0" => "Le condizioni di vittoria sono cambiate!",
  "0.39.0" => "Devi sconfiggere A0%1sF2R!",
  "0.40.0" => "A0%1sF0R è temporaneamente in fuga sotto terra!",
  "0.41.0" => "A0%1sF1R appaiono in vari luoghi!",
  "0.42.0" => "Sconfiggi A0%1sF3R e scova A0%2sF2R!",
  "0.43.0" => "L'A0%1sF1R avanza dopo la sconfitta di A0%2sF6R!",
  "0.44.0" => "A0%1sF0R sferra un A2attacco di semiR sulla A1base alleataR!",
  "0.45.0" => "Presto, sconfiggi A0%1sF2R!",
  "0.46.0" => "Pericolo! Sconfiggi A0%1sF2R!",
  "0.47.0" => "A0%1sF0R ha perso!",
  "0.48.0" => "Il corpo di A0%1sF6R è apparso dopo la sconfitta dei tentacoli!",
  "0.49.0" => "Hai sconfitto definitivamente A0%1sF2R!",
  "0.50.0" => "L'A0%1sF1R ha vinto la battaglia!",
  "0.51.0" => "A0%1sF0R è in fuga!",
  "0.52.0" => "L'A0%1sF1R ha perso la battaglia!",
  "0.53.0" => "L'area C1%1sF0R è stata conquistata dall'A0%2sF7R!",
  "0.54.0" => "L'A0%1sF1R marcia verso l'area A0%2sF2R!",
  "0.55.0" => "La A6%1sF0R si è aperta!",
  "0.56.0" => "L'area A0%1sF0R è aperta! A0%2sF0R si mette in marcia!",
  "0.57.0" => "L'A0%1sF1R ha conquistato l'area C1%2sF2R!",
  "0.58.0" => "Impedisci che la A1base alleataR venga conquistata!",
  "0.59.0" => "L'A0%1sF1R marcia verso l'A0%2sF7R!",
  "0.60.0" => "Adesso conquista l'area C2%1sF2R!",
  "0.61.0" => "A0%1sF0R ha abbandonato il campo di battaglia!",
  "0.62.0" => "Hai raggiunto l'area C2%1sF6R!",
  "0.63.0" => "Un'A6AracnulaR è stata avvistata sul campo di battaglia!",
  "0.64.0" => "Cerca l'A6AracnulaR!",
  "0.65.0" => "Hai ottenuto un'A6AracnulaR!",
  "0.66.0" => "L'A6AracnulaR sta per fuggire!",
  "0.67.0" => "L'A6AracnulaR è fuggita!",
  "0.68.0" => "A0%1sF0R va verso il A6ponte estR!",
  "0.69.0" => "È apparso uno A6scrignoR nell'area A0%1sF6R!",
  "0.70.0" => "Il morale di A0%1sF6R è migliorato!",
  "0.71.0" => "A0%1sF0R è in campo!",
  "0.72.0" => "L'A0%1sF1R ha conquistato l'area C2%2sF2R!",
  "0.73.0" => "A0%1sF0R attacca!",
  "0.74.0" => "Sono apparsi rinforzi per l'A0%1sF5R!",
  "0.75.0" => "A0%1sF0R appare nella A1base alleataR!",
  "0.76.0" => "L'area A0%1sF0R è chiusa!",
  "0.77.0" => "L'area A0%1sF0R è aperta!",
  "0.78.0" => "A0%1sF1R appaiono!",
  "0.79.0" => "A0%1sF0R comincia a evocare A2potenti demoniR!",
  "0.80.0" => "A0%1sF0R ricomincia a evocare!",
  "0.81.0" => "Sconfiggi A0%1sF2R e ferma l'evocazione!",
  "0.82.0" => "A0%1sF0R e A0%2sF2R vanno verso l'A0%3sF1R!",
  "0.83.0" => "Hai sconfitto A0%1sF2R e A0%2sF2R!",
  "0.84.0" => "Hai sconfitto A0%1sF3R!",
  "0.85.0" => "A0%1sF0R ha evocato A2potenti demoniR!",
  "0.86.0" => "A0%1sF0R evoca altri A2potenti demoniR!",
  "0.87.0" => "A0%1sF0R lotta contro l'A0%2sF2R!",
  "0.88.0" => "A0%1sF1R vanno verso la A1base alleataR!",
  "0.89.0" => "A0%1sF1R non hanno invaso la A1base alleataR!",
  "0.90.0" => "A0%1sF0R ha invaso la A1base alleataR!",
  "0.91.0" => "A0%1sF0R si esalta e il morale è migliorato!",
  "0.92.0" => "Hai scoperto chi è veramente A0%1sF2R!",
  "0.93.0" => "A0%1sF0R ha perso e l'armata si ritira!",
  "0.94.0" => "Ora puoi controllare A0%1sF2R!",
  "0.95.0" => "A0%1sF0R appare e va verso l'area C2%2sF6R!",
  "0.96.0" => "Hai conquistato l'area C2%1sF2R!",
  "0.97.0" => "Raggiungi A0%1sF2R!",
  "0.98.0" => "L'A0%1sF0R lotta contro A0%2sF2R!",
  "0.99.0" => "A0%2sF0R ha indebolito l'area C1%1sF0R!",
  "0.100.0" => "A0%1sF1R abbandonano la battaglia!",
