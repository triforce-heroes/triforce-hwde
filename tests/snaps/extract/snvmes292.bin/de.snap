Map {
  "1.0.0.0" => "Wo kommen all diese Monster her?",
  "1.0.1.0" => "Weicht keinen Schritt zurück!
Wir sind Hyrules letzte Hoffnung!",
  "1.0.2.0" => "Wir müssen die Prinzessin beschützen!
Beeil dich, Link!",
  "1.0.3.0" => "Für Hyrule!
Beschützt Prinzessin Zelda mit eurem Leben!",
  "1.0.4.0" => "Verfluchtes Reptil!
Wie bekämpft man dieses Monster?",
  "1.0.5.0" => "Um das Reptil müssen wir uns zuerst kümmern!",
  "1.0.6.0" => "Komm her, Wurm!",
  "1.0.7.0" => "Und das soll ein einfacher Rekrut sein?",
  "1.0.8.0" => "Er ist stark! Wie lautet der Name dieses Soldaten?",
  "1.0.9.0" => "Du glaubst, du seist mir gewachsen?
Beweise es!",
  "1.0.10.0" => "Lass dem Drachenkrieger keine Luft zum Atmen!",
  "1.0.11.0" => "Urgh... Ich weiß zwar nicht, wer du bist...
Aber ich weiß, dass wir uns wiedersehen werden.",
  "1.0.12.0" => "Wie soll ich Prinzessin Zelda helfen,
wenn diese Felsen mir den Weg versperren?",
  "1.0.13.0" => "Die werden uns überrennen!
Wir brauchen Hilfe!",
  "1.0.14.0" => "Oh nein! Wir müssen ihnen helfen, Link!",
  "1.0.15.0" => "Das sollte sie aufhalten!",
  "1.0.16.0" => "Vielen Dank!
Bitte nimm dies als Zeichen meiner Anerkennung!",
  "1.0.17.0" => "Unser Schatz...
Ich lasse ihn hier zurück...",
  "1.0.18.0" => "Damit kannst du Felsbrocken aus dem Weg
räumen, um zu Prinzessin Zelda zu gelangen.",
  "1.0.19.0" => "Zum Angriff! Zeigt dieser „Prinzessin“,
wer die wahren Herren von Hyrule sind!",
  "1.0.20.0" => "Erobere die Mittelfestung und die Ostfeld-
Festung. Schließe ihre nördlichen Tore!",
  "1.0.21.0" => "Ich überlege mir eine Strategie für die weitere
Schlacht, während du das Lager einnimmst!",
  "1.0.22.0" => "Ich habe keine Zeit, mich mit Schaben abzugeben.
Es gibt weitaus Wichtigeres für mich zu tun!",
  "1.0.23.0" => "Sie haben es auf unser Hauptquartier abgesehen!",
  "1.0.24.0" => "Wunderbar!
Erobere jetzt die Ostfeld-Festung!",
  "1.0.25.0" => "Nimm die Mittelfestung für uns ein!",
  "1.0.26.0" => "Wunderbar!
Erobere jetzt die Mittelfestung!",
  "1.0.27.0" => "Nimm die Ostfeld-Festung für uns ein!",
  "1.0.28.0" => "Wir haben die Hauptstreitmacht des Feindes nach
Norden gedrängt! Jetzt brauchen wir die Große Fee.",
  "1.0.29.0" => "Wenn wir nur eine Bombe hätten...
Dann kämen wir durch den Eingang zur Quelle...",
  "1.0.30.0" => "Achtung!
Der Feind greift uns von Norden an!",
  "1.0.31.0" => "Diese Narren sind also durchgekommen! Dann wird
es Zeit, dass wir ihr Hauptquartier überrennen!",
  "1.0.32.0" => "Hier entlang!
Beten wir gemeinsam zur Großen Fee!",
  "1.0.33.0" => "Du hast es geschafft!
Das sollte die Reihen unserer Feinde lichten!",
  "1.0.34.0" => "Das sollte die Reihen unserer Feinde lichten!",
  "1.0.35.0" => "Sehr gut! Gehen wir zum Gegenangriff über!",
  "1.0.36.0" => "Zieht Euch zurück, Prinzessin Zelda!
Von nun an übernehmen wir.",
  "1.0.37.0" => "Du hast recht.
Ich werde für euren Erfolg beten!",
  "1.0.38.0" => "Führt ihr ruhig eure Ameisenschlacht...
Ich habe hier Größeres vor...",
  "1.0.39.0" => "Hahahaaa! Jetzt wird die Sache richtig interessant!
Komm, König Dodongo!",
  "1.0.40.0" => "W-was ist das für ein Ungeheuer?",
  "1.0.41.0" => "W-wir müssen alles in unserer Macht tun,
um es aufzuhalten!",
  "1.0.42.0" => "H-haltet es auf!",
  "1.0.43.0" => "K-kämpft bis zum bitteren Ende! Wenn wir diese
Stellung verlieren, verlieren wir auch die Schlacht!",
  "1.0.44.0" => "Nimm das hier!
Damit werden deine Bomben mächtiger!",
  "1.0.45.0" => "Gut gemacht! Ihr habt alles gegeben!",
  "1.0.46.0" => "Lady Impa, ich bringe schlechte Neuigkeiten!
Der feindliche Magus greift unser Schloss an!",
  "1.0.47.0" => "Was? Also war die Bestie ein Ablenkungsmanöver!
Wo ist Prinzessin Zelda? Ist sie in Sicherheit?",
  "1.0.48.0" => "Möge das Licht Hyrule einmal mehr erhellen...",
  "1.0.49.0" => "Wir haben verloren...",
  "1.0.50.0" => "Oh nein... Prinzessin Zelda musste fliehen!
Jetzt ist alles aus!",
  "1.0.51.0" => "Link, besiege sie mit deinem Spezialangriff auf
einen Streich!",
  "1.0.52.0" => "Hahahaaa! Greift an, lasst nicht nach!",
  "1.0.53.0" => "Das ist unsere Chance! Angriff!",
  "1.0.54.0" => "Los! Mit einem Schlag!",
  "1.0.55.0" => "Auf diesen Volga ist kein Verlass!
Entsendet die nächste Einheit!",
  "1.0.56.0" => "Entfessele deine Magie und räume sie alle auf einmal aus dem Weg!",
  "1.0.57.0" => "Wenn der Plan funktioniert, ist uns der Sieg gewiss.
Folge mir zur Großen Fee bei der Quelle der Göttin!",
  "1.0.58.0" => "Komm her! Schnell!
Wir müssen das Tor mit Gewalt öffnen!",
  "1.0.59.0" => "Bewegt euch, ihr Nichtsnutze! Marschiert südwärts
in Richtung hylianische Festung!",
  "1.0.60.0" => "Die Mittelfestung wurde überrannt!",
  "1.0.61.0" => "Habt ihr Maden es endlich geschafft? Bewegt euch
endlich! Marschiert zur hylianischen Festung!",
  "1.0.62.0" => "Was? Wir haben die Ostfeld-Festung verloren?",
  "1.0.63.0" => "Was?",
  "1.0.64.0" => "Prinzessin Zelda ist nirgends aufzufinden?",
  "1.0.65.0" => "Sieh nur, Link! Da! Die Prinzessin!",
  "1.0.66.0" => "Du bist also der Junge vom Übungsplatz!",
  "1.0.67.0" => "Prinzessin Zelda. Ihr lebt! Es war ein Rekrut,
der uns den Weg mit Bomben freisprengte!",
  "1.0.68.0" => "Ein Rekrut, sagst du?
Wir müssen jedem dankbar sein, der uns hilft.",
  "1.0.69.0" => "Ein riesiger Felsbrocken hindert uns am Vormarsch.
Kannst du ihn mit Bomben beseitigen?",
  "1.0.70.0" => "Wir... Wir können sie nirgends finden!",
  "1.0.71.0" => "Was?",
  "1.0.72.0" => "Überlasst die Ostfeld-Festung uns! Kümmert euch
um die Mittelfestung!",
  "1.0.73.0" => "Erobere die Mittelfestung!
Stürme das feindliche Hauptquartier!",
  "1.0.74.0" => "Impa ist allein da draußen...
Ich werde sie retten!",
  "1.0.75.0" => "Die Goronen stecken in Schwierigkeiten...
Ich kümmere mich darum!",
  "1.0.76.0" => "Dieser Felsen steht zwischen mir und Impa...
Wenn wir ihn nur zerstören könnten!",
  "1.0.77.0" => "Damit müsste ich die Felsen zerstören und zu Impa
gelangen können!",
  "1.0.78.0" => "Impa! Geht es dir gut?",
  "1.0.79.0" => "Vergebt mir, Prinzessin Zelda! Es war dumm von
mir, einfach so in diese Falle zu tappen...",
  "1.0.80.0" => "Mach dir keine Gedanken! Jetzt müssen wir den
Feind zurückschlagen!",
  "1.0.81.0" => "Prinzessin Zelda! Bitte sehr!
Das wird die Bomben stärker machen!",
  "1.0.82.0" => "Prinzessin Zelda...",
  "1.0.83.0" => "Erobere die Mittelfestung!
Stürme das feindliche Hauptquartier!",
  "13.0.0.0" => "Wir müssen diese Felsen beseitigen,
um zu Prinzessin Zelda zu gelangen!",
  "13.0.1.0" => "Oh nein, oh nein, oh nein!
Wir müssen die Festung verteidigen!",
  "13.0.2.0" => "Erobere den Zentralposten für uns zurück!",
  "13.0.3.0" => "Erobere den Ost-Feldposten für uns zurück!",
  "13.0.4.0" => "Achtung!
Da kommen Feinde von Norden!",
  "13.0.5.0" => "Das sieht nicht gut aus! Unsere Feinde erobern
gerade den Zentralposten!",
  "13.0.6.0" => "Was sollen wir nur tun! Unsere Feinde überrennen
gerade den Ost-Feldposten!",
  "13.0.7.0" => "Lasst uns das machen, Prinzessin Zelda!",
  "13.0.8.0" => "Was ist das! Ein... Geist?",
  "13.0.9.0" => "Die Goronen stecken in Schwierigkeiten...
Ich kümmere mich darum!",
  "13.0.10.0" => "Diese Felsen stehen zwischen Impa und mir...
Wenn wir sie nur zerstören könnten!",
  "13.0.11.0" => "Damit müsste ich die Felsen zerstören und zu Impa
gelangen können!",
  "13.0.12.0" => "Prinzessin Zelda! Bitte sehr!
Das wird die Bomben stärker machen!",
  "13.0.13.0" => "Prinzessin Zelda...",
  "13.0.14.0" => "Erobere die Hauptfestung!
Stürme die feindliche Festung!",
}