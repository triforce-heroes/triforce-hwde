Map {
  "0.0.0" => "A0%1sF1R sind aus den A6SeelenportalenR erschienen!",
  "0.1.0" => "Die A6SeelenportaleR müssen schnellstmöglich geschlossen werden!",
  "0.2.0" => "A0%1sF0R wurde besiegt!",
  "0.3.0" => "Der Sieg über A0%1sF6R hat das A6SeelenportalR geschlossen!",
  "0.4.0" => "A0%1sF1R wurden besiegt!",
  "0.5.0" => "Der Sieg über A0%1sF7R hat die A6SeelenportaleR geschlossen!",
  "0.6.0" => "A0%1sF0R wurde am Himmel gesichtet!",
  "0.7.0" => "A0%1sF0R ist unter A0%2sF4R erschienen!",
  "0.8.0" => "A0%1sF0R rückt Richtung Südwüste vor!",
  "0.9.0" => "A0%1sF0R hat die Südwüste erreicht!",
  "0.10.0" => "Nach der Flucht A0%2sF2R greift A0%1sF5R die Südwüste an!",
  "0.11.0" => "A0%1sF0R wurde auf dem Schlachtfeld gesichtet!",
  "0.12.0" => "A0%1sF0R hat sich vorerst A0%2sF1R zurückgezogen!",
  "0.13.0" => "A0%1sF0R wurde verjagt!",
  "0.14.0" => "A0%1sF0R, A0%2sF5R und A0%3sF5R sind offen!",
  "0.15.0" => "Ein Teil der A0%1sF5R rückt gegen A0%2sF6R vor!",
  "0.16.0" => "A0%1sF1R wurden besiegt!",
  "0.17.0" => "Die A6SeelenportaleR müssen schnellstmöglich geschlossen werden!",
  "0.18.0" => "Ein Teil A0%1sF3R rückt Richtung A0%2sF4R vor!",
  "0.19.0" => "A0%1sF1R wurden besiegt!",
  "0.20.0" => "Alle A6SeelenportaleR wurden geschlossen!",
  "0.21.0" => "A0%1sF0R muss schnell verjagt werden!",
  "0.22.0" => "Besiege schnellstmöglich die A2MonsterR und rette A0%1sF6R!",
  "0.23.0" => "A6%1sF0R und A6%2sF5R sind offen!",
  "0.24.0" => "Fange A0%1sF7R ab!",
  "0.25.0" => "A0%1sF0R greift die Nordwüste aus der Luft an!",
  "0.26.0" => "A0%1sF0R wurde erobert!",
  "0.27.0" => "Der Verlust des Nestes hat die Moral A0%1sF2R gesenkt!",
  "0.28.0" => "Der Verlust des Nestes hat A0%1sF6R geschwächt!",
  "0.29.0" => "Die A0%1sF5R haben Verstärkung erhalten!",
  "0.30.0" => "A0%1sF0R hat sich vorerst A0%2sF1R zurückgezogen!",
  "0.31.0" => "A0%1sF0R ruht sich aus und regeneriert Lebensenergie!",
  "0.32.0" => "Die Moral A0%1sF2R steigt durch das Ausruhen!",
  "0.33.0" => "A0%1sF0R greift die Südwüste aus der Luft an!",
  "0.34.0" => "A0%1sF0R hat sich durch Ausruhen gestärkt!",
  "0.35.0" => "A0%1sF0R greift die Nordwüste aus der Luft an!",
  "0.36.0" => "A0%1sF0R hat sich durch Ausruhen noch weiter gestärkt!",
  "0.37.0" => "A0%1sF0R greift die Südwüste aus der Luft an!",
  "0.38.0" => "A0%1sF0R wurde besiegt!",
  "0.39.0" => "Das A1HauptquartierR ist an die A0%1sF7R gefallen!",
  "0.40.0" => "Die A0%1sF1R wurden besiegt!",
  "0.41.0" => "A0%1sF0R wurde von den A0%2sF7R vertrieben!",
  "0.42.0" => "C2%1sF0R wurde erobert!",
  "0.43.0" => "Versammele deine Mitstreiter bei A0%1sF4R!",
  "0.44.0" => "A0%2sF0R kämpft mit den A0%1sF0R!",
  "0.45.0" => "A0%1sF0R ist nun als spielbarer Kämpfer verfügbar!",
  "0.46.0" => "Erobere A0%1sF6R!",
  "0.47.0" => "Eine A6SkulltulaR wurde auf dem Schlachtfeld gesichtet!",
  "0.48.0" => "Du hast die A6SkulltulaR erlegt!",
  "0.49.0" => "Die A6SkulltulaR ist geflohen!",
  "0.50.0" => "Der Rückzug A0%1sF2R ist fehlgeschlagen!",
  "0.51.0" => "A0%1sF0R wurde auf dem Schlachtfeld gesichtet!",
  "0.52.0" => "Die Tore zur A6WüstenburgR sind offen!",
  "0.53.0" => "Die A0%1sF1R haben C1%2sF6R betreten!",
  "0.54.0" => "C1%1sF0R darf nicht fallen!",
  "0.55.0" => "Die Siegbedingungen haben sich geändert!",
  "0.56.0" => "Besiege A0%1sF6R!",
  "0.57.0" => "A0%1sF1R rücken von der A6WüstenburgR Richtung C1%2sF4R vor!",
  "0.58.0" => "A0%1sF1R rücken von der A6NordwüsteR Richtung C1%2sF4R vor!",
  "0.59.0" => "A0%1sF1R rücken von der A6SüdwüsteR aus gegen A0%2sF6R vor!",
  "0.60.0" => "Schließe alle A6SeelenportaleR!",
  "0.61.0" => "Erobere A0%1sF6R und verhindere, dass A0%2sF5R geheilt wird!",
  "0.62.0" => "Besiege A0%1sF7R und schließe die A6SeelenportaleR!",
