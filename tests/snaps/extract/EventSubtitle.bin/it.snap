  "3.7.0" => "Allora, dimmi...",
  "3.8.0" => "Qual è l'obiettivo di questa Cia...?",
  "3.9.0" => "Vuoi proprio saperlo?",
  "3.10.0" => "Beh...",
  "3.11.0" => "Prima dacci una mano...",
  "3.12.0" => "... e poi forse te lo dirò.",
