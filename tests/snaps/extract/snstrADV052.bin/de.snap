  "0.31.0" => "Ein Teil der A0%1sF5R verweigert den Gehorsam!",
  "0.32.0" => "Vorsicht vor den Verrätern unter den A0%1sF5R!",
  "0.33.0" => "Teile der A0%1sF5R sind übergelaufen!",
  "0.34.0" => "A0%1sF0R und A0%2sF5R sind offen!",
  "0.35.0" => "A0%1sF0R will Soldaten der A0%2sF3R abwerben!",
  "0.37.0" => "Besiege A0%2sF6R, bevor die A0%1sF5R überlaufen!",
  "0.38.0" => "A0%2sF0R hat einen Teil der A0%1sF5R abgeworben!",
  "0.39.0" => "Du hast die Pläne A0%1sF2R durchkreuzt!",
  "0.40.0" => "Die Einheit A0%1sF2R wurde zerschlagen!",
  "0.41.0" => "Die Moral der A5übergelaufenen TruppenR steigt!",
