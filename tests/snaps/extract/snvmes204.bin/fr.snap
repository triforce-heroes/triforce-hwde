Map {
  "1.0.0.0" => "Maître Ganon! Vos prouesses au combat
sont inégalables!",
  "1.0.1.0" => "C'est la raison pour laquelle je vous
reconnais comme mon roi!",
  "1.0.2.0" => "Hm? Les ennemis se rassemblent autour de moi?
Mais pourquoi?!",
  "1.0.3.0" => "Ils sont un peu trop nombreux à mon goût. Et ils n'ont pas
l'air commode... Il me semble qu'il est temps de réagir...",
  "1.0.4.0" => "Qui sont ces fous qui osent se dresser contre moi? Hum...
Mais avec un tel nombre, ils pourraient se révéler dangereux...",
  "1.0.5.0" => "Je voudrais admirer les prouesses de notre maître,
Ganon, encore davantage, mais je dois me retirer.",
  "1.0.6.0" => "Combien de temps vais-je encore devoir
tolérer ces misérables vermines?!",
  "1.0.7.0" => "Quel insigne honneur que de recevoir
votre aide, seigneur Ganon!",
  "1.0.8.0" => "Mes mots ne peuvent exprimer à quel point
je vous suis reconnaissant!",
  "1.0.9.0" => "Splendide! Nul ne peut vous résister!",
  "1.0.10.0" => "Quelle puissance redoutable! Et rien
ne peut étancher votre soif de destruction!",
  "1.0.11.0" => "Le seigneur Ganon est sans égal. Il balaie d'un simple
geste tous ceux qui osent s'opposer à lui!",
  "1.0.12.0" => "Ouvrez grand vos yeux et admirez!
Tremblez devant la puissance de mon roi!",
  "1.0.13.0" => "Continuez de tout saccager!
Détruisez! Détruisez tout!",
  "1.0.14.0" => "Moi, Ghirahim, je vous renouvelle mon
serment d'allégeance, seigneur Ganon.",
  "1.0.15.0" => "Ces misérables ne méritent pas de périr
de votre main, seigneur Ganon...",
  "1.0.16.0" => "C'est absolument... magnifique...",
  "1.0.17.0" => "Ne fléchissez pas, seigneur! Laissez-moi encore et
encore contempler votre exceptionnelle puissance!",
  "1.0.18.0" => "Nul ne peut rien faire face à vos
incommensurables pouvoirs!",
  "1.0.19.0" => "Le mot « suprême » a été créé pour vous qualifier!",
  "1.0.20.0" => "Votre puissance ne connaît aucune limite!",
  "1.0.21.0" => "Waouh! Elle est énorme, cette cocotte!
Et son bec a l'air de faire des ravages!",
  "1.0.22.0" => "Elle piétine ces ennemis comme si de rien
n'était. Elle ferait un allié de taille, non?",
  "1.0.23.0" => "Oh non! Nos ennemis se rassemblent par ici!",
  "1.0.24.0" => "Il y en a trop! On ne fait pas le poids!",
  "1.0.25.0" => "Nous sommes encerclés, Link... Il faut qu'on
réagisse, sinon ça va mal finir pour nous!",
  "1.0.26.0" => "Je crois que j'ai atteint ma limite...",
  "1.0.27.0" => "On est fichus, Link! Fuyons!",
  "1.0.28.0" => "Merci pour ton aide!",
  "1.0.29.0" => "On dirait qu'elle est venue nous aider.
Link! Encourageons-la pour la remercier!",
  "1.0.30.0" => "Il reste encore beaucoup d'ennemis!
Allez, mes amis, éliminons-les!",
  "1.0.31.0" => "Impressionnant! Je n'aurais jamais cru
que tu puisses devenir si fort!",
  "1.0.32.0" => "Alors tu penses être plus puissant que
ma cocotte?",
  "1.0.33.0" => "Continuons comme ça!",
  "1.0.34.0" => "Pas le temps de souffler!
Continuez comme ça!",
  "1.0.35.0" => "Ne relâchez pas votre attention!",
  "1.0.36.0" => "Bravo, Link! Continue comme ça!",
  "1.0.37.0" => "Ils peuvent venir aussi nombreux qu'ils voudront,
on les éliminera tous!",
  "1.0.38.0" => "Il en arrive de partout! Courage, Link!
Il ne faut pas abandonner!",
  "1.0.39.0" => "Allez, Link! Il est temps d'aller s'occuper
d'autres ennemis ailleurs!",
  "1.0.40.0" => "Beau travail, Link! Tu as vraiment réduit ces
ennemis en miettes!",
  "1.0.41.0" => "Tiens bon, Link! Montre-leur qui fait la loi ici!",
  "1.0.42.0" => "Voilà une victoire absolument écrasante! Je... je dois
même avouer que ces ennemis m'ont un peu déçu.",
  "1.0.43.0" => "Il faut être parfaitement inconscient pour
se dresser contre notre maître, Ganon...",
  "1.0.44.0" => "Une force aussi prodigieuse a sans aucun doute
dû plonger nos adversaires dans le désespoir.",
  "1.0.45.0" => "Maître! Vous avez écrasé cette armée comme
de vulgaires cloportes. J'en tremble d'admiration.",
  "1.0.46.0" => "Oh... Vous voir combattre avec tant de majesté
m'émeut comme jamais je ne l'ai été.",
  "1.0.47.0" => "Ce fut un combat grandiose! Quelle férocité!
Je suis submergé par l'émotion!",
  "1.0.48.0" => "On a réussi! Un vrai jeu d'enfant!",
  "1.0.49.0" => "Ils avaient l'avantage du nombre... mais ça
ne leur a pas suffi!",
  "1.0.50.0" => "Oh, je suis heureuse d'être dans ton camp, cette
bataille était vraiment un spectacle à couper le souffle!",
  "1.0.51.0" => "Tu n'en as fait qu'une bouchée, pas vrai, Link?",
  "1.0.52.0" => "Quel combat! J'étais sûre que tu serais à la hauteur!",
  "1.0.53.0" => "Tu as été incroyable, Link! Ha ha, je suis
bien contente de faire équipe avec toi!",
}