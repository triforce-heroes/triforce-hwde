  "5.5076.0" => "Rend de l'énergie à intervalle régulier de K.-O.",
  "5.5077.0" => "Remplit la jauge de coup fatal à intervalle régulier de K.-O.",
  "5.5078.0" => "Rend les bombes surpuissantes à intervalle régulier de K.-O.",
