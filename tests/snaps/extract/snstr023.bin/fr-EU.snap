Map {
  "0.0.0" => "Trouvez un moyen de détruire les A6gros rochersR !",
  "0.1.0" => "A0%1sF5R lutte contre un A5oiseau gigantesqueR !",
  "0.2.0" => "Vous avez pris le contrôle C2%1sF2R !",
  "0.3.0" => "Prenez le A6trésorR au bout du passage !",
  "0.4.0" => "Vous avez vaincu A0%1sF1R qui avançaient !",
  "0.5.0" => "Les A6portes de la salle secrète de MercantîleR sont fermées !",
  "0.6.0" => "Les A6portes de la salle secrète de MercantîleR sont ouvertes !",
  "0.7.0" => "Une partie A0%1sF3R avance sur A0%2sF0R !",
  "0.8.0" => "A0%1sF5R a forcé l'A5oiseau gigantesqueR à fuir temporairement !",
  "0.9.0" => "L'A5oiseau gigantesqueR revient sur le champ de bataille depuis l'A6Île ÉtoiléeR !",
  "0.10.0" => "A0%1sF4R quitte temporairement le champ de bataille !",
  "0.11.0" => "A0%1sF4R revient sur le champ de bataille depuis le A6Pas de ChatR !",
  "0.12.0" => "A0%1sF4R revient sur le champ de bataille depuis l'A6Île du DragonR !",
  "0.13.0" => "A0%1sF4R revient sur le champ de bataille depuis l'A6îlot des féesR !",
  "0.14.0" => "A0%1sF4R revient sur le champ de bataille depuis l'A6Île ÉtoiléeR !",
  "0.15.0" => "Vous avez détruit un des A6gros rochersR !",
  "0.16.0" => "Le A6gros rocherR a été détruit ! Une partie A0%1sF3R avance !",
  "0.17.0" => "Vous avez détruit tous les A6gros rochersR !",
  "0.18.0" => "Les portes C2%1sF2R sont ouvertes !",
  "0.19.0" => "C2%1sF4R n'envoie plus de renforts !",
  "0.20.0" => "Prenez le contrôle des autres A2forts aux entrées de la forteresseR !",
  "0.21.0" => "Vous avez pris le contrôle des A2forts aux entrées de la forteresseR !",
  "0.22.0" => "Les A2forts aux entrées de la forteresseR n'envoient plus du tout de renforts !",
  "0.23.0" => "A0%1sF4R invoque A0%2sF2R au A6Pas de ChatR !",
  "0.24.0" => "A0%1sF4R avance sur A0%2sF0R !",
  "0.25.0" => "Les conditions de victoire ont changé !",
  "0.26.0" => "Vaincre A0%1sF0R et A0%2sF0R !",
  "0.27.0" => "Les portes C2%1sF2R et C2%2sF2R sont ouvertes !",
  "0.28.0" => "Les troupes A0%1sF3R avancent sur A0%2sF0R !",
  "0.29.0" => "A0%1sF4R est passé à l'attaque en volant vers la A6place de MercantîleR !",
  "0.30.0" => "Repoussez immédiatement A0%1sF0R !",
  "0.31.0" => "A0%1sF4R quitte le champ de bataille !",
  "0.32.0" => "A0%1sF4R quitte le champ de bataille !",
  "0.33.0" => "A0%1sF4R encourage A0%2sF1R !",
  "0.34.0" => "Éliminez A0%1sF0R !",
  "0.35.0" => "Vous avez vaincu A0%1sF0R et A0%2sF0R !",
  "0.36.0" => "A0%2sF5R a fait tomber C1%1sF0R !",
  "0.37.0" => "A0%1sF5R a été vaincue !",
  "0.38.0" => "A0%1sF4R fuit !",
  "0.39.0" => "Une A6skulltulaR est apparue sur le champ de bataille !",
  "0.40.0" => "Vous avez obtenu une A6skulltulaR !",
  "0.41.0" => "La A6skulltulaR s'est enfuie !",
  "0.42.0" => "Vous avez vaincu A0%1sF0R !",
  "0.43.0" => "Le moral d'une partie A0%1sF3R augmente !",
  "0.44.0" => "Le chef est K.-O. ! Le moral A0%1sF3R baisse !",
  "0.45.0" => "Une partie des portes des A2forts aux entrées de la forteresseR est ouverte !",
  "0.46.0" => "A0%1sF6R rejoint le champ de bataille depuis C2%2sF0R !",
  "0.47.0" => "Le A2puissant monstreR avance sur A6MercantîleR !",
  "0.48.0" => "A0%1sF5R avancent sur A6MercantîleR !",
  "0.49.0" => "A0%2sF5R a fait fuir A0%1sF0R !",
  "0.50.0" => "Les A6portes sud de la PoudrerieR sont ouvertes !",
  "0.51.0" => "A0%1sF4R revient dans A0%2sF0R !",
  "0.52.0" => "A0%1sF4R revient sur la A6place de MercantîleR !",
  "0.53.0" => "L'A5oiseau gigantesqueR revient dans A0%2sF0R !",
  "0.54.0" => "Les portes A0%1sF2R sont ouvertes !",
  "0.55.0" => "C1%1sF4R ne doit pas tomber aux mains de l'ennemi !",
  "0.56.0" => "A0%1sF5R s'introduit dans C1%2sF0R !",
  "0.57.0" => "Repoussez A0%1sF0R !",
