Map {
  "0.0.0" => "La A2foudreR tombe dans les temples ! A0%1sF5R perd de l'énergie vitale !",
  "0.1.0" => "A0%1sF4R semble augmenter sa magie dans la A2base ennemieR !",
  "0.2.0" => "La A2foudreR fait perdre de l'énergie vitale à A0%1sF0R !",
  "0.3.0" => "A0%1sF4R ne doit pas s'enfuir !",
  "0.4.0" => "Prenez le contrôle des A6forts des SagesR restants !",
  "0.5.0" => "Les A6forts des SagesR ne doivent pas tomber aux mains de l'ennemi !",
  "0.6.0" => "Vous avez détruit les A6statues de la terreR !",
  "0.7.0" => "A0%1sF4R avance sur A0%2sF0R !",
  "0.8.0" => "La A6pousse des arbresR a relié les deux chemins !",
  "0.9.0" => "A0%1sF4R avance sur A0%2sF0R pour demander des renforts !",
  "0.10.0" => "A0%1sF4R a atteint A0%2sF0R et demande des renforts !",
  "0.11.0" => "A0%1sF4R quitte le champ de bataille !",
  "0.12.0" => "Sa destination étant prise, A0%1sF0R renonce à demander des renforts !",
  "0.13.0" => "A0%1sF4R bat en retraite !",
  "0.14.0" => "Vous avez empêché la demande de renforts !",
  "0.15.0" => "Vous avez pris le contrôle des quatre A6forts des SagesR !",
  "0.16.0" => "La A2foudreR ne tombe plus !",
  "0.17.0" => "Les portes des quatre A6forts des SagesR sont ouvertes !",
  "0.18.0" => "Regroupez-vous près de A0%1sF0R !",
  "0.19.0" => "A0%1sF4R renforce les A2monstres sur la place centraleR !",
  "0.20.0" => "Les A2monstres de la place centraleR commencent à amplifier leurs pouvoirs !",
  "0.21.0" => "A0%1sF6R et A0%2sF2R rejoignent le champ de bataille !",
  "0.22.0" => "A0%1sF4R et A0%2sF0R avancent sur les A6forts des SagesR !",
  "0.23.0" => "L'amplification magique renforce les A2monstres sur la place centraleR !",
  "0.24.0" => "L'amplification magique renforce encore les A2monstres sur la place centraleR !",
  "0.25.0" => "L'amplification magique renforce encore les A2monstres sur la place centraleR !",
  "0.26.0" => "Les A2monstres de la place centraleR avancent sur A0%1sF0R !",
  "0.27.0" => "Vous avez vaincu les deux A2monstres géantsR !",
  "0.28.0" => "Vous avez vaincu les A2monstres de la place centraleR !",
  "0.29.0" => "La destruction des A6statues de la terreR a relié les deux chemins !",
  "0.30.0" => "La A6pousse des arbresR a relié les deux chemins !",
  "0.31.0" => "Une partie des A2monstres du temple de la terreR avance sur C1%2sF0R et A0%3sF0R !",
  "0.32.0" => "Une partie des A2monstres du temple du ventR avance sur C1%2sF0R et A0%3sF0R !",
  "0.33.0" => "L'activation de tous les mécanismes a relié les chemins !",
  "0.34.0" => "La A2foudreR tombe encore dans les temples ! A0%1sF5R perd de l'énergie vitale !",
  "0.35.0" => "Prenez vite les A6forts des SagesR !",
  "0.36.0" => "Reprenez le contrôle des A6forts des SagesR !",
  "0.37.0" => "Les A6forts des SagesR sont sous votre contrôle ! La foudre ne tombe plus !",
  "0.38.0" => "L'amplification magique renforce A0%1sF0R !",
  "0.39.0" => "A0%1sF4R avance vers A0%2sF0R !",
  "0.40.0" => "A0%1sF4R utilise la magie accumulée pour régénérer son énergie vitale !",
  "0.41.0" => "Regroupez-vous immédiatement où se trouve A0%1sF0R !",
