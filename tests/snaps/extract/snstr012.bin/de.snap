  "0.32.0" => "A0%1sF0R nähert sich den A0%2sF5R!",
  "0.33.0" => "Beschütze A0%1sF6R!",
  "0.34.0" => "A0%1sF0R zieht sich zurück A0%2sF1R!",
  "0.35.0" => "Verstärkung für die A0%1sF5R rückt A0%2sF1R vor!",
