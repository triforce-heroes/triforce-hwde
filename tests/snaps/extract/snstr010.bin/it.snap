Map {
  "0.0.0" => "A0%1sF0R cerca la A6statua del sigilloR!",
  "0.1.0" => "A0%1sF0R ha trovato una A6statua del sigilloR!",
  "0.2.0" => "A0%1sF0R si mette in marcia verso la A6statua del sigilloR!",
  "0.3.0" => "L'arrivo di A0%1sF2R ha attivato la A6statua del sigilloR!",
  "0.4.0" => "L'A0%1sF1R appare in varie aree!",
  "0.5.0" => "Cerca nelle rovine e trova le A6statue del sigilloR!",
  "0.6.0" => "Proteggi il tuo alleato che sta attivando le A6statue del sigilloR!",
  "0.7.0" => "La A6statua del sigilloR è attivata! Ne mancano 2!",
  "0.8.0" => "La A6statua del sigilloR è attivata! Ne manca 1!",
  "0.9.0" => "Tutte le A6statue del sigilloR sono state attivate!",
  "0.10.0" => "La A6%1sF0R è aperta!",
  "0.11.0" => "L'A0%1sF1R avanza dal A6tempio della spada sacraR!",
  "0.12.0" => "Avvicinati alla finta A1LanaR!",
  "0.13.0" => "Cerca il A2nemicoR nascosto tra gli alleati!",
  "0.14.0" => "A0%1sF0R si comporta in modo strano! Avvicinati!",
  "0.15.0" => "Hai trovato il nemico che controlla l'A0%1sF2R!",
  "0.16.0" => "A0%1sF0R ha attaccato l'A0%2sF7R!",
  "0.17.0" => "Sconfiggi A0%1sF2R!",
  "0.18.0" => "Hai sconfitto il nemico che controllava l'A0%1sF3R!",
  "0.19.0" => "A0%1sF0R ha perso e l'A0%2sF3R è stata liberata!",
  "0.20.0" => "A0%1sF0R ha raggiunto l'A0%2sF7R!",
  "0.21.0" => "Le tre A6statue del sigilloR si sono attivate!",
  "0.22.0" => "La A6%1sF0R è aperta!",
  "0.23.0" => "A0%1sF0R, A0%2sF2R e A0%3sF2R si ritirano!",
  "0.24.0" => "L'A0%1sF1R è apparsa!",
  "0.25.0" => "Estrai la A6spada supremaR dal A6piedistallo della spada sacraR!",
  "0.26.0" => "Hai ottenuto la A6spada supremaR!",
  "0.27.0" => "A0%1sF0R appare!",
  "0.28.0" => "Le condizioni di vittoria sono cambiate!",
  "0.29.0" => "Devi sconfiggere A0%1sF2R!",
  "0.30.0" => "A0%1sF0R si ritira temporaneamente!",
  "0.31.0" => "A0%1sF0R appare nella piazza ovest delle rovine.",
  "0.32.0" => "Sono apparsi i rinforzi dell'A0%1sF1R!",
  "0.33.0" => "A0%1sF0R comincia a ritirarsi verso il A6tempio della spada sacraR!",
  "0.34.0" => "Proteggi A0%2sF2R da A0%1sF2R!",
  "0.35.0" => "A0%1sF0R ha perso!",
  "0.36.0" => "L'A0%1sF1R ha vinto la battaglia!",
  "0.37.0" => "A0%1sF0R è in fuga! Hai perso la battaglia!",
  "0.38.0" => "L'A0%1sF5R si ritira!",
  "0.39.0" => "L'area C2%1sF4R ha ceduto e si è aperta!",
  "0.40.0" => "L'area C2%1sF4R ha ceduto e si è aperta!",
  "0.41.0" => "L'area C2%1sF4R ha ceduto e si è aperta!",
  "0.42.0" => "L'area C2%1sF4R ha ceduto e si è aperta!",
  "0.43.0" => "A0%1sF0R ha perso e l'area C2%2sF0R è aperta!",
  "0.44.0" => "A0%1sF0R ha perso e l'area C2%2sF0R è aperta!",
  "0.45.0" => "Le aree A0%1sF0R e A0%2sF0R sono aperte!",
  "0.46.0" => "Supporta l'avanzata di A0%1sF6R!",
  "0.47.0" => "A0%1sF0R va verso A0%2sF6R!",
  "0.48.0" => "A0%1sF0R, A0%2sF2R e A0%3sF2R non devono ritirarsi!",
  "0.49.0" => "Sono apparsi rinforzi per l'A0%1sF5R!",
  "0.50.0" => "A0%1sF0R si ritira temporaneamente!",
  "0.51.0" => "L'A0%1sF1R ha aperto la strada per la A6spada supremaR e si ritira!",
  "0.52.0" => "A0%1sF0R ha ottenuto la A6spada supremaR!",
  "0.53.0" => "Hai scoperto la A6statua del sigilloR nell'area A0%1sF6R!",
  "0.54.0" => "A0%1sF0R si rimette in marcia verso la A6statua del sigilloR!",
  "0.55.0" => "A0%1sF0R è in fuga!",
  "0.56.0" => "A0%1sF0R va verso il A6piedistallo della spada sacraR!",
  "0.57.0" => "Il A6tempio della spada sacraR è chiuso e non puoi entrare!",
  "0.58.0" => "Hai salvato A0%1sF2R!",
  "0.59.0" => "Attenzione, A0%1sF2R non deve ritirarsi!",
  "0.60.0" => "Un'A6AracnulaR è stata avvistata sul campo di battaglia!",
  "0.61.0" => "Cerca l'A6AracnulaR!",
  "0.62.0" => "Hai ottenuto l'A6AracnulaR!",
  "0.63.0" => "L'A6AracnulaR sta per fuggire!",
  "0.64.0" => "L'A6AracnulaR è fuggita!",
  "0.65.0" => "L'area A0%1sF0R è aperta!",
  "0.66.0" => "Le condizioni di sconfitta sono cambiate!",
  "0.67.0" => "A0%1sF0R non deve ritirarsi!",
  "0.68.0" => "A0%1sF0R o A0%2sF2R non devono ritirarsi!",
  "0.69.0" => "Al centro dell'A0%1sF5R appare A0%2sF2R!",
  "0.70.0" => "L'A0%1sF1R avanza verso A0%2sF2R!",
  "0.71.0" => "A0%1sF0R cerca di risvegliare la statua, quindi è più vulnerabile!",
  "0.72.0" => "L'A0%1sF1R continua ad andare verso A0%2sF2R!",
  "0.73.0" => "A0%1sF4R appare vicino a A0%2sF2R!",
  "0.74.0" => "Sconfiggi A0%1sF2R e proteggi A0%2sF2R!",
  "0.75.0" => "L'A0%1sF1R è apparsa e ha circondato A0%2sF2R!",
  "0.76.0" => "L'A0%1sF1R è apparsa di nuovo!",
  "0.77.0" => "L'area A0%1sF0R è aperta!",
  "0.78.0" => "A0%1sF0R e A0%2sF2R appaiono vicino a A0%3sF6R!",
  "0.79.0" => "A0%2sF0R potenzia l'A0%1sF1R!",
  "0.80.0" => "Sconfiggi A0%1sF2R e A0%2sF2R e scorta A0%3sF2R!",
  "0.81.0" => "Presto, sconfiggi A0%1sF2R!",
  "0.82.0" => "Hai respinto A0%1sF2R!",
  "0.83.0" => "Hai scortato A0%1sF2R!",
  "0.84.0" => "A0%1sF0R appare nell'area A0%2sF6R!",
  "0.85.0" => "A0%1sF0R va verso l'area A0%2sF0R!",
  "0.86.0" => "A0%1sF0R ha perso e l'A0%2sF1R è più debole!",
  "0.87.0" => "A0%1sF1R hanno perso e A0%2sF1R è più debole!",
  "0.88.0" => "A0%1sF0R appare e va verso l'area C2%2sF6R!",
  "0.89.0" => "Hai conquistato l'area C2%1sF4R!",
  "0.90.0" => "Raggiungi A0%1sF2R!",
  "0.91.0" => "L'A0%1sF2R lotta contro A0%2sF2R!",
  "0.92.0" => "A0%1sF0R appare e va verso l'area C2%2sF6R!",
  "0.93.0" => "Nell'area A0%1sF6R si nasconde un tesoro!",
  "0.94.0" => "L'A0%2sF7R ha circondato A0%1sF2R!",
  "0.95.0" => "A0%1sF0R riprende la marcia!",
  "0.96.0" => "L'A0%2sF5R ha fatto fuggire A0%1sF2R!",
  "0.97.0" => "L'A0%1sF1R ha perso la battaglia!",
