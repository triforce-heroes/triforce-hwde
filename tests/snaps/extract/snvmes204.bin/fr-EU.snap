Map {
  "1.0.0.0" => "Seigneur Ganon ! Vous faites preuve de
tant de majesté lorsque vous combattez !",
  "1.0.1.0" => "Voilà pourquoi vous êtes digne d'être mon roi !",
  "1.0.2.0" => "Hm ? Les ennemis se rassemblent
autour de moi ?",
  "1.0.3.0" => "Ils sont un peu trop nombreux à mon goût. Si ça continue,
je serai dans une situation délicate",
  "1.0.4.0" => "Ils osent se dresser contre moi... Mais ils sont si
nombreux, ça pourrait se révéler risqué.",
  "1.0.5.0" => "Je voudrais admirer les prouesses de notre seigneur
Ganon encore davantage, mais je dois me retirer.",
  "1.0.6.0" => "Pendant combien de temps va-t-il encore
falloir que j'affronte ces vermines ?!",
  "1.0.7.0" => "Quel insigne honneur que de recevoir
l'aide du grand Ganon !",
  "1.0.8.0" => "Les mots ne peuvent exprimer à quel point
je vous suis reconnaissant !",
  "1.0.9.0" => "Splendide ! Nul ne peut vous résister !",
  "1.0.10.0" => "Quelle puissance redoutable !
Rien ne peux arrêter votre fureur !",
  "1.0.11.0" => "Le seigneur Ganon balaie tous ceux qui s'opposent à lui.
C'est cette force qui fait de lui mon roi.",
  "1.0.12.0" => "Ouvrez grand vos yeux et admirez !
Voilà la puissance de mon roi !",
  "1.0.13.0" => "Continuez de tout saccager !
Détruisez ! Détruisez tout !",
  "1.0.14.0" => "Moi, Ghirahim, je renouvelle mon serment
d'allégeance à votre puissante personne.",
  "1.0.15.0" => "Ces misérables ne font pas le poids !",
  "1.0.16.0" => "C'est absolument... magnifique...",
  "1.0.17.0" => "Laissez-moi encore et encore contempler
votre exceptionnelle puissance !",
  "1.0.18.0" => "Nul ne peut rien faire face à vos
incommensurables pouvoirs !",
  "1.0.19.0" => "Le mot « suprême » a été créé pour vous qualifier !",
  "1.0.20.0" => "Avec votre puissance, rien ne vous est impossible !",
  "1.0.21.0" => "Elle est énorme, cette cocotte !
Et elle a l'air très forte !",
  "1.0.22.0" => "Elle élimine plein d'ennemis !
Est-ce qu'elle est de notre côté ?",
  "1.0.23.0" => "Oh non ! Les ennemis se rassemblent par ici !",
  "1.0.24.0" => "Il y en a trop ! On ne fait pas le poids !",
  "1.0.25.0" => "Nous sommes encerclés par les ennemis...
Si ça continue, ça va mal finir pour nous !",
  "1.0.26.0" => "Je crois que j'ai atteint ma limite...",
  "1.0.27.0" => "On est fichus...
Link ! Allons-nous-en d'ici !",
  "1.0.28.0" => "Tu es venue m'aider ?
Merci !",
  "1.0.29.0" => "On dirait qu'elle est venue nous aider.
Link ! Encourageons-la pour la remercier !",
  "1.0.30.0" => "Il reste encore beaucoup d'ennemis !
Allez, mes amis, éliminons-les !",
  "1.0.31.0" => "Impressionnant ! Elle a vaincu tous
ces ennemis à elle toute seule !",
  "1.0.32.0" => "Elle est peut-être même plus
puissante que mes cocottes !",
  "1.0.33.0" => "Continuons comme ça !",
  "1.0.34.0" => "On aura pas de répit, on dirait !
Courage !",
  "1.0.35.0" => "Il faut rester concentrés jusqu'au bout !",
  "1.0.36.0" => "Oui, continuons comme ça !",
  "1.0.37.0" => "Ils peuvent venir aussi nombreux qu'ils voudront,
on les éliminera tous !",
  "1.0.38.0" => "Il en arrive de partout !
Courage ! Il ne faut pas abandonner !",
  "1.0.39.0" => "Si on allait éliminer d'autres ennemis ailleurs ?",
  "1.0.40.0" => "Ouah ! T'as vu tous les ennemis qu'elle a vaincus ?!",
  "1.0.41.0" => "Restons sur nos gardes et éliminons ceux qui restent !",
  "1.0.42.0" => "Voilà une victoire absolument écrasante !
Ces ennemis étaient vraiment décevants.",
  "1.0.43.0" => "Il faut être parfaitement inconscient pour
se dresser contre mon maître Ganon...",
  "1.0.44.0" => "Une force aussi prodigieuse a sans aucun doute
dû plonger nos adversaires dans le désespoir.",
  "1.0.45.0" => "Vous avez écrabouillé une multitude
d'ennemis en un clin d'œil !",
  "1.0.46.0" => "Oooh... Vous voir combattre avec tant de majesté
m'émeut comme jamais je ne l'avais été.",
  "1.0.47.0" => "Ce fut un combat grandiose !
Je suis submergé par l'émotion !",
  "1.0.48.0" => "Bravo ! Mais c'était du gâteau pour toi, pas vrai ?",
  "1.0.49.0" => "Il y avait tant d'ennemis... Impressionnant !",
  "1.0.50.0" => "C'était vraiment une belle bataille !",
  "1.0.51.0" => "Tu as vaincu plein d'ennemis !",
  "1.0.52.0" => "Tu es vraiment très forte, j'en reviens pas !",
  "1.0.53.0" => "Tu as été vraiment super forte !
On a bien fait de t'encourager !",
}