  "0.33.0" => "L'area C1%1sF0R è stata conquistata dall'A0%2sF7R!",
  "0.34.0" => "L'A0%1sF1R ha perso!",
  "0.35.0" => "L'A0%1sF1R ha perso la battaglia!",
  "0.36.0" => "Non hai potuto sconfiggere A0%1sF2R perché scappa!",
  "0.37.0" => "L'A0%1sF1R ha perso la battaglia!",
  "0.38.0" => "A0%1sF0R si mette in marcia verso A0%2sF2R!",
  "0.39.0" => "A0%1sF0R ha raggiunto l'area A0%2sF2R!",
  "0.40.0" => "A0%1sF0R cerca di convincere A0%2sF2R!",
  "0.41.0" => "Il morale dell'A0%1sF1R è peggiorato!",
  "0.42.0" => "L'A0%1sF1R si mette in marcia verso A0%2sF2R!",
  "0.43.0" => "L'area A0%1sF0R rischia di cadere! Vai in soccorso!",
  "0.44.0" => "L'area A0%1sF0R sta per cadere! Corri in aiuto!",
  "0.45.0" => "A0%1sF0R si ferma per combattere contro l'A0%2sF1R!",
  "0.46.0" => "A0%1sF0R si rimette in marcia!",
  "0.47.0" => "Conquista l'area A0%1sF0R!",
  "0.48.0" => "A0%1sF0R si mette in marcia!",
  "0.49.0" => "A0%1sF0R consuma energia magica per evocare l'A0%2sF1R!",
  "0.50.0" => "A0%1sF0R è senza energie e la sua difesa è dimezzata!",
  "0.51.0" => "Attenzione, A0%1sF2R non deve fuggire!",
  "0.52.0" => "Parte dell'A0%1sF1R si mette in marcia!",
  "0.53.0" => "Appare l'A0%1sF1R che si nascondeva nel palazzo!",
  "0.54.0" => "L'area C4%1sF0R è stata conquistata!",
  "0.55.0" => "Attenzione, l'area A0%1sF0R non deve cadere!",
  "0.56.0" => "Il morale dell'A0%1sF1R è migliorato!",
  "0.57.0" => "Più sono avidi, più sono facili da controllare.
Farò presto a convincere il re del crepuscolo.",
  "0.58.0" => "Hai sconfitto A0%1sF2R!",
  "0.59.0" => "L'A0%1sF1R va verso l'A0%2sF6R!",
  "0.60.0" => "A0%1sF0R ha bisogno d'aiuto!",
  "0.61.0" => "Presto, A0%1sF2R ha bisogno d'aiuto!",
  "0.62.0" => "A0%1sF0R e A0%2sF2R si demoralizzano!",
  "0.63.0" => "Non perdere d'occhio l'A0%1sF1R!",
  "0.64.0" => "A0%1sF0R è più forte perché A0%2sF2R è in ritirata!",
  "0.65.0" => "A0%2sF0R ha perso e A0%1sF2R è più debole!",
  "0.66.0" => "Le aree A0%1sF0R e A0%2sF0R sono aperte!",
  "0.67.0" => "Hai sconfitto A0%1sF3R!",
  "0.68.0" => "A0%1sF0R ha un miglioramento di morale!",
  "0.69.0" => "A0%1sF0R ha invaso l'area A0%2sF6R!",
  "0.70.0" => "Non hai sconfitto A0%1sF2R!",
  "0.71.0" => "Un'A6AracnulaR è stata avvistata sul campo di battaglia!",
