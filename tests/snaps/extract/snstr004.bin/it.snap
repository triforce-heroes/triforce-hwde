  "0.2.0" => "L'A0%1sF1R sta andando a conquistare i A6presidi rocciosiR!",
  "0.3.0" => "L'A2attacco di rocceR dall'area A0%1sF4R si è interrotto!",
  "0.4.0" => "L'A0%1sF1R si avvicina all'area A0%2sF0R!",
  "0.5.0" => "Adesso conquista l'area C2%1sF0R!",
  "0.6.0" => "Hai conquistato l'area C2%1sF1R!",
