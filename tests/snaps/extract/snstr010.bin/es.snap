  "0.51.0" => "¡Las A0%1sF1R se retiran tras abrir el camino al A6temploR!",
  "0.52.0" => "¡A0%1sF0R ha conseguido la A6Espada MaestraR!",
  "0.53.0" => "¡Has localizado una A6estatua cautivaR en A0%1sF2R!",
  "0.54.0" => "¡A0%1sF0R se dirige de nuevo hacia la A6estatua cautivaR!",
  "0.55.0" => "¡A0%1sF0R ha huido!",
  "0.56.0" => "¡A0%1sF0R avanza hacia el A6pedestal de la espada sagradaR!",
  "0.57.0" => "¡El A6templo de la espada sagradaR está cerrado!",
  "0.58.0" => "¡Has rescatado A0%1sF4R!",
  "0.59.0" => "¡Impide que A0%1sF2R huya!",
