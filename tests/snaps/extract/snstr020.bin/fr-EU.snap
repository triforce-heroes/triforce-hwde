Map {
  "0.0.0" => "A0%1sF5R se préparent pour leurs invocations !",
  "0.1.0" => "A0%1sF4R avance vers A0%2sF0R !",
  "0.2.0" => "A0%1sF4R est en difficulté ! Allez l'aider !",
  "0.3.0" => "A0%1sF4R est en grand danger ! Allez vite l'aider !",
  "0.4.0" => "Vous avez vaincu A0%1sF1R !",
  "0.5.0" => "Vous pouvez contrôler A0%1sF0R !",
  "0.6.0" => "A0%1sF7R avancent vers A0%2sF0R !",
  "0.7.0" => "A0%1sF4R est en difficulté ! Allez l'aider !",
  "0.8.0" => "A0%1sF4R est en grand danger ! Allez vite l'aider !",
  "0.9.0" => "Vous avez vaincu A0%1sF1R !",
  "0.10.0" => "A0%1sF4R rassemble ses alliées pour secourir A0%2sF0R !",
  "0.11.0" => "A0%1sF7R rejoignent le champ de bataille !",
  "0.12.0" => "A0%1sF5R invoquent A0%2sF3R !",
  "0.13.0" => "A0%1sF5R se préparent pour leurs invocations !",
  "0.14.0" => "Attention ! Surveillez bien A0%1sF0R !",
  "0.15.0" => "A0%1sF5R sont à court de magie et ont raté leur invocation !",
  "0.16.0" => "A0%2sF5R ont ouvert les portes des forts A0%1sF3R !",
  "0.17.0" => "A0%1sF7R apparaissent et commencent à appeler A0%2sF3R !",
  "0.18.0" => "A0%1sF5R se rassemblent vers A0%2sF1R !",
  "0.19.0" => "Éliminez immédiatement A0%1sF1R !",
  "0.20.0" => "Le moral des A2troupes rassembléesR vers A0%1sF0R augmente !",
  "0.21.0" => "Les A2troupes rassembléesR vers A0%1sF0R avancent sur A0%2sF0R !",
  "0.22.0" => "A0%1sF4R ne doit pas tomber aux mains de l'ennemi !",
  "0.23.0" => "A0%1sF6R supplémentaire apparaît et commence à appeler des renforts !",
  "0.24.0" => "A0%1sF4R rassemble ses alliées autour de A0%2sF0R !",
  "0.25.0" => "A0%1sF6R rejoint le champ de bataille !",
  "0.26.0" => "A0%1sF4R avance à la recherche de nourriture !",
  "0.27.0" => "Éliminez immédiatement A0%1sF1R !",
  "0.28.0" => "Vous avez vaincu la totalité A0%1sF3R !",
  "0.29.0" => "Une partie A0%1sF3R avance sur A0%2sF0R !",
  "0.30.0" => "A0%2sF4R a fermé les portes A0%1sF2R !",
  "0.31.0" => "Vous avez vaincu la totalité A0%1sF3R !",
  "0.32.0" => "Une A2horde de monstresR encercle A0%1sF0R !",
  "0.33.0" => "Sauvez vite A0%1sF0R !",
  "0.34.0" => "Vous avez escorté A0%1sF0R !",
  "0.35.0" => "La nourriture fait grandir A0%1sF0R qui devient une cocotte d'or !",
  "0.36.0" => "Les portes aux A6entrées du templeR sont ouvertes !",
  "0.37.0" => "A0%1sF4R avance sur A0%2sF0R !",
  "0.38.0" => "A0%1sF4R commence à appeler A0%2sF0R en renfort !",
  "0.39.0" => "A0%1sF4R absorbe de la magie et se renforce !",
  "0.40.0" => "A0%1sF4R absorbe de la magie et se renforce encore !",
  "0.41.0" => "A0%1sF4R perd de la magie et s'affaiblit !",
  "0.42.0" => "Vous avez vaincu A0%1sF0R ! ",
  "0.43.0" => "Tous A0%1sF1R ont disparu !",
  "0.44.0" => "A0%1sF4R bat en retraite !",
  "0.45.0" => "L'attaque A0%2sF3R a fait fuir A0%1sF0R !",
  "0.46.0" => "A0%1sF5R a été vaincue !",
  "0.47.0" => "A0%2sF5R a fait tomber C1%1sF0R !",
  "0.48.0" => "Les portes A0%1sF2R sont ouvertes !",
  "0.49.0" => "Vous avez pris C2%1sF0R !",
  "0.50.0" => "A0%1sF4R fuit !",
  "0.51.0" => "Une A6skulltulaR est apparue sur le champ de bataille !",
  "0.52.0" => "La A6skulltulaR s'est enfuie !",
  "0.53.0" => "A0%1sF4R affronte A0%2sF0R !",
  "0.54.0" => "A0%1sF4R absorbe la magie de la totalité A0%2sF3R !",
  "0.55.0" => "A0%1sF4R est K.-O. !",
  "0.56.0" => "Les A2troupes rassembléesR vers A0%1sF0R avancent vers A0%2sF0R !",
  "0.57.0" => "A0%1sF4R avance vers A0%2sF1R !",
  "0.58.0" => "Éliminez A0%1sF1R et affaiblissez A0%2sF0R !",
  "0.59.0" => "A0%1sF4R et A0%2sF1R avancent sur A0%3sF0R !",
