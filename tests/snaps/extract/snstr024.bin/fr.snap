Map {
  "0.0.0" => "A2DesR A0%1sF7R sont apparus A6aux portes des âmesR!",
  "0.1.0" => "Fermez A6toutes les portes des âmesR au plus vite!",
  "0.2.0" => "Vous avez vaincu A0%1sF2R!",
  "0.3.0" => "La défaite A2desR A0%1sF7R a fait disparaître A6la porte des âmesR!",
  "0.4.0" => "Vous avez vaincu A0%1sF1R!",
  "0.5.0" => "Vous avez vaincu A0%1sF1R! A6Les portes des âmesR ont disparu!",
  "0.6.0" => "A0%1sF4R rejoint le champ de bataille depuis les cieux!",
  "0.7.0" => "A0%1sF6R apparaît devant A0%2sF0R!",
  "0.8.0" => "A0%1sF4R se dirige vers le sud du désert!",
  "0.9.0" => "A0%1sF4R a atteint le sud du désert!",
  "0.10.0" => "A0%1sF4R poursuit A0%2sF0R jusqu'au sud du désert!",
  "0.11.0" => "A0%1sF4R a rejoint le champ de bataille!",
  "0.12.0" => "A0%1sF4R bat temporairement en retraite dans A0%2sF0R!",
  "0.13.0" => "Vous avez repoussé A0%1sF0R!",
  "0.14.0" => "A0%1sF4R, A0%2sF0R et A0%3sF0R sont ouverts!",
  "0.15.0" => "Une partie A0%1sF3R se dirige vers A0%2sF0R!",
  "0.16.0" => "Vous avez vaincu A0%1sF1R!",
  "0.17.0" => "Fermez A6toutes les portes des âmesR au plus vite!",
  "0.18.0" => "Une partie A0%1sF3R se dirige vers A0%2sF0R!",
  "0.19.0" => "Vous avez vaincu A0%1sF1R qui avançaient!",
  "0.20.0" => "A6Toutes les portes des âmesR ont disparu!",
  "0.21.0" => "Repoussez A0%1sF1R au plus vite!",
  "0.22.0" => "Éliminez A2les monstresR et secourez A0%1sF0R au plus vite!",
  "0.23.0" => "A6%1sF4R et A6%2sF4R sont ouvertes!",
  "0.24.0" => "Éliminez A0%1sF1R!",
  "0.25.0" => "A0%1sF4R a attaqué le nord du désert!",
  "0.26.0" => "A0%1sF4R est sous votre contrôle!",
  "0.27.0" => "Le moral A0%1sF3R est en baisse après la perte de son nid!",
  "0.28.0" => "A0%1sF4R est affaibli après avoir perdu son nid!",
  "0.29.0" => "A0%1sF5R a reçu des renforts!",
  "0.30.0" => "A0%1sF4R bat temporairement en retraite dans A0%2sF0R!",
  "0.31.0" => "A0%1sF4R se repose pour récupérer de l'énergie!",
  "0.32.0" => "A0%1sF4R s'est reposé pour remonter son moral!",
  "0.33.0" => "A0%1sF4R a attaqué le sud du désert!",
  "0.34.0" => "A0%1sF4R s'est reposé pour reprendre des forces!",
  "0.35.0" => "A0%1sF4R a attaqué le nord du désert!",
  "0.36.0" => "A0%1sF4R s'est reposé pour devenir encore plus fort!",
  "0.37.0" => "A0%1sF4R a attaqué le sud du désert!",
  "0.38.0" => "Vous avez vaincu A0%1sF0R!",
  "0.39.0" => "A1La base alliéeR est tombée sous les assauts A0%1sF3R!",
  "0.40.0" => "A0%1sF5R a perdu la bataille!",
  "0.41.0" => "A0%2sF5R a provoqué la fuite A0%1sF3R!",
  "0.42.0" => "C2%1sF4R est sous votre contrôle!",
  "0.43.0" => "Rassemblez les guerriers près A0%1sF3R!",
  "0.44.0" => "A0%1sF5R affronte A0%2sF0R!",
  "0.45.0" => "Vous pouvez désormais jouer avec A0%1sF0R!",
  "0.46.0" => "Prenez le contrôle A0%1sF2R!",
  "0.47.0" => "A6Une skulltulaR est apparue sur le champ de bataille!",
  "0.48.0" => "Vous avez trouvé A6la skulltulaR!",
  "0.49.0" => "A6La skulltulaR s'est enfuie!",
  "0.50.0" => "A0%1sF4R n'a pas pu battre en retraite!",
  "0.51.0" => "A0%1sF4R a rejoint le champ de bataille!",
  "0.52.0" => "Les portes près A6de la tour du JugementR sont ouvertes!",
  "0.53.0" => "A0%1sF5R a pénétré dans C1%2sF0R!",
