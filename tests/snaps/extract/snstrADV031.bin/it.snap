  "0.23.0" => "La A2base nemicaR è aperta!",
  "0.24.0" => "Sembra che A0%1sF2R stia trasportando un tesoro!",
  "0.25.0" => "A0%1sF0R appare e avanza verso la A6fontana della deaR!",
  "0.26.0" => "Sconfiggi A0%1sF2R e impossessati del A6tesoroR!",
  "0.27.0" => "Hai sconfitto A0%1sF2R prima che giungesse a A2destinazioneR!",
  "0.28.0" => "A0%1sF0R giunge a A2destinazioneR!",
  "0.29.0" => "Sono apparsi i rinforzi dell'A0%1sF1R!",
  "0.30.0" => "La A1base alleataR è caduta! Hai perso!",
  "0.31.0" => "L'A0%1sF1R ha perso la battaglia!",
  "0.32.0" => "A0%1sF0R fugge!",
  "0.33.0" => "Hai sconfitto A0%1sF2R!",
  "0.34.0" => "A0%1sF0R entra nell'area A0%2sF4R!",
  "0.35.0" => "Parte dell'A0%1sF1R avanza verso A0%2sF2R!",
  "0.36.0" => "Non lasciare che A0%1sF2R fugga!",
  "0.37.0" => "A0%1sF0R si ferma!",
  "0.38.0" => "Sconfiggi i rinforzi dell'A0%1sF1R per far avanzare A0%2sF2R!",
  "0.39.0" => "Hai sconfitto i rinforzi dell'A0%1sF1R!",
  "0.40.0" => "A0%1sF0R si rimette in marcia!",
  "0.41.0" => "A0%1sF0R si esalta per gli eventi recenti!",
  "0.42.0" => "A0%1sF0R ha perso!",
  "0.43.0" => "A0%1sF0R che hai sconfitto era una A6copiaR!",
  "0.44.0" => "A0%1sF0R si ritira!",
  "0.45.0" => "L'A0%1sF1R è entrata nella A1base alleataR!",
  "0.46.0" => "Alcuni presidi dell'A0%1sF1R sono aperti!",
  "0.47.0" => "A0%2sF0R vince e ispira l'A0%1sF1R!",
  "0.48.0" => "Conquista uno dei A2presidi nemiciR per sfondare le linee nemiche!",
  "0.49.0" => "Sono arrivati i rinforzi per l'A0%1sF1R!",
  "0.50.0" => "Scorta A1LavioR fino alla A1base alleataR!",
  "0.51.0" => "A0%1sF0R avanza!",
  "0.52.0" => "A0%1sF0R ha evocato A0%2sF2R!",
  "0.53.0" => "Sconfiggi A0%1sF2R una volta per tutte!",
  "0.54.0" => "Hai salvato A0%1sF2R!",
  "0.55.0" => "Ora salva i tuoi alleati!",
  "0.56.0" => "Le condizioni di sconfitta sono cambiate!",
  "0.57.0" => "Non lasciare che A0%1sF2R o A0%2sF2R fuggano o che la A1base alleataR cada!",
  "0.58.0" => "Il piano si è concluso. A0%1sF0R abbandona il campo di battaglia!",
