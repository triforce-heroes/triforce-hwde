  "0.47.0" => "A0%1sF0R ha invaso l'area A0%2sF6R!",
  "0.48.0" => "A0%1sF0R attacca il presidio con il A2potere della TriforzaR!",
  "0.49.0" => "L'A0%1sF1R si esalta dopo la riduzione dell'A0%2sF5R!",
  "0.50.0" => "L'A0%1sF1R è più forte dopo la riduzione dell'A0%2sF5R!",
  "0.51.0" => "Difendi l'area A0%1sF2R a ogni costo!",
  "0.52.0" => "Hai sconfitto A0%1sF2R e A0%2sF2R!",
  "0.53.0" => "Hai sconfitto A0%1sF2R e A0%2sF2R e hai vinto la battaglia!",
  "0.54.0" => "L'A0%2sF7R ha conquistato l'area C1%1sF0R!",
  "0.55.0" => "L'A0%1sF1R ha perso la battaglia!",
  "0.56.0" => "Il tempo è scaduto! Hai perso la battaglia!",
  "0.57.0" => "La fuga di A0%1sF6R demoralizza l'A0%2sF1R!",
  "0.58.0" => "Attenzione, A0%1sF2R avanza da est!",
  "0.59.0" => "Aiuta A0%1sF2R!",
  "0.60.0" => "Aiuta A0%1sF2R!",
  "0.61.0" => "A0%2sF0R ha perso! L'area C2%1sF0R è aperta!",
  "0.62.0" => "L'area A0%1sF2R è stata conquistata e si è aperta!",
  "0.63.0" => "Un A2evocatoreR è apparso!",
  "0.64.0" => "L'A0%1sF1R ha vinto la battaglia!",
  "0.65.0" => "Un'A6AracnulaR è stata avvistata sul campo di battaglia!",
  "0.66.0" => "Cerca l'A6AracnulaR!",
  "0.67.0" => "Hai ottenuto l'A6AracnulaR!",
  "0.68.0" => "L'A6AracnulaR sta per fuggire!",
  "0.69.0" => "L'A6AracnulaR è fuggita!",
  "0.70.0" => "Soccorri l'A0%1sF3R e non farla scappare!",
  "0.71.0" => "I A1LizalfosR non devono perdere!",
  "0.72.0" => "A0%1sF0R ha perso!",
  "0.73.0" => "A0%1sF0R fugge!",
  "0.74.0" => "A0%1sF0R ha un miglioramento di morale!",
  "0.75.0" => "Parte dell'A0%1sF1R si mette in marcia!",
  "0.76.0" => "L'A0%1sF1R si è esaltata e il morale è migliorato!",
  "0.77.0" => "Il morale dell'A0%1sF1R è tornato normale!",
  "0.78.0" => "A0%2sF0R ha costretto A0%1sF2R alla fuga!",
  "0.79.0" => "A0%1sF0R è in pericolo!",
  "0.80.0" => "A0%1sF0R ora è più potente!",
  "0.81.0" => "A0%1sF0R va verso il A6checkpoint rocciosoR!",
  "0.82.0" => "A0%1sF0R non deve raggiungere il A6checkpoint rocciosoR!",
  "0.83.0" => "A0%1sF1R non hanno raggiunto la A1base alleataR!",
  "0.84.0" => "A0%1sF0R ha attraversato il A6checkpoint rocciosoR!",
  "0.85.0" => "Parte dell'A0%1sF1R è diventata più forte!",
  "0.86.0" => "A0%1sF1R vanno verso l'area A0%2sF6R!",
  "0.87.0" => "Hai sconfitto A0%1sF2R!",
  "0.88.0" => "A0%1sF1R appaiono!",
  "0.89.0" => "L'area C2%1sF0R è aperta! A0%2sF1R avanzano!",
  "0.90.0" => "A0%1sF0R si avvicina all'area A0%2sF6R! All'attacco!",
  "0.91.0" => "Hai sconfitto A0%1sF3R!",
  "0.92.0" => "A0%1sF0R appare!",
  "0.93.0" => "A0%1sF0R ha evocato A0%2sF2R!",
  "0.94.0" => "A0%1sF0R ha perso e l'armata si ritira!",
  "0.95.0" => "A0%1sF0R ha evocato di nuovo A0%2sF6R!",
