Map {
  "0.0.0" => "A0%1sF4R se dirige vers A0%2sF0R!",
  "0.1.0" => "A0%1sF5R a reçu des renforts A2depuis certains forts ennemisR!",
  "0.2.0" => "A0%1sF5R a reçu davantage de renforts!",
  "0.3.0" => "A0%1sF5R se dirigent vers A1les fortsR A0%2sF3R!",
  "0.4.0" => "Ne laissez pas A0%1sF0R s'enfuir!",
  "0.5.0" => "Secourez A0%1sF0R!",
  "0.6.0" => "Secourez A0%1sF0R au plus vite!",
  "0.7.0" => "A0%2sF5R a provoqué la fuite A0%1sF3R!",
  "0.8.0" => "A0%1sF4R a atteint A0%2sF0R!",
  "0.9.0" => "A0%1sF4R a atteint sa destination sans encombre!",
  "0.10.0" => "A0%1sF4R se dirige vers A0%2sF0R!",
  "0.11.0" => "A0%1sF4R a atteint A0%2sF0R!",
  "0.12.0" => "A0%1sF5R ont quitté le champ de bataille!",
  "0.13.0" => "A0%1sF5R a reçu des renforts!",
  "0.14.0" => "L'attaque fait battre A0%1sF0R en retraite temporairement!",
  "0.15.0" => "A0%1sF4R doit se rendre A6à la chambre de la sorcièreR!",
  "0.16.0" => "C2%1sF4R est sous votre contrôle!",
  "0.17.0" => "Vous avez sauvé A0%1sF0R des ténèbres!",
  "0.18.0" => "Une partie des portes des A2fortsR A0%1sF3R est ouverte!",
  "0.19.0" => "A0%1sF5R se dirige vers A0%2sF0R!",
  "0.20.0" => "Vous pouvez désormais jouer avec A0%1sF0R!",
  "0.21.0" => "A0%1sF5R a reçu des renforts sur tout le champ de bataille!",
  "0.22.0" => "Éliminez tous A2les monstres ciblesR et protégez A0%1sF0R!",
  "0.23.0" => "A0%1sF5R affronte A0%2sF0R!",
  "0.24.0" => "A0%1sF5R a reçu des renforts sur tout le champ de bataille!",
  "0.25.0" => "A0%1sF4R se prépare à appeler des renforts!",
  "0.26.0" => "La défaite A0%1sF3R a provoqué la retraite de certains soldats!",
  "0.27.0" => "A0%1sF4R a invoqué A0%2sF0R!",
  "0.28.0" => "A0%1sF4R a de nouveau invoqué A0%2sF0R!",
  "0.29.0" => "A0%1sF4R se dirige vers A0%2sF0R!",
  "0.30.0" => "Vous avez vaincu A0%1sF0R!",
  "0.31.0" => "A0%1sF4R se prépare à encourager les troupes!",
  "0.32.0" => "A0%1sF4R a encouragé une partie A0%2sF3R!",
  "0.33.0" => "Le moral d'une partie A0%1sF3R est en hausse!",
  "0.34.0" => "A2Tous les monstres géantsR ont été vaincus!",
  "0.35.0" => "A0%1sF6R et A2desR A0%2sF7R ont rejoint le champ de bataille!",
  "0.36.0" => "Vous avez vaincu A0%1sF0R!",
  "0.37.0" => "Vous avez vaincu A2deuxR A0%1sF7R!",
  "0.38.0" => "A0%1sF4R est en danger! Allez lui porter secours!",
  "0.39.0" => "A0%1sF4R est en grand danger! Allez l'aider au plus vite!",
  "0.40.0" => "A0%1sF4R a pris la fuite!",
  "0.41.0" => "A0%1sF5R a perdu la bataille!",
  "0.42.0" => "Des attaques menacent A0%1sF0R!",
  "0.43.0" => "La chute A0%1sF2R est imminente!",
  "0.44.0" => "A0%2sF5R s'est emparée C1%1sF2R!",
  "0.45.0" => "Vous avez vaincu A0%1sF0R!",
  "0.46.0" => "Les conditions de défaite ont changé!",
  "0.47.0" => "Ne laissez pas A0%1sF0R fuir ni A0%2sF0R tomber!",
  "0.48.0" => "Vous avez pris C2%1sF0R et arrêté l'arrivée de renforts!",
  "0.49.0" => "Les portes A0%1sF2R sont ouvertes!",
  "0.50.0" => "Vous avez pris le contrôle A2de tous les fortsR A0%1sF3R!",
  "0.51.0" => "A0%1sF4R se prépare à appeler des renforts!",
  "0.52.0" => "A6Une skulltulaR est apparue sur le champ de bataille!",
  "0.53.0" => "Vous avez trouvé A6la skulltulaR!",
  "0.54.0" => "A6La skulltulaR s'est enfuie!",
  "0.55.0" => "Les deux A0%1sF7R ont fui suite à l'attaque A0%2sF3R!",
  "0.56.0" => "A0%1sF5R a contacté A0%2sF0R!",
  "0.57.0" => "A0%1sF5R a pénétré dans A0%2sF0R!",
  "0.58.0" => "A0%1sF4R se dirige vers A0%2sF0R depuis l'ouest!",
  "0.59.0" => "A0%1sF4R se dirige vers A0%2sF0R depuis l'est!",
