Map {
  "0.0.0" => "¡Acércate A0%1sF4R!",
  "0.1.0" => "¡Han aparecido A0%1sF1R y están atacando a los A2monstruosR!",
  "0.2.0" => "¡A0%1sF0R se ha teletransportado hasta A0%2sF2R!",
  "0.3.0" => "Tras abrirse A0%1sF2R, las A0%2sF1R van A0%3sF4R.",
  "0.4.0" => "¡A0%1sF0R se ha cerrado!",
  "0.5.0" => "¡A0%1sF0R ha aparecido en el campo de batalla!",
  "0.6.0" => "¡Derrota A0%1sF4R y abre A0%2sF2R!",
  "0.7.0" => "¡Has vencido A0%1sF4R! ¡A0%2sF0R se ha abierto!",
  "0.8.0" => "¡Has llegado A0%1sF4R!",
  "0.9.0" => "¡A0%1sF0R se dispone a invocar A2monstruosR!",
  "0.10.0" => "¡Ve A0%1sF4R cuanto antes!",
  "0.11.0" => "¡A0%1sF0R ha invocado A2monstruosR!",
  "0.12.0" => "¡Las A0%1sF1R avanzan hacia A0%2sF2R!",
  "0.13.0" => "¡A0%1sF0R ha aparecido en el campo de batalla!",
  "0.14.0" => "¡A0%1sF0R avanza en busca de comida!",
  "0.15.0" => "¡A2Hordas de monstruosR están acorralando A0%1sF4R!",
  "0.16.0" => "¡Rescata A0%1sF4R!",
  "0.17.0" => "¡A0%1sF0R ha llegado a la A6zona de comerR!",
  "0.18.0" => "¡A0%1sF0R ha comido y se ha convertido en A0%2sF2R!",
  "0.19.0" => "¡A0%1sF0R ha huido!",
  "0.20.0" => "¡A0%1sF0R se ha teletransportado a algún lugar!",
  "0.21.0" => "¡Los bastiones de las A0%1sF1R se han abierto!",
  "0.22.0" => "¡Has vencido A0%1sF5R!",
  "0.23.0" => "¡Encuentra A0%1sF4R cuanto antes!",
  "0.24.0" => "¡Has tomado A0%1sF2R! ¡A0%2sF0R ha aparecido!",
  "0.25.0" => "¡Has localizado A0%1sF4R!",
  "0.26.0" => "¡Has conquistado A0%1sF2R!",
  "0.27.0" => "¡A0%1sF0R se ha abierto! ¡Los A2monstruos poderososR avanzan!",
  "0.28.0" => "¡Las A0%1sF1R se han puesto en marcha!",
  "0.29.0" => "¡A0%1sF0R se ha abierto! ¡Las A0%2sF1R avanzan!",
  "0.30.0" => "¡Las A0%1sF1R se han puesto en marcha!",
  "0.31.0" => "¡Vence A0%1sF4R cuanto antes!",
  "0.32.0" => "¡La luz de la A6brújulaR ha perturbado A0%1sF4R!",
  "0.33.0" => "¡Has derrotado A0%1sF4R!",
  "0.34.0" => "¡A0%1sF0R ha arrebatado la A6brújulaR A0%2sF4R!",
  "0.35.0" => "¡A0%1sF0R ha caído en manos de las A0%2sF1R!",
  "0.36.0" => "¡A0%1sF0R ha aparecido y se dirige C2%2sF4R!",
  "0.37.0" => "¡Parece que hay un tesoro oculto en A0%1sF2R!",
  "0.38.0" => "¡Las A0%2sF1R han hecho huir A0%1sF4R!",
  "0.39.0" => "¡Las A0%1sF1R han sido derrotadas!",
  "0.40.0" => "¡A0%1sF0R está en peligro! ¡Necesita ayuda rápido!",
  "0.41.0" => "¡A0%1sF0R está en grave peligro! ¡Necesita ayuda inmediata!",
  "0.42.0" => "¡A0%1sF0R se ha vuelto a poner en marcha!",
  "0.43.0" => "¡Derrota A0%1sF4R!",
  "0.44.0" => "¡Ha aparecido una A6skulltulaR en el campo de batalla!",
  "0.45.0" => "¡Has conseguido una A6skulltulaR!",
  "0.46.0" => "¡La A6skulltulaR ha huido!",
  "0.47.0" => "¡A0%1sF0R se ha abierto!",
