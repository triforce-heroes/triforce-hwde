  "0.34.0" => "A0%1sF0R ha ripreso le forze!",
  "0.35.0" => "A0%1sF0R ha di nuovo ripreso le forze!",
  "0.36.0" => "Sconfiggi subito A0%1sF2R e A0%2sF2R!",
  "0.37.0" => "A0%1sF0R ha ripreso le forze!",
  "0.38.0" => "A0%1sF0R ha di nuovo ripreso le forze!",
  "0.39.0" => "A0%1sF0R attacca il presidio con il A2potere della TriforzaR!",
  "0.40.0" => "A0%1sF0R va verso l'area A0%2sF6R!",
  "0.41.0" => "L'avanzata di A0%1sF6R ha indebolito il A2potere della TriforzaR!",
  "0.42.0" => "A0%1sF0R attacca il presidio con il A2potere della TriforzaR!",
