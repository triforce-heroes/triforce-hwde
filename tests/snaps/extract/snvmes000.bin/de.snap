Map {
  "1.0.0.0" => "Wo kommen all diese Monster her?",
  "1.0.1.0" => "Weicht keinen Schritt zurück!
Wir sind Hyrules letzte Hoffnung!",
  "1.0.2.0" => "Wir müssen die Prinzessin beschützen!
Beeil dich, Link!",
  "1.0.3.0" => "Für Hyrule! Beschützt Prinzessin
Zelda mit eurem Leben!",
  "1.0.4.0" => "Verfluchtes Reptil!
Wie bekämpft man dieses Monster?",
  "1.0.5.0" => "Um das Reptil müssen wir uns zuerst
kümmern!",
  "1.0.6.0" => "Komm her, Wurm!",
  "1.0.7.0" => "Und das soll ein einfacher Rekrut sein?",
  "1.0.8.0" => "Er ist stark! Wie lautet der Name dieses
Soldaten?",
  "1.0.9.0" => "Du glaubst, du seist mir gewachsen?
Beweise es!",
  "1.0.10.0" => "Lass dem Drachenkrieger keine Luft zum
Atmen!",
  "1.0.11.0" => "Urgh... Ich weiß zwar nicht, wer du bist... Aber
ich weiß, dass wir uns wiedersehen werden.",
  "1.0.12.0" => "Wie soll ich Prinzessin Zelda helfen,
wenn diese Felsen mir den Weg versperren?",
  "1.0.13.0" => "Die werden uns überrennen!
Wir brauchen Hilfe!",
  "1.0.14.0" => "Oh nein! Wir müssen ihnen helfen, Link!",
  "1.0.15.0" => "Das sollte sie aufhalten!",
  "1.0.16.0" => "Vielen Dank! Dafür kriegst du
den Schatz aus dieser Höhle!",
  "1.0.17.0" => "Unser Schatz...
Ich lasse ihn hier zurück...",
  "1.0.18.0" => "Damit kannst du die Felsen aus dem Weg
räumen und zu Prinzessin Zelda gelangen.",
  "1.0.19.0" => "Zum Angriff! Zeigt dieser „Prinzessin“,
wer die wahren Herren von Hyrule sind!",
  "1.0.20.0" => "Erobert Mittelfestung und Ostfeld-Festung.
Schließt ihre nördlichen Tore!",
  "1.0.21.0" => "Ich überlege mir eine Strategie für die weitere
Schlacht, während du die Festung eroberst!",
  "1.0.22.0" => "Ich habe keine Zeit für diese Schaben.
Es gibt weitaus Wichtigeres für mich zu tun!",
  "1.0.23.0" => "Sie haben es auf unser Hauptquartier
abgesehen!",
  "1.0.24.0" => "Wunderbar!
Erobere jetzt die Ostfeld-Festung!",
  "1.0.25.0" => "Nimm die Mittelfestung für uns ein!",
  "1.0.26.0" => "Wunderbar!
Erobern wir jetzt die Mittelfestung!",
  "1.0.27.0" => "Nimm die Ostfeld-Festung für uns ein!",
  "1.0.28.0" => "Wir haben die Feinde nach Norden gedrängt!
Jetzt brauchen wir die Große Fee.",
  "1.0.29.0" => "Wenn wir nur eine Bombe hätten,
dann kämen wir in die Quelle...",
  "1.0.30.0" => "Achtung!
Der Feind greift uns von Norden an!",
  "1.0.31.0" => "Haha! Endlich kommen meine Schergen voran!
Es wird Zeit, dass wir das Schloss überrennen!",
  "1.0.32.0" => "Hier entlang!
Beten wir gemeinsam zur Großen Fee!",
  "1.0.33.0" => "Du hast es geschafft!
Das sollte die Reihen unserer Feinde lichten!",
  "1.0.34.0" => "Das sollte die Reihen unserer
Feinde lichten!",
  "1.0.35.0" => "Sehr gut! Gehen wir zum Gegenangriff über!",
  "1.0.36.0" => "Zieht Euch zurück, Prinzessin Zelda!
Von nun an übernehmen wir.",
  "1.0.37.0" => "Du hast recht.
Ich werde für euren Erfolg beten!",
  "1.0.38.0" => "Führt ihr ruhig eure Ameisenschlacht...
Ich habe hier Größeres vor...",
  "1.0.39.0" => "Hahahaaa! Jetzt wird die Sache richtig
interessant! Komm, König Dodongo!",
  "1.0.40.0" => "W-was ist das für ein Ungeheuer?",
  "1.0.41.0" => "W-wir müssen alles in unserer Macht tun,
um es aufzuhalten!",
  "1.0.42.0" => "H-haltet es auf!",
  "1.0.43.0" => "K-kämpft bis zum bitteren Ende! Ohne diese
Stellung verlieren wir die ganze Schlacht!",
  "1.0.44.0" => "Nimm das hier!
Damit werden deine Bomben mächtiger!",
  "1.0.45.0" => "Gut gemacht! Ihr habt alles gegeben!",
  "1.0.46.0" => "Lady Impa! Es ist schrecklich! Der feindliche
Hexer hat das Schloss eingenommen!",
  "1.0.47.0" => "Die Bestie war nur ein Ablenkungsmanöver!
Wo ist Prinzessin Zelda? Ist sie in Sicherheit?",
  "1.0.48.0" => "Möge das Licht Hyrule einmal
mehr erhellen...",
  "1.0.49.0" => "Wir haben verloren...",
  "1.0.52.0" => "Hahahaaa! Greift an, lasst nicht nach!",
  "1.0.53.0" => "Jetzt oder nie! Zum Angriff!",
  "1.0.55.0" => "Auf diesen Volga ist kein Verlass!
Entsendet die nächste Einheit!",
  "1.0.57.0" => "Gelingt der Plan, ist uns der Sieg gewiss.
Zur Großen Fee bei der Quelle der Göttin!",
  "1.0.58.0" => "Komm her! Schnell!
Wir müssen die Wand sprengen!",
  "1.0.59.0" => "Los, ihr Nichtsnutze! Marschiert südwärts
zum hylianischen Hauptquartier!",
  "1.0.60.0" => "Die Mittelfestung wurde überrannt!",
  "1.0.61.0" => "Sind die Maden endlich durchgestoßen?
Dann auf zum hylianischen Hauptquartier!",
  "1.0.62.0" => "Was? Wir haben die Ostfeld-Festung
verloren?",
  "1.0.63.0" => "Was?",
  "1.0.65.0" => "Sieh nur, Link! Da! Die Prinzessin!",
  "1.0.66.0" => "Du bist doch der Junge vom Übungsplatz!",
  "1.0.67.0" => "Prinzessin Zelda. Ihr lebt! Ein Rekrut hat
uns den Weg mit Bomben freigesprengt!",
  "1.0.68.0" => "Ein Rekrut, sagst du? Wir müssen
jedem dankbar sein, der uns hilft.",
  "1.0.69.0" => "Ein riesiger Felsbrocken ist uns im Weg.
Kannst du ihn mit Bomben beseitigen?",
  "1.0.70.0" => "Wir... Wir können sie nirgends finden!",
  "1.0.71.0" => "Was?",
  "1.0.72.0" => "Überlasst die Ostfeld-Festung uns!
Kümmert euch um die Mittelfestung!",
  "1.0.73.0" => "Du... Du bist doch der Rekrut vom
Übungsplatz...",
  "1.0.74.0" => "Helft mir! Ich bin von Monstern umzingelt!",
  "1.0.75.0" => "Danke! Ich hab diese Monster nicht kommen
sehen... Mein Name ist Proxi! Wie heißt du?",
  "1.0.76.0" => "Link? Und... Wie bitte?! Du willst Hyrule
gegen diese Monster verteidigen?",
  "1.0.77.0" => "Das gefällt mir!
Ich werde dir zur Seite stehen, Link!",
  "1.0.79.0" => "Erobern wir die Westfeld-Festung! Dann sind wir
nicht mehr von Impa und den anderen getrennt!",
  "1.0.80.0" => "Wir haben sie nach Norden zurückgedrängt!
Wenn uns jetzt noch die Große Fee hilft...",
  "1.0.81.0" => "Ich werde alles vorbereiten. Rekrut,
mir nach! Zur Quelle der Göttin!",
  "1.0.82.0" => "Der Norden von Schloss Hyrule ist
ihre Schwachstelle! Greift an!",
  "1.0.83.0" => "Verbarrikadiert das Nordtor und
schlagt sie zurück!",
  "1.0.84.0" => "Jawohl! Verlasst Euch auf mich!",
  "1.0.85.0" => "Der Feind ist zurückgeschlagen!
Blockieren wir den Klippen-Kontrollpunkt!",
  "1.0.86.0" => "Jetzt! Schnell zur Quelle der Göttin!",
  "1.0.87.0" => "Kommt schnell her, Prinzessin!
Beten wir zur Großen Fee!",
  "1.0.88.0" => "Gut... Beten wir zur Großen Fee!",
  "1.0.89.0" => "Nur dank dir ist unser Plan aufgegangen!
Nimm das hier als Lohn!",
  "1.0.90.0" => "Allein ist es zu gefährlich...
Wir müssen zusammenhalten!",
  "1.0.91.0" => "Hier ist alles bereit! Beeilt euch
mit der Blockade des Nordtors!",
  "1.0.92.0" => "Geschafft! Jetzt sollten wir uns mit deutlich
weniger Feinden herumschlagen müssen.",
  "1.0.93.0" => "Damit sollten ein bisschen weniger
Feinde zu uns vordringen!",
  "1.0.94.0" => "Sie sollen diese Festung um jeden Preis
beschützen. Verdächtig... Nehmen wir sie ein!",
  "1.0.95.0" => "Hilf mir! Mit vereinten Kräften bringen
wir dieses Monster zu Fall!",
  "13.0.0.0" => "Wir müssen diese Felsen beseitigen,
um zu Prinzessin Zelda zu gelangen!",
  "13.0.1.0" => "Oh nein, oh nein, oh nein!
Wir müssen die Festung verteidigen!",
  "13.0.2.0" => "Erobere die Mittelfestung für uns zurück!",
  "13.0.3.0" => "Erobere die Ostfeld-Festung für uns zurück!",
  "13.0.4.0" => "Achtung!
Da kommen Feinde von Norden!",
  "13.0.5.0" => "Das sieht nicht gut aus! Unsere Feinde erobern
gerade die Mittelfestung!",
  "13.0.6.0" => "Was sollen wir nur tun! Unsere Feinde überrennen
gerade die Ostfeld-Festung!",
  "13.0.7.0" => "Lasst uns das machen, Prinzessin Zelda!",
  "13.0.8.0" => "Was ist das! Ein... Geist?",
  "13.0.9.0" => "Dieser Drachenkrieger darf uns nicht abhängen!",
  "13.0.10.0" => "Vergebt mir, Prinzessin Zelda! Der Feind hat mir eine Falle gestellt...",
  "13.0.11.0" => "Jetzt sollten wir in der Lage sein, unsere Feinde
zurückzudrängen. Verlieren wir keine Zeit!",
  "13.0.12.0" => "Impa, alles in Ordnung?",
  "13.0.13.0" => "Du bist... ein Rekrut?",
  "13.0.14.0" => "Wir müssen die Hauptfestungen und die östlichen
Festungen erobern und ihre Nordtore schließen!",
  "13.0.15.0" => "Ich bereite den Plan vor. Prinzessin Zelda, bitte
übernehmt die Eroberung der Festungen!",
  "13.0.16.0" => "Wir haben die Hauptstreitmacht des Feindes nach
Norden gedrängt! Jetzt brauchen wir die Große Fee.",
  "13.0.17.0" => "Wenn der Plan funktioniert, ist uns der Sieg gewiss.
Folge mir zur Großen Fee bei der Quelle der Göttin!",
  "13.0.18.0" => "Wenn wir nur eine Bombe hätten...
Dann kämen wir durch den Eingang zur Quelle...",
  "13.0.19.0" => "Schnell! Spreng den Eingang frei, damit wir die
Quelle der Göttin betreten können!",
  "13.0.20.0" => "Achtung!
Der Feind greift uns von Norden an!",
  "13.0.21.0" => "Du sagst, die Ostfeld-Festung wurde erobert?",
  "13.0.22.0" => "Hier entlang!
Beten wir gemeinsam zur Großen Fee!",
  "13.0.23.0" => "Prinzessin Zelda, der Plan war ein großer Erfolg!
Wir haben ihnen schwere Verluste zugefügt!",
  "13.0.24.0" => "Prinzessin Zelda, der Plan war ein Erfolg!
Wir haben ihnen Verluste zugefügt!",
  "13.0.25.0" => "Impa, ich übernehme...
Führe du die hylianischen Truppen!",
  "13.0.26.0" => "Verstanden! Viel Glück, Hoheit!",
  "13.0.27.0" => "Wir haben es geschafft! Das haben wir nur
eurem Kampfgeist zu verdanken!",
  "13.0.28.0" => "Prinzessin Zelda, schreckliche Neuigkeiten!
Der Feind hat das Schloss erobert!",
  "13.0.29.0" => "Wir müssen Hyrule verteidigen! Schnell, Link!",
  "13.0.30.0" => "Damit müsste ich die Felsen zerstören und zu Impa
gelangen können!",
  "13.0.31.0" => "Prinzessin Zelda! Bitte sehr!
Das wird eure Bomben stärker machen!",
  "13.0.32.0" => "Prinzessin Zelda...",
  "13.0.33.0" => "Diese Felsen stehen zwischen uns und Impa...
Wenn wir sie nur zerstören könnten!",
  "13.0.34.0" => "Sieh nur, Link! Da! Die Prinzessin!",
}