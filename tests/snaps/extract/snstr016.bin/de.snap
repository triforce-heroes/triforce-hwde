Map {
  "0.0.0" => "A0%1sF0R ist in Bedrängnis und braucht Hilfe!",
  "0.1.0" => "C2%1sF0R wurde erobert!",
  "0.2.0" => "A0%1sF0R versucht zu fliehen!",
  "0.3.0" => "A0%1sF0R und A0%2sF5R wurden besiegt!",
  "0.4.0" => "A0%1sF0R wurde gesichtet!",
  "0.5.0" => "Die Tore zwischen A6WüsteR und A6WüstenburgR wurden geschlossen!",
  "0.6.0" => "Die Moral A0%1sF2R sinkt!",
  "0.7.0" => "A0%1sF0R rückt Richtung A0%2sF4R vor!",
  "0.8.0" => "A6%1sF0R wurde geschlossen, um A2ZantoR zu stoppen!",
  "0.9.0" => "Die A0%1sF1R haben A0%2sF6R besiegt!",
  "0.10.0" => "A6%1sF0R ist offen!",
  "0.11.0" => "Du hast A0%1sF6R erreicht!",
  "0.12.0" => "A0%1sF0R, A0%2sF5R und A0%3sF5R wurden gesichtet!",
  "0.13.0" => "Die Moral A0%1sF2R steigt!",
  "0.14.0" => "Die A0%1sF1R haben Verstärkung erhalten!",
  "0.15.0" => "Die A0%1sF1R rücken Richtung A0%2sF4R vor!",
  "0.16.0" => "C5%1sF0R und C5%2sF5R sind offen!",
  "0.17.0" => "Hindere die A0%1sF5R am Angriff!",
  "0.18.0" => "Die A0%1sF1R greifen an!",
  "0.19.0" => "Alle A0%1sF1R rücken Richtung A0%2sF4R vor!",
  "0.20.0" => "A0%1sF0R und A0%2sF5R wurden entdeckt!",
  "0.21.0" => "A0%1sF0R wurde besiegt!",
  "0.22.0" => "A0%1sF0R ist in Gefahr! Deine Hilfe wird benötigt!",
  "0.23.0" => "A0%1sF0R steht kurz davor zu fallen! Deine Hilfe wird benötigt!",
  "0.24.0" => "A0%1sF0R ist in Bedrängnis und braucht Hilfe!",
  "0.25.0" => "A0%1sF0R ist in Gefahr und benötigt auf der Stelle Hilfe!",
  "0.26.0" => "Die A0%1sF5R haben die Schlacht gewonnen!",
  "0.27.0" => "A0%2sF0R wurde von den A0%1sF5R vertrieben!",
  "0.28.0" => "Die A0%1sF1R wurden besiegt!",
  "0.29.0" => "C1%1sF0R ist an die A0%2sF5R gefallen!",
  "0.30.0" => "A6%1sF0R wurde von A2ZantoR geschlossen!",
  "0.31.0" => "A0%1sF0R darf nicht fliehen!",
  "0.32.0" => "Besiege schnellstmöglich A0%1sF6R!",
  "0.33.0" => "A0%1sF0R hat sich zurück aufs Schlachtfeld teleportiert!",
  "0.34.0" => "Erreiche schnellstmöglich A0%1sF6R!",
  "0.35.0" => "A0%1sF0R hat sich wegteleportiert!",
  "0.36.0" => "Die Tore zwischen A6WüsteR und A6WüstenburgR sind offen!",
  "0.37.0" => "A6%1sF0R ist offen!",
  "0.38.0" => "Begib dich zur Festung und finde A0%1sF6R und A0%2sF6R!",
  "0.39.0" => "Besiege A0%1sF6R und A0%2sF6R schnellstmöglich!",
  "0.40.0" => "A0%1sF0R rückt Richtung A0%2sF4R vor!",
  "0.41.0" => "A6%1sF0R ist offen!",
  "0.42.0" => "A6%1sF0R wurde von den A2Truppen von GanondorfR geöffnet!",
  "0.43.0" => "A2ZantoR hat A0%1sF6R zum Teil geschlossen!",
  "0.44.0" => "Die A2WüstenhitzeR setzt A0%1sF4R zu!",
  "0.45.0" => "A0%1sF0R und A0%2sF5R dürfen nicht fliehen!",
  "0.46.0" => "Eine A6SkulltulaR wurde auf dem Schlachtfeld gesichtet!",
  "0.47.0" => "Finde die A6SkulltulaR!",
  "0.48.0" => "Du hast die A6SkulltulaR erlegt!",
  "0.49.0" => "Die A6SkulltulaR wird bald fliehen!",
  "0.50.0" => "Die A6SkulltulaR ist geflohen!",
  "0.51.0" => "A0%1sF0R muss schnell besiegt werden!",
  "0.52.0" => "Besiege A0%1sF6R!",
  "0.53.0" => "Verfolge A0%1sF6R!",
  "0.54.0" => "Die A0%1sF5R im Süden der Wüste verlieren keine Energie mehr!",
  "0.55.0" => "Die A0%1sF5R in der Nordwüste verlieren keine Lebensenergie mehr!",
  "0.56.0" => "A0%1sF0R versucht erneut zu fliehen!",
  "0.57.0" => "A0%1sF0R rückt gegen A0%2sF6R vor!",
  "0.58.0" => "A0%1sF0R ist zum Teil offen!",
  "0.59.0" => "Die Südwüste entzieht den Soldaten Lebensenergie!",
  "0.60.0" => "Die Nordwüste entzieht den Soldaten Lebensenergie!",
  "0.61.0" => "A0%1sF0R hat A0%2sF6R besiegt!",
  "0.62.0" => "Finde einen Weg zu A0%1sF4R!",
  "0.63.0" => "A0%1sF0R, A0%2sF5R und A0%3sF5R sind nun als spielbare Kämpfer verfügbar!",
  "0.64.0" => "A0%1sF1R wurden A0%2sF3R und A0%3sF3R gesichtet!",
  "0.65.0" => "A0%1sF1R rücken Richtung A0%2sF4R und A0%3sF4R vor!",
  "0.66.0" => "A0%1sF1R wurden alle besiegt!",
  "0.67.0" => "A0%1sF0R und A0%2sF5R wurden gesichtet!",
  "0.68.0" => "A0%1sF0R plant etwas!",
  "0.69.0" => "A0%1sF0R und A0%2sF5R wurden besiegt!",
  "0.70.0" => "Die Moral der A0%1sF1R steigt!",
  "0.71.0" => "Die A0%1sF1R haben mehrere Festungen erobert!",
  "0.72.0" => "A0%1sF0R hat die Moral der A0%2sF1R gesteigert!",
  "0.73.0" => "A0%1sF0R hat A0%2sF6R beschworen!",
  "0.74.0" => "A0%1sF0R rückt gegen A0%2sF6R vor!",
  "0.75.0" => "A0%1sF0R ist nach dem Angriff der A0%2sF5R geflohen!",
  "0.76.0" => "Die A0%1sF1R wurden besiegt!",
