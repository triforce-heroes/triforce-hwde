Map {
  "0.0.0" => "A0%1sF4R si dirige da nord a sud!",
  "0.1.0" => "A0%1sF4R si dirige da sud a nord!",
  "0.2.0" => "Sconfiggi entrambi A0%1sF3R!",
  "0.3.0" => "A0%1sF0R e A0%2sF2R si dirigono a nord verso A0%3sF2R!",
  "0.4.0" => "A0%1sF0R si dirige a sud verso A0%2sF6R!",
  "0.5.0" => "A0%1sF0R e A0%2sF6R appaiono nel A6presidio montanoR!",
  "0.6.0" => "L'area C5%1sF4R è aperta!",
  "0.7.0" => "Sconfiggi ancora A0%1sF6R!",
  "0.8.0" => "A0%1sF1R si uniscono! Il loro morale migliora!",
  "0.9.0" => "Il morale A0%1sF7R è migliorato!",
  "0.10.0" => "A0%1sF0R a nord si mette in marcia verso A0%2sF2R!",
  "0.11.0" => "Attenzione, A0%1sF2R non deve ritirarsi!",
  "0.12.0" => "A0%1sF0R non deve essere distrutta!",
  "0.13.0" => "La A1radiominaR ha distrutto il A2muroR dell'area A0%1sF4R!",
  "0.14.0" => "A0%1sF0R ha distrutto il muro!",
  "0.15.0" => "A0%1sF0R non ha distrutto il muro!",
  "0.16.0" => "Il morale dell'A0%1sF1R è peggiorato!",
  "0.17.0" => "Il morale dell'A0%1sF1R è migliorato!",
  "0.18.0" => "L'area A0%1sF0R è aperta!",
  "0.19.0" => "L'area A0%1sF0R è aperta!",
  "0.20.0" => "A2GanondorfR ha potenziato l'A0%1sF1R!",
  "0.21.0" => "A0%1sF0R scaglia un A2attacco di fulminiR!",
  "0.22.0" => "La porta nord dell'area A0%1sF4R si è chiusa!",
  "0.23.0" => "Il A2castello di HyruleR è aperto!",
  "0.24.0" => "L'area A0%1sF0R è aperta!",
  "0.25.0" => "Hai conquistato il A2castello di HyruleR!",
  "0.26.0" => "Il morale dell'A0%1sF1R è peggiorato!",
  "0.27.0" => "A0%1sF0R si indebolisce!",
  "0.28.0" => "Sconfiggi A0%1sF2R!",
  "0.29.0" => "Presto, conquista l'area A0%1sF2R!",
  "0.30.0" => "A0%1sF0R ha perso! L'attacco di A2fulminiR si è interrotto!",
  "0.31.0" => "A0%1sF0R ha perso! L'attacco di A2fulminiR si è interrotto!",
  "0.32.0" => "A0%1sF0R va verso l'area A0%2sF6R!",
  "0.33.0" => "Il A2castello di HyruleR è stato conquistato e ora è accessibile!",
  "0.34.0" => "Hai conquistato l'area C2%1sF4R!",
  "0.35.0" => "Il morale dell'A0%1sF1R è peggiorato!",
  "0.36.0" => "A0%1sF0R è in campo!",
  "0.37.0" => "Le condizioni di vittoria sono cambiate!",
  "0.38.0" => "Devi sconfiggere A0%1sF2R!",
  "0.39.0" => "Le condizioni di sconfitta sono cambiate!",
  "0.40.0" => "Il A1castello di HyruleR viene conquistato o A0%1sF2R fugge.",
  "0.41.0" => "A0%1sF0R scaglia A2fulminiR sul A1castello di HyruleR!",
  "0.42.0" => "A0%1sF0R potenzia le A6frecce di luceR e puoi usarne quante vuoi!",
  "0.43.0" => "Grazie agli A1alleatiR, le A6frecce di luceR sono più potenti!",
  "0.44.0" => "Grazie agli A1alleatiR, le A6frecce di luceR sono più potenti!",
  "0.45.0" => "Grazie agli A1alleatiR, le A6frecce di luceR sono più potenti!",
  "0.46.0" => "A0%1sF0R è in fuga!",
  "0.47.0" => "L'A0%1sF1R ha perso la battaglia!",
  "0.48.0" => "L'A0%1sF7R ha conquistato il A1castello di HyruleR!",
  "0.49.0" => "L'A0%1sF1R ha perso la battaglia!",
  "0.50.0" => "L'A0%1sF1R ha perso la battaglia!",
  "0.51.0" => "Conquista l'area A0%1sF2R!",
  "0.52.0" => "Il A6presidio montanoR è aperto!",
  "0.53.0" => "Un'A6AracnulaR è stata avvistata sul campo di battaglia!",
  "0.54.0" => "Cerca l'A6AracnulaR!",
  "0.55.0" => "Hai ottenuto l'A6AracnulaR!",
  "0.56.0" => "L'A6AracnulaR sta per fuggire!",
  "0.57.0" => "L'A6AracnulaR è fuggita!",
  "0.58.0" => "È apparso un A2evocatoreR!",
  "0.59.0" => "L'A0%1sF1R ha vinto la battaglia!",
  "0.60.0" => "A0%1sF4R ha perso!",
  "0.61.0" => "A0%1sF0R deve fermarsi a causa dell'attacco dell'A0%2sF5R!",
  "0.62.0" => "A0%1sF0R ha subito gravi danni!",
  "0.63.0" => "A0%1sF0R non deve essere distrutta!",
  "0.64.0" => "A0%1sF0R si risveglia!",
  "0.65.0" => "A0%1sF0R va verso l'area A0%2sF6R!",
  "0.66.0" => "L'A0%1sF1R si dirige verso l'area A0%2sF6R!",
  "0.67.0" => "L'A0%1sF1R si mette in marcia!",
  "0.68.0" => "Il A6checkpoint est del castelloR e il A2presidio nemicoR sono aperti!",
  "0.69.0" => "L'area A0%1sF0R rischia di cadere!",
  "0.70.0" => "L'area A0%1sF0R sta per cadere!",
  "0.71.0" => "Presto, sconfiggi A0%1sF2R!",
  "0.72.0" => "A0%1sF0R comincia a combattere con A0%2sF2R!",
  "0.73.0" => "Parte dell'A0%1sF1R avanza verso A0%2sF2R!",
  "0.74.0" => "Sconfiggi l'A0%2sF3R che attacca A0%1sF2R!",
  "0.75.0" => "Sconfiggi l'A0%2sF3R che attacca A0%1sF2R!",
  "0.76.0" => "A0%1sF0R ricomincia a muoversi!",
  "0.77.0" => "Parte dell'A0%1sF1R si dirige verso A0%2sF2R!",
  "0.78.0" => "A0%1sF0R appare vicino all'A0%2sF7R!",
  "0.79.0" => "A0%1sF1R vanno verso A0%2sF2R!",
  "0.80.0" => "Appaiono A0%1sF3R. Sono in due!",
  "0.81.0" => "A0%1sF1R si preparano a evocare A0%2sF7R!",
  "0.82.0" => "A0%1sF0R ha evocato A0%2sF6R!",
  "0.83.0" => "A0%1sF0R ha evocato A0%2sF7R!",
  "0.84.0" => "A0%1sF0R ha indebolito le A6frecce di luceR!",
  "0.85.0" => "A0%1sF0R ha perso! Le A6frecce di luceR si rigenerano!",
  "0.86.0" => "A0%1sF0R ha perso! Le A6frecce di luceR si rigenerano ancora!",
