Map {
  "0.0.0" => "A0%1sF4R est en difficulté ! Allez l'aider !",
  "0.1.0" => "Vous avez pris C2%1sF0R !",
  "0.2.0" => "A0%1sF4R commence à s'enfuir !",
  "0.3.0" => "Vous avez vaincu A0%1sF0R et A0%2sF0R !",
  "0.4.0" => "A0%1sF4R rejoint le champ de bataille !",
  "0.5.0" => "Les portes qui relient la A6tour du JugementR au A6désertR sont fermées !",
  "0.6.0" => "A0%1sF4R a perdu le moral !",
  "0.7.0" => "A0%1sF4R avance sur A0%2sF0R !",
  "0.8.0" => "Fermeture A6%1sF2R ! L'avancée de A2XantoR est bloquée !",
  "0.9.0" => "A0%1sF5R a vaincu A0%2sF0R !",
  "0.10.0" => "Ouverture A6%1sF2R !",
  "0.11.0" => "Vous avez rejoint A0%1sF0R !",
  "0.12.0" => "A0%1sF4R, A0%2sF0R et A0%3sF0R rejoignent le champ de bataille !",
  "0.13.0" => "A0%1sF4R reprend du poil de la bête !",
  "0.14.0" => "A0%1sF5R a reçu des renforts !",
  "0.15.0" => "A0%1sF5R avance sur A0%2sF0R !",
  "0.16.0" => "Les portes C5%1sF2R et C5%2sF2R sont ouvertes !",
  "0.17.0" => "Empêchez A0%1sF1R d'attaquer !",
  "0.18.0" => "A0%1sF5R lance une attaque générale !",
  "0.19.0" => "A0%1sF5R lance une attaque générale sur A0%2sF0R !",
  "0.20.0" => "A0%1sF4R et A0%2sF0R ont été repérés !",
  "0.21.0" => "Vous avez vaincu A0%1sF0R !",
  "0.22.0" => "A0%1sF4R est en danger ! Allez le défendre !",
  "0.23.0" => "A0%1sF4R va tomber ! Allez vite le défendre !",
  "0.24.0" => "A0%1sF4R est en difficulté ! Allez l'aider !",
  "0.25.0" => "A0%1sF4R est en grand danger ! Allez vite l'aider !",
  "0.26.0" => "A0%1sF5R a vaincu !",
  "0.27.0" => "A0%1sF5R a fait fuir A0%2sF0R !",
  "0.28.0" => "A0%1sF5R a été vaincue !",
  "0.29.0" => "A0%2sF5R a fait tomber C1%1sF0R !",
  "0.30.0" => "A2XantoR a fermé A6%1sF0R !",
  "0.31.0" => "A0%1sF4R ne doit pas s'enfuir !",
  "0.32.0" => "Éliminez immédiatement A0%1sF0R !",
  "0.33.0" => "A0%1sF4R se téléporte sur le champ de bataille !",
  "0.34.0" => "Rejoignez immédiatement A0%1sF0R !",
  "0.35.0" => "A0%1sF4R se téléporte hors du champ de bataille !",
  "0.36.0" => "Les portes qui relient la A6tour du JugementR au A6désertR sont ouvertes !",
  "0.37.0" => "Ouverture A6%1sF2R !",
  "0.38.0" => "Dirigez-vous vers les forts et trouvez les vrais A0%1sF0R et A0%2sF0R !",
  "0.39.0" => "Éliminez immédiatement A0%1sF0R et A0%2sF0R !",
  "0.40.0" => "A0%1sF4R avance sur A0%2sF0R !",
  "0.41.0" => "Ouverture A6%1sF2R !",
  "0.42.0" => "L'attaque de l'A2armée de GanondorfR a ouvert A6%1sF0R !",
  "0.43.0" => "A2XantoR a fermé une partie des portes A0%1sF2R !",
  "0.44.0" => "La A2chaleur du désertR fait perdre de l'énergie vitale à A0%1sF0R !",
  "0.45.0" => "A0%1sF4R et A0%2sF0R ne doivent pas s'enfuir !",
  "0.46.0" => "Une A6skulltulaR est apparue sur le champ de bataille !",
  "0.48.0" => "Vous avez obtenu une A6skulltulaR !",
  "0.50.0" => "La A6skulltulaR s'est enfuie !",
  "0.51.0" => "Éliminez immédiatement A0%1sF0R !",
  "0.52.0" => "Éliminez A0%1sF0R !",
  "0.53.0" => "Pourchassez A0%1sF0R !",
  "0.54.0" => "A0%1sF5R au sud du désert ne perd plus d'énergie vitale !",
  "0.55.0" => "A0%1sF5R au nord du désert ne perd plus d'énergie vitale !",
  "0.56.0" => "A0%1sF4R commence à s'enfuir à nouveau !",
  "0.57.0" => "A0%1sF4R avance vers A0%2sF0R !",
  "0.58.0" => "Une partie des portes A0%1sF2R est ouverte !",
  "0.59.0" => "La chaleur au sud du désert fait perdre de l'énergie vitale aux soldats !",
  "0.60.0" => "La chaleur au nord du désert fait perdre de l'énergie vitale aux soldats !",
  "0.61.0" => "A0%1sF4R a vaincu A0%2sF0R !",
  "0.62.0" => "Trouvez un moyen de rejoindre A0%1sF0R !",
  "0.63.0" => "Vous pouvez contrôler A0%1sF0R, A0%2sF0R et A0%3sF0R !",
  "0.64.0" => "A0%1sF7R apparaissent dans A0%2sF0R et A0%3sF0R !",
  "0.65.0" => "A0%1sF5R avancent sur A0%2sF0R et A0%3sF0R !",
  "0.66.0" => "Vous avez vaincu la totalité A0%1sF3R !",
  "0.67.0" => "A0%1sF6R et A0%2sF2R apparaissent !",
  "0.68.0" => "A0%1sF4R représente une menace !",
  "0.69.0" => "Vous avez vaincu A0%1sF0R et A0%2sF0R !",
  "0.70.0" => "Le moral A0%1sF3R augmente !",
  "0.71.0" => "A0%1sF5R occupe A0%2sF0R et A0%3sF0R !",
  "0.72.0" => "A0%1sF4R encourage A0%2sF1R et la galvanise !",
  "0.73.0" => "A0%1sF4R invoque A0%2sF2R à la puissance démesurée !",
  "0.74.0" => "A0%1sF4R à la puissance démesurée avance vers A0%2sF0R !",
  "0.75.0" => "L'attaque A0%2sF3R a fait fuir A0%1sF0R !",
  "0.76.0" => "A0%1sF5R a été vaincue !",
  "0.77.0" => "A0%1sF6R apparaît et avance sur C2%2sF0R !",
  "0.78.0" => "Vous avez pris le contrôle C2%1sF2R !",
  "0.79.0" => "Regroupez-vous vers A0%1sF0R !",
  "0.80.0" => "A0%1sF5R affronte A0%2sF0R !",
  "0.81.0" => "A0%1sF6R apparaît et avance sur C2%2sF0R !",
  "0.82.0" => "Un trésor semble reposer dans A0%1sF0R !",
  "0.83.0" => "A0%1sF5R avancent sur les différents forts A0%2sF3R !",
  "0.84.0" => "Les forts A0%1sF3R ne doivent pas tomber !",
  "0.85.0" => "A0%1sF4R a pénétré dans A0%2sF0R !",
  "0.86.0" => "Éliminez immédiatement A0%1sF0R !",
  "0.87.0" => "A0%1sF5R occupe A0%2sF0R !",
  "0.88.0" => "A0%1sF4R à la puissance démesurée avance vers A0%2sF0R !",
  "0.89.0" => "A0%1sF4R est K.-O. ! Ses troupes battent en retraite !",
