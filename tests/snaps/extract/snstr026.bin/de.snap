Map {
  "0.0.0" => "Es schlagen A2BlitzeR ein! Die A0%1sF5R verlieren Lebensenergie!",
  "0.1.0" => "A0%1sF0R sammelt im A2feindlichen HauptquartierR Magie!",
  "0.2.0" => "A0%1sF0R verliert durch die A2BlitzeR Lebensenergie!",
  "0.3.0" => "A0%1sF0R darf nicht fliehen!",
  "0.4.0" => "Erobere auch die übrigen A6WeisenfestungenR!",
  "0.5.0" => "Die A6WeisenfestungenR dürfen nicht fallen!",
  "0.6.0" => "Die A6Terra-StatuenR wurden zerstört!",
  "0.7.0" => "A0%1sF0R rückt Richtung A0%2sF4R vor!",
  "0.8.0" => "Die A6BäumeR haben den Weg geöffnet!",
  "0.9.0" => "A0%1sF0R will A0%2sF3R Verstärkung rufen!",
  "0.10.0" => "A0%1sF0R hat A0%2sF3R Verstärkung gerufen!",
  "0.11.0" => "A0%1sF0R hat sich zurückgezogen!",
  "0.12.0" => "A0%1sF0R konnte keine Verstärkung rufen, weil sein Ziel erobert wurde!",
  "0.13.0" => "A0%1sF0R hat das Schlachtfeld verlassen!",
  "0.14.0" => "Der Ruf nach Verstärkung wurde verhindert!",
  "0.15.0" => "Die vier A6WeisenfestungenR wurden erobert!",
  "0.16.0" => "Die A2BlitzschlägeR haben aufgehört!",
  "0.17.0" => "Die A6WeisenfestungenR sind offen!",
  "0.18.0" => "Versammele dich bei A0%1sF4R!",
  "0.19.0" => "Die A2Monster auf dem ZentralplatzR wurden durch A0%1sF6R gestärkt!",
  "0.20.0" => "Die A2Monster auf dem ZentralplatzR wollen sich durch Magie stärken!",
  "0.21.0" => "A0%1sF0R und A0%2sF5R wurden gesichtet!",
  "0.22.0" => "A0%1sF0R und A0%2sF5R rücken zu den A6WeisenfestungenR vor!",
  "0.23.0" => "Die A2Monster auf dem ZentralplatzR wurden durch Magie gestärkt!",
  "0.24.0" => "Die A2Monster auf dem ZentralplatzR wurden durch Magie weiter gestärkt!",
  "0.25.0" => "Die A2Monster auf dem ZentralplatzR wurden durch Magie noch weiter gestärkt!",
  "0.26.0" => "Die A2Monster auf dem ZentralplatzR rücken Richtung A0%1sF4R vor!",
  "0.27.0" => "Beide A2RiesenmonsterR wurden besiegt!",
  "0.28.0" => "Die A2Monster auf dem ZentralplatzR wurden besiegt!",
  "0.29.0" => "Durch die Zerstörung der A6Terra-StatuenR ist der Weg nun verbunden!",
  "0.30.0" => "Die A6BäumeR haben den Weg geöffnet!",
  "0.31.0" => "Ein Teil der A2Monster des Terra-TempelsR rückt Richtung C1%2sF4R und A0%3sF4R vor!",
  "0.32.0" => "Ein Teil der A2Monster des ZephirtempelsR rückt Richtung C1%2sF4R und A0%3sF4R vor!",
  "0.33.0" => "Alle Schalter wurden betätigt! Der Weg ist offen!",
  "0.34.0" => "Es schlagen wieder A2BlitzeR ein! Die A0%1sF5R nehmen Schaden!",
  "0.35.0" => "Erobere schnell die A6WeisenfestungenR!",
  "0.36.0" => "Erobere die A6WeisenfestungenR zurück!",
  "0.37.0" => "Durch die Eroberung der A6WeisenfestungenR haben die Blitzschläge aufgehört!",
  "0.38.0" => "A0%1sF0R wurde durch Magie gestärkt!",
  "0.39.0" => "A0%1sF0R rückt gegen A0%2sF6R vor!",
  "0.40.0" => "Die Energie A0%1sF2R wurde durch Magie wiederhergestellt!",
  "0.41.0" => "Versammele deine Mitstreiter schnell bei A0%1sF4R!",
  "0.42.0" => "Die Lebensenergie A0%1sF2R wird nicht länger aufgefüllt!",
  "0.43.0" => "A0%1sF0R wurde von den A0%2sF7R vertrieben!",
  "0.44.0" => "Die A0%1sF1R wurden besiegt!",
  "0.45.0" => "A0%1sF0R ist geflohen! Der Kampf ist verloren!",
  "0.46.0" => "C1%1sF0R ist an den A2FeindR gefallen!",
  "0.47.0" => "Eine A6SkulltulaR wurde auf dem Schlachtfeld gesichtet!",
  "0.48.0" => "Finde die A6SkulltulaR!",
  "0.49.0" => "Du hast die A6SkulltulaR erlegt!",
  "0.50.0" => "Die A6SkulltulaR wird bald fliehen!",
  "0.51.0" => "Die A6SkulltulaR ist geflohen!",
  "0.52.0" => "A0%1sF0R wurde besiegt!",
  "0.53.0" => "C2%1sF0R ist offen!",
  "0.54.0" => "C2%1sF0R wurde erobert!",
  "0.55.0" => "C1%1sF0R ist an den A2FeindR gefallen!",
  "0.56.0" => "A0%1sF0R hat A0%2sF6R erreicht!",
  "0.57.0" => "A0%1sF0R droht zu fallen!",
  "0.58.0" => "A0%1sF0R steht kurz davor zu fallen!",
  "0.59.0" => "Die A0%1sF5R verlieren keine Lebensenergie mehr!",
  "0.60.0" => "A2Mächtige MonsterR rücken gegen A0%1sF6R vor!",
  "0.61.0" => "Das A6Südtor zur HöhlenmitteR ist offen!",
  "0.62.0" => "Das A6Nordtor des TempelgangsR ist offen!",
  "0.63.0" => "Die Lebensenergie A0%1sF2R wurde vollständig wiederhergestellt!",
  "0.64.0" => "A0%1sF1R rücken Richtung C1%2sF4R vor!",
  "0.65.0" => "A0%1sF1R rücken nun Richtung A0%3sF4R vor!",
