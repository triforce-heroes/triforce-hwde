  "0.55.0" => "Les conditions de victoire ont changé!",
  "0.56.0" => "Éliminez A0%1sF0R!",
  "0.57.0" => "A0%1sF5R de A6la tour du JugementR se dirigent vers C1%2sF0R!",
  "0.58.0" => "A0%1sF5R du A6sud du désertR se dirigent vers C1%2sF0R!",
