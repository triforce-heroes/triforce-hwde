Map {
  "0.0.0" => "A0%1sF1R wurden auf dem Schlachtfeld gesichtet!",
  "0.1.0" => "Finde den A6BogenR im Gebiet des Dorfes!",
  "0.2.0" => "A0%1sF1R wurden alle besiegt!",
