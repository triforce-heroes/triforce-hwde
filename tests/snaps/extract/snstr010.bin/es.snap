Map {
  "0.0.0" => "¡A0%1sF0R está buscando las A6estatuas cautivasR!",
  "0.1.0" => "¡A0%1sF0R ha encontrado una A6estatua cautivaR!",
  "0.2.0" => "¡A0%1sF0R se dirige a la A6estatua cautivaR!",
  "0.3.0" => "¡A0%1sF0R ha activado una A6estatua cautivaR!",
  "0.4.0" => "¡Las A0%1sF1R han aparecido en varios puntos!",
  "0.5.0" => "¡Busca las A6estatuas cautivasR en las ruinas!",
  "0.6.0" => "¡Protege a los aliados mientras activan a las A6estatuas cautivasR!",
  "0.7.0" => "¡Una A6estatua cautivaR ha sido activada! ¡Quedan dos!",
  "0.8.0" => "¡Otra A6estatua cautivaR ha sido activada! ¡Queda una!",
  "0.9.0" => "¡Todas las A6estatuas cautivasR han sido activadas!",
  "0.10.0" => "¡Se ha abierto una puerta en A6%1sF0R!",
  "0.11.0" => "¡Las A0%1sF1R avanzan desde el A6templo de la espada sagradaR!",
  "0.12.0" => "¡Acércate a la doble de A1LanaR y revela su verdadera identidad!",
  "0.13.0" => "¡Descubre al A2enemigoR que se oculta entre los aliados!",
  "0.14.0" => "¡A0%1sF0R se comporta de forma extraña! ¡Síguela!",
  "0.15.0" => "¡Has descubierto quién controla a las A0%1sF1R!",
  "0.16.0" => "¡A0%1sF0R está atacando a las A0%2sF1R!",
  "0.17.0" => "¡Derrota A0%1sF4R!",
  "0.18.0" => "¡Has derrotado al enemigo que controlaba a las A0%1sF1R!",
  "0.19.0" => "¡La derrota A0%1sF6R ha liberado a las A0%2sF1R!",
  "0.20.0" => "¡A0%1sF0R se ha aliado con las A0%2sF1R!",
  "0.21.0" => "¡Las tres A6estatuas cautivasR están activadas!",
  "0.22.0" => "¡Se ha abierto una puerta en A6%1sF0R!",
  "0.23.0" => "¡A0%1sF0R, A0%2sF2R y A0%3sF2R abandonan el campo de batalla!",
  "0.24.0" => "¡Las A0%1sF1R han aparecido!",
  "0.25.0" => "Saca la A6Espada MaestraR del A6pedestal de la espada sagradaR.",
  "0.26.0" => "¡Has obtenido la A6Espada MaestraR!",
  "0.27.0" => "¡A0%1sF0R ha aparecido!",
  "0.28.0" => "¡Las condiciones para la victoria han cambiado!",
  "0.29.0" => "¡Debes vencer A0%1sF4R!",
  "0.30.0" => "¡A0%1sF0R deja la batalla temporalmente!",
  "0.31.0" => "¡A0%1sF0R ha vuelto a aparecer en la plaza oeste de las ruinas!",
  "0.32.0" => "¡Han aparecido refuerzos de las A0%1sF1R!",
  "0.33.0" => "¡A0%1sF0R se retira al A6templo de la espada sagradaR!",
  "0.34.0" => "¡Protege A0%2sF4R del ataque A0%1sF6R!",
  "0.35.0" => "¡Has derrotado A0%1sF4R!",
  "0.36.0" => "¡Las A0%1sF1R han ganado la batalla!",
  "0.37.0" => "¡A0%1sF0R ha huido! ¡No es posible continuar con la batalla!",
  "0.38.0" => "¡Las A0%1sF1R han sido derrotadas!",
  "0.39.0" => "¡Has capturado C2%1sF2R! ¡La A6puerta norteR se ha abierto!",
  "0.40.0" => "¡Has capturado C2%1sF2R! ¡La A6puerta oesteR se ha abierto!",
  "0.41.0" => "¡Has capturado C2%1sF2R! ¡La A6puerta esteR se ha abierto!",
  "0.42.0" => "¡Has capturado C2%1sF2R! ¡La A6puerta surR se ha abierto!",
  "0.43.0" => "¡La derrota A0%1sF6R ha abierto C2%2sF2R!",
  "0.44.0" => "¡La derrota A0%1sF6R ha abierto C2%2sF2R!",
  "0.45.0" => "¡A0%1sF0R y A0%2sF2R se han abierto!",
  "0.46.0" => "¡Protege el avance de las tropas A0%1sF6R!",
  "0.47.0" => "¡A0%1sF0R se aproxima A0%2sF4R!",
  "0.48.0" => "¡Impide que A0%1sF2R, A0%2sF2R y A0%3sF2R huyan!",
  "0.49.0" => "¡Han aparecido refuerzos de las A0%1sF1R en el campo de batalla!",
