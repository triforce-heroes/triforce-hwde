Map {
  "0.0.0" => "L'A0%1sF1R combatte contro A2Re DafnesR e i suoi alleati!",
  "0.1.0" => "Indebolisci A2Re DafnesR e le sue truppe per reclutarli!",
  "0.2.0" => "A0%1sF1R avanzano verso A0%2sF2R!",
  "0.3.0" => "A0%1sF0R si indebolisce e fa indebolire anche A0%2sF3R!",
  "0.4.0" => "A0%1sF0R ha perso e alcune truppe si sono ritirate.",
  "0.5.0" => "A0%1sF0R appare!",
  "0.6.0" => "Il nemico va verso l'area A0%2sF6R!",
  "0.7.0" => "L'A0%1sF1R ha invaso la A1base alleataR!",
  "0.8.0" => "Hai reclutato A0%1sF2R e A0%2sF3R spariscono!",
