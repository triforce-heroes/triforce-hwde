Map {
  "1.0.0.0" => "Pourquoi y a-t-il autant de monstres,
tout à coup ?!",
  "1.0.1.0" => "Ne vous laissez pas décourager !
Nous devons maintenir la paix en Hyrule !",
  "1.0.2.0" => "Il faut protéger la princesse !
Dépêche-toi, Link !",
  "1.0.3.0" => "Il faut combattre ces ennemis pour défendre
Hyrule ! Protégez Son Altesse Zelda à tout prix !",
  "1.0.4.0" => "Ce lézard est vraiment puissant... !",
  "1.0.5.0" => "Commençons par éliminer ce lézard !",
  "1.0.6.0" => "Approchez si vous l'osez !",
  "1.0.7.0" => "Ce jeune garçon, c'est une nouvelle recrue... ?",
  "1.0.8.0" => "Il est fort... !
Mais qui est cette nouvelle recrue ?",
  "1.0.9.0" => "Que ceux qui se pensent assez
forts viennent m'affronter !",
  "1.0.10.0" => "Ne laissez pas ce chevalier dragon aller
plus loin !",
  "1.0.11.0" => "Grrr... Je ne sais pas qui tu es,
mais nous nous reverrons...",
  "1.0.12.0" => "Ces rochers nous gênent. Nous ne pouvons pas
aller aider Son Altesse Zelda... !",
  "1.0.13.0" => "J'en peux plus !
Que quelqu'un vienne m'aider !",
  "1.0.14.0" => "C'est terrible ! Link, allons l'aider !",
  "1.0.15.0" => "Comme ça, ils ne pourront pas entrer !",
  "1.0.16.0" => "Merci de m'avoir aidé ! Pour te remercier,
je voudrais te donner un trésor !",
  "1.0.17.0" => "Notre trésor... Tout ce que je peux faire,
c'est le laisser ici...",
  "1.0.18.0" => "Nous pouvons maintenant détruire ces rochers. Une fois les
portes ouvertes, nous pourrons rejoindre Son Altesse Zelda.",
  "1.0.19.0" => "À l'attaque ! Rapportez-moi la tête
de la princesse d'Hyrule !",
  "1.0.20.0" => "Prenez le fort central et le fort est de la plaine
et verrouillez les portes nord de chacun d'eux !",
  "1.0.21.0" => "Je vais préparer mon plan d'attaque.
Dépêchez-vous de prendre le fort !",
  "1.0.22.0" => "Pas le temps de m'occuper du menu fretin, je dois
commencer les préparatifs de la suite...",
  "1.0.23.0" => "Notre base est attaquée ! Protégez-la à tout prix !",
  "1.0.24.0" => "Bravo ! À présent, prenez le fort est de la plaine !",
  "1.0.25.0" => "Reprenez le fort central !",
  "1.0.26.0" => "Continuons comme ça !
À présent, prenons le fort central !",
  "1.0.27.0" => "Reprenez le fort est de la plaine !",
  "1.0.28.0" => "Nous avons contenu le gros des forces ennemies au
nord ! Il nous faut maintenant l'aide de la grande fée...",
  "1.0.29.0" => "Si nous avions des bombes, nous pourrions
détruire le mur de la fontaine...",
  "1.0.30.0" => "Faites attention ! Les ennemis
nous attaquent depuis le nord !",
  "1.0.31.0" => "Vous avez réussi à passer, c'est pas trop tôt !
Allez vite attaquer le château d'Hyrule au sud !",
  "1.0.32.0" => "Par ici ! Prions la grande fée ensemble !",
  "1.0.33.0" => "Nous avons réussi ! Les troupes ennemies
ont été considérablement réduites !",
  "1.0.34.0" => "Les troupes ennemies ont été un peu réduites !",
  "1.0.35.0" => "Bien ! Lançons la contre-attaque !",
  "1.0.36.0" => "Princesse Zelda, repliez-vous,
nous nous occupons du reste.",
  "1.0.37.0" => "Très bien. Soyez prudents.",
  "1.0.38.0" => "Amusez-vous tant que vous voudrez.
Pendant ce temps, moi...",
  "1.0.39.0" => "Hya ha ha ! Maintenant, on va s'amuser !
Montre-toi, roi dodongo !",
  "1.0.40.0" => "Qu... Qu'est-ce que c'est que ce monstre... ?!",
  "1.0.41.0" => "Nous... Nous... Nous allons l'arrêter !",
  "1.0.42.0" => "Nous... Nous ne pouvons pas
le laisser aller plus loin !",
  "1.0.43.0" => "P... Protégez cet endroit à tout prix ! S'il tombe
aux mains de l'ennemi, c'est la fin !",
  "1.0.44.0" => "Utilisez ceci ! Cela devrait augmenter
la puissance des bombes !",
  "1.0.45.0" => "Nous avons réussi à nous en sortir...
Vous avez fait du bon travail !",
  "1.0.46.0" => "Dame Impa, c'est terrible ! Le mage
ennemi a pris le château !",
  "1.0.47.0" => "Comment ?! Ce monstre n'était qu'un leurre... ?
Son Altesse Zelda est-elle saine et sauve ?!",
  "1.0.48.0" => "Que la lumière brille sur Hyrule...",
  "1.0.49.0" => "Nous avons perdu...",
  "1.0.52.0" => "Hya ha ha ! Attaquez sans relâche !",
  "1.0.55.0" => "Stupide Volga, on ne peut pas compter sur lui...
Envoyez la troupe suivante !",
  "1.0.57.0" => "Si mon plan fonctionne, nous infligerons de
lourds dégâts à l'ennemi ! Vite, à la fontaine !",
  "1.0.58.0" => "Vite, par ici ! Aidez-moi à détruire ce mur !",
  "1.0.59.0" => "Bande de lourdauds, allez au sud !
Attaquez la base de l'armée d'Hyrule !",
  "1.0.60.0" => "Ils ont traversé le fort central !",
  "1.0.61.0" => "Vous l'avez enfin traversé, bons à rien ! Rendez-vous
dans la base de l'armée d'Hyrule et plus vite que ça !",
  "1.0.62.0" => "Ils ont réussi à ouvrir le fort est de la plaine... ?!",
  "1.0.63.0" => "Comment... ?!",
  "1.0.65.0" => "Link, regarde ! C'est la princesse !",
  "1.0.66.0" => "Toi ! Tu étais dans le centre d'entraînement...",
  "1.0.67.0" => "Princesse Zelda ! Vous êtes saine et sauve ? Cette
nouvelle recrue a ouvert le passage avec des bombes.",
  "1.0.68.0" => "Oh, une nouvelle recrue... ?
Toute aide est la bienvenue.",
  "1.0.69.0" => "Un gros rocher nous empêche d'avancer.
Pourrait-on le détruire avec des bombes ?",
  "1.0.70.0" => "Eh... Eh bien... Elle a disparu !",
  "1.0.71.0" => "Comment... ?!",
  "1.0.72.0" => "Nous nous occupons du fort de l'est !
Que quelqu'un se charge du fort central !",
  "1.0.73.0" => "Toi ! Tu étais dans le centre d'entraînement...",
  "1.0.74.0" => "Au secours ! Aidez-moi !
Les monstres m'attaquent !",
  "1.0.75.0" => "Merci ! Je suis la fée Proxie ! Ces monstres m'ont
attaquée tout à coup... Comment tu t'appelles ?",
  "1.0.76.0" => "Link ? C'est bien ça ?... Comment ?
Tu veux protéger Hyrule des monstres ?",
  "1.0.77.0" => "Très bien, alors je vais t'aider ! Je suis sûre
qu'on formera une super équipe tous les deux !",
  "1.0.79.0" => "Prenons le fort ouest de la plaine, si nous en ouvrons
les portes Impa et les autres pourront nous rejoindre.",
  "1.0.80.0" => "Nous avons contenu le gros des forces ennemies au
nord ! Il nous faut maintenant l'aide de la grande fée...",
  "1.0.81.0" => "Je vais aller mettre mon plan à exécution, viens avec
moi à la fontaine de la Déesse, nouvelle recrue !",
  "1.0.82.0" => "Attaquez le château d'Hyrule par le nord !
Ils n'ont pas beaucoup de soldats là-bas !",
  "1.0.83.0" => "Fermez les portes au nord pour
empêcher l'invasion ennemie !",
  "1.0.84.0" => "À vos ordres, je m'en charge !",
  "1.0.85.0" => "Nous avons vaincu les troupes ennemies !
Fermez la passe du rocher !",
  "1.0.86.0" => "Maintenant ! À la fontaine de la Déesse !",
  "1.0.87.0" => "Princesse, par ici !
Prions la grande fée !",
  "1.0.88.0" => "Bien, prions la grande fée !",
  "1.0.89.0" => "Grâce à toi, mon plan a été un succès.
Je te confie ceci.",
  "1.0.90.0" => "C'est dangereux de combattre seul !
Il faut qu'on reste tous unis... !",
  "1.0.91.0" => "J'ai terminé les préparatifs de mon côté.
Fermez vite les portes au nord !",
  "1.0.92.0" => "Oui ! Les forces ennemies ont été
considérablement réduites !",
  "1.0.93.0" => "Les forces ennemies ont été un peu réduites !",
  "1.0.94.0" => "Ce fort est très bien gardé... Cela
cache quelque chose. Prenons-le !",
  "1.0.95.0" => "Donne-moi un coup de main ! Si on l'attaque
ensemble, on peut vaincre ce monstre !",
  "13.0.0.0" => "On va utiliser ça pour détruire les rochers
et rejoindre la princesse Zelda !",
  "13.0.1.0" => "C'est terrible ! Il faut défendre la base !",
  "13.0.2.0" => "Nous devons récupérer le fort central !",
  "13.0.3.0" => "Nous devons récupérer le fort est de la plaine !",
  "13.0.4.0" => "Écoutez-moi tous ! L'ennemi nous attaque
depuis le nord !",
  "13.0.5.0" => "Oh, non ! L'ennemi traverse le fort central !",
  "13.0.6.0" => "Mais qu'est-ce qu'on va faire ?!
L'ennemi traverse le fort est !",
  "13.0.7.0" => "Votre Altesse ! Nous nous chargeons d'eux !",
  "13.0.8.0" => "C'est quoi, ce truc ? Un fantôme ?",
  "13.0.9.0" => "Attention ! Il ne faut pas laisser ce chevalier
dragon aller plus loin !",
  "13.0.10.0" => "Votre Altesse ! Veuillez me pardonner.
Je me suis jetée dans la gueule du loup...",
  "13.0.11.0" => "Il nous suffit juste de repousser l'ennemi d'ici.
Tous avec moi !",
  "13.0.12.0" => "Dame Impa ! Vous allez bien ?",
  "13.0.13.0" => "Tu es une nouvelle recrue... ?",
  "13.0.14.0" => "Votre Altesse ! Prenons le contrôle du fort est et
du fort central et verrouillons leurs portes nord !",
  "13.0.15.0" => "Je vais préparer mon plan d'attaque. Votre Altesse,
veuillez ordonner la prise des forts !",
  "13.0.16.0" => "Nous avons contenu le gros des forces ennemies au
nord ! Il nous faut maintenant l'aide de la grande fée...",
  "13.0.17.0" => "Si mon plan fonctionne, nous infligerons de
lourdes dégâts à l'ennemi ! Vite, à la fontaine !",
  "13.0.18.0" => "Si nous avions des bombes, nous pourrions
détruire les portes de la fontaine...",
  "13.0.19.0" => "Venez vite par ici ! Détruisons les portes et
entrons dans la fontaine !",
  "13.0.20.0" => "Soyez tous très prudents ! L'ennemi nous attaque
depuis le nord !",
  "13.0.21.0" => "L'ennemi a réussi à passer le
fort est de la plaine... ?",
  "13.0.22.0" => "Par ici ! Prions la grande fée
ensemble !",
  "13.0.23.0" => "Nous avons réussi, Votre Altesse ! Les troupes
ennemies ont été considérablement réduites !",
  "13.0.24.0" => "Nous avons réussi, Votre Altesse ! Les troupes
ennemies ont été quelque peu réduites !",
  "13.0.25.0" => "Impa, laisse-moi me charger de cet endroit.
Je veux que tu commandes les troupes à l'arrière.",
  "13.0.26.0" => "Très bien. Bonne chance, Votre Altesse !",
  "13.0.27.0" => "Nous avons survécu... ! C'est grâce à vous
tous. Merci d'avoir combattu à mes côtés !",
  "13.0.28.0" => "Votre Altesse ! C'est terrible !
Le mage ennemi a pris le château !",
  "13.0.29.0" => "Nous devons protéger la paix d'Hyrule !
Link, dépêche-toi !",
  "13.0.30.0" => "Si on utilise ça pour détruire les rochers, on pourra
rejoindre Impa... !",
  "13.0.31.0" => "Votre Altesse ! Utilisez ceci ! Cet objet devrait
augmenter la puissance des bombes !",
  "13.0.32.0" => "Votre Altesse... Pardonnez-moi...",
  "13.0.33.0" => "Ces rochers nous bloquent ! Nous ne pouvons
pas aller aider dame Impa... !",
  "13.0.34.0" => "Link, regarde ! C'est la princesse !",
}