Map {
  "0.0.0" => "Erreiche A0%1sF6R!",
  "0.1.0" => "A0%1sF1R wurden gesichtet! Sie greifen die A2MonsterR an!",
  "0.2.0" => "A0%1sF0R hat sich A0%2sF1R teleportiert!",
  "0.3.0" => "A0%1sF0R ist offen! Der Feind rückt Richtung A0%3sF4R vor!",
  "0.4.0" => "A0%1sF0R wurde geschlossen!",
  "0.5.0" => "A0%1sF0R wurde auf dem Schlachtfeld gesichtet!",
  "0.6.0" => "Besiege A0%1sF6R und öffne A0%2sF6R!",
  "0.7.0" => "A0%1sF0R wurde besiegt! A0%2sF0R ist offen!",
  "0.8.0" => "Du hast A0%1sF6R erreicht!",
  "0.9.0" => "A0%1sF0R will A2MonsterR beschwören!",
  "0.10.0" => "Begib dich schnell A0%1sF1R!",
  "0.11.0" => "A0%1sF0R hat A2MonsterR beschworen!",
  "0.12.0" => "Die A0%1sF1R rücken Richtung A0%2sF4R vor!",
  "0.13.0" => "A0%1sF0R wurde auf dem Schlachtfeld gesichtet!",
  "0.14.0" => "A0%1sF0R rückt auf der Suche nach Futter vor!",
  "0.15.0" => "A2MonstertruppenR sind um A0%1sF6R erschienen!",
  "0.16.0" => "Rette A0%1sF6R!",
  "0.17.0" => "A0%1sF0R hat den A6FutterplatzR erreicht!",
  "0.18.0" => "A0%1sF0R hat gefressen und sich in A0%2sF6R verwandelt!",
  "0.19.0" => "A0%1sF0R ist geflohen!",
  "0.20.0" => "A0%1sF0R hat sich an einen anderen Ort teleportiert!",
  "0.21.0" => "Die Festungen der A0%1sF1R sind offen!",
  "0.22.0" => "A0%1sF1R wurden besiegt!",
  "0.23.0" => "Finde schnell A0%1sF6R!",
  "0.24.0" => "A0%1sF0R wurde erobert! A0%2sF0R ist erschienen!",
  "0.25.0" => "Du hast A0%1sF6R entdeckt!",
  "0.26.0" => "A0%1sF0R wurde erobert!",
  "0.27.0" => "A0%1sF0R ist offen! A2Mächtige MonsterR rücken vor!",
  "0.28.0" => "Die A0%1sF1R rücken vor!",
  "0.29.0" => "A0%1sF0R ist offen! Die A0%2sF1R rücken vor!",
  "0.30.0" => "Die A0%1sF1R rücken vor!",
  "0.31.0" => "A0%1sF0R muss schnell besiegt werden!",
  "0.32.0" => "A0%1sF0R wurde vom Licht des A6KompassR geblendet!",
  "0.33.0" => "A0%1sF0R wurde besiegt!",
  "0.34.0" => "A0%1sF0R hat A0%2sF4R ihren A6KompassR wieder abgenommen!",
  "0.35.0" => "A0%1sF0R ist an die A0%2sF7R gefallen!",
  "0.36.0" => "A0%1sF0R wurde gesichtet und rückt Richtung C2%2sF4R vor!",
  "0.37.0" => "A0%1sF0R scheint einen Schatz zu beherbergen!",
  "0.38.0" => "A0%1sF0R ist nach dem Angriff der A0%2sF5R geflohen!",
  "0.39.0" => "Die A0%1sF1R wurden besiegt!",
  "0.40.0" => "A0%1sF0R ist in Bedrängnis und braucht Hilfe!",
  "0.41.0" => "A0%1sF0R ist in Gefahr und benötigt auf der Stelle Hilfe!",
  "0.42.0" => "A0%1sF0R rückt wieder vor!",
  "0.43.0" => "Besiege A0%1sF6R!",
