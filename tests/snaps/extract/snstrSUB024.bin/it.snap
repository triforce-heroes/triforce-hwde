Map {
  "0.1.0" => "A0%1sF0R appare sul campo di battaglia!",
  "0.2.0" => "A0%1sF0R ha subito ferite nella battaglia con l'A0%2sF1R!",
  "0.3.0" => "A0%1sF0R comincia a ritirarsi verso l'area A0%2sF2R!",
  "0.4.0" => "Scorta A0%1sF2R mentre si ritira ed evita la disfatta!",
  "0.5.0" => "A0%1sF0R fugge dall'A0%2sF7R!",
  "0.6.0" => "Con la sua maledizione, A0%1sF2R ha ridotto la tua energia!",
  "0.7.0" => "A0%1sF0R ha ridotto le tue rupie con la maledizione!",
  "0.8.0" => "A0%1sF0R fa sparire i tuoi oggetti di ripristino con la maledizione!",
  "0.9.0" => "A0%1sF0R fa ritirare parte dell'A0%2sF5R con la maledizione!",
  "0.10.0" => "A0%1sF0R demoralizza l'A0%2sF5R con la maledizione!",
  "0.11.0" => "A0%1sF0R ha raggiunto l'area A0%2sF6R!",
  "0.12.0" => "Hai aiutato A0%1sF2R!",
  "0.13.0" => "Non hai salvato A0%1sF2R!",
  "0.14.0" => "A0%1sF4R appare sul campo di battaglia!",
  "0.15.0" => "Parte dell'A0%1sF5R si ritira per la paura!",
  "0.16.0" => "Sconfiggi A0%1sF2R e annulla la maledizione!",
  "0.17.0" => "A0%1sF0R ha perso! La maledizione è annullata!",
}