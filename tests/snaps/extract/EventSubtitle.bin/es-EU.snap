  "15.33.0" => "Zelda",
  "16.0.0" => "¿Intentabais esconderos?",
  "16.1.0" => "¡Insensatos!",
  "16.2.0" => "Invocante",
  "16.3.0" => "Invocante",
  "17.0.0" => "Los débiles piensan que las espadas lo son
todo, pero solo un necio creería algo así.",
  "17.1.0" => "Arrogancia, ego, orgullo...",
  "17.2.0" => "La oscuridad que alberga tu interior...",
  "17.3.0" => "¡será tu perdición!",
  "17.4.0" => "Cya",
  "17.5.0" => "Cya",
  "17.6.0" => "Cya",
  "17.7.0" => "Cya",
  "18.0.0" => "¡Sé fuerte, Link!",
  "18.1.0" => "Para ser fuerte debes conocer tus puntos débiles.",
  "18.2.0" => "Lana",
  "18.3.0" => "Impa",
  "19.1.0" => "¡Aaaaah!",
  "19.2.0" => "¡Os voy a dar una lección!",
  "19.3.0" => "¡Uuuaaah!",
  "19.4.0" => "¡Cya! ¿Por qué? Qué insensata...",
  "19.5.0" => "Cya",
  "19.6.0" => "Cya",
  "19.7.0" => "Cya",
  "19.8.0" => "Lana",
  "20.0.0" => "Con vuestra ayuda haré realidad mi propósito.",
  "20.1.0" => "¡La Trifuerza será mía!",
  "20.2.0" => "Ganondorf",
  "20.3.0" => "Ganondorf",
  "21.0.0" => "Los tres fragmentos al fin...",
  "21.1.0" => "Je, je, je.",
  "21.2.0" => "¡Mua, ja, ja!",
  "21.3.0" => "Ganondorf",
  "21.4.0" => "Ganondorf",
  "21.5.0" => "Ganondorf",
  "22.0.0" => "¡Concédeme lo que pido!",
  "22.1.0" => "¡Socorro! ¡Que alguien me ayude!",
  "22.2.0" => "Lana",
  "22.3.0" => "Lana",
  "181.0.0" => "¡Jo, jo, jo!",
  "181.1.0" => "Soy la Gran Hada que sirve a la Diosa.
