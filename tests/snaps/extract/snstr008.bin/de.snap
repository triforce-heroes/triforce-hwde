Map {
  "0.0.0" => "Vorsicht! Die A0%1sF3R rücken Richtung A1HauptquartierR vor!",
  "0.2.0" => "Die Moral der A0%1sF5R steigt!",
  "0.3.0" => "Begib dich schnell zur A6Statue der GöttinR!",
  "0.4.0" => "Du hast die A6Statue der GöttinR erreicht!",
  "0.5.0" => "A0%1sF0R wurde auf dem Schlachtfeld gesichtet!",
  "0.7.0" => "A0%1sF0R darf nicht fliehen!",
  "0.8.0" => "A0%1sF0R hat Kürbissuppe erhalten!",
  "0.9.0" => "Rette A0%1sF6R im A6Nordteil der RitterschuleR!",
  "0.10.0" => "A0%1sF0R transportiert die Kürbissuppe!",
  "0.11.0" => "A0%1sF0R hat das A6ZielR erreicht!",
  "0.12.0" => "Der Duft der Kürbissuppe hat A1NarishaR angelockt!",
  "0.13.0" => "A1NarishaR hat den Weg freigemacht!",
  "0.14.0" => "C2%1sF0R und C2%2sF5R sind offen!",
  "0.15.0" => "A0%1sF0R rückt in Richtung A1deines HauptquartiersR vor!",
  "0.16.0" => "A0%1sF0R rückt in Richtung A6Norden der RitterschuleR vor!",
  "0.17.0" => "Besiege A0%1sF6R!",
  "0.18.0" => "Die Bedingungen für eine Niederlage haben sich geändert!",
  "0.19.0" => "A0%1sF0R darf nicht fliehen und A1dein HauptquartierR darf nicht fallen!",
  "0.21.0" => "A0%1sF0R darf nicht fliehen!",
  "0.22.0" => "Besiege schnellstmöglich A0%1sF6R!",
  "0.23.0" => "A0%1sF0R wurde besiegt!",
  "0.27.0" => "Rücke zum A2feindlichen HauptquartierR vor!",
  "0.28.0" => "Die A0%1sF3R rücken gegen A1dein HauptquartierR vor!",
  "0.30.0" => "A0%1sF0R rückt vor!",
  "0.31.0" => "Lebensenergie-Verlust zwang die A0%1sF1R, ihren Vormarsch zu stoppen!",
  "0.32.0" => "Die A0%1sF1R sind erneut auf dem Vormarsch!",
  "0.33.0" => "Aktiviere den A6MagiekreisR C5%1sF3R!",
  "0.34.0" => "Die A0%1sF5R erhalten Verstärkung bei C5%2sF2R!",
  "0.35.0" => "Besiege A0%1sF7R und erreiche C5%2sF6R!",
  "0.36.0" => "C5%1sF0R ist offen!",
  "0.37.0" => "Aktiviere den A6MagiekreisR!",
  "0.39.0" => "Besiege A0%1sF6R!",
  "0.40.0" => "A0%1sF0R darf nicht fliehen!",
  "0.41.0" => "A0%1sF0R wurde besiegt!",
  "0.42.0" => "Die A0%1sF1R haben die Schlacht gewonnen!",
  "0.43.0" => "C1%1sF0R ist an die A0%2sF7R gefallen!",
  "0.44.0" => "Die A0%1sF1R wurden besiegt!",
  "0.45.0" => "A0%1sF0R ist geflohen!",
  "0.47.0" => "A0%1sF0R ist in Bedrängnis!",
  "0.49.0" => "A0%1sF0R wurde gerettet!",
  "0.50.0" => "A0%1sF0R konnte nicht gerettet werden!",
  "0.51.0" => "A6%1sF0R ist offen!",
  "0.52.0" => "A0%1sF0R wurde durch die Macht des Drachenbluts gestärkt!",
  "0.53.0" => "A0%1sF0R rückt vor, um A0%2sF6R aufzuhalten!",
  "0.54.0" => "A0%1sF0R wurde durch den Blitz von A1NarishaR geschwächt!",
  "0.55.0" => "Eskortiere A0%1sF6R!",
  "0.56.0" => "Das A1HauptquartierR darf nicht fallen!",
  "0.57.0" => "Das Drachenblut hat die Energie A0%1sF2R wiederhergestellt!",
  "0.58.0" => "Eine A6SkulltulaR wurde auf dem Schlachtfeld gesichtet!",
  "0.59.0" => "Finde die A6SkulltulaR!",
  "0.60.0" => "Du hast die A6SkulltulaR erlegt!",
  "0.61.0" => "Die A6SkulltulaR wird bald fliehen!",
  "0.62.0" => "Die A6SkulltulaR ist geflohen!",
  "0.63.0" => "A0%1sF0R hat sich vom Schlachtfeld zurückgezogen!",
  "0.64.0" => "Die A0%1sF1R rücken vor!",
  "0.65.0" => "C2%1sF0R ist offen!",
  "0.66.0" => "Die wahre Macht A0%1sF2R wurde entfesselt!",
  "0.67.0" => "A0%1sF0R wurde im A6Nordteil der RitterschuleR gesichtet!",
  "0.68.0" => "Aktiviere schnell den A6MagiekreisR C5%1sF3R!",
  "0.69.0" => "Sichere eine Marschroute für A0%1sF6R!",
  "0.70.0" => "Die A0%1sF7R greifen A0%2sF6R an!",
  "0.71.0" => "A0%1sF0R rückt Richtung C5%2sF4R vor!",
  "0.72.0" => "A0%1sF0R ist A6bei der Statue der GöttinR angekommen!",
  "0.73.0" => "Besiege A0%1sF6R auf dem Weg zum A1HauptquartierR!",
  "0.74.0" => "A0%1sF1R rücken in Richtung A1deines HauptquartiersR vor!",
  "0.75.0" => "A0%1sF1R dürfen A1dein HauptquartierR nicht erreichen!",
  "0.76.0" => "A0%1sF0R hat sich zurückgezogen!",
  "0.77.0" => "Ein Teil der A0%1sF1R rückt gegen A0%2sF6R vor!",
  "0.78.0" => "Die A0%1sF1R haben A0%2sF3R Verstärkung erhalten!",
  "0.79.0" => "Eskortiere A0%1sF6R zur Westklippe!",
  "0.80.0" => "A0%1sF0R muss schnell besiegt werden!",
  "0.81.0" => "A0%1sF1R wurden auf dem Schlachtfeld gesichtet!",
  "0.82.0" => "A0%1sF0R ist offen! A0%2sF1R rücken vor!",
  "0.83.0" => "A0%1sF1R wurden alle besiegt!",
  "0.84.0" => "A0%1sF0R und A0%2sF5R rücken vor!",
  "0.85.0" => "Das A6Nordtor der HügelruineR wurde für die A0%2sF1R geöffnet!",
  "0.86.0" => "A0%1sF0R rückt gegen A0%2sF6R vor!",
  "0.87.0" => "Besiege A0%1sF6R!",
  "0.88.0" => "A0%1sF0R wurde besiegt!",
  "0.89.0" => "A0%1sF0R und A0%2sF5R wurden besiegt!",
  "0.90.0" => "Der Vormarsch A0%2sF2R hat A0%1sF6R geöffnet! ",
  "0.92.0" => "A0%1sF1R wurden besiegt!",
  "0.93.0" => "Der Magiekreis wurde aktiviert!",
  "0.94.0" => "A0%1sF0R hat das Ziel erreicht!",
  "0.95.0" => "A0%1sF0R wurde gesichtet und rückt Richtung C2%2sF4R vor!",
  "0.96.0" => "C2%1sF0R wurde erobert!",
