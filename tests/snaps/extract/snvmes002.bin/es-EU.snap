Map {
  "1.0.0.0" => "¡Dispersad a esos gusanos hylianos!",
  "1.0.1.0" => "Parece que ese hechicero es el líder enemigo.
Si acabamos con él, es posible que ganemos.",
  "1.0.2.0" => "Solo queda ocuparse de ese monstruo.",
  "1.0.3.0" => "Las plantas están lanzando veneno...",
  "1.0.4.0" => "Esa chica parece muy lista. ¡Procura que
el enemigo no se acerque a ella!",
  "1.0.5.0" => "Son babas deku. ¡Si no nos libramos
de ellas, sucumbiremos a su veneno!",
  "1.0.6.0" => "En ese caso, os ayudaré.",
  "1.0.7.0" => "Además de ser venenosas, las plantas
esquivan los ataques directos.",
  "1.0.8.0" => "Si pudiésemos atacar desde cierta distancia,
lograríamos acabar con ellas.",
  "1.0.9.0" => "Si no recuerdo mal, en el extremo sur de
la aldea hay un arco; podrías ir a por él.",
  "1.0.10.0" => "¡Bien hecho! Ahora será mejor acabar también
con las demás.",
  "1.0.11.0" => "El veneno ya no es un problema, ¡menos mal!",
  "1.0.12.0" => "¡Mentecatos! ¡No consentiré que huyáis
con tanta facilidad!",
  "1.0.13.0" => "¡Cercad el árbol y acabad con ellos!",
  "1.0.14.0" => "Todos parecen muy cansados... Será mejor que
vayamos al Gran Árbol Deku.",
  "1.0.15.0" => "¡Yo detendré a los enemigos; vosotros retiraos!",
  "1.0.16.0" => "Así que huyen hacia su base...
¡Cercad el árbol y acabad con ellos!",
  "1.0.17.0" => "Así que se esconden en ese árbol...",
  "1.0.18.0" => "¿Qué hacemos? El enemigo se dirige
al Gran Árbol Deku.",
  "1.0.19.0" => "El Gran Árbol Deku es nuestra base... ¡Debemos
protegerlo a toda costa!",
  "1.0.20.0" => "Primero debemos ocuparnos de los enemigos
que se aproximan por el sur.",
  "1.0.21.0" => "Yo ayudaré a la chica.",
  "1.0.22.0" => "¡Cuidado! Los enemigos amenazan la base
aliada por el norte.",
  "1.0.23.0" => "Al menos el enemigo del sur está fuera
de combate. ¡Vamos a por los demás!",
  "1.0.24.0" => "¡Necesito ayuda!",
  "1.0.25.0" => "Bien, ha llegado el momento de sembrar el caos.",
  "1.0.26.0" => "Si nadie nos ayuda, estamos acabados.",
  "1.0.27.0" => "¡No os rindáis! ¡Estoy llegando!",
  "1.0.28.0" => "¡Bravo, hemos logrado alejar al enemigo!",
  "1.0.29.0" => "Menos mal... Supongo que ahora el Gran Árbol Deku
estará a salvo.",
  "1.0.30.0" => "Disfrutad mientras podáis... Mi nuevo plan
hará que os arrepintáis de haber ganado.",
  "1.0.31.0" => "¡Veo llamas! ¡Hay un incendio!",
  "1.0.32.0" => "¡El Gran Árbol Deku está en peligro!
¿Cómo podemos apagar las llamas?",
  "1.0.33.0" => "¡No hay agua que pueda apagar ese fuego!
Vais a acabar fritos.",
  "1.0.34.0" => "¡Debemos impedir que el Gran Árbol Deku arda!
¿Qué podemos hacer?",
  "1.0.35.0" => "Vaya... Siento la presencia de una Gran Hada.
¡Si nos ayuda, estaremos salvados!",
  "1.0.36.0" => "¡Fuego! ¡Fuego!",
  "1.0.37.0" => "Si no apagamos pronto ese fuego, el Gran Árbol Deku
quedará reducido a cenizas.",
  "1.0.38.0" => "¡Este será vuestro fin!",
  "1.0.40.0" => "Las puertas están cerradas a cal y canto.
¿Cómo podemos abrirlas?",
  "1.0.41.0" => "Poderosa Gran Hada, ¡necesitamos tu fuerza!
Te suplicamos que abras esta puerta.",
  "1.0.42.0" => "¡Las llamas se extinguen! Ahora podremos
enseñarles una lección.",
  "1.0.43.0" => "Ha faltado poco... ¡Gracias, Gran Hada!",
  "1.0.44.0" => "Jamás pensé que mi plan fracasaría.",
  "1.0.45.0" => "¡Es él quien prendió fuego al Gran Árbol Deku!
Nunca podremos perdonárselo...",
  "1.0.46.0" => "Tengo una idea... Haré que él se ocupe de ellos.",
  "1.0.47.0" => "¡El hechicero ha huido!",
  "1.0.49.0" => "¿Qué monstruo es este?",
  "1.0.50.0" => "No es un enemigo normal y corriente...
¡En guardia!",
  "1.0.51.0" => "Parece muy poderoso... ¡Pero no importa!
Tenemos que acabar con él.",
  "1.0.53.0" => "¡Socorro!",
  "1.0.54.0" => "¡No! El monstruo está en el Gran Árbol.
¡Usa la ocarina para volver y protegerlo!",
  "1.0.55.0" => "Todo monstruo tiene un punto débil.",
  "1.0.56.0" => "Tiene un ojo enorme... Quizás si le
disparamos una flecha sirva de algo.",
  "1.0.57.0" => "¡Ha vuelto! No hacía más que recuperar energía.",
  "1.0.58.0" => "Es mejor atacar antes de que se oculte...
Si no, esto no acabará nunca.",
  "1.0.59.0" => "¡Bravo! ¡Lo hemos derrotado!",
  "1.0.60.0" => "¡Fantástico! ¡Hemos vencido al monstruo!",
  "1.0.61.0" => "¡Buen trabajo! Hemos logrado una gran victoria.",
  "1.0.62.0" => "¡El Gran Árbol Deku! Estamos perdidos...",
  "1.0.63.0" => "No hemos podido defenderlo...
Es una pérdida irreparable.",
  "1.0.64.0" => "¡No es posible!",
  "1.0.65.0" => "¡Se acabó el corretear! ¡Ja, ja, ja!",
  "1.0.66.0" => "Rápido, ¡ven a mi fuente!",
  "1.0.67.0" => "Noto la presencia de la Gran Hada.",
  "1.0.68.0" => "Percibo una poderosa presencia en el noreste...
¿Será la Gran Hada?",
  "1.0.69.0" => "¿Aún no has encontrado el arco y las flechas?",
  "1.0.70.0" => "¡Ah, es verdad! El arco debería de estar en
el árbol que hay al suroeste de la aldea.",
  "1.0.71.0" => "Es verdad... Creo que he visto el arco
en el árbol del suroeste de la aldea.",
  "1.0.72.0" => "¡Si no hacemos algo, el Gran Árbol Deku arderá!
Debemos apagar las llamas cuanto antes.",
  "1.0.73.0" => "Aún no hemos apagado el fuego y aparecen más
enemigos... ¿Qué hacemos?",
  "1.0.74.0" => "Otra vez él... Ya no sabe qué hacer para
fastidiarnos.",
  "1.0.75.0" => "Puedes acabar con las plantas venenosas usando
el arco y las flechas. ¿Por qué no lo intentas?",
  "1.0.76.0" => "Debe de saber dónde está la princesa Zelda.
¡Acabaré con él y lo averiguaré!",
  "1.0.77.0" => "¡Demasiado rápido!",
  "1.0.78.0" => "¿Se ha escapado?",
  "1.0.79.0" => "Diría que aún le quedaban fuerzas...",
  "1.0.80.0" => "¡Percibo el poder de la Gran Hada desde aquí!
Acaba con los monstruos y abre la puerta.",
  "1.0.81.0" => "¡El monstruo ha vuelto!",
  "1.0.82.0" => "¡Yo me encargaré de
los enemigos del sur!",
  "1.0.83.0" => "¡Yo me ocupo de los enemigos del sur!",
  "1.0.84.0" => "Cuando venzamos al enemigo del norte,
¡tenemos que ocuparnos del del sur!",
  "1.0.85.0" => "¡Bien! ¡Hemos logrado contener
al enemigo!",
  "1.0.86.0" => "Esos gusanos son más persistentes
de lo que esperaba...",
  "1.0.87.0" => "¡Usad esto, que os resultará muy útil!",
  "1.0.88.0" => "Ya podremos volver a la estatua
siempre que queramos.",
  "1.0.89.0" => "¡Reagrupémonos en torno al monstruo!
¡Juntos acabaremos con él!",
  "13.0.0.0" => "Atacar desde tan cerca no sirve de nada...",
  "13.0.1.0" => "Si no recuerdo mal, en el sur de la aldea
hay un arco. Quizás podríamos usarlo.",
  "13.0.2.0" => "Me suena haber visto un arco cerca del árbol
que hay al suroeste de la aldea.",
  "13.0.3.0" => "¡Bien! El arco es justo lo que necesitábamos.
Acabemos con las babas deku que quedan.",
  "13.0.4.0" => "Ya no tenemos que preocuparnos por el veneno.",
  "13.0.5.0" => "Tenemos que frenar al enemigo para que todos
puedan llegar al Gran Árbol Deku.",
  "13.0.6.0" => "Antes de proseguir, tenemos que detener a
los enemigos que vienen por el sur.",
  "13.0.7.0" => "No podrá hacer esto ella sola...
¡Vamos a ayudarla!",
  "13.0.8.0" => "El enemigo se aproxima al Gran Árbol
Deku; ¡tenemos que hacer algo!",
  "13.0.9.0" => "El enemigo ya no supone una amenaza en
esta zona. ¡Acabemos con los que quedan!",
  "13.0.10.0" => "Los enemigos que hay en esta zona ya no suponen
una amenaza. Ahora solo quedan los de allí...",
  "13.0.11.0" => "Noto la presencia de la Gran Hada...
Si la localizamos, puede que nos ayude.",
  "13.0.12.0" => "Noto una fuerte presencia en el noreste. ¡Creo que
puede ser la Gran Hada!",
  "13.0.13.0" => "El enemigo está atacando el Árbol Deku.
¡Usa la ocarina para protegerlo!",
  "13.0.14.0" => "Puede que el ojo sea su punto débil.
¡Probemos a dispararle con el arco!",
  "13.0.15.0" => "¡El enemigo sigue atacando! Y parece que cada
vez tiene más fuerzas...",
  "13.0.16.0" => "¡Link, trata de centrarte!",
  "13.0.17.0" => "Creo que hemos acabado con ella. Vayamos
a por las babas deku que quedan.",
  "13.0.18.0" => "El enemigo se aproxima al Gran Árbol
Deku; ¡tenemos que hacer algo!",
  "13.0.19.0" => "Puede que acabes con ellas si atacas
desde cierta distancia.",
  "13.0.20.0" => "El arco resulta muy útil contra
las babas deku. ¡Dispárales!",
}