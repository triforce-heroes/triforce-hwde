Map {
  "0.0.0" => "Die A0%1sF1R greifen die A0%2sF7R an!",
  "0.1.0" => "Besiege die A0%1sF3R!",
  "0.2.0" => "Erobere die andere Festung der A0%1sF5R!",
  "0.3.0" => "Die Tore zur A6KristallhöhleR sind offen!",
  "0.4.0" => "Du hast den A6RingR an dich gebracht!",
  "0.5.0" => "Die Siegbedingungen haben sich geändert!",
  "0.6.0" => "Besiege A0%1sF6R!",
  "0.7.0" => "Die Bedingungen für eine Niederlage haben sich geändert!",
  "0.8.0" => "A0%1sF0R darf nicht fliehen und A0%2sF5R darf nicht fallen!",
  "0.9.0" => "Die Tore nach Westen sind offen!",
  "0.10.0" => "Besiege A0%1sF6R!",
  "0.11.0" => "Die A0%1sF5R haben Verstärkung erhalten!",
  "0.12.0" => "A0%1sF0R hat sich vorerst zurückgezogen!",
  "0.13.0" => "A0%1sF1R und A0%2sF7R wurden gesichtet!",
  "0.14.0" => "A0%1sF0R rückt Richtung A0%2sF4R vor!",
  "0.15.0" => "Verhindere, dass A0%1sF5R in die Festung eindringt!",
  "0.16.0" => "A0%1sF0R hat A0%2sF6R erreicht und wird bald explodieren!",
  "0.17.0" => "C1%1sF0R ist wegen der Explosion A0%2sF2R gefallen!",
  "0.18.0" => "Die Moral der A0%1sF1R und der A0%2sF1R steigt!",
  "0.19.0" => "Der Fall C1%2sF2R senkt die Moral der A0%1sF1R!",
  "0.20.0" => "C1%1sF0R ist wegen der Explosion A0%2sF2R gefallen!",
  "0.21.0" => "A0%1sF0R hat schweren Schaden erlitten!",
  "0.22.0" => "Mehrere A0%1sF3R haben schweren Schaden erlitten!",
  "0.23.0" => "A0%1sF0R wurde gestärkt A0%2sF3R gesichtet!",
  "0.24.0" => "Erobere schnell die Festungen der A0%1sF1R!",
  "0.25.0" => "A0%1sF0R kämpft mit A0%2sF4R!",
  "0.26.0" => "A0%1sF0R ist in Bedrängnis und benötigt Unterstützung!",
  "0.27.0" => "A0%1sF0R ist in Gefahr und benötigt auf der Stelle Hilfe!",
  "0.28.0" => "A0%1sF0R und A0%2sF5R wurden besiegt!",
  "0.29.0" => "A0%1sF0R ist offen!",
  "0.30.0" => "Besiege A0%1sF6R!",
  "0.31.0" => "A0%1sF0R wurde gesichtet! Es sind zwei Exemplare!",
  "0.32.0" => "A0%1sF0R im Nordwesten rückt Richtung A0%2sF4R vor!",
  "0.33.0" => "A0%1sF0R hat dich verraten und rückt Richtung A0%2sF4R vor!",
  "0.34.0" => "Besiege A0%1sF6R und A0%2sF6R!",
  "0.35.0" => "A0%1sF0R hat A0%2sF6R erreicht!",
  "0.36.0" => "A0%1sF0R will die A0%2sF7R angreifen!",
  "0.37.0" => "A0%1sF0R wurde besiegt!",
  "0.38.0" => "A0%1sF0R und A0%2sF5R wurden besiegt!",
  "0.39.0" => "A0%1sF0R wendet dunkle Magie auf A0%2sF6R und A0%3sF6R an!",
  "0.40.0" => "C1%1sF0R ist gefallen!",
  "0.41.0" => "Die A0%1sF1R wurden besiegt!",
  "0.42.0" => "A0%1sF0R ist geflohen!",
  "0.43.0" => "Die Einheit A0%1sF2R wurde zerschlagen!",
  "0.44.0" => "Die A0%1sF5R haben Verstärkung erhalten!",
  "0.45.0" => "Das A6Westtor des ZentralplatzesR ist offen!",
  "0.46.0" => "A0%1sF0R darf nicht fallen!",
  "0.47.0" => "Die Moral der A0%1sF1R steigt!",
  "0.48.0" => "A0%1sF0R kämpft mit den A0%2sF1R!",
  "0.49.0" => "Die Festungen der A0%1sF5R wurden erobert!",
  "0.50.0" => "A0%1sF0R darf nicht fallen!",
  "0.51.0" => "Begib dich zur A6KristallhöhleR und finde den A6RingR!",
  "0.52.0" => "Erobere A0%1sF6R, um nach dem A6RingR zu suchen!",
  "0.53.0" => "A0%1sF0R wurde besiegt!",
  "0.54.0" => "Ein A5MagusR wurde gesichtet!",
  "0.55.0" => "Eine A6SkulltulaR wurde auf dem Schlachtfeld gesichtet!",
  "0.56.0" => "Finde die A6SkulltulaR!",
  "0.57.0" => "Du hast die A6SkulltulaR erlegt!",
  "0.58.0" => "Die A6SkulltulaR wird bald fliehen!",
  "0.59.0" => "Die A6SkulltulaR ist geflohen!",
  "0.60.0" => "A0%1sF0R wurde gesichtet und rückt Richtung C2%2sF4R vor!",
  "0.61.0" => "C2%1sF0R wurde erobert!",
  "0.62.0" => "Versammele deine Mitstreiter bei A0%1sF4R!",
  "0.63.0" => "A0%2sF0R kämpft mit den A0%1sF0R!",
  "0.64.0" => "A0%1sF0R wurde gesichtet und rückt Richtung C2%2sF4R vor!",
  "0.65.0" => "A0%1sF0R scheint einen Schatz zu beherbergen!",
  "0.66.0" => "Wenn A0%1sF5R explodiert, fällt die Festung!",
