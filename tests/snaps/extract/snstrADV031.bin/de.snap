  "0.29.0" => "Die A0%1sF1R haben Verstärkung erhalten!",
  "0.30.0" => "A1Dein HauptquartierR ist gefallen! Du hast verloren!",
  "0.31.0" => "Die A0%1sF1R wurden besiegt!",
  "0.32.0" => "A0%1sF0R ist geflohen!",
