  "5.6192.0" => "Motivation! Des ennemis au A6moral d'acierR!",
  "5.6193.0" => "Ne craignez pas les ennemis du Crépuscule!",
  "5.6194.0" => "Solution! Des conseils sur le champ de bataille!",
  "5.6195.0" => "Gare aux voleurs! Un festin des chasseurs!",
  "5.6196.0" => "Imprévu! Une armée d'invocateurs!",
  "5.6197.0" => "Stupeur! Un champ de bataille piégé!",
  "5.6198.0" => "Recrutement! Le cercle s'agrandit!",
  "5.6199.0" => "Travail d'équipe! Méfiez-vous de l'harmonie!",
  "5.6200.0" => "Bâti en une nuit! Le magicien du fort!",
  "5.6201.0" => "Combat! Les détenteurs de la Triforce!",
  "5.6202.0" => "Combat! Les guerriers d'Ocarina of Time!",
  "5.6203.0" => "Combat! Les guerriers de Twilight Princess!",
  "5.6204.0" => "Combat! Les guerriers de Skyward Sword!",
  "5.6205.0" => "Tentation pour les sorcières!",
  "5.6206.0" => "Pétrifiant! Rugissements de monstres géants!",
  "5.6207.0" => "Duel avec le chevalier dragon!",
  "5.6208.0" => "Rancœur! Bienvenue dans la maison des horreurs!",
  "5.6209.0" => "Inexplicable! L'armée des sorciers!",
  "5.6210.0" => "Persuasion! Des rumeurs sur le champ de bataille!",
  "5.6211.0" => "Guerriers embrasés! Attention aux flammes!",
  "5.6212.0" => "Duel! Combat pour l'honneur des épéistes!",
  "5.6213.0" => "Démesure! Combat de titans!",
  "5.6214.0" => "Rapide comme l'éclair! Épreuve de rapidité!",
  "5.6215.0" => "Assaut! Secousses sur le champ de bataille!",
  "5.6216.0" => "Une promenade réconfortante au soleil!",
