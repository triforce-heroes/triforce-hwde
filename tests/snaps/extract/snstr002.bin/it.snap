Map {
  "0.0.0" => "Sono apparse A0%1sF3R!",
  "0.1.0" => "Trova l'A6arcoR nell'area sud del villaggio!",
  "0.2.0" => "Tutte A0%1sF3R sono state sconfitte!",
  "0.3.0" => "Hai sconfitto A0%1sF6R! Ne mancano 4!",
  "0.4.0" => "Hai sconfitto A0%1sF6R! Ne mancano 3!",
  "0.5.0" => "L'A0%1sF1R si ritira nell'area A0%2sF6R!",
  "0.6.0" => "A0%1sF1R vanno verso l'area A0%2sF6R!",
  "0.7.0" => "A0%1sF0R va verso A0%2sF7R!",
  "0.8.0" => "A0%1sF0R va verso A0%2sF7R!",
  "0.9.0" => "A0%1sF1R arrivano da nord! Stai in guardia!",
  "0.10.0" => "A0%1sF0R si infiltra nell'area A0%2sF6R!",
  "0.11.0" => "Il morale di parte dell'A0%1sF1R è peggiorato!",
  "0.12.0" => "L'area A0%1sF4R è stata difesa!",
  "0.13.0" => "A2SciamanR ha A2dato fuocoR all'A0%1sF0R!",
  "0.15.0" => "L'area A0%1sF0R è A2in fiammeR! Corri in soccorso!",
  "0.16.0" => "L'A0%1sF1R ha invaso l'area A0%2sF6R!",
  "0.17.0" => "L'area C5%1sF0R è aperta!",
  "0.18.0" => "Il A6potere del cerchio magicoR ha spento l'incendio all'A0%1sF4R!",
  "0.19.0" => "Sconfiggi A0%1sF2R!",
  "0.20.0" => "A0%1sF0R ha abbandonato il campo di battaglia!",
  "0.21.0" => "A0%1sF0R è in campo!",
  "0.22.0" => "A0%1sF0R attacca l'area A0%2sF6R!",
  "0.24.0" => "L'A0%1sF1R ha vinto la battaglia!",
  "0.25.0" => "L'area C1%1sF0R è stata conquistata dall'A0%2sF7R!",
  "0.26.0" => "L'A0%1sF1R ha perso la battaglia!",
  "0.27.0" => "L'A0%2sF7R ha messo in fuga A0%1sF2R!",
  "0.28.0" => "Vai verso l'area A0%1sF6R!",
  "0.29.0" => "Sconfiggi A0%1sF3R restanti!",
  "0.30.0" => "Trova la A1fata radiosaR!",
  "0.31.0" => "L'area A0%1sF0R è A2in fiammeR! Corri subito in soccorso!",
  "0.32.0" => "L'area A0%1sF2R ha bisogno di essere difesa!",
  "0.33.0" => "L'area A0%1sF4R ha bisogno di rinforzi immediati!",
  "0.34.0" => "Attacca A0%1sF4R nel punto debole!",
  "0.36.0" => "L'area A0%1sF4R non deve cadere!",
  "0.37.0" => "Esplora l'area a nord est!",
  "0.38.0" => "Raggiungi l'area A0%1sF2R!",
  "0.39.0" => "Il A6checkpoint ovestR è aperto!",
  "0.40.0" => "Il A6checkpoint del ponteR e la A2piazza nordR sono aperti!",
  "0.41.0" => "Aiuta A0%2sF2R a ritirarsi nell'area A0%1sF6R!",
  "0.42.0" => "A0%1sF0R va verso l'area A0%2sF6R!",
  "0.44.0" => "A0%1sF0R sferra un feroce attacco sull'area A0%2sF2R!",
  "0.45.0" => "Usa l'A6arcoR per sconfiggere A0%1sF3R!",
  "0.46.0" => "Le aree A0%1sF0R and A0%2sF0R are open to let A0%3sF1R advance!",
  "0.47.0" => "A0%1sF0R va verso l'area A0%2sF6R!",
  "0.48.0" => "La A6%1sF0R è aperta!",
  "0.49.0" => "A0%1sF0R si ritira temporaneamente dall'area A0%2sF2R!",
  "0.50.0" => "A0%1sF0R sta riprendendo le forze!",
  "0.53.0" => "Trova l'A6arcoR nel grande albero a sud ovest.",
  "0.54.0" => "Usa l'A6arcoR per sconfiggere A0%1sF3R!",
