Map {
  "0.0.0" => "Attenzione all'A0%1sF3R che si dirige verso la A1base alleataR!",
  "0.2.0" => "Il morale di parte dell'A0%1sF5R è migliorato!",
  "0.3.0" => "Presto, vai al A6presidio della statua della deaR!",
  "0.4.0" => "Hai raggiunto il A6presidio della statua della deaR!",
  "0.5.0" => "A0%1sF0R scende in campo!",
  "0.7.0" => "Attenzione, A0%1sF2R non deve ritirarsi!",
  "0.8.0" => "A0%1sF0R ha ottenuto una zuppa di zucca.",
  "0.9.0" => "Salva A0%1sF2R nell'A6accademia dei cavalieriR!",
  "0.10.0" => "A0%1sF0R comincia il trasporto della zuppa di zucca!",
  "0.11.0" => "A0%1sF0R ha raggiunto la A6destinazioneR!",
  "0.12.0" => "L'aroma della zuppa di zucca ha fatto apparire A1NarishaR!",
  "0.13.0" => "Le strade si sono collegate grazie al potere di A1NarishaR!",
  "0.14.0" => "Le aree C2%1sF0R e C2%2sF0R sono aperte!",
  "0.15.0" => "A0%1sF0R si dirige verso la A1base alleataR!",
  "0.16.0" => "A0%1sF0R si dirige verso l'A6accademia dei cavalieriR!",
  "0.17.0" => "Sconfiggi A0%1sF2R!",
  "0.18.0" => "Le condizioni di sconfitta sono cambiate!",
  "0.19.0" => "A0%1sF0R perde o la A1base alleataR cade!",
  "0.21.0" => "Attenzione, A0%1sF2R non deve ritirarsi!",
  "0.22.0" => "Presto, sconfiggi A0%1sF2R!",
  "0.23.0" => "A0%1sF0R ha perso!",
  "0.27.0" => "Raggiungi la A2base nemicaR!",
  "0.28.0" => "L'A0%1sF3R si dirige verso la A1base alleataR!",
  "0.30.0" => "A0%1sF0R si mette in marcia!",
  "0.31.0" => "L'A0%1sF1R è troppo debole e si deve fermare!",
  "0.32.0" => "L'A0%1sF1R si può rimettere in marcia!",
  "0.33.0" => "Raggiungi l'area C5%1sF6R e usa il A6cerchio magicoR!",
  "0.34.0" => "Appaiono rinforzi dell'A0%1sF5R davanti all'area C5%2sF6R!",
  "0.35.0" => "Sconfiggi A0%1sF3R e raggiungi l'area C5%2sF6R!",
  "0.36.0" => "L'area C5%1sF0R è aperta!",
  "0.37.0" => "Usa il A6cerchio magicoR!",
  "0.39.0" => "Sconfiggi A0%1sF2R!",
  "0.40.0" => "Attenzione, A0%1sF2R non deve ritirarsi!",
  "0.41.0" => "A0%1sF0R ha perso!",
  "0.42.0" => "L'A0%1sF1R ha vinto la battaglia!",
  "0.43.0" => "L'area C1%1sF0R è stata conquistata dall'A0%2sF7R!",
  "0.44.0" => "L'A0%1sF1R ha perso la battaglia!",
  "0.45.0" => "A0%1sF0R è in fuga!",
  "0.47.0" => "A0%1sF0R è in difficoltà!",
  "0.49.0" => "A0%1sF0R è in salvo!",
  "0.50.0" => "Non hai salvato A0%1sF2R!",
  "0.51.0" => "La A6%1sF0R è aperta!",
  "0.52.0" => "Il sangue di drago rende A0%1sF2R ancora più forte!",
  "0.53.0" => "A0%1sF0R si rimette in marcia per fermare A0%2sF2R!",
  "0.54.0" => "Il fulmine di A1NarishaR ha indebolito A0%1sF0R!",
  "0.55.0" => "Proteggi A0%1sF2R!",
  "0.56.0" => "Impedisci che la A1base alleataR venga conquistata!",
  "0.57.0" => "A0%1sF0R ha ripreso le forze grazie al sangue del drago!",
  "0.58.0" => "Un'A6AracnulaR è stata avvistata sul campo di battaglia!",
  "0.59.0" => "Cerca l'A6AracnulaR!",
  "0.60.0" => "Hai ottenuto l'A6AracnulaR!",
  "0.61.0" => "L'A6AracnulaR sta per fuggire!",
  "0.62.0" => "L'A6AracnulaR è fuggita!",
  "0.63.0" => "A0%1sF0R ha abbandonato la battaglia!",
  "0.64.0" => "L'A0%1sF1R ha cominciato la marcia!",
  "0.65.0" => "L'area C2%1sF0R è aperta!",
  "0.66.0" => "A0%1sF0R è ancora più forte!",
  "0.67.0" => "A0%1sF0R arriva a A6nord dell'accademiaR!",
  "0.68.0" => "Raggiungi l'area C5%1sF6R e usa il A6cerchio magicoR!",
  "0.69.0" => "Assicurati che A0%1sF2R riesca ad avanzare!",
  "0.70.0" => "L'A0%1sF1R attacca A0%2sF2R!",
  "0.71.0" => "A0%1sF0R avanza verso l'area C5%2sF6R!",
  "0.72.0" => "A0%1sF0R arriva A6vicino alla statua della deaR!",
  "0.73.0" => "Sconfiggi A0%1sF3R che si dirigono alla A1base alleataR!",
  "0.74.0" => "A0%1sF1R vanno verso la A1base alleataR!",
  "0.75.0" => "A0%1sF1R non devono raggiungere la A1base alleataR!",
  "0.76.0" => "A0%1sF0R ha abbandonato il campo di battaglia!",
  "0.77.0" => "Parte dell'A0%1sF1R va verso A0%2sF2R!",
  "0.78.0" => "Rinforzi dell'A0%1sF1R appaiono nell'area A0%2sF6R!",
  "0.79.0" => "Scorta A0%1sF2R alla rupe ovest!",
  "0.80.0" => "Presto, sconfiggi A0%1sF2R!",
  "0.81.0" => "A0%1sF1R appaiono!",
  "0.82.0" => "L'area A0%1sF0R è aperta e A0%2sF3R avanzano!",
  "0.83.0" => "Hai sconfitto A0%1sF3R!",
  "0.84.0" => "A0%1sF0R e A0%2sF2R avanzano!",
  "0.85.0" => "L'A6altopiano delle rovineR è aperto e l'A0%2sF1R avanza!",
  "0.86.0" => "A0%1sF0R si mette in marcia verso A0%2sF2R!",
  "0.87.0" => "Sconfiggi A0%1sF2R!",
  "0.88.0" => "Hai sconfitto A0%1sF2R!",
  "0.89.0" => "Hai sconfitto A0%1sF2R e A0%2sF2R!",
  "0.90.0" => "L'area A0%1sF0R è aperta e A0%2sF2R avanza!",
  "0.92.0" => "Hai sconfitto A0%1sF3R!",
  "0.93.0" => "Hai usato il cerchio magico!",
  "0.94.0" => "Hai scortato A0%1sF2R!",
  "0.95.0" => "A0%1sF0R appare e va verso l'area C2%2sF6R!",
  "0.96.0" => "Hai conquistato l'area C2%1sF4R!",
  "0.97.0" => "Nell'area A0%1sF6R si nasconde un tesoro!",
  "0.98.0" => "A0%1sF1R vanno verso la A1base alleataR!",
  "0.99.0" => "A0%2sF1R escono dall'area A0%1sF0R!",
