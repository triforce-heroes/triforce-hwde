  "0.52.0" => "A0%1sF0R und A0%2sF5R wurden besiegt!",
  "0.53.0" => "A0%1sF0R und A0%2sF5R wurden besiegt! Der Kampf wurde gewonnen!",
  "0.54.0" => "C1%1sF0R ist an die A0%2sF7R gefallen!",
