  "0.50.0" => "A0%1sF0R ist in Gefahr!",
  "0.51.0" => "A0%1sF0R hat A0%2sF6R gerettet!",
  "0.52.0" => "A0%1sF0R und A0%2sF5R rücken gegen A0%3sF7R vor!",
  "0.53.0" => "Die Moral A0%1sF2R und A0%2sF2R steigt!",
