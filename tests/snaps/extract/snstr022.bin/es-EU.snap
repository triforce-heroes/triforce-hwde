Map {
  "0.0.0" => "¡Las A0%1sF1R han sido derrotadas!",
  "0.1.0" => "¡Has derrotado A0%1sF4R!",
  "0.2.0" => "¡A0%1sF0R se retira tras dejar A6corazonesR!",
