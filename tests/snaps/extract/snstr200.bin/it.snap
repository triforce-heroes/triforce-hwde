Map {
  "0.0.0" => "L'A0%1sF1R ha vinto la battaglia!",
  "0.1.0" => "L'A0%1sF1R ha perso la battaglia!",
  "0.2.0" => "Sconfiggi A0%1sF2R e A0%2sF2R!",
  "0.3.0" => "L'A0%1sF1R è apparsa!",
  "0.4.0" => "Appaiono rinforzi dell'A0%1sF1R!",
  "0.5.0" => "L'A0%1sF1R si è ritirata!",
  "0.6.0" => "A0%1sF1R avanzano verso l'A1albero DekuR!",
  "0.7.0" => "Le aree A0%1sF0R e A0%2sF0R sono aperte!",
  "0.8.0" => "A0%1sF0R e A0%2sF2R vanno verso l'A1albero DekuR!",
  "0.9.0" => "A0%1sF0R e A0%2sF2R ora sono più forti!",
  "0.10.0" => "Alcuni A6presidiR sono aperti!",
  "0.11.0" => "L'A1albero DekuR è caduto! La battaglia è persa!",
  "0.12.0" => "L'A0%1sF1R lascia in campo A6giare di rifornimentoR!",
  "0.13.0" => "Sconfiggi i A2nemiciR e raccogli A6materialiR!",
  "0.14.0" => "I A2capitani nemiciR sono più forti grazie alla velocità della vittoria.",
  "0.15.0" => "L'A2armata nemicaR ha A2dato fuocoR all'A1albero DekuR!",
  "0.16.0" => "L'A2unità di rifornimento giareR è apparsa!",
  "0.17.0" => "L'A2unità di rifornimento di frammenti di forzaR è apparsa!",
  "0.18.0" => "L'A2unità di rifornimento cuoriR è apparsa!",
  "0.19.0" => "Sconfiggi A2altri 200 nemiciR con la mossa speciale!",
  "0.20.0" => "Sconfiggi A2altri 100 nemiciR con la mossa speciale!",
  "0.21.0" => "Sconfiggi A2altri 50 nemiciR con la mossa speciale!",
  "0.22.0" => "Sconfiggi A2altri 200 nemiciR mentre usi l'incantesimo!",
  "0.23.0" => "Sconfiggi A2altri 100 nemiciR mentre usi l'incantesimo!",
  "0.24.0" => "Sconfiggi A2altri 50 nemiciR mentre usi l'incantesimo!",
  "0.25.0" => "Ancora A2300 nemiciR!",
  "0.26.0" => "Ancora A2200 nemiciR!",
  "0.27.0" => "Ancora A2100 nemiciR!",
  "0.28.0" => "In alcuni A6presidiR ci sono A6giare della mossa specialeR!",
  "0.29.0" => "In alcuni A6presidiR ci sono A6giare magicheR!",
  "0.30.0" => "A0%1sF0R e A0%2sF2R sono più deboli senza i A2capitaniR!",
  "0.31.0" => "Sconfiggi i A2capitani nemiciR per indebolire A0%1sF2R e A0%2sF2R!",
  "0.32.0" => "A0%1sF0R ha raggiunto l'A1albero DekuR!",
  "0.33.0" => "A0%1sF0R e A0%2sF2R appaiono e sono più forti che mai!",
  "0.34.0" => "Sconfiggi i A2nemiciR intorno all'A1albero DekuR!",
  "0.35.0" => "A0%1sF0R assale A0%2sF6R!",
  "0.36.0" => "Prima prova!",
  "0.37.0" => "Prova della mossa speciale!",
  "0.38.0" => "Prova dell'incantesimo!",
  "0.39.0" => "Prova finale!",
  "0.40.0" => "Il A6livello di sfidaR è aumentato in base al risultato della prova!",
  "0.41.0" => "I A2capitani nemiciR sono diventati più forti!",
  "0.42.0" => "Alcuni A2capitani nemiciR sono diventati più forti!",
  "0.43.0" => "L'A0%1sF1R comincia ad avanzare verso l'A1albero DekuR!",
  "0.44.0" => "L'A2unità di rifornimento giareR si è ritirata!",
  "0.45.0" => "L'A2unità di rifornimento di frammenti di forzaR si è ritirata!",
  "0.46.0" => "L'A2unità di rifornimento cuoriR si è ritirata!",
  "0.47.0" => "A6Grado AR completo!",
  "0.48.0" => "A6Grado BR completo!",
  "0.49.0" => "A6Grado CR completo!",
  "0.50.0" => "L'A2unità di rifornimento di frammenti di forzaR si ritira tra due minuti!",
  "0.51.0" => "Attenzione, l'A2unità di rifornimento giareR si ritirerà tra un minuto!",
  "0.52.0" => "Hai ottenuto un grado alto! Appaiono le A2truppe bottinoR!",
  "0.53.0" => "Risultato della prova!",
  "0.54.0" => "A0%1sF0R e A0%2sF2R cominciano ad attaccare A0%3sF2R!",
  "0.55.0" => "Sconfiggi A0%1sF2R e A0%2sF2R ora che sono deboli!",
  "0.56.0" => "È apparsa una A2Deku babaR!",
  "0.57.0" => "Attenzione, le A2Deku babaR appaiono ogni minuto!",
  "0.58.0" => "L'occasione per raccogliere A6materiali demoniaciR! Sconfiggi i A2nemiciR!",
