Map {
  "1.0.0.0" => "Woah, il y a tellement de portes des âmes...
Il faut qu'on les referme au plus vite!",
  "1.0.1.0" => "Faites attention! Des monstres bizarres
gardent les portes des âmes!",
  "1.0.2.0" => "Je parie que ces monstres sont contrôlés par
les portes! Si on les bat, elles se fermeront!",
  "1.0.3.0" => "Affrontez les ennemis au nord du désert!
On les empêchera de traverser le pont!",
  "1.0.4.0" => "L'ennemi nous submerge!
On ne tiendra pas longtemps!",
  "1.0.5.0" => "Comme prévu! En éliminant ces monstres,
on a pu fermer les portes. Bon travail!",
  "1.0.6.0" => "Qu'est-ce que c'était! Wooooooah!
Un énorme oiseau vient de filer dans le ciel!",
  "1.0.7.0" => "Il cherche probablement un nid, mais peu
importe... On a des problèmes plus urgents!",
  "1.0.8.0" => "Profitez-en pour vous enfuir
pendant qu'il se repose!",
  "1.0.9.0" => "Hein?! Mais qui es-tu?",
  "1.0.10.0" => "Je me suis fait pousser des ailes et j'ai atterri
ici... Pfff! L'oiseau m'a enlevée, évidemment...",
  "1.0.11.0" => "Oups! Il s'est réveillé et on dirait qu'il m'a
remarquée... Je peux avoir un peu d'aide?",
  "1.0.12.0" => "Je n'ai pas tout compris, mais oui,
je peux t'aider.",
  "1.0.13.0" => "C'est horrible, grand frère! L'oiseau
attaque Tetra! Il faut aller l'aider!",
  "1.0.14.0" => "Link! Il faut qu'on chasse cet oiseau,
le roi Cuirasse! Tu peux nous aider?",
  "1.0.15.0" => "Pfiou! Contente qu'on en soit débarrassés...
Enfin pour l'instant au moins...",
  "1.0.16.0" => "Kah! Que venez-vous faire isssi?
Disssparaisssez!",
  "1.0.17.0" => "On s'est fait repérer par l'homme
lézard. Il va falloir se battre...",
  "1.0.18.0" => "Voilà! Ça devrait être plus
calme ici maintenant!",
  "1.0.19.0" => "Il faut que je ferme la porte des âmes!",
  "1.0.20.0" => "Kah! Anéantisssez leur base!
Et faites les sssouffrir!",
  "1.0.21.0" => "Ils sssont... trop forts...",
  "1.0.22.0" => "On devrait être tranquilles pour
un moment. Bonne nouvelle!",
  "1.0.23.0" => "Maintenant, allons secourir cet enfant!",
  "1.0.24.0" => "Hya? L'oiseau ssse bat contre
les humains? Sss'est bizarre!",
  "1.0.25.0" => "Profitons-en! Chasssez ssses
sssales humains!",
  "1.0.26.0" => "Les monstres du désert prennent de
l'assurance. Méfiez-vous!",
  "1.0.27.0" => "Je crois qu'ils essaient d'utiliser
l'oiseau géant pour nous chasser!",
  "1.0.28.0" => "Espèce d'oiseau déplumé... Tu vas payer
pour tout le mal que tu nous as fait!",
  "1.0.29.0" => "Génial... On dirait que l'oiseau s'est reposé...
Exactement ce dont on avait besoin...",
  "1.0.30.0" => "On devrait prendre le fort qu'il utilise comme
nid! Ça l'empêchera de se reposer!",
  "1.0.31.0" => "Avec ça, il ne devrait plus
être capable de s'enfuir.",
  "1.0.32.0" => "Hya! Allez-vous-en, misérables humains!",
  "1.0.33.0" => "Cette petite sieste a fait des merveilles!
L'oiseau géant est plus déchaîné que jamais!",
  "1.0.34.0" => "Il est un peu trop sûr de lui!
Dépêchez-vous, allez lui voler son nid!",
  "1.0.35.0" => "Il est vraiment très dangereux...
Nous devons prendre son nid!",
  "1.0.36.0" => "J'avais raison. Maintenant qu'on a pris
son nid, il n'a plus nulle part où s'enfuir!",
  "1.0.37.0" => "On va enfin pouvoir souffler un peu!",
  "1.0.38.0" => "Ne vous relâchez pas! Tous ces
changements n'ont pas l'air terminés.",
  "1.0.39.0" => "Hum... Nous n'avons pas appris grand
chose ici, mais nous devons trouver Cya.",
  "1.0.40.0" => "Non! Ils ont pris notre base...
Nous avons perdu la bataille.",
  "1.0.41.0" => "Les monstres du désert sont devenus
fous à cause de l'oieau. Il faut les calmer!",
  "1.0.42.0" => "Allons-y alors!",
  "1.0.43.0" => "Il est temps qu'il paye
pour ce qu'il a fait!",
  "1.0.44.0" => "Cet oiseau m'a donc amenée au beau
milieu de ce désert? Gentil de sa part!",
  "1.0.45.0" => "Il ne reste plus que l'oiseau! Sers-toi de
ta magie pour nous en débarrasser, Lana!",
  "1.0.46.0" => "Je crois que tu as encore quelque chose
à faire, je me trompe?",
  "1.0.47.0" => "Il faut vite retourner à la base,
elle ne va pas tenir longtemps!",
}