Map {
  "1.0.0.0" => "Sie verschanzen sich also in ihrem Schloss.
Ich bezweifle, dass ihnen das helfen wird.",
  "1.0.1.0" => "Ich werde die Prinzessin und ihren „Helden“
besiegen und das Triforce wird mir gehören!",
  "1.0.2.0" => "Dieses Schloss ist unsere letzte Bastion...
Wir müssen diesen Kampf gewinnen!",
  "1.0.3.0" => "Wir müssen Ganondorfs Hauptquartier erobern,
wenn wir eine Chance haben wollen!",
  "1.0.4.0" => "Ich werde das Nordtor öffnen und eine
Route für unseren Vormarsch sichern.",
  "1.0.5.0" => "Sie greifen das Nordtor an. Zanto
ist nun unser vorrangiges Ziel!",
  "1.0.6.0" => "Jawohl, Euer Hoheit!",
  "1.0.7.0" => "Sie haben unseren Plan bereits durchschaut.
Wir dürfen die Prinzessin nicht unterschätzen.",
  "1.0.8.0" => "Die Menschlein wirken sehr motiviert. Und mit
jedem besiegten Monster wird es schlimmer...",
  "1.0.9.0" => "Es macht keinen Unterschied. Nichts
wird mich jetzt noch aufhalten!",
  "1.0.10.0" => "Wir haben einen echten Helden auf unserer
Seite! Wir werden siegen! Stimmt doch, Link?",
  "1.0.11.0" => "In welcher Zeit ich auch erscheine, immer
stellt sich mir dieser „Held“ in den Weg...",
  "1.0.12.0" => "Übernimm dich nicht, Link! Zieh dich
kurz zurück und erhole dich!",
  "1.0.13.0" => "Ein geschickter Schachzug,
den Helden zurückziehen...",
  "1.0.14.0" => "Link kommt wieder, sobald er
neue Kraft geschöpft hat!",
  "1.0.15.0" => "Ich habe meine Aufgabe erfüllt.
Der Weg ist frei.",
  "1.0.16.0" => "Einer ihrer stärksten Kämpfer ist besiegt!
Das müssen wir ausnutzen!",
  "1.0.17.0" => "Denkt ihr, es interessiert mich, dass ihr
jemanden wie Zanto besiegt habt?",
  "1.0.18.0" => "Mit der Macht der Großen Fee können
wir den Kampf noch für uns entscheiden!",
  "1.0.19.0" => "Sie darf die Quelle nicht erreichen! Die
Große Fee könnte alles ruinieren...",
  "1.0.20.0" => "Ich halte sie auf.",
  "1.0.21.0" => "Das führt zu nichts. Ignorieren wir
Ghirahim, die Quelle ist wichtiger!",
  "1.0.22.0" => "W-w-wir haben es geschafft!
Wir haben Ghirahim besiegt!",
  "1.0.23.0" => "Diese erbärmlichen Menschlein
werden ihre Arroganz noch bereuen!",
  "1.0.24.0" => "Wir müssen die Magie vereinen, um das
feindliche Hauptquartier zu zerstören.",
  "1.0.25.0" => "Wir brauchen etwas Zeit, um
genügend Magie zu sammeln...",
  "1.0.26.0" => "Gut... Das ist eine Menge Energie...",
  "1.0.27.0" => "Das ist genug! Und jetzt auf sie!",
  "1.0.28.0" => "Zu schade...",
  "1.0.29.0" => "Impa! Das kann nicht sein!",
  "1.0.30.0" => "Los, Link! Wir müssen
diesen Kampf gewinnen!",
  "1.0.31.0" => "Link ist zurück! Wir greifen
auf ganzer Front an!",
  "1.0.32.0" => "Vorwärts, Link!",
  "1.0.33.0" => "Wie zuvorkommend, dass sie sich gemeinsam
zeigen. Ich hole mir jetzt das Triforce.",
  "1.0.34.0" => "Haltet sie auf! Wir müssen
Prinzessin Zelda beschützen!",
  "1.0.35.0" => "Ich kümmere mich um das Bürschchen.",
  "1.0.36.0" => "Dann bleibt mir die Prinzessin.",
  "1.0.37.0" => "Nein... Wir dürfen nicht aufgeben...",
  "1.0.38.0" => "Und jetzt den Helden!",
  "1.0.39.0" => "Link, wach auf! Wach doch auf! Link!",
  "1.0.40.0" => "Dieser Kampf scheint mir
so gut wie beendet.",
  "1.0.41.0" => "Und jetzt die Prinzessin!",
  "1.0.42.0" => "Link setzt sein Leben aufs Spiel!
Ich werde nicht tatenlos zusehen!",
  "1.0.43.0" => "Sieh nur, wie entschlossen die Prinzessin
kämpft! Wir sollten uns ein Beispiel nehmen!",
  "1.0.44.0" => "Sture Narren... Wenn ich euch beide
besiegen muss, dann soll es so sein.",
  "1.0.45.0" => "N-n-nein, ich gebe nicht auf!",
  "1.0.46.0" => "Sieh dich doch an. Du bist geschlagen.
Was willst du noch ausrichten?",
  "1.0.47.0" => "Gib nicht auf, Link!",
  "1.0.48.0" => "Ihr könnt mich so oft angreifen, wie
ihr wollt! Mein Sieg ist unvermeidlich!",
  "1.0.49.0" => "Link schafft es nicht allein!",
  "1.0.50.0" => "Wir müssen die Prinzessin retten, Link!",
  "1.0.51.0" => "Ich werde das Böse mit der Macht des
Triforce in mir aus dieser Festung jagen!",
  "1.0.52.0" => "Wir können es nicht länger aufschieben.
Ich gehe zu Ganondorfs Hauptquartier.",
  "1.0.53.0" => "Mit dem Triforce des Mutes kannst du
die böse Macht dort austreiben, Link!",
  "1.0.54.0" => "Wir haben keine Zeit zu verlieren! Machen
wir uns auf den Weg zu ihrem Hauptquartier!",
  "1.0.55.0" => "Wenn wir diese Festung erobern,
können wir gewinnen!",
  "1.0.56.0" => "Mit der Macht des Triforce werde ich
das Böse aus dieser Festung verjagen!",
  "1.0.57.0" => "Das ist ihr Hauptquartier! Wenn wir es
erobern, können wir noch siegen!",
  "1.0.58.0" => "Setze das Triforce ein und lösche
die dunkle Macht aus, Link!",
  "1.0.59.0" => "Argh... Die Macht des Triforce... Wir
müssen etwas dagegen unternehmen!",
  "1.0.60.0" => "Wenn wir sie nicht schnell besiegen,
wird unser Hauptquartier fallen.",
  "1.0.61.0" => "Bei meiner Ehre, ich werde mich von diesen
Ungeheuern nicht besiegen lassen!",
  "1.0.62.0" => "Wir werden unser Hyrule beschützen!",
  "1.0.63.0" => "Was soll das werden?
Beschützt das Hauptquartier!",
  "1.0.64.0" => "Endlich halte ich alle Teile des
Triforce in meinen Händen!",
  "1.0.65.0" => "Elende Narren... Ihr habt nur etwas
Zeit gewonnen, den Krieg gewinne ich!",
  "1.0.66.0" => "Es sieht nicht gut für uns aus...
Ich muss etwas tun!",
  "1.0.67.0" => "Ich werde ebenfalls vorrücken!
Alle Truppen zum Angriff!",
  "1.0.68.0" => "Keine Zeit für weiche Knie!
Schlagen wir sie zurück!",
  "1.0.69.0" => "Überlasst mir das Kleinvieh!",
  "1.0.70.0" => "Hahaha! Die Feinde im Norden sind isoliert!",
  "1.0.71.0" => "Die Feinde zittern vor uns! Wenn wir jetzt
nicht nachlassen, gehört ihr Hauptquartier uns!",
  "1.0.72.0" => "Wenn ihr euch mal nicht überschätzt...
Wir zeigen euch eure Schranken auf!",
  "13.0.0.0" => "Menschen haben so viel... Kampfgeist!",
  "13.0.1.0" => "Der kleine Held... Wenn wir ihn aus dem Weg
räumen, werden unsere Feinde verzweifeln!",
  "13.0.2.0" => "Es ist noch nicht vorbei! Sobald Links Wunden
verheilt sind, kommen wir wieder!",
  "13.0.3.0" => "Wollt ihr mich etwa an der Nase herumführen?!
...Sie dürfen die Quelle nicht erreichen!",
}