Map {
  "1.0.0.0" => "So viele Seelenportale... Wir müssen sie schließen,
sonst kommen immer mehr Monster hindurch!",
  "1.0.1.0" => "Vorsicht, die Portale werden von
seltsamen Monstern bewacht!",
  "1.0.2.0" => "Da besteht sicher eine Verbindung... Wenn wir sie
besiegen, schließen sich vielleicht die Portale!",
  "1.0.3.0" => "Kümmere du dich um die Feinde im Norden,
wir passen auf die Brücke im Osten auf!",
  "1.0.4.0" => "Es kommen einfach immer mehr!
Wir sind erledigt!",
  "1.0.5.0" => "Wie ich's mir dachte. Besiegen wir die
Monster, schließen sich die Seelenportale!",
  "1.0.6.0" => "Wo kommt dieser riesige
Vogel plötzlich her?",
  "1.0.7.0" => "Er sucht wahrscheinlich nur einen
Nistplatz. Wir haben größere Probleme!",
  "1.0.8.0" => "Solange der Vogel sich ausruht,
sollte ich verschwinden!",
  "1.0.9.0" => "Wer bist denn du?",
  "1.0.10.0" => "Mein Name ist Tetra. Dieser Vogel...
Der Maskenkönig hat mich entführt!",
  "1.0.11.0" => "Oje! Er hat wohl gemerkt, dass ich
weggelaufen bin. Etwas Hilfe wäre nett!",
  "1.0.12.0" => "Ich verstehe nicht ganz, was los ist,
aber ich werde dir helfen!",
  "1.0.13.0" => "Tetra wird von diesem Riesenvogel
angegriffen! Wir müssen sie retten!",
  "1.0.14.0" => "Link! Wir müssen den Vogel verjagen!
Kannst du uns helfen?",
  "1.0.15.0" => "Zum Glück ist das erst mal vorbei...",
  "1.0.16.0" => "Diessse Würmer!
Wir werden sssie zerquetssschen!",
  "1.0.17.0" => "Sie haben uns entdeckt.
Das bedeutet wohl wieder Ärger!",
  "1.0.18.0" => "Das Gebiet sollte jetzt
einigermaßen gesichert sein.",
  "1.0.19.0" => "Ich muss das Seelenportal schließen!",
  "1.0.20.0" => "Zerssstört ihr Hauptquartier!
Macht sssie fertig!",
  "1.0.21.0" => "Sssie sssind ssso ssstark...",
  "1.0.22.0" => "Jetzt sollten eine Weile keine neuen
Monster mehr auftauchen...",
  "1.0.23.0" => "Jetzt lasst uns das Mädchen retten!",
  "1.0.24.0" => "Wasss? Der Vogel kämpft gegen
die Warmblüter?",
  "1.0.25.0" => "Dasss issst die Gelegenheit!
Fegt sssie hinweg!",
  "1.0.26.0" => "Die Monster der Wüste werden
aufmüpfig!",
  "1.0.27.0" => "Sie scheinen den Maskenkönig gegen
uns einsetzen zu wollen!",
  "1.0.28.0" => "Dieser elende Vogel... Zahlen wir ihm all
den Ärger heim, den er verursacht hat!",
  "1.0.29.0" => "Toll. Es scheint diesem Geier schon wieder
besser zu gehen. Das hat uns noch gefehlt.",
  "1.0.30.0" => "Wir sollten die Festung erobern,
in der er nistet!",
  "1.0.31.0" => "Jetzt kann er nicht mehr entkommen!",
  "1.0.32.0" => "Verssschwindet!",
  "1.0.33.0" => "Oje! Das Nickerchen scheint dem
Vogel gutgetan zu haben.",
  "1.0.34.0" => "Dieser Vogel... Schnell, nehmen
wir ihm sein Nest!",
  "1.0.35.0" => "Wir müssen ihm sein Nest
wegnehmen!",
  "1.0.36.0" => "Ohne Nest kann er nicht mehr
abhauen!",
  "1.0.37.0" => "Endlich Ruhe!",
  "1.0.38.0" => "Schön wär's! Leider gibt es da noch
diesen klitzekleinen Dimensionsriss...",
  "1.0.39.0" => "Ja... Wir müssen noch
immer Cia finden!",
  "1.0.40.0" => "Unser Hauptquartier!
Das ist unser Untergang...",
  "1.0.41.0" => "Der Maskenkönig macht alle Monster
verrückt! Wir müssen was tun!",
  "1.0.42.0" => "Dann los!",
  "1.0.43.0" => "Jetzt wird abgerechnet!",
  "1.0.44.0" => "Der Vogel hat vielleicht Nerven, mich
in die Wüste zu verschleppen...",
  "1.0.45.0" => "Bleibt nur noch dieser Vogel! Mit Lanas
Magie können wir ihn besiegen!",
  "1.0.46.0" => "Und hattet ihr hier nicht auch
noch irgendwas zu erledigen?",
  "1.0.47.0" => "Wenn wir uns nicht sofort um unser
Hauptquartier kümmern, wird es fallen!",
}