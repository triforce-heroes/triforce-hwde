Map {
  "0.0.0" => "Scopri come distruggere i A6mostri di pietraR!",
  "0.1.0" => "L'A0%1sF1R e il A5rapace regaleR combattono!",
  "0.2.0" => "Hai conquistato l'area C2%1sF4R!",
  "0.3.0" => "Trova il A6tesoroR in fondo al passaggio!",
  "0.4.0" => "A0%1sF1R hanno perso!",
  "0.5.0" => "La A6sala nascosta dell'Isola TauraR è chiusa!",
  "0.6.0" => "La A6sala nascosta dell'Isola TauraR è aperta!",
  "0.7.0" => "Parte dell'A0%1sF5R va verso l'A6Isola TauraR!",
  "0.8.0" => "L'A0%1sF5R fa scappare il A5rapace regaleR!",
  "0.9.0" => "Il A5rapace regaleR riappare sull'A6Isola StellaR!",
  "0.10.0" => "A0%1sF0R si ritira temporaneamente!",
  "0.11.0" => "A0%1sF0R riappare all'A6Isola OrmaR!!",
  "0.12.0" => "A0%1sF0R riappare all'A6Isola del DragoR!",
  "0.13.0" => "A0%1sF0R riappare all'A6Oasi FataR!",
  "0.14.0" => "A0%1sF0R riappare sull'A6Isola StellaR!",
  "0.15.0" => "Hai distrutto il A6mostro di pietraR!",
  "0.16.0" => "La A6strada è apertaR! L'A0%1sF5R avanza!",
  "0.17.0" => "Hai distrutto tutti i A6mostri di pietraR!",
  "0.18.0" => "L'area C2%1sF0R è aperta!",
  "0.19.0" => "I rinforzi dall'area C2%1sF0R si sono fermati!",
  "0.20.0" => "Conquista gli altri A2presidi d'entrata della fortezza dei demoniR!",
  "0.21.0" => "Hai conquistato tutti i A2presidi d'entrata della fortezzaR!",
  "0.22.0" => "Hai fermato i rinforzi dai A2presidi d'entrata della fortezzaR!",
  "0.23.0" => "A0%1sF0R ha evocato A0%2sF2R sull'A6Isola OrmaR!",
  "0.24.0" => "A0%1sF0R va verso l'area A0%2sF6R!",
  "0.25.0" => "Le condizioni di vittoria sono cambiate!",
  "0.26.0" => "Sconfiggi A0%1sF2R e A0%2sF2R!",
  "0.27.0" => "Le aree C2%1sF0R e C2%2sF0R sono aperte!",
  "0.28.0" => "Tutta l'A0%1sF3R va verso l'area A0%2sF0R!",
  "0.29.0" => "A0%1sF0R attacca l'A6Isola TauraR in volo!",
  "0.30.0" => "Sconfiggi A0%1sF2R al più presto!",
  "0.31.0" => "A0%1sF0R ha abbandonato il campo di battaglia!",
  "0.32.0" => "A0%1sF0R ha abbandonato il campo di battaglia!",
  "0.33.0" => "A0%1sF0R incoraggia l'A0%2sF5R!",
  "0.34.0" => "Sconfiggi A0%1sF2R!",
  "0.35.0" => "Hai sconfitto A0%1sF2R!",
  "0.36.0" => "L'area C1%1sF0R si è arresa all'A0%2sF7R!",
  "0.37.0" => "L'A0%1sF1R ha perso la battaglia!",
  "0.38.0" => "A0%1sF0R è in fuga!",
  "0.39.0" => "Un'A6AracnulaR è stata avvistata sul campo di battaglia!",
  "0.40.0" => "Hai ottenuto un'A6AracnulaR!",
  "0.41.0" => "L'A6AracnulaR è fuggita!",
  "0.42.0" => "Hai sconfitto A0%1sF2R!",
  "0.43.0" => "Il morale di parte dell'A0%1sF1R è migliorato!",
  "0.44.0" => "L'A0%1sF1R si demoralizza dopo la sconfitta del capo!",
  "0.45.0" => "Alcuni A2presidi d'entrata della fortezza dei demoniR sono aperti!",
  "0.46.0" => "A0%1sF0R appare nell'area C2%2sF6R!",
