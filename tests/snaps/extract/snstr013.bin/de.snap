Map {
  "0.0.0" => "Begib dich zur A6MonstersiedlungR!",
  "0.1.0" => "C2%1sF0R und C2%2sF5R sind offen!",
  "0.2.0" => "Die A0%1sF1R rücken gegen die A0%2sF3R vor!",
  "0.3.0" => "Die A0%1sF1R haben C2%2sF6R erobert!",
  "0.4.0" => "Erobere C2%1sF6R, C2%2sF6R und C2%3sF6R!",
  "0.6.0" => "Erobere C2%2sF6R von den A0%1sF7R zurück!",
  "0.7.0" => "Der A6Osteingang der SiedlungR ist offen!",
  "0.8.0" => "Erobere C2%1sF6R und C2%2sF6R!",
  "0.9.0" => "Erobere als Nächstes C2%1sF6R!",
  "0.10.0" => "Alle Festungen der A6SiedlungR wurden erobert!",
  "0.11.0" => "A0%1sF0R hat C2%2sF6R erreicht!",
  "0.12.0" => "Der A6Eingang zur WüstenburgR ist offen!",
  "0.13.0" => "Begib dich zur A6WüstenburgR!",
  "0.14.0" => "Ein A6KerkerR wurde entdeckt!",
  "0.15.0" => "A6%1sF0R ist offen!",
  "0.16.0" => "Die A5NimbusgardeR hat sich den A0%1sF1R angeschlossen!",
  "0.17.0" => "A0%1sF0R wurde auf dem Schlachtfeld gesichtet!",
  "0.18.0" => "A0%1sF0R rückt gegen A0%2sF6R vor!",
  "0.19.0" => "Besiege schnellstmöglich A0%1sF7R!",
  "0.20.0" => "Die Niederlage A0%3sF3R hebt die Moral A0%1sF2R und A0%2sF2R!",
  "0.21.0" => "A0%1sF0R wurde besiegt!",
  "0.22.0" => "A0%1sF0R und A0%2sF5R wurden auf dem Schlachtfeld gesichtet!",
  "0.23.0" => "C2%1sF0R wurde erobert und ist offen!",
  "0.24.0" => "Die Siegbedingungen haben sich geändert!",
  "0.25.0" => "Besiege alle A2RiesenmonsterR!",
  "0.26.0" => "Die Begegnung mit A0%2sF4R hebt die Moral A0%1sF2R!",
  "0.27.0" => "Die Begegnung mit A0%2sF4R hat A0%1sF6R stärker gemacht!",
  "0.28.0" => "A0%1sF0R wurde besiegt!",
  "0.29.0" => "Besiege auch A0%1sF6R und A0%2sF6R!",
  "0.30.0" => "Alle A2RiesenmonsterR wurden besiegt!",
  "0.31.0" => "A0%1sF0R ist in Gefahr!",
  "0.32.0" => "A0%1sF0R ist geflohen!",
  "0.33.0" => "A0%2sF0R ist geflohen! Die Moral der A0%1sF1R steigt!",
  "0.34.0" => "A0%2sF0R ist geflohen! Die A0%1sF1R sind stärker geworden!",
  "0.35.0" => "Die A0%1sF1R haben die Schlacht gewonnen!",
  "0.36.0" => "Die A0%1sF1R wurden besiegt!",
  "0.37.0" => "C1%2sF0R wurde von den A0%1sF1R erobert!",
  "0.38.0" => "Besiege auch A0%1sF6R!",
  "0.39.0" => "Erobere als Nächstes C2%1sF6R und C2%2sF6R!",
  "0.40.0" => "Eine A6SkulltulaR wurde auf dem Schlachtfeld gesichtet!",
  "0.41.0" => "Finde die A6SkulltulaR!",
  "0.42.0" => "Du hast die A6SkulltulaR erlegt!",
  "0.43.0" => "Die A6SkulltulaR wird bald fliehen!",
  "0.44.0" => "Die A6SkulltulaR ist geflohen!",
  "0.45.0" => "A0%1sF0R hat einen Kampf gewittert und rückt vor!",
  "0.46.0" => "Besiege die A2RiesenmonsterR, bevor sie sich begegnen!",
  "0.47.0" => "Die A6Eingänge zur SiedlungR wurden geschlossen!",
  "0.48.0" => "Befreie die A5gefangenen MonsterR aus ihren A6KerkernR!",
  "0.49.0" => "Der A6Eingang zur WüstenburgR ist geschlossen!",
  "0.50.0" => "Der A6Eingang zur WüstenburgR ist offen!",
  "0.51.0" => "In der A6WüstenburgR versteckte A2MonsterR sind erschienen! ",
  "0.52.0" => "A0%1sF0R hat einen Kampf gewittert und ein Bombardement gestartet!",
  "0.53.0" => "Vorsicht vor den A2RiesenmonsternR!",
  "0.54.0" => "A0%1sF0R hat A0%2sF6R erreicht!",
  "0.55.0" => "A0%1sF0R und A0%2sF5R beschützen einander und sind stärker geworden!",
  "0.56.0" => "A0%1sF0R hat A6in der SiedlungR A2MonsterR herbeigerufen!",
  "0.57.0" => "Die A63 FestungenR müssen schnell erobert werden!",
  "0.58.0" => "A0%1sF0R hat mehr A2MonsterR herbeigerufen!",
  "0.59.0" => "A0%1sF1R rücken von der A6NordwüsteR in die A6SüdwüsteR vor!",
  "0.60.0" => "A0%1sF0R wurde vor der A6SüdwüsteR aufgehalten!",
  "0.61.0" => "A0%1sF1R haben die A6SüdwüsteR erreicht!",
  "0.62.0" => "Die Moral eines Teils der A0%1sF5R steigt durch die Verstärkung!",
  "0.63.0" => "Die A63 FestungenR wurden erobert!",
  "0.64.0" => "A0%1sF1R sind A6vor den KerkernR erschienen!",
  "0.65.0" => "A0%1sF1R bereiten das Öffnen der A6KerkerR vor!",
  "0.66.0" => "A0%1sF1R wurden alle besiegt!",
  "0.67.0" => "A0%1sF1R haben die A6KerkertoreR geöffnet!",
  "0.68.0" => "Die Monster aus den A6KerkernR gehören nun zu den A0%1sF7R!",
  "0.69.0" => "Besiege A0%1sF6R!",
  "0.70.0" => "A0%1sF0R hat einen Kampf gewittert und rückt vor!",
  "0.71.0" => "Ein Teil der A0%1sF5R rückt mit gestiegener Moral gegen die A0%2sF7R vor!",
  "0.72.0" => "Die Einheit A0%1sF2R wurde zerschlagen!",
  "0.73.0" => "C2%1sF4R, C2%2sF4R und C2%3sF4R sind offen!",
  "0.74.0" => "A0%1sF0R ist nun als spielbarer Kämpfer verfügbar!",
  "0.75.0" => "A0%1sF0R ist nach dem Angriff der A0%2sF5R geflohen!",
  "0.76.0" => "A0%1sF0R wurde gesichtet und rückt Richtung C2%2sF4R vor!",
  "0.77.0" => "C2%1sF0R wurde erobert!",
  "0.78.0" => "A0%1sF0R scheint einen Schatz zu beherbergen!",
  "0.79.0" => "Versammele deine Mitstreiter bei A0%1sF4R!",
