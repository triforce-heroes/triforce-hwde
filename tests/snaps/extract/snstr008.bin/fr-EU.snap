  "0.42.0" => "A0%1sF5R a vaincu !",
  "0.43.0" => "A0%2sF5R a fait tomber C1%1sF0R !",
  "0.44.0" => "A0%1sF5R a été vaincue !",
  "0.45.0" => "A0%1sF4R fuit !",
