Map {
  "0.0.0" => "A0%1sF0R und A0%2sF5R rücken zu den A6HeiligtümernR vor!",
  "0.1.0" => "A6%1sF0R wurde geschlossen! A2LanasR Falle schnappt zu!",
  "0.2.0" => "A0%1sF0R ist offen! A0%2sF0R rückt vor!",
  "0.3.0" => "A6%1sF0R wurde geschlossen! A2LanasR Falle schnappt zu!",
  "0.4.0" => "A0%1sF0R ist offen! A0%2sF0R rückt vor!",
  "0.5.0" => "C1%1sF0R ist offen!",
  "0.6.0" => "Erobere als Nächstes A0%1sF6R!",
  "0.7.0" => "C1%1sF0R ist offen!",
  "0.8.0" => "Erobere als Nächstes A0%1sF6R!",
  "0.9.0" => "Das A6Heiligtum der GöttinR wurde erobert!",
  "0.10.0" => "Die A6HeiligtümerR wurden erobert! Die Moral der A0%1sF1R sinkt!",
  "0.11.0" => "A0%2sF0R ist geflohen! Die Moral eines Teils der A0%1sF1R steigt!",
  "0.12.0" => "A0%2sF0R ist geflohen! Die Moral eines Teils der A0%1sF1R steigt!",
  "0.13.0" => "A0%1sF0R wurde an mehreren Stellen gesichtet!",
  "0.14.0" => "A0%1sF1R rücken vor!",
  "0.15.0" => "Besiege A0%1sF6R!",
  "0.16.0" => "A0%2sF0R und Doppelgängerinnen A0%1sF2R wurden gesichtet!",
  "0.17.0" => "Besiege A0%1sF7R A6in den RuinenR!",
  "0.18.0" => "A0%1sF0R eilt A0%2sF4R zu Hilfe!",
  "0.19.0" => "A0%1sF0R wurde enttarnt!",
  "0.20.0" => "A0%1sF1R sind alle stärker geworden!",
  "0.21.0" => "A0%1sF1R sind alle schwächer geworden!",
  "0.22.0" => "Die echte A0%1sF5R wurde besiegt!",
  "0.23.0" => "A0%1sF1R sind alle schwächer geworden!",
  "0.24.0" => "Die echte A0%1sF5R wurde besiegt!",
  "0.25.0" => "A0%1sF0R und A0%2sF5R sind offen!",
  "0.26.0" => "A0%1sF1R rücken vor!",
  "0.27.0" => "Besiege A0%2sF6R in der Nähe A0%1sF2R!",
  "0.28.0" => "A0%1sF0R wurde in der Nähe A0%2sF2R gesichtet!",
  "0.29.0" => "A0%1sF0R ist offen!",
  "0.30.0" => "A0%1sF0R flieht!",
  "0.31.0" => "A0%1sF0R hat mittels Magie zwei Doppelgängerinnen von sich erschaffen!",
  "0.32.0" => "Bedingungen für eine Niederlage wurden hinzugefügt!",
  "0.33.0" => "Keine A0%1sF3R darf den A6FluchtpunktR erreichen!",
  "0.34.0" => "A0%1sF0R verfolgt A0%2sF6R im Westen!",
  "0.35.0" => "A0%1sF0R verfolgt A0%2sF6R im Osten!",
  "0.36.0" => "Besiege alle A0%1sF3R!",
  "0.37.0" => "A0%1sF1R nähern sich dem A6FluchtpunktR!",
  "0.38.0" => "A0%1sF0R im Westen nähert sich dem A6FluchtpunktR!",
  "0.39.0" => "A0%1sF0R im Osten nähert sich dem A6FluchtpunktR!",
  "0.40.0" => "A0%1sF0R wurde besiegt!",
  "0.41.0" => "A0%1sF1R wurden alle besiegt!",
  "0.42.0" => "A0%1sF0R ist entkommen!",
  "0.43.0" => "Die A0%1sF1R wurden besiegt!",
  "0.44.0" => "C1%1sF0R ist an die A0%2sF7R gefallen!",
  "0.45.0" => "Die A0%1sF1R wurden besiegt!",
  "0.46.0" => "A0%1sF0R ist offen! A0%2sF0R rückt vor!",
  "0.47.0" => "Ein Teil der A0%1sF1R rückt gegen A0%2sF6R vor!",
  "0.48.0" => "Ein Teil der A0%1sF1R rückt gegen A0%2sF6R vor!",
  "0.49.0" => "Ein A2MagusR wurde auf dem Schlachtfeld gesichtet!",
  "0.50.0" => "Die A0%1sF1R haben die Schlacht gewonnen!",
  "0.51.0" => "Eine A6SkulltulaR wurde auf dem Schlachtfeld gesichtet!",
  "0.52.0" => "Finde die A6SkulltulaR!",
  "0.53.0" => "Du hast die A6SkulltulaR erlegt!",
  "0.54.0" => "Die A6SkulltulaR wird bald fliehen!",
  "0.55.0" => "Die A6SkulltulaR ist geflohen!",
  "0.56.0" => "Die Doppelgängerinnen A0%1sF2R sind verschwunden!",
  "0.57.0" => "Besiege A0%1sF7R A6in den RuinenR!",
  "0.58.0" => "Rette A0%1sF6R und A0%2sF6R!",
  "0.59.0" => "Die A0%1sF1R haben Verstärkung erhalten!",
  "0.60.0" => "A0%1sF0R wurde besiegt!",
  "0.61.0" => "Die Hilfstruppen A0%1sF2R haben eine Großoffensive gestartet!",
  "0.62.0" => "Die Tore sind geschlossen! Finde einen anderen Weg!",
  "0.63.0" => "A0%1sF1R sind verschwunden!",
  "0.64.0" => "A0%1sF0R wurde an mehreren Stellen gesichtet!",
  "0.65.0" => "Die Moral A0%1sF2R steigt!",
  "0.66.0" => "Ein Teil der A0%1sF1R rückt Richtung C1%2sF4R vor!",
  "0.67.0" => "C1%1sF0R wurde verteidigt!",
  "0.68.0" => "A0%1sF0R plant etwas und muss schnell besiegt werden!",
  "0.69.0" => "A0%2sF1R haben die Moral der A0%1sF1R gesteigert!",
  "0.70.0" => "Der Plan A0%1sF2R wurde durchkreuzt!",
  "0.71.0" => "A0%1sF0R rückt vor, um weitere Verstärkung zu rufen!",
  "0.72.0" => "A0%1sF0R ist A0%2sF3R angekommen und ruft Verstärkung!",
  "0.73.0" => "Stärke und Geschwindigkeit A0%1sF3R haben sich gesteigert!",
  "0.74.0" => "Moral und Geschwindigkeit A0%1sF2R haben sich gesteigert!",
  "0.75.0" => "Besiege die letzte A0%1sF6R!",
  "0.76.0" => "A0%1sF0R im Norden nähert sich dem A6FluchtpunktR!",
  "0.77.0" => "A0%1sF0R hat Verstärkung für die A0%2sF5R gerufen!",
  "0.78.0" => "A0%1sF0R ist nun als spielbarer Kämpfer verfügbar!",
  "0.79.0" => "A0%1sF0R ist geflohen!",
  "0.80.0" => "A0%1sF0R wurde gesichtet und rückt Richtung C2%2sF4R vor!",
  "0.81.0" => "C2%1sF0R wurde erobert!",
  "0.82.0" => "A0%1sF0R scheint einen Schatz zu beherbergen!",
  "0.83.0" => "A0%1sF0R bereitet eine Stärkung der Truppen vor!",
  "0.84.0" => "A0%1sF0R wurde besiegt!",
  "0.85.0" => "A0%1sF0R bereitet eine Stärkung der Truppen vor!",
  "0.86.0" => "A0%1sF0R muss schnell besiegt werden!",
  "0.87.0" => "A0%1sF0R hat A0%2sF6R erreicht!",
  "0.88.0" => "A0%1sF0R hat sich zurückgezogen!",
  "0.89.0" => "Greife sofort ein!",
  "0.90.0" => "A0%1sF0R wurde auf dem Schlachtfeld gesichtet!",
