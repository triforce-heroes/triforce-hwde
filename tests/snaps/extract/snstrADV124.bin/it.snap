Map {
  "0.0.0" => "A0%1sF1R appaiono!",
  "0.1.0" => "La magia A0%2sF7R ha diviso A0%1sF2R!",
  "0.2.0" => "A0%1sF0R e le sue copie si ritirano temporaneamente!",
  "0.3.0" => "A0%1sF0R e le sue copie appaiono di nuovo!",
  "0.4.0" => "Presto, trova e sconfiggi A0%1sF2R originale!",
  "0.5.0" => "A0%1sF0R e le sue copie vanno verso A0%2sF2R!",
  "0.6.0" => "A0%1sF0R ha perso!",
  "0.7.0" => "A0%2sF0R ha perso e una copia scompare!",
  "0.8.0" => "A0%1sF0R percepisce il pericolo ed evoca A0%2sF2R!",
  "0.9.0" => "A0%1sF1R vanno verso A0%2sF2R!",
  "0.10.0" => "Hai sconfitto A0%1sF2R originale!",
  "0.11.0" => "Le copie scompaiono lasciando degli oggetti!",
  "0.12.0" => "A0%1sF1R si ritirano!",
  "0.13.0" => "A0%1sF0R e le copie si mettono in marcia!",
  "0.14.0" => "Sconfiggi A0%1sF3R per eliminare le copie!",
  "0.15.0" => "A0%1sF0R va verso A0%2sF2R!",
  "0.16.0" => "A0%1sF1R si comportano in modo sospetto!",
  "0.17.0" => "Fai attenzione a non attaccare le copie!",
  "0.18.0" => "A0%1sF0R e le copie si esaltano!",
  "0.19.0" => "A0%1sF0R e le copie diventano più forti!",
  "0.20.0" => "A0%1sF0R e le copie diventano ancora più forti!",
  "0.21.0" => "L'A0%1sF1R ha perso la battaglia!",
  "0.22.0" => "Hai eliminato tutte le copie!",
  "0.23.0" => "Sconfiggi A0%1sF2R originale!",
  "0.24.0" => "A0%1sF0R si esalta!",
  "0.25.0" => "A0%1sF0R percepisce il pericolo ed evoca A0%2sF2R!",
  "0.26.0" => "A0%1sF0R è debole e chiama le sue copie!",
  "0.27.0" => "Le copie si dirigono verso A0%2sF2R!",
  "0.28.0" => "A0%1sF0R avanza per proteggere A0%2sF2R!",
  "0.29.0" => "A0%1sF0R ha ancora quattro copie!",
  "0.30.0" => "A0%1sF0R ha ancora tre copie!",
  "0.31.0" => "A0%1sF0R ha ancora due copie!",
  "0.32.0" => "A0%1sF0R ha ancora una copia!",
  "0.33.0" => "A0%1sF0R originale si prepara a evocare un A2mostro giganteR!",
  "0.34.0" => "A0%1sF0R originale ha evocato A0%2sF2R!",
  "0.35.0" => "Presto, sconfiggi A0%1sF2R!",
  "0.36.0" => "A0%1sF0R si divide grazie alla magia di A0%2sF6R!",
  "0.37.0" => "A0%1sF0R si ritira!",
  "0.38.0" => "Batti A0%1sF3R e ferma A0%2sF2R per eliminarne le copie!",
