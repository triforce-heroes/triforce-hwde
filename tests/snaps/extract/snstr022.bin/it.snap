Map {
  "0.0.0" => "L'A0%1sF1R ha perso la battaglia!",
  "0.1.0" => "A0%1sF0R ha perso!",
  "0.2.0" => "A0%1sF0R lascia A6cuoriR in campo e si ritira!",
  "0.3.0" => "A0%1sF0R lascia un A6frammento di forzaR e si ritira!",
  "0.4.0" => "A0%1sF0R lascia una A6giara magicaR in campo e si ritira!",
  "0.5.0" => "A0%1sF0R è in fuga!",
  "0.6.0" => "A0%1sF0R si esalta e il suo morale è migliorato!",
  "0.7.0" => "A0%1sF0R va verso l'area C1%2sF6R!",
  "0.8.0" => "A0%1sF0R si esalta e va verso l'area C1%2sF6R!",
  "0.9.0" => "I A2demoniR hanno conquistato A1presidi dell'armata di HyruleR!",
  "0.10.0" => "I A2presidiR si aprono! L'A0%1sF1R va all'area C1%2sF6R!",
  "0.11.0" => "L'A0%1sF1R lotta contro i A2demoni a nordR!",
  "0.12.0" => "Sconfiggi i A2demoniR che attaccano A0%1sF3R!",
  "0.13.0" => "L'A0%1sF1R riceve rinforzi nelle aree A0%2sF2R e A0%3sF2R!",
  "0.14.0" => "Due presidi si aprono e l'A0%3sF1R avanza!",
  "0.15.0" => "Hai difeso l'area C1%1sF6R dai A2demoniR!",
  "0.16.0" => "Appaiono altri rinforzi dell'A0%1sF1R!",
  "0.17.0" => "Le aree C2%1sF2R e C2%2sF2R sono state conquistate!",
  "0.18.0" => "Sconfiggi i A2demoniR che minacciano l'area C1%1sF6R!",
  "0.19.0" => "Conquista le aree A0%1sF2R e A0%2sF2R!",
  "0.20.0" => "A0%1sF0R appare!",
  "0.21.0" => "Le condizioni di vittoria sono cambiate!",
  "0.22.0" => "Sconfiggi A0%1sF2R!",
  "0.23.0" => "Appaiono A2potenti demoniR e vanno verso l'area C1%1sF6R!",
  "0.24.0" => "Hai sconfitto i A2potenti demoniR!",
  "0.25.0" => "Sono apparsi altri A2potenti demoniR!",
  "0.26.0" => "A0%1sF1R tornano sul campo!",
  "0.27.0" => "La luce della A6bussolaR ha indebolito A0%1sF2R!",
  "0.28.0" => "A0%1sF1R appaiono!",
  "0.29.0" => "L'A0%1sF1R si esalta e va verso i A2potenti demoniR!",
  "0.30.0" => "L'A0%1sF1R va verso i A2potenti demoniR!",
  "0.31.0" => "Presto, sconfiggi A0%1sF2R!",
  "0.32.0" => "A0%1sF0R si avvicina all'area C1%2sF6R!",
  "0.33.0" => "Hai sconfitto l'A2orda di demoniR!",
  "0.34.0" => "L'A0%2sF7R ha conquistato l'area C1%1sF0R!",
  "0.35.0" => "A0%1sF0R è in fuga!",
  "0.36.0" => "Hai difeso A0%1sF3R dall'attacco dei A2demoniR!",
  "0.37.0" => "Appaiono i rinforzi dell'A0%1sF1R!",
  "0.38.0" => "Ora puoi controllare A0%1sF2R!",
  "0.39.0" => "A0%1sF0R ha perso! A0%2sF0R è in salvo!",
  "0.40.0" => "Un'A6AracnulaR è stata avvistata sul campo di battaglia!",
  "0.41.0" => "L'A6AracnulaR è fuggita!",
  "0.42.0" => "A2Potenti demoniR sono vicini all'area C1%1sF0R!",
