  "0.22.0" => "A0%1sF0R passa dalla parte dell'A0%2sF1R!",
  "0.23.0" => "Le condizioni di sconfitta sono cambiate!",
  "0.24.0" => "Le condizioni di vittoria sono cambiate!",
  "0.25.0" => "A0%1sF0R scappa! L'A0%2sF5R ha perso!",
  "0.26.0" => "L'area C1%1sF4R è caduta! L'A0%2sF5R ha perso!",
  "0.27.0" => "L'area A0%1sF2R è stata conquistata!",
  "0.28.0" => "A0%1sF0R ha perso!",
  "0.29.0" => "Hai sconfitto A0%1sF2R!",
  "0.30.0" => "Sconfiggi A0%1sF2R!",
  "0.31.0" => "A0%1sF0R o A0%2sF2R perdono o la A1base alleataR cade!",
  "0.32.0" => "L'area A0%1sF0R si è aperta!",
  "0.33.0" => "L'A0%2sF5R ha fermato A0%1sF2R!",
  "0.34.0" => "Conquista l'area A0%1sF2R!",
  "0.35.0" => "A0%1sF0R conquista l'area C2%2sF4R e riparte!",
  "0.36.0" => "A0%1sF0R potenzia e fa avanzare A0%2sF3R più velocemente!",
  "0.37.0" => "A0%1sF0R ha perso e A0%2sF3R rallentano!",
  "0.38.0" => "A0%1sF0R fa andare più veloce parte dell'A0%2sF7R!",
  "0.39.0" => "A0%1sF0R combatte contro l'A0%2sF7R!",
  "0.40.0" => "Conquista l'area A0%1sF2R e aiuta A0%2sF2R ad avanzare!",
  "0.41.0" => "A0%1sF0R perde o la A1base alleataR cade!",
  "0.42.0" => "A0%1sF1R abbandonano il fronte!",
  "0.43.0" => "A0%1sF0R va verso A0%2sF2R!",
  "0.44.0" => "Sconfiggi A0%1sF2R per rallentare A0%2sF3R!",
  "0.45.0" => "Sconfiggi A0%1sF2R per velocizzare A0%2sF3R!",
  "0.46.0" => "Attenzione, il A6tempo scorreR!",
  "0.47.0" => "A0%1sF0R era sotto il controllo della maschera!",
  "0.48.0" => "A0%1sF0R è in grave pericolo! Corri in suo aiuto!",
  "0.49.0" => "A0%1sF0R è nei guai!",
  "0.50.0" => "A0%1sF0R è in grave pericolo!",
  "0.51.0" => "A0%1sF0R ha salvato A0%2sF2R!",
  "0.52.0" => "A0%1sF0R e A0%2sF2R vanno verso A0%3sF3R!",
  "0.53.0" => "A0%1sF0R e A0%2sF2R hanno un miglioramento di morale!",
