  "0.77.0" => "A0%1sF0R ist offen!",
  "0.78.0" => "A0%1sF0R und A0%2sF5R sind in der Nähe A0%3sF2R erschienen!",
  "0.79.0" => "A0%2sF0R hat die A0%1sF1R gestärkt!",
  "0.80.0" => "Besiege A0%1sF6R und A0%2sF6R! Beschütze A0%3sF6R!",
