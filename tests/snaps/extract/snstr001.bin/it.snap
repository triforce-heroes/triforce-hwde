Map {
  "0.0.0" => "A0%1sF0R ha raggiunto A0%2sF2R!",
  "0.1.0" => "Trova e conquista i A6presidiR infestati dai A2demoniR!",
  "0.2.0" => "Conquista l'area C2%1sF2R!",
  "0.3.0" => "A0%1sF0R appare nell'area A0%2sF6R!",
  "0.4.0" => "A0%1sF0R ha evocato A0%2sF2R nel campo di battaglia!",
  "0.5.0" => "L'A0%1sF1R è apparsa!",
  "0.6.0" => "L'area A0%1sF0R è aperta!",
  "0.7.0" => "L'area A0%1sF0R è aperta!",
  "0.8.0" => "L'A0%1sF1R marcia verso A0%2sF6R!",
  "0.9.0" => "Soccorri A0%1sF2R che è sotto attacco dall'A0%2sF3R!",
  "0.10.0" => "Hai sconfitto A0%1sF3R!",
  "0.11.0" => "A0%1sF4R attacca A0%2sF2R!",
  "0.12.0" => "L'A0%1sF1R ha conquistato l'area C2%2sF2R!",
  "0.13.0" => "A0%1sF0R ha evocato altri A2demoniR!",
  "0.14.0" => "A0%2sF0R attacca A0%1sF2R e ferma la sua avanzata!",
  "0.15.0" => "Apri lo A6scrignoR e prendi il A6tesoroR!",
  "0.16.0" => "A0%1sF0R ha ripreso la marcia.",
  "0.17.0" => "L'A0%1sF1R marcia verso l'A0%2sF7R nella A6cavernaR!",
  "0.18.0" => "Vai verso il A6profondo delle caverneR!",
  "0.19.0" => "Lo A2stregoneR fa apparire gli A2evocatoriR in varie aree!",
  "0.20.0" => "A0%1sF0R è in fuga!",
  "0.21.0" => "Lo A2stregoneR fa apparire A2A0%1sF3RR!",
  "0.22.0" => "A0%1sF0R avanza verso l'area A0%2sF6R!",
  "0.23.0" => "A0%1sF1R non hanno invaso l'area A0%2sF6R!",
  "0.24.0" => "Proteggi A0%1sF2R!",
  "0.25.0" => "Raggiungi l'A6uscita delle caverneR!",
  "0.26.0" => "Hai superato le A6caverneR!",
  "0.27.0" => "A0%1sF0R ha lasciato il campo di battaglia! Hai perso!",
  "0.28.0" => "L'A0%1sF5R è stata sconfitta!",
  "0.29.0" => "Appare di nuovo A0%1sF6R!",
  "0.30.0" => "A0%1sF0R è in fuga!",
  "0.31.0" => "A0%1sF0R ha invaso l'area A0%2sF4R!",
  "0.32.0" => "Il morale dell'A0%1sF1R nella A6cavernaR è migliorato!",
  "0.33.0" => "I rinforzi dell'A0%1sF5R appaiono e vanno verso A0%2sF2R!",
  "0.34.0" => "Tutte A0%1sF3R sono state distrutte!",
  "0.35.0" => "L'A0%1sF5R ha annientato l'ultimo A0%2sF7R!",
  "0.36.0" => "A0%1sF0R ha subito gravi ferite!",
  "0.37.0" => "A0%2sF0R ha indebolito l'area C1%1sF0R!",
  "0.38.0" => "A0%1sF1R abbandonano la battaglia!",
  "0.39.0" => "Nell'area A0%1sF6R si nasconde un tesoro!",
  "0.40.0" => "L'A0%1sF1R ha cominciato a marciare verso la A6cavernaR!",
  "0.41.0" => "A0%1sF0R è in campo!",
  "0.42.0" => "Hai trovato A0%1sF2R!",
  "0.43.0" => "L'A0%1sF1R avanza verso A0%2sF2R!",
  "0.44.0" => "Sono apparsi i rinforzi dell'A0%1sF5R!",
  "0.45.0" => "A0%1sF0R non si può muovere per l'attacco dell'A0%2sF5R!",
  "0.46.0" => "A0%1sF0R ha ripreso la marcia.",
  "0.47.0" => "A0%1sF0R ha interrotto la marcia nell'area C2%2sF6R!",
  "0.48.0" => "Sconfiggi l'A0%2sF3R che attacca A0%1sF2R!",
  "0.49.0" => "Conquista l'area C2%1sF2R immediatamente!",
  "0.50.0" => "A0%1sF0R restante si mette in marcia!",
  "0.51.0" => "Attenzione! L'A0%1sF5R insegue!",
  "0.52.0" => "Altri A2demoniR sono apparsi nell'area C2%1sF0R!",
  "0.53.0" => "L'A0%1sF1R è apparsa nell'area C2%2sF0R!",
  "0.54.0" => "Conquista le aree C2%1sF2R e C2%2sF2R!",
  "0.55.0" => "L'A0%1sF1R ha cominciato la marcia!",
  "0.56.0" => "A2DemoniR appaiono nell'area C2%1sF6R!",
  "0.57.0" => "A2DemoniR appaiono nell'area C2%1sF6R!",
  "0.58.0" => "A0%1sF0R appare e va verso l'area C2%2sF6R!",
  "0.59.0" => "Hai conquistato l'area C2%1sF4R!",
  "0.60.0" => "Le aree C2%1sF4R e C2%2sF4R sono state conquistate!",
  "0.61.0" => "Adesso conquista il A6presidioR da cui appaiono i A2demoniR!",
  "0.62.0" => "L'A0%1sF1R ha conquistato l'area C2%2sF2R!",
  "0.63.0" => "L'area C2%1sF2R è stata conquistata!",
  "0.64.0" => "Hai raggiunto l'area A0%1sF6R!",
  "0.65.0" => "A0%1sF0R non era nell'area A0%2sF6R!",
  "0.66.0" => "Trova l'altro A6presidioR!",
  "0.67.0" => "A0%1sF0R è in campo!",
  "0.68.0" => "Hai trovato A0%1sF2R!",
  "0.69.0" => "Sconfiggi A0%1sF2R!",
  "0.70.0" => "L'area A0%1sF0R si apre! A0%2sF0R è in marcia!",
  "0.71.0" => "A0%1sF0R è in fuga!",
  "0.72.0" => "A0%1sF0R restante ha subito gravi danni!",
  "0.73.0" => "A0%1sF0R ha subito gravissime ferite!",
  "0.74.0" => "La A6%1sF0R è aperta!",
  "0.75.0" => "A0%1sF0R ha perso!",
  "0.76.0" => "Una porta dell'area A0%1sF0R si è aperta!",
  "0.77.0" => "La A6%1sF0R è aperta!",
  "0.78.0" => "L'A0%1sF1R marcia verso l'area A0%2sF2R!",
  "0.79.0" => "L'A0%1sF1R ha vinto la battaglia!",
  "0.80.0" => "A0%1sF0R ha raggiunto A6l'uscita della cavernaR!",
  "0.81.0" => "Raggiungi subito A6l'uscita della cavernaR!",
  "0.82.0" => "L'A0%1sF1R marcia verso le A6caverneR!",
  "0.83.0" => "L'area C1%1sF0R è stata conquistata dall'A0%2sF7R!",
  "0.84.0" => "Riconquista l'area C2%1sF2R!",
  "0.85.0" => "L'area C2%1sF2R è stata riconquistata!",
  "0.86.0" => "L'area C2%1sF0R è stata conquistata e si è aperta!",
  "0.87.0" => "Un'A6AracnulaR è stata avvistata sul campo di battaglia!",
  "0.88.0" => "Cerca l'A6AracnulaR!",
  "0.89.0" => "Hai ottenuto l'A6AracnulaR!",
  "0.90.0" => "L'A6AracnulaR sta per fuggire!",
  "0.91.0" => "L'A6AracnulaR è fuggita!",
  "0.92.0" => "L'A0%1sF1R ha raggiunto l'area A0%2sF2R!",
  "0.93.0" => "Hai trovato una nuova strada oltre le mura!",
  "0.94.0" => "Un A1capitano di HyruleR è stato trovato dietro alla A6%1sF0R!",
  "0.95.0" => "Trova un'altra strada per raggiungere A0%1sF2R!",
  "0.96.0" => "Usa le A6bombeR per distruggere il muro!",
  "0.97.0" => "Hai raggiunto A0%1sF2R!",
  "0.98.0" => "Hai raggiunto A6l'uscita della cavernaR!",
  "0.99.0" => "Hai distrutto le due A6rocceR!",
  "0.100.0" => "Proteggi A0%1sF2R!",
  "0.101.0" => "Hai distrutto una delle due A6grandi rocceR!",
  "0.102.0" => "A0%1sF0R insegue l'A0%2sF1R per fermarla!",
  "0.103.0" => "Hai distrutto la A6rocciaR!",
  "0.104.0" => "Attenzione! A0%1sF0R non deve perdere!",
  "0.105.0" => "Non hai raggiunto A0%1sF2R!",
  "0.106.0" => "A0%1sF0R è giù di morale a causa dei tanti A2demoniR!",
  "0.107.0" => "Presto, raggiungi il A1capitano di HyruleR!",
  "0.108.0" => "Altri A2demoniR appaiono dal profondo delle caverne!",
  "0.109.0" => "A0%1sF0R si rimette in marcia per aiutare A0%2sF2R!",
  "0.110.0" => "Hai sconfitto A0%1sF2R!",
  "0.111.0" => "A0%1sF0R è in ritirata!",
  "0.112.0" => "Le condizioni di sconfitta sono cambiate!",
  "0.113.0" => "Proteggi A0%1sF2R!",
  "0.114.0" => "Proteggi A0%1sF3R!",
  "0.115.0" => "Raggiungi A0%1sF2R!",
  "0.116.0" => "A0%1sF0R difende l'area A0%2sF4R!",
  "0.117.0" => "Inoltrati nella caverna e trova A0%1sF2R!",
  "0.118.0" => "A0%1sF0R appare di nuovo per schierare A0%2sF2R!",
  "0.119.0" => "A0%1sF0R ha temporaneamente abbandonato il campo!",
  "0.120.0" => "L'area C2%1sF2R è aperta!",
  "0.121.0" => "A0%1sF1R vanno verso l'area A0%2sF6R!",
  "0.122.0" => "L'area A0%1sF2R è aperta!",
  "0.123.0" => "Hai conquistato tutti i A6presidiR da cui uscivano i A2demoniR!",
