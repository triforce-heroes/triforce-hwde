Map {
  "0.0.0" => "A0%1sF0R sucht die A6SiegelstatuenR!",
  "0.1.0" => "A0%1sF0R hat eine A6SiegelstatueR entdeckt!",
  "0.2.0" => "A0%1sF0R rückt Richtung A6SiegelstatueR vor!",
  "0.3.0" => "A0%1sF0R hat die A6SiegelstatueR erreicht und somit aktiviert!",
  "0.4.0" => "Die A0%1sF1R wurden an verschiedenen Orten gesichtet!",
  "0.5.0" => "Suche in den A6RuinenR nach den Siegelstatuen!",
  "0.6.0" => "Beschütze die Verbündeten, die die A6SiegelstatuenR aktivieren!",
  "0.7.0" => "Eine A6SiegelstatueR wurde aktiviert! Noch 2 übrig!",
  "0.8.0" => "Eine A6SiegelstatueR wurde aktiviert! Noch 1 übrig!",
  "0.9.0" => "Alle A6SiegelstatuenR wurden aktiviert!",
  "0.10.0" => "A6%1sF0R ist offen!",
  "0.11.0" => "Die A0%1sF1R rücken aus dem A6Tempel des heiligen SchwertesR vor!",
  "0.12.0" => "Enthülle die wahre Identität von A1LanasR Doppelgänger!",
  "0.13.0" => "Finde den A2FeindR in deinen Reihen!",
  "0.14.0" => "A0%1sF0R verhält sich verdächtig. Folge ihr!",
  "0.15.0" => "Du hast entdeckt, wer die A0%1sF3R kontrolliert!",
  "0.16.0" => "A0%1sF0R hat die A0%2sF7R angegriffen!",
  "0.17.0" => "Besiege A0%1sF6R!",
  "0.18.0" => "Der Feind, der die A0%1sF3R kontrolliert hat, wurde besiegt!",
  "0.19.0" => "A0%1sF0R wurde besiegt! Die A0%2sF3R sind frei!",
  "0.20.0" => "A0%1sF0R hat sich mit den A0%2sF7R verbündet!",
  "0.21.0" => "Die drei A6SiegelstatuenR sind vollständig erwacht!",
  "0.22.0" => "A6%1sF0R ist offen!",
  "0.23.0" => "A0%1sF0R, A0%2sF5R und A0%3sF5R haben sich zurückgezogen!",
  "0.24.0" => "Die A0%1sF1R wurden auf dem Schlachtfeld gesichtet!",
  "0.25.0" => "Ziehe das A6Master-SchwertR aus dem A6Sockel des heiligen SchwertesR!",
  "0.26.0" => "Du hast das A6Master-SchwertR erhalten!",
  "0.27.0" => "A0%1sF0R wurde auf dem Schlachtfeld gesichtet!",
  "0.28.0" => "Die Siegbedingungen haben sich geändert!",
  "0.29.0" => "Besiege A0%1sF6R!",
  "0.30.0" => "A0%1sF0R hat sich vorerst zurückgezogen!",
  "0.31.0" => "A0%1sF0R wurde am Westplatz der A6RuinenR gesichtet!",
  "0.32.0" => "Die A0%1sF1R haben Verstärkung erhalten!",
  "0.33.0" => "A0%1sF0R hat sich in den A6Tempel des heiligen SchwertesR zurückgezogen!",
  "0.34.0" => "Beschütze A0%2sF6R vor A0%1sF4R!",
  "0.35.0" => "A0%1sF0R wurde besiegt!",
  "0.36.0" => "Die A0%1sF1R haben die Schlacht gewonnen!",
  "0.37.0" => "A0%1sF0R ist vom Schlachtfeld geflohen!",
  "0.38.0" => "Die A0%1sF5R haben den Kampf verloren!",
  "0.39.0" => "C2%1sF0R wurde erobert! Das A6NordtorR ist offen!",
  "0.40.0" => "C2%1sF0R wurde erobert! Das A6WesttorR ist offen!",
  "0.41.0" => "C2%1sF0R wurde erobert! Das A6OsttorR ist offen!",
