Map {
  "0.0.0" => "¡Las A0%1sF1R están atacando a las A0%2sF1R!",
  "0.1.0" => "¡Vence a las A0%1sF1R!",
  "0.2.0" => "¡Hazte con el otro bastión de las A0%1sF1R!",
  "0.3.0" => "¡Se han abierto las puertas que llevan a la A6cueva de cristalR!",
  "0.4.0" => "¡Has conseguido el A6anillo antiguoR!",
  "0.5.0" => "¡Las condiciones para la victoria han cambiado!",
  "0.6.0" => "Debes vencer A0%1sF4R.",
  "0.7.0" => "¡Las condiciones para la derrota han cambiado!",
  "0.8.0" => "Evita que A0%1sF2R huya o que A0%2sF2R caiga.",
  "0.9.0" => "¡Se han abierto las puertas de la zona oeste de las cuevas!",
  "0.10.0" => "¡Vence A0%1sF4R!",
  "0.11.0" => "¡Han aparecido refuerzos de las A0%1sF1R!",
  "0.12.0" => "¡A0%1sF0R se ha retirado temporalmente!",
  "0.13.0" => "¡Han aparecido varios A0%1sF1R y A0%2sF1R!",
  "0.14.0" => "¡A0%1sF0R se dirige A0%2sF4R!",
  "0.15.0" => "¡Impide que A0%1sF2R entre en el bastión!",
  "0.16.0" => "¡A0%1sF0R está a punto de explotar en A0%2sF2R!",
  "0.17.0" => "¡Tras explotar A0%2sF2R, C1%1sF2R ha caído!",
  "0.18.0" => "¡La moral de las A0%1sF1R y de las A0%2sF1R ha aumentado!",
  "0.19.0" => "¡La moral de las A0%1sF1R ha disminuido al caer C1%2sF2R!",
  "0.20.0" => "¡Tras explotar A0%2sF2R, C1%1sF2R ha caído!",
  "0.21.0" => "¡A0%1sF0R ha explotado!",
  "0.22.0" => "¡Varios A0%1sF1R han explotado!",
  "0.23.0" => "¡Ha aparecido otro A0%1sF1R más fuerte en A0%2sF2R!",
  "0.24.0" => "¡Hazte con el bastión de las A0%1sF1R cuanto antes!",
  "0.25.0" => "¡A0%1sF0R y A0%2sF2R están luchando!",
  "0.26.0" => "¡A0%1sF0R está en peligro! ¡Acude en su ayuda!",
  "0.27.0" => "¡A0%1sF0R está en grave peligro! ¡Acude en su ayuda!",
  "0.28.0" => "¡Has vencido A0%1sF4R y A0%2sF4R!",
  "0.29.0" => "¡A0%1sF0R se ha abierto!",
  "0.30.0" => "¡Vence A0%1sF4R!",
  "0.31.0" => "¡Han aparecido dos A0%1sF1R!",
  "0.32.0" => "¡A0%1sF0R que está en el noroeste se dirige A0%2sF4R!",
  "0.33.0" => "¡A0%1sF0R te ha traicionado y se dirige A0%2sF4R!",
  "0.34.0" => "¡Vence A0%1sF4R y A0%2sF4R!",
  "0.35.0" => "¡A0%1sF0R ha entrado en A0%2sF2R!",
  "0.36.0" => "¡A0%1sF0R se prepara para atacar a las A0%2sF1R!",
  "0.37.0" => "¡Has vencido A0%1sF4R!",
  "0.38.0" => "¡Has vencido A0%1sF4R y A0%2sF4R!",
  "0.39.0" => "¡A0%1sF0R está imbuyendo de magia oscura A0%2sF4R y A0%3sF4R!",
  "0.40.0" => "¡C1%1sF0R ha caído!",
  "0.41.0" => "¡Las A0%1sF1R han perdido la batalla!",
  "0.42.0" => "¡A0%1sF0R ha huido!",
  "0.43.0" => "¡Has vencido A0%1sF4R y sus tropas se han retirado!",
  "0.44.0" => "¡Han aparecido refuerzos de las A0%1sF1R!",
  "0.45.0" => "¡La A6puerta oeste del bastión centralR se ha abierto!",
  "0.46.0" => "¡Impide que A0%1sF2R caiga!",
  "0.47.0" => "¡La moral de las A0%1sF1R ha aumentado!",
  "0.48.0" => "¡A0%1sF0R está luchando con las A0%2sF1R!",
  "0.49.0" => "¡Has conquistado todos los bastiones de las A0%1sF1R!",
  "0.50.0" => "Impide que A0%1sF2R caiga.",
  "0.51.0" => "¡Ve a la A6cueva de cristalR y busca el A6anillo antiguoR!",
