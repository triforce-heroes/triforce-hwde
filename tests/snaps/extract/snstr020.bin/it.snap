Map {
  "0.0.0" => "A0%1sF1R si preparano all'evocazione!",
  "0.1.0" => "A0%1sF0R va verso A0%2sF2R!",
  "0.2.0" => "A0%1sF0R è nei guai! Vai in soccorso!",
  "0.3.0" => "A0%1sF0R è in pericolo! Vai in soccorso!",
  "0.4.0" => "Hai sconfitto A0%1sF3R!",
  "0.5.0" => "Ora puoi controllare A0%1sF2R!",
  "0.6.0" => "A0%1sF1R vanno verso A0%2sF2R!",
  "0.7.0" => "A0%1sF0R è nei guai! Vai in soccorso!",
  "0.8.0" => "A0%1sF0R è in pericolo! Vai in soccorso!",
  "0.9.0" => "Hai sconfitto A0%1sF2R!",
  "0.10.0" => "A0%1sF0R ha chiamato i rinforzi per A0%2sF2R!",
  "0.11.0" => "A0%1sF1R appaiono!",
  "0.12.0" => "A0%1sF1R hanno evocato A0%2sF7R!",
  "0.13.0" => "A0%1sF1R si preparano all'evocazione!",
  "0.14.0" => "Non perdere d'occhio A0%1sF2R!",
  "0.15.0" => "A0%1sF1R hanno esaurito la magia per l'evocazione!",
  "0.16.0" => "A0%2sF1R aprono i presidi dell'A0%1sF5R!",
  "0.17.0" => "A0%1sF1R appaiono e chiamano A0%2sF7R!",
  "0.18.0" => "A0%1sF1R vanno verso A0%2sF3R!",
  "0.19.0" => "Presto, sconfiggi A0%1sF3R!",
  "0.20.0" => "A0%1sF4R e le A2truppe vicineR si esaltano!",
  "0.21.0" => "A0%1sF4R e le A2truppe vicineR vanno all'area A0%2sF6R!",
  "0.22.0" => "L'area A0%1sF4R non deve cedere!",
  "0.23.0" => "Appaiono ancora A0%1sF3R e chiamano rinforzi!",
  "0.24.0" => "A0%1sF1R vanno verso A0%2sF2R!",
  "0.25.0" => "A0%1sF0R appare!",
  "0.26.0" => "A0%1sF0R è in cerca di cibo!",
  "0.27.0" => "Presto, sconfiggi A0%1sF3R!",
  "0.28.0" => "Hai sconfitto A0%1sF3R!",
  "0.29.0" => "A0%1sF0R e le A2truppe vicineR vanno all'area A0%2sF6R!",
  "0.30.0" => "A0%2sF0R ha chiuso l'area A0%1sF0R!",
  "0.31.0" => "Hai sconfitto A0%1sF3R!",
  "0.32.0" => "Un'orda di demoni circonda A0%1sF2R!",
  "0.33.0" => "Presto, salva A0%1sF2R!",
  "0.34.0" => "Hai aiutato A0%1sF2R!",
  "0.35.0" => "A0%1sF0R ha mangiato ed è diventato un Coccò d'oro!",
  "0.36.0" => "Le A6entrate del tempioR sono aperte!",
  "0.37.0" => "A0%1sF0R va verso l'area A0%2sF6R!",
  "0.38.0" => "A0%1sF0R comincia a chiamare A0%2sF3R!",
  "0.39.0" => "A0%1sF0R ha assorbito la magia ed è più forte!",
  "0.40.0" => "A0%1sF0R ha assorbito la magia ed è ancora più forte!",
  "0.41.0" => "A0%1sF0R ha perso un po' di magia ed è più debole!",
  "0.42.0" => "Hai sconfitto A0%1sF2R!",
  "0.43.0" => "Tutti A0%1sF3R sono scomparsi!",
  "0.44.0" => "A0%1sF0R si ritira!",
  "0.45.0" => "L'A0%2sF5R ha messo in fuga A0%1sF2R!",
  "0.46.0" => "L'A0%1sF1R ha perso la battaglia!",
  "0.47.0" => "L'area C1%1sF0R si è arresa all'A0%2sF7R!",
  "0.48.0" => "L'area A0%1sF0R è aperta!",
  "0.49.0" => "L'area C2%1sF0R è stata conquistata!",
  "0.50.0" => "A0%1sF0R è in fuga!",
  "0.51.0" => "Un'A6AracnulaR è stata avvistata sul campo di battaglia!",
  "0.52.0" => "L'A6AracnulaR è fuggita!",
  "0.53.0" => "A0%1sF0R inizia a lottare contro A0%2sF2R!",
  "0.54.0" => "A0%1sF0R assorbe la magia A0%2sF7R!",
  "0.55.0" => "A0%1sF0R ha perso!",
  "0.56.0" => "A0%1sF0R e le A2truppe vicineR vanno verso A0%2sF2R!",
  "0.57.0" => "A0%1sF1R vanno verso l'A0%2sF7R!",
  "0.58.0" => "Sconfiggi A0%1sF3R per indebolire A0%2sF2R!",
  "0.59.0" => "A0%1sF0R e A0%2sF3R vanno all'area A0%3sF6R!",
  "0.60.0" => "L'A0%1sF5R attacca l'A0%2sF7R!",
  "0.61.0" => "Le A2truppe che circondanoR A0%1sF2R si demoralizzano!",
