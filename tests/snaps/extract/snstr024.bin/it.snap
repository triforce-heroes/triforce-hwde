Map {
  "0.0.0" => "A0%1sF1R appaiono da varie A6porte delle animeR!",
  "0.1.0" => "Chiudi subito tutte le A6porte delle animeR!",
  "0.2.0" => "Hai sconfitto A0%1sF6R!",
  "0.3.0" => "Hai sconfitto A0%1sF6R e chiuso la A6porta delle animeR!",
  "0.4.0" => "Hai sconfitto A0%1sF3R!",
  "0.5.0" => "Hai sconfitto A0%1sF3R e chiuso le A6porte delle animeR!",
  "0.6.0" => "A0%1sF0R appare dal cielo!",
  "0.7.0" => "A0%1sF0R appare vicino a A0%2sF6R!",
  "0.8.0" => "A0%1sF0R va verso il deserto sud!",
  "0.9.0" => "A0%1sF0R ha raggiunto il deserto sud!",
  "0.10.0" => "A0%2sF0R fugge e A0%1sF2R attacca il deserto sud!",
  "0.11.0" => "A0%1sF0R appare!",
  "0.12.0" => "A0%1sF0R si ritira temporaneamente nell'area A0%2sF6R!",
  "0.13.0" => "Hai respinto A0%1sF2R!",
  "0.14.0" => "Le aree A0%1sF0R, A0%2sF0R e A0%3sF0R sono aperte!",
  "0.15.0" => "Parte dell'A0%1sF1R va verso A0%2sF2R!",
  "0.16.0" => "Hai sconfitto A0%1sF3R!",
  "0.17.0" => "Presto, chiudi tutte le A6porte delle animeR!",
  "0.18.0" => "Parte A0%1sF7R va verso l'area A0%2sF6R!",
  "0.19.0" => "A0%1sF1R hanno perso!",
  "0.20.0" => "Tutte le A6porte delle animeR sono svanite!",
  "0.21.0" => "Attacca e respingi A0%1sF2R!",
  "0.22.0" => "Presto, sconfiggi i A2demoniR e salva A0%1sF2R!",
  "0.23.0" => "La A6%1sF0R e la A6%2sF0R sono aperte!",
  "0.24.0" => "Sconfiggi A0%1sF3R!",
  "0.25.0" => "A0%1sF0R attacca in volo dal deserto nord!",
  "0.26.0" => "Hai conquistato l'area A0%1sF4R!",
  "0.27.0" => "A0%1sF0R perde il suo nido e si demoralizza!",
  "0.28.0" => "A0%1sF0R perde il suo nido e si indebolisce!",
  "0.29.0" => "Appaiono i rinforzi dell'A0%1sF5R!",
  "0.30.0" => "A0%1sF0R si ritira temporaneamente nell'area A0%2sF6R!",
  "0.31.0" => "A0%1sF0R si riposa per recuperare le energie!",
  "0.32.0" => "A0%1sF0R si riposa e il suo morale migliora!",
  "0.33.0" => "A0%1sF0R attacca in volo dal deserto sud!",
  "0.34.0" => "A0%1sF0R si riposa per potenziarsi!",
  "0.35.0" => "A0%1sF0R attacca in volo dal deserto nord!",
  "0.36.0" => "A0%1sF0R si riposa per potenziarsi ancora di più!",
  "0.37.0" => "A0%1sF0R attacca in volo dal deserto sud!",
  "0.38.0" => "Hai sconfitto A0%1sF2R!",
  "0.39.0" => "La A1base alleataR è nelle mani dell'A0%1sF7R!",
  "0.40.0" => "L'A0%1sF1R ha perso la battaglia!",
  "0.41.0" => "L'A0%2sF7R ha fatto fuggire A0%1sF2R!",
  "0.42.0" => "Hai conquistato l'area C2%1sF4R!",
  "0.43.0" => "Raggiungi A0%1sF2R!",
  "0.44.0" => "L'A0%1sF2R lotta contro A0%2sF2R!",
  "0.45.0" => "Ora puoi controllare A0%1sF2R!",
  "0.46.0" => "Conquista l'area A0%1sF2R!",
  "0.47.0" => "Un'A6AracnulaR è stata avvistata sul campo di battaglia!",
  "0.48.0" => "Hai ottenuto un'A6AracnulaR!",
  "0.49.0" => "L'A6AracnulaR è fuggita!",
  "0.50.0" => "A0%1sF0R non si può ritirare!",
  "0.51.0" => "A0%1sF0R appare!",
  "0.52.0" => "Le porte vicino al A6patiboloR sono aperte!",
  "0.53.0" => "L'A0%1sF0R invade l'area C1%2sF0R!",
  "0.54.0" => "L'area C1%1sF4R non deve cadere!",
  "0.55.0" => "Le condizioni di vittoria sono cambiate!",
  "0.56.0" => "Sconfiggi A0%1sF2R!",
  "0.57.0" => "A0%1sF1R del A6patiboloR vanno verso l'area C1%2sF0R!",
  "0.58.0" => "A0%1sF1R del A6deserto nordR vanno verso l'area C1%2sF0R!",
  "0.59.0" => "A0%1sF1R del A6deserto sudR vanno verso A0%2sF2R!",
  "0.60.0" => "Chiudi tutte le A6porte delle animeR!",
  "0.61.0" => "Conquista l'area A0%1sF2R per indebolire A0%2sF2R!",
  "0.62.0" => "Sconfiggi A0%1sF3R per chiudere le A6porte delle animeR!",
