Map {
  "0.0.0" => "Sconfiggi subito A0%1sF2R perché si comporta in modo sospetto!",
  "0.1.0" => "Hai raggiunto A0%1sF2R!",
  "0.2.0" => "A0%1sF0R ora è tra i tuoi A1alleatiR!",
  "0.3.0" => "L'A2armata nemicaR è più forte perché A0%1sF2R l'ha incoraggiata!",
  "0.4.0" => "A0%1sF0R, che non hai scelto, ora è dalla parte del nemico!",
  "0.5.0" => "A0%1sF0R ha evocato A0%2sF3R!",
  "0.6.0" => "Le condizioni di sconfitta sono cambiate!",
  "0.7.0" => "A0%1sF0R non deve fuggire!",
  "0.8.0" => "Hai sconfitto tutti A0%1sF3R!",
  "0.9.0" => "L'A2armata nemicaR ha abbandonato il campo di battaglia!",
  "0.10.0" => "A0%1sF0R si ritira momentaneamente!",
  "0.11.0" => "A0%1sF0R si allontana temporaneamente!",
  "0.12.0" => "Ferma il piano A2nemicoR!",
  "0.13.0" => "Appaiono A0%1sF2R e A0%2sF2R!",
  "0.14.0" => "Le armate combattono una contro l'altra!",
  "0.15.0" => "Hai sconfitto A0%1sF2R!",
  "0.16.0" => "A0%1sF0R e la sua armata ora sono tra i tuoi A1alleatiR!",
  "0.17.0" => "A0%1sF0R e A0%2sF2R appaiono di nuovo!",
  "0.18.0" => "A0%1sF0R ha evocato un A2mostro giganteR e delle A2truppe nemicheR!",
  "0.19.0" => "A0%1sF0R ha evocato un A2mostro giganteR e delle A2truppe nemicheR!",
  "0.20.0" => "Hai sconfitto entrambi i A2comandantiR!",
  "0.21.0" => "Hai sconfitto tutti i A2comandantiR e il A2mostro giganteR!",
  "0.22.0" => "Né A0%1sF2R né A0%2sF2R devono scappare!",
  "0.23.0" => "Gli A1alleatiR incoraggiano A0%1sF2R, facendo migliorare il suo morale!",
  "0.24.0" => "Il morale di A0%1sF6R è tornato normale!",
  "0.25.0" => "A0%1sF0R lascia A6giare magicheR sul campo per gli A1alleatiR!",
  "0.26.0" => "A0%1sF0R lascia A6frammenti di forzaR sul campo per gli A1alleatiR!",
  "0.27.0" => "Il tempo è scaduto! Hai perso!",
  "0.28.0" => "A0%1sF0R è in fuga! Hai perso!",
  "0.29.0" => "A0%1sF0R ha perso!",
  "0.30.0" => "A5Tutte le armate nemicheR si sono ritirate!",
