Map {
  "0.0.0" => "L'A0%1sF1R attacca l'A0%2sF7R!",
  "0.1.0" => "A0%1sF0R ha chiuso la A6porta principale del tempioR!",
  "0.2.0" => "A0%1sF0R va verso A0%2sF2R!",
  "0.3.0" => "A0%1sF0R va verso l'area A0%2sF2R!",
  "0.4.0" => "L'A0%2sF5R ha fermato A0%1sF2R!",
  "0.5.0" => "A0%1sF1R appaiono!",
  "0.6.0" => "A0%1sF1R vanno alla A6porta principale del tempioR!",
  "0.7.0" => "L'A0%1sF1R va verso A0%2sF3R!",
  "0.8.0" => "A0%1sF0R è nei guai!",
  "0.9.0" => "A0%1sF0R è in pericolo! Vai in soccorso!",
  "0.10.0" => "A0%1sF0R ha raggiunto la porta principale del tempio!",
  "0.11.0" => "Scorta il resto A0%1sF7R a destinazione!",
  "0.12.0" => "A0%1sF1R sono all'A6entrata del tempio dell'acquaR!",
  "0.13.0" => "Hai scortato A0%1sF3R!",
  "0.14.0" => "A0%1sF1R hanno aperto la A6porta principale del tempioR!",
  "0.15.0" => "A0%1sF0R è in fuga!",
  "0.16.0" => "Il morale di parte dell'A0%1sF1R è migliorato!",
  "0.17.0" => "L'A0%1sF7R ha aperto il A6tempioR!",
  "0.18.0" => "Parte dell'A0%1sF1R va verso l'A0%2sF7R!",
  "0.19.0" => "Parte dell'A0%1sF1R va verso l'area A0%2sF6R!",
  "0.20.0" => "L'area C1%1sF4R non deve cadere!",
  "0.21.0" => "L'A0%1sF5R ha aperto la A6porta est del tempioR!",
  "0.22.0" => "Hai sconfitto A0%1sF2R!",
  "0.23.0" => "L'area A0%1sF0R è aperta!",
  "0.24.0" => "A0%1sF0R e A0%2sF2R vanno verso l'area C1%3sF6R!",
  "0.25.0" => "A0%1sF0R si ferma davanti alla A6porta est del tempioR!",
  "0.26.0" => "A0%1sF0R ha aperto la A6porta est del tempioR!",
  "0.27.0" => "A0%1sF0R va verso l'area C1%2sF6R!",
  "0.28.0" => "Hai sconfitto A0%1sF2R!",
  "0.29.0" => "Hai sconfitto A0%1sF2R e A0%2sF2R!",
  "0.30.0" => "A0%1sF0R si mette in marcia verso A0%2sF6R!",
  "0.31.0" => "I presidi dell'A0%1sF1R sono aperti!",
  "0.32.0" => "Parte dell'A0%1sF1R va verso A0%2sF2R!",
  "0.33.0" => "L'A0%2sF7R ha fermato A0%1sF2R!",
  "0.34.0" => "Salva A0%1sF2R dall'A0%2sF3R!",
  "0.35.0" => "Aiuta A0%1sF2R e apri l'area A0%2sF2R!",
  "0.36.0" => "A0%1sF0R ha raggiunto l'area A0%2sF4R!",
  "0.37.0" => "Hai aiutato A0%1sF2R!",
  "0.38.0" => "L'A0%1sF1R si ritira!",
  "0.39.0" => "L'A0%1sF1R ha vinto!",
  "0.40.0" => "L'A0%2sF5R ha messo in fuga A0%1sF2R!",
  "0.41.0" => "L'A0%1sF5R ha perso!",
  "0.42.0" => "L'area A0%1sF0R si è arresa all'A0%2sF7R!",
  "0.43.0" => "Ora puoi controllare A0%1sF2R!",
  "0.44.0" => "A0%1sF0R attacca A0%2sF2R!",
  "0.45.0" => "Hai sconfitto A0%1sF3R!",
  "0.48.0" => "Raggiungi il A6tempio dell'acquaR!",
  "0.49.0" => "Sconfiggi A0%1sF2R!",
  "0.50.0" => "Rinforzi per l'A0%1sF5R sono apparsi nell'area C5%2sF6R!",
  "0.51.0" => "Presto, apri le dighe e salva A0%1sF2R!",
  "0.52.0" => "L'A0%1sF1R si avvicina a A0%2sF6R!",
  "0.53.0" => "A0%1sF0R ha cominciato a combattere contro A0%2sF2R!",
  "0.54.0" => "A0%1sF1R appaiono!",
  "0.55.0" => "Apri tutte le dighe!",
  "0.56.0" => "Hai trovato l'A6interruttore di controlloR di una diga!",
  "0.57.0" => "Un'A6AracnulaR è stata avvistata sul campo di battaglia!",
  "0.58.0" => "Cerca l'A6AracnulaR!",
  "0.59.0" => "Hai ottenuto l'A6AracnulaR!",
  "0.60.0" => "L'A6AracnulaR sta per fuggire!",
  "0.61.0" => "L'A6AracnulaR è fuggita!",
  "0.62.0" => "Hai salvato A0%1sF2R!",
  "0.63.0" => "L'area C2%1sF0R è aperta!",
  "0.64.0" => "A0%1sF0R si mette in marcia!",
  "0.65.0" => "A0%1sF0R abbandona il campo di battaglia!",
  "0.66.0" => "A0%1sF0R ha evocato A0%1sF2R!",
  "0.67.0" => "Nell'area C5%1sF6R appaiono demoni!",
  "0.68.0" => "A0%1sF0R appare per aiutare A0%2sF2R!",
  "0.69.0" => "A0%1sF0R ha lasciato temporaneamente il campo di battaglia!",
  "0.70.0" => "Conquista l'area C2%1sF0R!",
  "0.71.0" => "A0%1sF0R si mette in marcia per proteggere il A6tempio dell'acquaR!",
  "0.72.0" => "L'attacco a sorpresa dell'A0%2sF5R demoralizza l'A0%1sF1R!",
  "0.73.0" => "Scorta A0%1sF2R alla sua destinazione!",
  "0.74.0" => "A0%1sF0R ha raggiunto l'area A0%2sF0R!",
  "0.75.0" => "A0%1sF0R ha evocato A0%2sF2R!",
  "0.76.0" => "La magia di A0%2sF6R potenzia A0%1sF2R!",
  "0.77.0" => "A0%1sF0R va verso l'area A0%2sF2R!",
  "0.78.0" => "Hai protetto A0%1sF2R!",
  "0.79.0" => "Salva A0%1sF2R!",
  "0.80.0" => "Ora puoi controllare A0%1sF2R!",
  "0.81.0" => "Hai protetto A0%1sF2R!",
  "0.82.0" => "Presto, soccorri A0%1sF2R!",
  "0.83.0" => "A0%1sF0R appare!",
  "0.84.0" => "A0%1sF0R va verso la piazza del tempio!",
  "0.85.0" => "A0%1sF0R non deve raggiungere il tempio dell'acqua!",
  "0.86.0" => "A0%1sF0R ha raggiunto il tempio dell'acqua!",
  "0.87.0" => "A0%1sF0R si esalta e il morale è migliorato!",
  "0.88.0" => "Presto, salva A0%1sF2R!",
  "0.89.0" => "A0%2sF0R ha perso! L'A0%1sF5R si demoralizza!",
  "0.90.0" => "L'A0%1sF1R si mette in marcia!",
  "0.91.0" => "Presto, sconfiggi A0%1sF2R!",
  "0.92.0" => "Scorta A0%2sF2R all'area A0%1sF6R!",
