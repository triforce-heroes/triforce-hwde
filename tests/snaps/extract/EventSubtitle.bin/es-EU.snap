Map {
  "0.0.0" => "¡Apártate de mi camino!",
  "0.1.0" => "Bien, entonces moriréis juntos.",
  "0.2.0" => "Oh, no...",
  "0.3.0" => "Tú eres...",
  "0.4.0" => "Volga",
  "0.5.0" => "Volga",
  "0.6.0" => "Impa",
  "0.7.0" => "Impa",
  "1.0.0" => "No logramos dar con la princesa Zelda.
Espero que esté sana y salva...",
  "1.1.0" => "Necesitamos que nos ayudes a encontrarla.",
  "1.2.0" => "Link, demuestra que eres digno de ponerte estas ropas.",
  "1.3.0" => "Impa",
  "1.4.0" => "Impa",
  "1.5.0" => "Impa",
  "2.1.0" => "La princesa no está muerta.",
  "2.2.0" => "Puede que la encontréis en algún
momento de vuestro heroico viaje...",
  "2.3.0" => "Podéis llamarme Sheik.",
  "2.4.0" => "Mi nombre procede de la tribu sheikah,
sirvientes de la familia real de Hyrule.",
  "2.5.0" => "¿La tribu sheikah?",
  "2.6.0" => "No es posible...",
  "2.7.0" => "Ya hablaremos con calma cuando salgamos
de aquí. ¡Iré con vosotros!",
  "2.8.0" => "(?)",
  "2.9.0" => "(?)",
  "2.10.0" => "Sheik",
  "2.11.0" => "Sheik",
  "2.12.0" => "Impa",
  "2.13.0" => "Impa",
  "2.14.0" => "Sheik",
  "3.1.0" => "Tú...",
  "3.2.0" => "¿Eres la líder de estos guerreros?",
  "3.3.0" => "Sí.",
  "3.4.0" => "Sabes usar la magia.
¿Dónde has aprendido?",
  "3.5.0" => "Verás... soy una hechicera.",
  "3.6.0" => "Pertenezco al mismo clan que Cya, la hechicera
que controla a esos monstruos.",
  "3.7.0" => "Dime una cosa...",
  "3.8.0" => "¿Qué quiere de Hyrule esa tal Cya?",
  "3.9.0" => "¿Seguro que quieres saberlo?",
  "3.10.0" => "Pues...",
  "3.11.0" => "A lo mejor si nos ayudas...",
  "3.12.0" => "te lo diré.",
  "3.13.0" => "Lana",
  "3.14.0" => "Impa",
  "3.15.0" => "Lana",
  "3.16.0" => "Impa",
  "3.17.0" => "Lana",
  "3.18.0" => "Lana",
  "3.19.0" => "Impa",
  "3.20.0" => "Impa",
  "3.21.0" => "Lana",
  "3.22.0" => "Lana",
  "3.23.0" => "Lana",
  "3.24.0" => "Lana",
  "4.1.0" => "Tenía la esperanza de que Zelda estuviese aquí...
Ya veo que me equivocaba.",
  "4.2.0" => "¿Dónde estará? Que las diosas la protejan...",
  "4.3.0" => "Impa",
  "4.4.0" => "Impa",
  "5.0.0" => "¿Eh?",
  "5.1.0" => "El famoso Link... Déjame verte bien.",
  "5.2.0" => "¿Qué?",
  "5.3.0" => "¡Link!",
  "5.4.0" => "Dos...",
  "5.5.0" => "Ya veo...",
  "5.6.0" => "Qué buena noticia.",
  "5.7.0" => "¡Ven a mí!",
  "5.8.0" => "Cya",
  "5.9.0" => "Cya",
  "5.10.0" => "Cya",
  "5.11.0" => "Sheik",
  "5.12.0" => "Cya",
  "5.13.0" => "Cya",
  "5.14.0" => "Cya",
  "5.15.0" => "Cya",
  "6.0.0" => "¡Sheik! Eso es...",
  "6.1.0" => "Qué oportuno que hayas traído la Trifuerza de la Sabiduría.",
  "6.2.0" => "Ahora ya tengo los tres fragmentos.",
  "6.3.0" => "¡Contemplad el poder de la Trifuerza!",
  "6.4.0" => "¡No! ¡Huye, Link!",
  "6.5.0" => "Cya...",
  "6.6.0" => "Ahora solo debo recuperar el último
fragmento de mi espíritu.",
  "6.7.0" => "Sí... Siento que me busca.",
  "6.8.0" => "¡Aaaaah!",
  "6.9.0" => "Lana",
  "6.10.0" => "Cya",
  "6.11.0" => "Cya",
  "6.12.0" => "Cya",
  "6.13.0" => "Lana",
  "6.14.0" => "(?)",
  "6.15.0" => "(?)",
  "6.16.0" => "Cya",
  "6.17.0" => "Cya",
  "7.0.0" => "Podías haber ido con Link o con Lana.
¿Por qué has venido conmigo?",
  "7.1.0" => "No sé qué te traes entre manos...
¿Cuánto sabes de los sheikah?",
  "7.2.0" => "Dime, ¿quién es vuestro líder?",
  "7.3.0" => "Impa. Es decir, tú.",
  "7.4.0" => "Exacto. Y entre nosotros no hay
nadie que se llame Sheik...",
  "7.5.0" => "Entonces... ¿quién eres? ¿Qué es lo que buscas?",
  "7.6.0" => "¡Socorro! ¡La princesa Ruto está en apuros!",
  "7.7.0" => "Ruto, la princesa zora.",
  "7.8.0" => "¡Los goron la han secuestrado!",
  "7.9.0" => "Darunia, su líder, siempre ha tenido
un corazón de oro...",
  "7.10.0" => "Hasta que una tal Zelda apareció y
de repente dejó de ser el mismo.",
  "7.11.0" => "¿Zelda? ¿Está aquí la princesa Zelda?",
  "7.12.0" => "Vayamos a comprobarlo con nuestros propios ojos.",
  "7.13.0" => "Impa",
  "7.14.0" => "Impa",
  "7.15.0" => "Impa",
  "7.16.0" => "Sheik",
  "7.17.0" => "Impa",
  "7.18.0" => "Impa",
  "7.19.0" => "Hada",
  "7.20.0" => "Sheik",
  "7.21.0" => "Hada",
  "7.22.0" => "Hada",
  "7.23.0" => "Hada",
  "7.24.0" => "Impa",
  "7.25.0" => "Sheik",
  "8.0.0" => "¿Cómo has sabido que era un impostor?",
  "8.1.0" => "No puedes ser Zelda.",
  "8.2.0" => "Porque...",
  "8.3.0" => "¡Yo soy la princesa Zelda!",
  "8.4.0" => "¡Princesa! ¡Estáis viva!",
  "8.5.0" => "Impa, perdona que no te lo contase.",
  "8.6.0" => "Debemos cerrar el portal.",
  "8.7.0" => "Invocante",
  "8.8.0" => "Sheik",
  "8.9.0" => "Sheik",
  "8.10.0" => "Zelda",
  "8.11.0" => "Impa",
  "8.12.0" => "Zelda",
  "8.13.0" => "Zelda",
  "9.0.0" => "¡No os acerquéis!",
  "9.1.0" => "¡Aaaah!",
  "9.2.0" => "Ha estado cerca...",
  "9.3.0" => "¿Estás bien?",
  "9.4.0" => "¡Sí! Me llamo Maripola.
¿Y tú quién eres?",
  "9.5.0" => "Soy Lana.",
  "9.6.0" => "Necesito encontrar el Portal de las Almas.
Pero... no sé dónde buscarlo.",
  "9.7.0" => "¿El Portal de las Almas? Nunca he visto uno.",
  "9.8.0" => "Pero puedo llevarte adonde quieras ir.",
  "9.9.0" => "Y... ¿cómo vas a hacerlo?",
  "9.10.0" => "¡Pues con esta mariposa guía! Nos guiará por
el Reino del Crepúsculo.",
  "9.11.0" => "Niña",
  "9.12.0" => "Niña",
  "9.13.0" => "Lana",
  "9.14.0" => "Lana",
  "9.15.0" => "Niña",
  "9.16.0" => "Lana",
  "9.17.0" => "Lana",
  "9.18.0" => "Maripola",
  "9.19.0" => "Maripola",
  "9.20.0" => "Lana",
  "9.21.0" => "Maripola",
  "10.0.0" => "¡Suéltala! No es una mariposa cualquiera.",
  "10.1.0" => "¿Para qué? ¿Para que vuele por ahí
y envenene a mis tropas?",
  "10.2.0" => "¿Qué?",
  "10.3.0" => "No, el polvillo que sueltan sus alas
no es venenoso, ¡os lo prometo!",
  "10.4.0" => "¿Polvillo?",
  "10.5.0" => "Es una mariposa guía.",
  "10.6.0" => "Si se lo pides educadamente, te guiará a cualquier sitio.
Es una mariposa muy misteriosa.",
  "10.7.0" => "A cualquier sitio, ¿eh?",
  "10.8.0" => "¡Oye, mariposa! Llévame con esa bruja tan fea.",
  "10.9.0" => "Ay... ¿Qué podemos hacer?",
  "10.10.0" => "Lo único que podemos hacer es luchar.",
  "10.11.0" => "Lana",
  "10.12.0" => "Midna",
  "10.13.0" => "Lana",
  "10.14.0" => "Maripola",
  "10.15.0" => "Midna",
  "10.16.0" => "Maripola",
  "10.17.0" => "Maripola",
  "10.18.0" => "Midna",
  "10.19.0" => "Midna",
  "10.20.0" => "Maripola",
  "10.21.0" => "Lana",
  "11.0.0" => "Lana, ¿qué haces tú aquí?",
  "11.1.0" => "¡Cya!",
  "11.2.0" => "¡Es ella! ¡Fue ella quien me hechizó!",
  "11.3.0" => "Yo diría que estás mejor así. Es el aspecto
ideal para una princesa del Crepúsculo.",
  "11.4.0" => "Serás...",
  "11.5.0" => "¡Aaaah!",
  "11.6.0" => "¡Insolente!",
  "11.7.0" => "Lana, es igual que tú...",
  "11.8.0" => "Soy la otra mitad de Cya... Una vez fuimos una sola persona.",
  "11.9.0" => "¿Quéee?",
  "11.10.0" => "Cya",
  "11.11.0" => "Lana",
  "11.12.0" => "Midna",
  "11.13.0" => "Cya",
  "11.14.0" => "Midna",
  "11.15.0" => "Cya",
  "11.16.0" => "Cya",
  "11.17.0" => "Midna",
  "11.18.0" => "Lana",
  "11.19.0" => "Midna",
  "12.0.0" => "Me llamo Fay. Os estaba esperando.",
  "12.1.0" => "No sois mi amo, pero os consideraré como tal.",
  "12.2.0" => "Mi cometido es serviros.",
  "12.3.0" => "Si queréis tener éxito, necesitaréis mi ayuda.",
  "12.4.0" => "¿Os acompaño?",
  "12.5.0" => "Fay",
  "12.6.0" => "Fay",
  "12.7.0" => "Fay",
  "12.8.0" => "Fay",
  "12.9.0" => "Fay",
  "13.0.0" => "¿El enemigo conoce mis planes?",
  "13.1.0" => "¡Qué inoportuno!",
  "13.2.0" => "Es indignante.",
  "13.3.0" => "Si no saben estarse quietos, ¡me desharé de ellos!",
  "13.4.0" => "Grahim",
  "13.5.0" => "Grahim",
  "13.6.0" => "Grahim",
  "13.7.0" => "Grahim",
  "14.0.0" => "Amo, apuntad con vuestra espada
hacia los cielos y luego bajadla.",
  "14.1.0" => "Fay",
  "15.0.0" => "¿Han vuelto vuestros fragmentos de la Trifuerza?",
  "15.1.0" => "Sí, ahora están dentro de Link y de mí...",
  "15.2.0" => "No sabemos qué ha ocurrido, pero el poder
de Cya ha menguado.",
  "15.3.0" => "Si vamos a contratacar, debemos hacerlo ya.",
  "15.4.0" => "Cya aún tiene la Trifuerza del Poder.",
  "15.5.0" => "No la derrotaremos tan fácilmente.",
  "15.6.0" => "Si nos hacemos con la Espada Maestra,
podemos ganar.",
  "15.7.0" => "Creo que Link posee la fuerza necesaria para empuñarla.",
  "15.8.0" => "Pero princesa... La Espada Maestra
no es una mera arma. Es una barrera.",
  "15.9.0" => "Encierra un fragmento del mal. Al extraerla,
el espíritu quedará libre.",
  "15.10.0" => "Las barreras que rodean el Templo de la Espada
Sagrada fueron creadas con una magia especial.",
  "15.11.0" => "El simple hecho de empuñar la Espada Maestra
no anulará la barrera. Al menos no por completo.",
  "15.12.0" => "¿Creéis que Link estará a la altura?",
  "15.13.0" => "Yo creo en él.",
  "15.14.0" => "Yo también.",
  "15.15.0" => "Link, si querías demostrar tu valía, esta es tu oportunidad.",
  "15.16.0" => "Entonces vayamos al Templo de la Espada Sagrada.",
  "15.17.0" => "Lana",
  "15.18.0" => "Zelda",
  "15.19.0" => "Lana",
  "15.20.0" => "Lana",
  "15.21.0" => "Impa",
  "15.22.0" => "Impa",
  "15.23.0" => "Zelda",
  "15.24.0" => "Zelda",
  "15.25.0" => "Impa",
  "15.26.0" => "Impa",
  "15.27.0" => "Lana",
