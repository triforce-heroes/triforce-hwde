  "0.8.0" => "A0%1sF0R hat den Vormarsch A0%2sF3R gebremst!",
  "0.9.0" => "ADV082_mes, 9",
  "0.10.0" => "ADV082_mes, 10",
  "0.11.0" => "A0%1sF1R rücken zu ihren Zielen vor!",
  "0.12.0" => "Ein Teil der A0%1sF1R rückt gegen A0%2sF7R vor!",
  "0.13.0" => "A0%1sF1R dürfen nicht fliehen!",
  "0.14.0" => "A0%2sF1R werden durch den Sieg über A0%1sF6R schneller!",
  "0.15.0" => "ADV082_mes, 15",
  "0.16.0" => "A0%1sF0R hat das A6ZielR erreicht!",
  "0.17.0" => "ADV082_mes, 17",
  "0.18.0" => "ADV082_mes, 18",
  "0.19.0" => "A0%1sF0R ist geflohen!",
  "0.20.0" => "ADV082_mes, 20",
  "0.21.0" => "ADV082_mes, 21",
  "0.22.0" => "A0%1sF0R hat sich den A0%2sF1R angeschlossen!",
  "0.23.0" => "Die Bedingungen für eine Niederlage haben sich geändert!",
  "0.24.0" => "Die Siegbedingungen haben sich geändert!",
  "0.25.0" => "A0%1sF0R ist geflohen! Die A0%2sF5R wurden besiegt!",
  "0.26.0" => "C1%1sF0R ist gefallen! Die A0%2sF5R wurden besiegt!",
  "0.27.0" => "A0%1sF0R wurde erobert!",
  "0.28.0" => "A0%1sF0R wurde besiegt!",
  "0.29.0" => "A0%1sF0R wurde besiegt!",
  "0.30.0" => "Besiege A0%1sF6R!",
  "0.31.0" => "A0%1sF0R und A0%2sF5R dürfen nicht fliehen, A1dein HauptquartierR nicht fallen!",
  "0.32.0" => "A0%1sF0R ist offen!",
  "0.33.0" => "Die A0%2sF5R haben den Vormarsch A0%1sF2R gestoppt!",
  "0.34.0" => "Erobere A0%1sF6R!",
  "0.35.0" => "A0%1sF0R rückt nach der Eroberung C2%2sF2R wieder vor!",
  "0.36.0" => "A0%1sF0R hat A0%2sF7R gestärkt und schneller gemacht!",
  "0.37.0" => "A0%2sF1R werden durch die Niederlage A0%1sF2R langsamer!",
  "0.38.0" => "A0%1sF0R hat einen Teil der A0%2sF7R schneller gemacht!",
  "0.39.0" => "Einer A0%1sF3R kämpft gegen die A0%2sF7R!",
  "0.40.0" => "Erobere A0%1sF6R und unterstütze den Vormarsch A0%2sF2R!",
  "0.41.0" => "A0%1sF0R darf nicht fliehen und A1dein HauptquartierR darf nicht fallen!",
  "0.42.0" => "A0%1sF1R haben sich zurückgezogen!",
  "0.43.0" => "A0%1sF0R rückt gegen A0%2sF6R vor!",
  "0.44.0" => "Besiege A0%1sF6R, um A0%2sF7R zu verlangsamen!",
  "0.45.0" => "Besiege A0%1sF6R, um A0%2sF7R zu beschleunigen!",
  "0.46.0" => "Achte auf die A6verbleibende ZeitR!",
  "0.47.0" => "ADV082_mes, 47",
  "0.48.0" => "A0%1sF0R ist in Gefahr und benötigt auf der Stelle Hilfe!",
