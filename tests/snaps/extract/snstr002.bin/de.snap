  "0.19.0" => "Besiege A0%1sF6R!",
  "0.20.0" => "A0%1sF0R hat sich zurückgezogen!",
  "0.21.0" => "A0%1sF0R wurde auf dem Schlachtfeld gesichtet!",
  "0.22.0" => "A0%1sF0R greift A0%2sF6R an!",
  "0.24.0" => "Die A0%1sF1R haben die Schlacht gewonnen!",
  "0.25.0" => "C1%1sF0R ist an die A0%2sF7R gefallen!",
