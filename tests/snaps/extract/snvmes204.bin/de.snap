Map {
  "1.0.0.0" => "O großer Ganon, Eure Kampfkraft
ist wahrlich überragend!",
  "1.0.1.0" => "Ihr seid fürwahr meiner Gefolgschaft würdig!",
  "1.0.2.0" => "Ich werde von immer mehr Feinden umgeben...",
  "1.0.3.0" => "Es widerstrebt mir, dies zuzugeben, aber die
Zahl unserer Gegner könnte ein Problem werden...",
  "1.0.4.0" => "Ihr seid Narren, euch gegen mich zu stellen!
Sehr, sehr viele Narren...",
  "1.0.5.0" => "Ich hätte Euch gern länger zugesehen,
aber ich sollte mich besser zurückziehen...",
  "1.0.6.0" => "Wie lange muss ich mich mit
diesem Gesindel noch abgeben?",
  "1.0.7.0" => "Eure Hilfe ehrt mich, großer Ganon!",
  "1.0.8.0" => "Ihr habt mir sehr geholfen, Herr! Worte können
meine Dankbarkeit nicht ausdrücken...",
  "1.0.9.0" => "Großartig! Niemand kann es mit Eurer
Herrlichkeit aufnehmen!",
  "1.0.10.0" => "Eure Kraft ist gewaltig! Eure
Kampfeslust geradezu unstillbar!",
  "1.0.11.0" => "Ein Handstreich, und die Feinde zerstieben in
alle Richtungen. Groß ist Eure Stärke!",
  "1.0.12.0" => "Verzweifelt vor der Macht meines Herrn!",
  "1.0.13.0" => "Ja! Genau so! Verschont niemanden!",
  "1.0.14.0" => "Ich stelle mich bedingungslos in Euren
Dienst, Herr...",
  "1.0.15.0" => "Es ist zu viel der Ehre für dieses Kanonenfutter,
dass Ihr Euch mit ihnen befasst...",
  "1.0.16.0" => "Diese Schlacht...
Sie ist wunderschön...",
  "1.0.17.0" => "Es ist eine Freude, Euch in Aktion
erleben zu dürfen!",
  "1.0.18.0" => "Verglichen mit Euch sind sie nur Würmer!",
  "1.0.19.0" => "Niemand kann Euch aufhalten!",
  "1.0.20.0" => "Eure Macht kennt keine Grenzen!",
  "1.0.21.0" => "Wie ist dieses Huhn so groß geworden?
Wo das zupickt, wächst kein Gras mehr...",
  "1.0.22.0" => "Es zertrampelt unsere Feinde...
Ist es auf unserer Seite?",
  "1.0.23.0" => "Der Feind sammelt sich hier...
Das gefällt mir gar nicht!",
  "1.0.24.0" => "Gegen so viele Feinde haben wir keine Chance!",
  "1.0.25.0" => "Wir sind umzingelt, Link! Uns muss
schnell etwas einfallen, sonst...",
  "1.0.26.0" => "Ich kann nicht mehr...",
  "1.0.27.0" => "Sie haben uns überrannt...
Wir müssen fliehen, Link!",
  "1.0.28.0" => "Danke für die Hilfe!",
  "1.0.29.0" => "Wir sollten uns für die Hilfe
revanchieren, Link!",
  "1.0.30.0" => "Es sind genug Feinde für alle da!
Gebt es ihnen!",
  "1.0.31.0" => "Ich hätte nicht gedacht,
dass du gleich so viele schaffst!",
  "1.0.32.0" => "Du hältst dich für stärker als unser gefiederter
Freund? Da lachen ja die Hühner...",
  "1.0.33.0" => "Immer weiter so!",
  "1.0.34.0" => "Keine Zeit für eine Pause! Weiter, weiter!",
  "1.0.35.0" => "Jetzt nur nicht nachlassen!",
  "1.0.36.0" => "Weiter so!",
  "1.0.37.0" => "Egal, wie viele Feinde noch kommen,
wir werden sie alle besiegen!",
  "1.0.38.0" => "Es kommen einfach immer mehr...
Verlier nicht den Mut, Link!",
  "1.0.39.0" => "Lass uns anderswo ein paar
Feinde besiegen, Link!",
  "1.0.40.0" => "Sehr gut, Link! Du lässt ihnen
keine Chance!",
  "1.0.41.0" => "Nur noch ein paar mehr!
Gib's ihnen!",
  "1.0.42.0" => "Das war fast schon zu einfach. Sie hätten
sich ruhig etwas mehr anstrengen können.",
  "1.0.43.0" => "Sie hätten wissen müssen, was passiert, wenn man
sich dem großen Ganon in den Weg stellt.",
  "1.0.44.0" => "Eure unermessliche Macht hat unsere Gegner
in hoffnungslose Verzweiflung getrieben!",
  "1.0.45.0" => "Es war ein Kinderspiel für Euch,
all diese Feinde zu besiegen!",
  "1.0.46.0" => "Eure Großartigkeit raubt mir den Atem!",
  "1.0.47.0" => "Welch großartige Schlacht! Ich fühle mich geehrt,
dass Ihr mich daran habt teilhaben lassen!",
  "1.0.48.0" => "Geschafft! Das war ja gar nicht mal so schwer...",
  "1.0.49.0" => "Der Feind war übermächtig, aber wir haben gesiegt!",
  "1.0.50.0" => "Es war eine Freude, dich kämpfen zu sehen!",
  "1.0.51.0" => "Du hast eine Menge Feinde besiegt, Link!",
  "1.0.52.0" => "Ein unglaublicher Kampf!",
  "1.0.53.0" => "Du warst fantastisch, Link!
Aber ich hab dich ja auch angefeuert...",
}