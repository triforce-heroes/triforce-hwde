  "0.83.0" => "Erobere C2%1sF6R zurück!",
  "0.84.0" => "A0%1sF0R hat das Schlachtfeld verlassen!",
  "0.85.0" => "Eine A6SkulltulaR wurde auf dem Schlachtfeld gesichtet!",
