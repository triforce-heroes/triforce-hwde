  "0.14.0" => "A0%1sF0R va verso l'area A0%2sF6R!",
  "0.15.0" => "A0%1sF0R va verso A0%2sF2R!",
  "0.16.0" => "A0%1sF0R ignora A0%2sF2R e riprende la marcia!",
  "0.17.0" => "L'A0%1sF1R è diventata più forte dopo la fuga di A0%2sF2R!",
  "0.18.0" => "A0%1sF0R è nell'area A0%2sF6R e potenzia il cerchio magico!",
  "0.19.0" => "Sconfiggi A0%1sF2R prima che accumuli potere magico!",
  "0.20.0" => "Presto, sconfiggi A0%1sF2R!",
  "0.21.0" => "Devi sconfiggere immediatamente A0%1sF2R!",
  "0.22.0" => "A0%1sF0R ha accumulato potere per lanciare una magia!",
  "0.23.0" => "Non hai fermato il piano nemico!",
