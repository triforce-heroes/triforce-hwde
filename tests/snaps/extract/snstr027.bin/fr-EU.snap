Map {
  "0.0.0" => "A0%1sF5R attaque A0%2sF1R !",
  "0.1.0" => "Éliminez A0%1sF1R !",
  "0.2.0" => "Prenez l'autre fort A0%1sF3R !",
  "0.3.0" => "Les portes d'accès à la A6caverne de cristalR sont ouvertes !",
  "0.4.0" => "Vous avez obtenu la A6bague ancienneR !",
  "0.5.0" => "Les conditions de victoire ont changé !",
  "0.6.0" => "Vaincre A0%1sF0R !",
  "0.7.0" => "Les conditions de défaite ont changé !",
  "0.8.0" => "Ne pas laisser A0%1sF0R fuir ni A0%2sF0R tomber !",
  "0.9.0" => "Les portes menant vers le côté ouest de la grotte sont ouvertes !",
  "0.10.0" => "Éliminez A0%1sF0R !",
  "0.11.0" => "A0%1sF5R a reçu des renforts !",
  "0.12.0" => "A0%1sF4R bat temporairement en retraite !",
  "0.13.0" => "A0%1sF7R et A0%2sF3R apparaissent !",
  "0.14.0" => "A0%1sF6R avance sur A0%2sF0R !",
  "0.15.0" => "Empêchez A0%1sF0R de s'introduire dans le fort !",
  "0.16.0" => "A0%1sF4R s'est introduit dans A0%2sF0R et se prépare à exploser !",
  "0.17.0" => "A0%2sF4R a explosé ! Vous avez perdu C1%1sF0R !",
  "0.18.0" => "Le moral A0%1sF3R et A0%2sF3R augmente !",
  "0.19.0" => "La chute C1%2sF2R décourage A0%1sF1R !",
  "0.20.0" => "A0%2sF4R a explosé ! Vous avez perdu C1%1sF0R !",
  "0.21.0" => "A0%1sF4R a été détruit !",
  "0.22.0" => "A0%1sF5R ont été détruits !",
  "0.23.0" => "A0%1sF6R renforcé est apparu dans A0%2sF0R !",
  "0.24.0" => "Prenez immédiatement le contrôle des forts A0%1sF3R !",
  "0.25.0" => "A0%1sF4R affronte A0%2sF0R !",
  "0.26.0" => "A0%1sF4R est en difficulté ! Allez l'aider !",
  "0.27.0" => "A0%1sF4R est en grand danger ! Allez vite l'aider !",
  "0.28.0" => "Vous avez vaincu A0%1sF0R et A0%2sF0R !",
  "0.29.0" => "Les portes A0%1sF2R sont ouvertes !",
  "0.30.0" => "Éliminez A0%1sF0R !",
  "0.31.0" => "A0%1sF7R rejoignent le champ de bataille ! Ils sont deux !",
  "0.32.0" => "Un A0%1sF3R avance sur A0%2sF0R depuis le nord !",
  "0.33.0" => "A0%1sF4R vient de vous trahir et avance sur A0%2sF0R !",
  "0.34.0" => "Vaincre A0%1sF0R et A0%2sF0R !",
  "0.35.0" => "A0%1sF6R a pénétré dans A0%2sF0R !",
  "0.36.0" => "A0%1sF4R lance une attaque contre A0%2sF1R !",
  "0.37.0" => "Vous avez vaincu A0%1sF0R !",
  "0.38.0" => "Vous avez vaincu A0%1sF0R et A0%2sF0R !",
  "0.39.0" => "A0%1sF4R imprègne A0%2sF0R et A0%3sF0R de magie des ténèbres !",
  "0.40.0" => "Chute C1%1sF2R !",
  "0.41.0" => "A0%1sF5R a été vaincue !",
  "0.42.0" => "A0%1sF4R fuit !",
  "0.43.0" => "A0%1sF4R est K.-O. ! Ses troupes battent en retraite !",
  "0.44.0" => "A0%1sF5R a reçu des renforts !",
  "0.45.0" => "Les A6portes ouest du fort centralR sont ouvertes !",
  "0.46.0" => "A0%1sF4R ne doit pas tomber aux mains de l'ennemi !",
  "0.47.0" => "Le moral A0%1sF3R augmente !",
  "0.48.0" => "A0%1sF4R affronte A0%2sF1R !",
  "0.49.0" => "Vous avez pris le contrôle des forts A0%1sF3R !",
  "0.50.0" => "Ne pas laisser A0%1sF0R tomber !",
  "0.51.0" => "Dirigez-vous vers la A6caverne de cristalR et cherchez la A6bague ancienneR !",
  "0.52.0" => "Prenez A0%1sF0R pour trouver la A6bague ancienneR !",
  "0.53.0" => "A0%1sF4R est K.-O. !",
  "0.54.0" => "Un A5invocateurR rejoint le champ de bataille !",
  "0.55.0" => "Une A6skulltulaR est apparue sur le champ de bataille !",
  "0.56.0" => "Trouvez la A6skulltulaR !",
  "0.57.0" => "Vous avez obtenu une A6skulltulaR !",
  "0.58.0" => "La A6skulltulaR s'apprête à fuir !",
  "0.59.0" => "La A6skulltulaR s'est enfuie !",
  "0.60.0" => "A0%1sF6R rejoint le champ de bataille et avance sur C2%2sF0R !",
  "0.61.0" => "Vous avez pris le contrôle A0%1sF2R !",
  "0.62.0" => "Rassemblez-vous vers A0%1sF0R !",
  "0.63.0" => "A0%1sF4R affronte A0%2sF0R !",
